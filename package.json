{
  "name": "astro-app",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "clean:generated": "node scripts/clean-generated-artifacts.mjs",
    "build": "npm run clean:generated && NODE_OPTIONS='--max-old-space-size=14336' astro build --concurrency 1",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check",
    "lint": "astro check",
    "validate:personality": "npx tsx scripts/validate-personality-data.ts",
    "validate:i18n": "node scripts/audit-i18n.mjs",
    "audit:page-structure": "node scripts/audit-page-structure.mjs",
    "audit:localization": "node scripts/audit-localization.mjs",
    "audit:content-quality": "node scripts/audit-content-quality.mjs",
    "test:editorial-quality": "node --test scripts/editorial-quality.test.mjs",
    "content:manifest": "node scripts/generate-content-manifest.mjs",
    "audit:seo": "node scripts/audit-seo-output.mjs",
    "audit:links": "python3 scripts/link-audit.py dist",
    "verify:harness": "node scripts/verify-harness.mjs && node scripts/audit-exam-category.mjs",
    "test:tier-list": "node --experimental-strip-types --test src/lib/tier-list-state.test.ts",
    "test:finance": "node --experimental-strip-types --test src/lib/finance/*.test.ts",
    "audit:magazine-compat": "node scripts/audit-magazine-compat.mjs",
    "triage:magazine-compat": "node scripts/triage-magazine-compat.mjs",
    "submit:indexing": "python3 ../docs/search-submit-all.py --site blog --new-only",
    "submit:indexing:dry": "python3 ../docs/search-submit-all.py --site blog --new-only --dry-run",
    "test:cloud-state": "node --experimental-strip-types --test src/lib/cloud-state/*.test.ts",
    "audit:translations": "node scripts/verify-translation-batch.mjs --scan",
    "audit:emphasis": "node scripts/audit-markdown-emphasis.mjs",
    "audit:exam-category": "node scripts/audit-exam-category.mjs",
    "fix:exam-category": "node scripts/audit-exam-category.mjs --fix",
    "audit:layout-content-queries": "node scripts/audit-layout-content-queries.mjs",
    "audit:content-similarity": "node scripts/audit-content-similarity.mjs",
    "redirects:bulk-export": "node scripts/export-bulk-redirects.mjs",
    "redirects:bulk-sync": "node scripts/export-bulk-redirects.mjs --sync-pages",
    "redirects:bulk-check": "node scripts/export-bulk-redirects.mjs --check",
    "audit:headers-collision": "node scripts/audit-headers-collision.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.16.15",
    "astro-robots-txt": "^1.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.7",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-math": "^6.0.0",
    "remark-wiki-link": "^2.0.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@tailwindcss/typography": "^0.5.19",
    "google-translate-api-x": "^10.7.2",
    "gray-matter": "^4.0.3",
    "tsx": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
