# Cloudflare adapter binding note
SESSION=your-cloudflare-session-binding

# Analytics
PUBLIC_GA_ID=

# ── sitemap-submit.py ────────────────────────────────────────────────────────
# Google Search Console
# 1. GCP Console → IAM → Service Accounts → Create → Download JSON key
# 2. GSC → Settings → Users & permissions → Add service account email as "Owner"
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Bing Webmaster Tools
# Bing Webmaster → Settings → API Access → Generate API key
BING_WEBMASTER_API_KEY=

# IndexNow (Bing, Yandex, Naver, Seznam…)
# 1. Pick any unique string as your key (UUID recommended)
# 2. Create public/{key}.txt containing only the key value
# 3. It will be served at https://blog.oiyo.net/{key}.txt for verification
INDEXNOW_API_KEY=
