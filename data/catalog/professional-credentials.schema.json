{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Professional Credential Record",
  "type": "object",
  "required": [
    "id",
    "name_ko",
    "family",
    "status",
    "license_type",
    "overview",
    "preparation_stages",
    "exam_rounds",
    "passing_rule",
    "last_verified_on"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name_ko": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "draft", "published", "needs-review"]
    },
    "license_type": {
      "type": "string"
    },
    "overview": {
      "type": "string"
    },
    "preparation_stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typical_study_period": {
      "type": "string"
    },
    "eligibility_summary": {
      "type": "string"
    },
    "credit_requirement": {
      "type": ["string", "null"]
    },
    "exam_rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_name", "subjects"],
        "properties": {
          "round_name": {
            "type": "string"
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "passing_rule": {
      "type": "string"
    },
    "cutline_notes": {
      "type": "string"
    },
    "practical_training": {
      "type": "string"
    },
    "career_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_series_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified_on": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
