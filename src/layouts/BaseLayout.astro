---
import SEO from "../components/SEO.astro";
import { getLocaleFromPath, getTranslations } from "../lib/i18n";
import { siteConfig } from "../config/site.config";
import "../styles/global.css";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";

// BCP-47 mapping: Astro locale → HTML lang attribute standard value
const BCP47: Record<string, string> = {
  en: "en", ko: "ko", ja: "ja", fr: "fr", es: "es",
  zh: "zh-CN", // zh folder = Simplified Chinese
  cn: "zh-TW", // cn folder = Traditional Chinese
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  author?: string;
}

const { title, description, image, type, pubDate, updatedDate, tags, category, author } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = await getTranslations(locale);
const nav = t.nav as Record<string, string>;

const scrollSnapEnabled = siteConfig.features.scrollSnap;
---

<html
  lang={BCP47[locale] ?? locale}
  class:list={["scroll-smooth", { "snap-y snap-mandatory": scrollSnapEnabled }]}
>
  <head>
    <SEO {title} {description} {image} {type} {pubDate} {updatedDate} {tags} {category} {author} />

    



    <!-- KaTeX CSS: prevents duplicate math text (MathML + HTML both showing) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5" crossorigin="anonymous" />
    <!-- Mermaid diagram rendering -->
    <script type="module" is:inline>
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      const isDark = document.documentElement.classList.contains("dark");
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? "dark" : "neutral",
        securityLevel: "strict",
      });
      // Convert fenced code blocks to mermaid diagrams
      document.querySelectorAll("code.language-mermaid").forEach((el) => {
        const pre = el.parentElement;
        if (!pre) return;
        const div = document.createElement("div");
        div.className = "mermaid not-prose my-8";
        div.textContent = el.textContent;
        pre.replaceWith(div);
      });
      await mermaid.run();
    </script>
  </head>
  <body
    class="min-h-screen bg-background text-foreground font-sans antialiased text-pretty selection:bg-primary/20 selection:text-primary"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] bg-primary text-primary-foreground px-4 py-2 rounded-lg"
    >
      Skip to content
    </a>
    <header
      role="banner"
      class="sticky top-0 z-50 w-full border-b bg-background"
    >
      <div class="container flex h-16 items-center justify-between px-4">
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "SiteNavigationElement",
          "hasPart": [
            { "@type": "WebPage", "name": t.nav.home, "url": `${siteConfig.url}/${locale}/` },
            { "@type": "WebPage", "name": nav.courses ?? "Courses", "url": `${siteConfig.url}/${locale}/courses` },
            { "@type": "WebPage", "name": nav.magazine ?? "Magazine", "url": `${siteConfig.url}/${locale}/magazine` },
            { "@type": "WebPage", "name": nav.interactive ?? "Interactive", "url": `${siteConfig.url}/${locale}/interactive` },
            { "@type": "WebPage", "name": t.nav.about, "url": `${siteConfig.url}/${locale}/about` }
          ]
        })} />
        <div class="flex items-center gap-8">
          <a href={`/${locale}/`} class="flex items-center space-x-2">
            <span class="inline-block font-bold text-xl tracking-tighter">
              OIYO
            </span>
          </a>
          <nav
            class="flex gap-6 items-center overflow-x-auto scrollbar-hide max-w-[calc(100vw-120px)]"
          >
            <a
              href={`/${locale}/`}
              class="text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
              >{t.nav.home}</a
            >
            <a
              href={`/${locale}/courses`}
              class="text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
            >{nav.courses ?? "Courses"}</a>
            <a
              href={`/${locale}/magazine`}
              class="text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
            >{nav.magazine ?? "Magazine"}</a>
            <a
              href={`/${locale}/interactive`}
              class="text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
            >{nav.interactive ?? "Interactive"}</a>
            <a
              href={`/${locale}/search`}
              class="flex items-center gap-1.5 text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
              aria-label="Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              Search
            </a>
            <div
              class="flex items-center gap-3 space-x-2 text-xs font-bold uppercase tracking-widest text-muted-foreground/70 border-l border-border/40 pl-6 whitespace-nowrap"
            >
              <a
                href="/en/"
                class={`hover:text-primary transition-colors ${locale === "en" ? "text-primary" : ""}`}
                >EN</a
              >
              <a
                href="/ko/"
                class={`hover:text-primary transition-colors ${locale === "ko" ? "text-primary" : ""}`}
                >KO</a
              >
              <a
                href="/ja/"
                class={`hover:text-primary transition-colors ${locale === "ja" ? "text-primary" : ""}`}
                >JA</a
              >
              <a
                href="/fr/"
                class={`hover:text-primary transition-colors ${locale === "fr" ? "text-primary" : ""}`}
                >FR</a
              >
              <a
                href="/es/"
                class={`hover:text-primary transition-colors ${locale === "es" ? "text-primary" : ""}`}
                >ES</a
              >
              <a
                href="/zh/"
                class={`hover:text-primary transition-colors ${locale === "zh" ? "text-primary" : ""}`}
                >ZH</a
              >
              <a
                href="/cn/"
                class={`hover:text-primary transition-colors ${locale === "cn" ? "text-primary" : ""}`}
                >CN</a
              >
            </div>
          </nav>
        </div>
      </div>
    </header>

    <!-- Reading progress bar -->
    <div
      id="reading-progress"
      class="fixed top-[64px] left-0 z-50 h-0.5 bg-primary transition-none"
      style="width: 0%"
      aria-hidden="true"
    ></div>
    <script is:inline>
      (function () {
        var bar = document.getElementById("reading-progress");
        if (!bar) return;
        function update() {
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var docHeight =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          bar.style.width = Math.min(100, pct).toFixed(1) + "%";
        }
        window.addEventListener("scroll", update, { passive: true });
        update();
      })();
    </script>

    <main id="main-content" role="main" class="flex-1">
      <slot />
    </main>

    <footer class="py-12 border-t border-border/40 text-center md:text-left">
      <div class="container px-4 space-y-6">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-8"
        >
          <span class="font-bold text-lg tracking-tighter">OIYO</span>
          <nav
            class="flex gap-8 text-xs font-bold uppercase tracking-widest text-muted-foreground"
          >
            <a href="/rss.xml" class="hover:text-primary transition-colors"
              >RSS Feed</a
            >
            <a
              href="/sitemap-index.xml"
              class="hover:text-primary transition-colors">Sitemap</a
            >
            <a href={`/${locale === "en" ? "" : locale + "/"}privacy`} class="hover:text-primary transition-colors">{t.legal.privacy.title}</a>
            <a href={`/${locale === "en" ? "" : locale + "/"}terms`} class="hover:text-primary transition-colors">{t.legal.terms.title}</a>
            <a
              href="mailto:support@oiyo.net"
              class="hover:text-primary transition-colors">support@oiyo.net</a
            >
          </nav>
          <div
            class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50"
          >
            © {new Date().getFullYear()} Oiyo Tech
          </div>
        </div>
        <div class="flex justify-center md:justify-start gap-6 text-xs text-muted-foreground/60 items-center border-t border-border/20 pt-4">
          <span class="font-bold uppercase tracking-widest text-[10px]">Family</span>
          <a
            href="https://ahoxy.com?utm_source=blog_oiyo&utm_medium=referral&utm_campaign=family_nav"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors"
          >Ahoxy — Tools</a>
          <a
            href="https://oiyo.net?utm_source=blog_oiyo&utm_medium=referral&utm_campaign=family_nav"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors"
          >Oiyo — Personality Tests</a>
        </div>
      </div>
    </footer>
  </body>
</html>
