---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import KnowledgeNetworkMap from "../../components/shared/_oiyo-shared/KnowledgeNetworkMap.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site.config";
import seedData from "../../data/knowledge-seed.json";

const posts = await getCollection("blog", ({ data }) => data.draft !== true);
const guideCount = posts.length;
const locales = siteConfig.locales;

// Topic map: hub concepts from the shared seed and the number of English blog
// guides covering each one. Route-level ownership is independent of format.
// Unicode-aware: keep letters/numbers of any script (CJK, Hangul) so non-latin
// tags/aliases (e.g. 해몽, 태몽) don't all collapse to the same token.
const norm = (s: string) => s.toLowerCase().trim().replace(/[^\p{L}\p{N}]+/gu, "-").replace(/^-|-$/g, "");
const enGuideTagCount = new Map<string, number>();
for (const p of posts) {
  if ((p.data.locale ?? p.slug.split("/")[0]) !== "en") continue;
  for (const tag of p.data.tags ?? []) {
    enGuideTagCount.set(norm(tag), (enGuideTagCount.get(norm(tag)) ?? 0) + 1);
  }
}
type Seed = { id: string; name?: Record<string, string>; aliases?: string[]; relatedTopicIds?: string[] };
const topicMap = ((seedData as { topics?: Seed[] }).topics ?? [])
  .map((t) => {
    const name = t.name?.en ?? t.id;
    let guides = enGuideTagCount.get(norm(t.id)) ?? 0;
    for (const a of t.aliases ?? []) guides = Math.max(guides, enGuideTagCount.get(norm(a)) ?? 0);
    return {
      id: t.id,
      name,
      // Same-site search for this concept (reliable; surfaces blog's guides).
      href: `/en/search?q=${encodeURIComponent(name)}`,
      guides,
      related: t.relatedTopicIds ?? [],
    };
  })
  // Surface the most-covered topics first (by blog guide depth), then alphabetical.
  .sort((a, b) => b.guides - a.guides || a.name.localeCompare(b.name));

const resources = [
  { name: "guides.json", href: "/knowledge/guides.json", desc: `${guideCount} guides/articles (schema.org ItemList) with summary, track, locale and a stable URL.` },
  { name: "relations.json", href: "/knowledge/relations.json", desc: "Series clusters and cross-locale translation links." },
  { name: "index.json", href: "/knowledge/index.json", desc: "Machine-readable discovery manifest for this site and the knowledge network." },
];

const network = [
  {
    role: "Reference",
    title: "Oiyo Wiki",
    href: "https://wiki.oiyo.net/knowledge/",
    summary: "Source-backed definitions and concept graphs.",
    details: "Use this catalog when you need stable terms, cited references, and machine-readable DefinedTerm data.",
    catalogs: [{ label: "topics.json", href: "https://wiki.oiyo.net/knowledge/topics.json" }],
  },
  {
    role: "Publishing",
    title: "Oiyo Blog",
    href: "https://blog.oiyo.net/knowledge/",
    summary: "Guides, lessons, comparisons, and long-form context.",
    details: "Use this catalog for guides, lessons, references, and established utilities published on the blog.",
    catalogs: [{ label: "guides.json", href: "/knowledge/guides.json" }],
    current: true,
  },
  {
    role: "Interactive",
    title: "OIYO",
    href: "https://oiyo.net/knowledge/",
    summary: "Tests, calculators, results, and repeatable workflows.",
    details: "Use this catalog when the user wants to calculate, test, save a result, or turn knowledge into action.",
    catalogs: [{ label: "tools.json", href: "https://oiyo.net/knowledge/tools.json" }],
  },
];
---

<BaseLayout
  title="Knowledge Network — Citable Publishing Data"
  description="A machine-citable catalog of long-form guides and explainers across astrology, saju, personality, finance and certifications — for people and AI to cite."
>
  <article class="py-24 max-w-3xl mx-auto px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-primary mb-4">Knowledge Network · Publishing</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
      Guides built to be cited
    </h1>
    <p class="text-lg text-muted-foreground leading-relaxed mb-10">
      Oiyo Blog publishes long-form guides, lectures, references, explainers, and established utilities
      as clean HTML <em>and</em> as machine-readable catalogs.
    </p>

    <h2 class="text-2xl font-bold tracking-tight mb-4">Open data catalogs</h2>
    <ul class="space-y-4 mb-12">
      {resources.map((r) => (
        <li class="border border-border rounded-lg p-5">
          <a href={r.href} class="text-primary font-bold font-mono">{r.name}</a>
          <p class="text-sm text-muted-foreground mt-1">{r.desc}</p>
        </li>
      ))}
    </ul>

    {topicMap.length > 0 && (
      <>
        <h2 class="text-2xl font-bold tracking-tight mb-4">Topic map</h2>
        <p class="text-muted-foreground mb-4">Top-level concepts and how they connect. Each links to related guides.</p>
        <div class="grid sm:grid-cols-2 gap-3 mb-12">
          {topicMap.map((t) => (
            <a href={t.href} class="border border-border rounded-lg p-4 block hover:border-primary transition-colors">
              <span class="font-bold">{t.name}</span>
              {t.guides > 0 && <span class="text-xs text-muted-foreground"> · {t.guides} guides</span>}
              {t.related.length > 0 && (
                <p class="text-xs text-muted-foreground mt-1">related: {t.related.join(", ")}</p>
              )}
            </a>
          ))}
        </div>
      </>
    )}

    <KnowledgeNetworkMap
      eyebrow="Canonical catalogs"
      heading="The knowledge network"
      intro="Start with the canonical catalog that matches the task. A content format does not force a particular domain."
      layers={network}
    />

    <h2 class="text-2xl font-bold tracking-tight mb-4">Citation</h2>
    <p class="text-muted-foreground">
      Cite individual guides by their stable URL (see <a href="/knowledge/guides.json" class="text-primary">guides.json</a>).
      Coverage spans {locales.length} languages ({locales.join(", ")}). Attribution: <strong>Oiyo (blog.oiyo.net)</strong>.
    </p>

    <FaqAccordion
      heading="FAQ"
      items={[
        { q: "Can I cite or reuse these guides?", a: "Yes. Each guide has a stable canonical URL (see <a href='/knowledge/guides.json'>guides.json</a>). Please attribute to Oiyo (blog.oiyo.net)." },
        { q: "Is the catalog machine-readable?", a: "Yes — open JSON catalogs (guides.json, relations.json) plus structured data on each page." },
        { q: "How current is it?", a: "Catalogs are regenerated on every build; each guide carries a published and updated date." },
      ]}
    />
  </article>
</BaseLayout>
