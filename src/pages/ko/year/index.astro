---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const CURRENT_YEAR = new Date().getFullYear();
const START_YEAR = 1940;

// group years by decade (descending)
const decades: { decade: number; years: number[] }[] = [];
for (let d = Math.floor(CURRENT_YEAR / 10) * 10; d >= Math.floor(START_YEAR / 10) * 10; d -= 10) {
  const ys: number[] = [];
  for (let y = Math.max(d, START_YEAR); y < d + 10 && y <= CURRENT_YEAR; y++) ys.push(y);
  if (ys.length) decades.push({ decade: d, years: ys });
}

const title = "출생연도별 정보 — 띠·나이·간지·생애 연표 (1940~현재)";
const description = "1940년생부터 올해까지, 태어난 해의 띠와 60갑자, 한국나이·만 나이, 띠 궁합, 생애 연표를 연도별로 확인하세요.";

const faqs = [
  { question: "출생연도로 무엇을 알 수 있나요?", answer: "태어난 해의 띠(십이지)와 60갑자, 올해 기준 한국나이와 만 나이, 띠 궁합, 그리고 초등학교 입학·환갑 같은 생애 주요 시기를 연도별로 정리해 보여줍니다." },
  { question: "어느 연도까지 지원하나요?", answer: `현재 ${START_YEAR}년생부터 ${CURRENT_YEAR}년생까지 지원합니다.` },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout title={title} description={description} availableLocales={["ko"]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-black text-slate-900">출생연도별 정보</h1>
    <p class="mt-3 leading-7 text-slate-700">
      태어난 해를 고르면 그 해의 띠와 60갑자, 올해 기준 한국나이·만 나이, 띠 궁합, 생애 연표를 한눈에 볼 수 있습니다.
    </p>

    {decades.map((d) => (
      <section class="mt-8">
        <h2 class="text-lg font-bold text-slate-900">{d.decade}년대</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {d.years.map((y) => (
            <a class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm text-slate-700 hover:bg-green-50 hover:text-green-700" href={`/ko/year/${y}`}>{y}</a>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-12">
      <h2 class="text-xl font-bold text-slate-900">자주 묻는 질문</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {faqs.map((f) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{f.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
