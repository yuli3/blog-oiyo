---
// Root page redirection to preferred locale.
// Static next-page links keep no-JS / crawler hops on-session before redirect.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href="https://blog.oiyo.net/en/" />
    <title>Redirecting...</title>
    <script is:inline>
      const getPreferredLocale = () => {
        const languages = navigator.languages || [navigator.language];
        const supportedLocales = ["ko", "en", "ja", "fr", "es", "zh"];

        for (const lang of languages) {
          const shortLang = lang.split("-")[0].toLowerCase();
          if (supportedLocales.includes(shortLang)) {
            return shortLang;
          }
        }
        return "en";
      };

      const locale = getPreferredLocale();
      window.location.href = `/${locale}/`;
    </script>
    <meta http-equiv="refresh" content="0;url=/en/" />
  </head>
  <body>
    <p>Redirecting to <a href="/en/">/en/</a>...</p>
    <nav aria-label="Next page">
      <p>Continue reading:</p>
      <ul>
        <li><a href="/en/">English home</a></li>
        <li><a href="/en/height-converter/">Height converter</a></li>
        <li><a href="/ko/tools/">도구 모음</a></li>
      </ul>
    </nav>
  </body>
</html>
