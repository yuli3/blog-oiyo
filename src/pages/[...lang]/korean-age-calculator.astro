---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import ToolsCompanionBanner from "../../components/ToolsCompanionBanner.astro";
import KoreanAgeCalculator from "../../components/tools/KoreanAgeCalculator";
import AgeCountryCalculator from "../../components/tools/AgeCountryCalculator";
import type { AgeCountry } from "../../lib/age-milestones-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// Law-dependent tool: each locale page follows its own country's legal ages (세운 2026-10-19).
// ko and en (people living in Korea) use Korean law.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, AgeCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string; eyebrow: string }> = {
  ko: {
    title: "만 나이 & 띠 계산기 — 법정 연령·선거권·운전면허·연금 개시일 조견표",
    description: "생년월일 기준으로 법정 표준 만 나이, 연 나이, 세는 나이, 12간지 띠와 투표권·운전면허·청소년보호법 해제·국민연금 수급 연령을 자동 판정합니다.",
    eyebrow: "공식 법정 연령 계산기",
  },
  en: {
    title: "Korean Age Calculator — International Age, Korean Age & Legal Ages in South Korea",
    description: "For South Korea: international (man) age, calendar-year age, traditional Korean age, zodiac sign, and the Korean legal ages for voting, driving, alcohol and the national pension.",
    eyebrow: "Official Age Utility",
  },
  ja: {
    title: "満年齢計算機 — 日本の法律で決まる年齢（成年・選挙権・免許・飲酒・年金）",
    description: "生年月日から日本の法律上の満年齢を計算し、早生まれの小学校入学年、成年18歳、選挙権、普通免許、飲酒・喫煙20歳、老齢基礎年金65歳に到達する日を確認できます。",
    eyebrow: "年齢・資格早見表",
  },
  zh: {
    title: "周岁计算器 — 中国法律规定的年龄（身份证·成年·驾照·退休）",
    description: "输入出生日期计算法定周岁，并查看申领身份证16周岁、成年18周岁、选举权、驾驶证以及逐步延迟的法定退休年龄的到达日期。",
    eyebrow: "法定年龄工具",
  },
  fr: {
    title: "Calculateur d'âge — les âges légaux en France (permis, majorité, retraite)",
    description: "Calculez votre âge exact et la date à laquelle vous atteignez les âges fixés par la loi française : conduite accompagnée, permis B à 17 ans, majorité, vote, âge légal de la retraite.",
    eyebrow: "Calculateur d'âge",
  },
  es: {
    title: "Calculadora de edad — edades legales en España (DNI, mayoría, carnet, jubilación)",
    description: "Calcula tu edad exacta y cuándo alcanzas las edades fijadas por la ley española: DNI obligatorio, mayoría de edad, voto, permiso de conducir B y jubilación ordinaria.",
    eyebrow: "Utilidad de edad legal",
  },
};

const content: Record<
  ActiveLocale,
  {
    introTitle: string;
    intro: string;
    guideTitle: string;
    guides: { title: string; body: string }[];
    faqTitle: string;
    faqs: { question: string; answer: string }[];
  }
> = {
  ko: {
    introTitle: "대한민국 '만 나이 통일법'과 연령 체계 총정리",
    intro: "2023년 6월 28일부터 행정·민사상 나이 계산이 '만 나이'로 전면 통일되었습니다. 다만 병역법과 청소년보호법(술·담배 구매)은 예외적으로 '연 나이'를 적용하므로 두 기준을 구분해야 합니다.",
    guideTitle: "나이 계산 3대 기준의 차이",
    guides: [
      {
        title: "만 나이 (법적 표준)",
        body: "출생일을 0세로 시작하여 매년 생일마다 1세씩 더하는 국제 표준입니다. 계약, 법적 자격, 공문서의 기본 기준입니다.",
      },
      {
        title: "연 나이 (병역·청소년법)",
        body: "현재 연도에서 태어난 연도를 뺀 나이입니다. 병무청 병역판정검사(연 19세)와 술·담배 구매 가능일(연 19세가 되는 해 1월 1일)에 적용됩니다.",
      },
      {
        title: "12간지 띠의 계산 기준",
        body: "전통 띠는 입춘(양력 2월 4일경)을 기준으로 바뀌며, 일상적으로는 출생 음력/양력 연도의 12지지(자축인묘진사오미신유술해)를 따릅니다.",
      },
      {
        title: "국민연금 수령 개시 연령",
        body: "출생연도에 따라 만 60세부터 65세까지 단계적으로 늦춰지며, 1969년생 이후 출생자는 만 65세부터 정규 노령연금을 수령합니다.",
      },
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      {
        question: "생일이 지나지 않았을 때 만 나이는 어떻게 계산하나요?",
        answer: "현재 연도에서 태어난 연도를 뺀 후, 올해 생일이 아직 지나지 않았다면 추가로 1살을 더 빼야 합니다.",
      },
      {
        question: "만 19세가 되는 해 1월 1일부터 술과 담배 구매가 가능한가요?",
        answer: "네, 청소년보호법은 개별 생일과 관계없이 연 나이 19세가 되는 해의 1월 1일부터 성인으로 간주하여 구매를 허용합니다.",
      },
    ],
  },
  en: {
    introTitle: "Understanding Korean Age vs. International Age Standards",
    intro: "While South Korea standardized on international age in June 2023, specific laws such as military enlistment and alcohol sales still utilize calendar year age formulas.",
    guideTitle: "Core Differences in Age Systems",
    guides: [
      {
        title: "International Age",
        body: "Starts at zero on the date of birth and increases by one year on each subsequent birthday.",
      },
      {
        title: "Calendar Year Age",
        body: "Current year minus birth year. Used in special regulatory contexts like youth tobacco and alcohol laws.",
      },
      {
        title: "Chinese Zodiac Signs",
        body: "A 12-year cycle of symbolic animals repeating based on lunar and solar calendar transitions.",
      },
      {
        title: "State Pension Starting Age",
        body: "Ranging from age 60 to 65 depending on your birth cohort, reaching full maturity at age 65 for post-1969 births.",
      },
    ],
    faqTitle: "Frequently Asked Questions",
    faqs: [
      {
        question: "How do I calculate international age before my birthday?",
        answer: "Subtract your birth year from the current year, then subtract one additional year if your birthday has not occurred yet this year.",
      },
      {
        question: "What is traditional Korean age?",
        answer: "Under the historical Korean age convention, a person is 1 year old at birth and gains another year on January 1st.",
      },
    ],
  },
  ja: {
    introTitle: "日本では誕生日の前日に年をとります",
    intro: "日本の法律上の年齢は「年齢計算ニ関スル法律」で決まり、誕生日の前日が終わる時点で1歳加算されます。そのため4月1日生まれは前の学年に入る「早生まれ」になります。2022年4月から成年年齢は18歳になりましたが、飲酒・喫煙や公営競技は20歳のままです。",
    guideTitle: "主な年齢の決まり",
    guides: [
      { title: "成年 18歳", body: "民法改正で2022年4月1日から18歳。親の同意なく契約ができます。" },
      { title: "飲酒・喫煙 20歳", body: "二十歳未満ノ者ノ飲酒ノ禁止ニ関スル法律などにより20歳のままです。" },
      { title: "普通自動車免許 18歳", body: "原付・小型特殊は16歳から取得できます。" },
      { title: "老齢基礎年金 65歳", body: "原則65歳から。60歳まで繰上げ、75歳まで繰下げができます。" },
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "4月1日生まれはなぜ早生まれですか？", answer: "法律上は誕生日の前日（3月31日）に満6歳になるため、その年の4月1日に始まる学年に入学します。4月2日生まれは4月1日に満6歳になるので翌年度の入学です。" },
      { question: "数え年はもう使わないのですか？", answer: "法律上の年齢は満年齢です。数え年は厄年や七五三など行事で使われることがあります。" },
    ],
  },
  zh: {
    introTitle: "法律上的年龄按周岁计算",
    intro: "中国法律中的年龄一律按周岁计算，从出生之日起，过了生日当天才算满一岁。虚岁只在民俗中使用。成年年龄是18周岁，申领居民身份证的义务年龄是16周岁。法定退休年龄从2025年1月起按出生年月逐步延迟。",
    guideTitle: "主要法定年龄",
    guides: [
      { title: "身份证 16周岁", body: "《居民身份证法》规定年满16周岁应当申领，未满16周岁可以申领。" },
      { title: "成年 18周岁", body: "《民法典》规定18周岁以上为成年人；16周岁以上以自己劳动收入为主要生活来源的视为完全民事行为能力人。" },
      { title: "小型汽车驾照 18周岁", body: "申请小型汽车驾驶证的年龄为18周岁以上。" },
      { title: "法定退休年龄", body: "2025年起逐步延迟：男职工从60岁延至63岁，女职工从50岁、55岁分别延至55岁、58岁。" },
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "周岁和虚岁有什么区别？", answer: "周岁从0岁算起，每过一次生日加一岁；虚岁出生就算一岁，每过一次春节再加一岁。法律上使用周岁。" },
      { question: "生肖按公历还是农历？", answer: "生肖以农历春节为界。1月或2月春节前出生的人，属上一年的生肖。" },
    ],
  },
  fr: {
    introTitle: "En France, l'âge légal se compte en années révolues",
    intro: "En France, on gagne un an le jour de son anniversaire. La majorité civile et le droit de vote sont fixés à 18 ans. Depuis le 1er janvier 2024, le permis B peut être obtenu dès 17 ans. L'âge légal de départ à la retraite est de 64 ans pour les générations nées à partir de 1969 ; la loi de financement de la Sécurité sociale pour 2026 l'a abaissé de quelques mois pour les générations 1964 à 1968.",
    guideTitle: "Les principaux âges légaux",
    guides: [
      { title: "Conduite accompagnée 15 ans", body: "L'apprentissage anticipé de la conduite (AAC) est possible dès 15 ans." },
      { title: "Permis B 17 ans", body: "Âge minimal abaissé de 18 à 17 ans au 1er janvier 2024." },
      { title: "Majorité et vote 18 ans", body: "Capacité juridique complète et inscription automatique sur les listes électorales." },
      { title: "Retraite 62 à 64 ans", body: "Selon l'année de naissance ; 64 ans pour les personnes nées à partir de 1969." },
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "À quel âge peut-on acheter de l'alcool ou du tabac ?", answer: "La vente d'alcool et de tabac aux mineurs est interdite : il faut avoir 18 ans." },
      { question: "L'âge légal de la retraite permet-il le taux plein ?", answer: "Pas forcément. Le taux plein dépend aussi du nombre de trimestres cotisés ; à 67 ans, il est atteint automatiquement." },
    ],
  },
  es: {
    introTitle: "En España la edad se cumple el día del cumpleaños",
    intro: "En España la edad legal se cuenta en años cumplidos. La mayoría de edad y el derecho de voto llegan a los 18 años, igual que el permiso de conducir B. El DNI es obligatorio desde los 14 años. La edad ordinaria de jubilación sube a 67 años en 2027, salvo para quienes hayan cotizado al menos 38 años y 6 meses, que pueden jubilarse a los 65.",
    guideTitle: "Principales edades legales",
    guides: [
      { title: "DNI 14 años", body: "Obligatorio a partir de los 14 años; antes es voluntario." },
      { title: "Mayoría y voto 18 años", body: "Plena capacidad de obrar y derecho de sufragio." },
      { title: "Permiso B 18 años", body: "Los ciclomotores (AM) pueden conducirse desde los 15." },
      { title: "Jubilación 65 a 67 años", body: "En 2026: 66 años y 10 meses, o 65 con 38 años y 3 meses cotizados. Desde 2027: 67, o 65 con 38 años y 6 meses." },
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿A qué edad se puede comprar alcohol o tabaco?", answer: "A los 18 años. La venta a menores está prohibida en todo el país." },
      { question: "¿Puedo jubilarme antes de la edad ordinaria?", answer: "Sí, con jubilación anticipada voluntaria (hasta 2 años antes) o involuntaria (hasta 4 años antes), con coeficientes reductores y requisitos de cotización." },
    ],
  },
};

const m = meta[locale] ?? meta.en;
const c = content[locale] ?? content.en;
---

<BaseLayout title={m.title} description={m.description}>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8">
      <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        {m.eyebrow}
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight">
        {m.title}
      </h1>
      <p class="text-sm text-muted-foreground mt-2">
        {m.description}
      </p>
    </div>

    {country ? <AgeCountryCalculator client:load country={country} /> : <KoreanAgeCalculator client:load locale={locale} />}

    <section class="mt-12 space-y-8 rounded-2xl border border-border bg-card p-6 sm:p-8">
      <div>
        <h2 class="text-lg font-bold text-foreground">{c.introTitle}</h2>
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{c.intro}</p>
      </div>

      <div>
        <h3 class="text-base font-bold text-foreground">{c.guideTitle}</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {c.guides.map((item) => (
            <div class="rounded-xl border border-border/60 bg-muted/30 p-4">
              <h4 class="text-sm font-semibold text-foreground">{item.title}</h4>
              <p class="mt-1 text-xs text-muted-foreground leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-base font-bold text-foreground">{c.faqTitle}</h3>
        <dl class="mt-4 space-y-4">
          {c.faqs.map((faq) => (
            <div class="rounded-xl border border-border/60 bg-muted/20 p-4">
              <dt class="text-sm font-semibold text-foreground">{faq.question}</dt>
              <dd class="mt-1 text-xs text-muted-foreground leading-relaxed">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="mt-8">
      <ToolsCompanionBanner tool="tools-hub" />
    </div>

    <div class="mt-10">
      <RelatedToolLinks
        locale={locale}
        slugs={["percentage-calculator", "loan-comparison-calculator", "tdee-calculator"]}
        current="korean-age-calculator"
      />
    </div>
  </div>
</BaseLayout>
