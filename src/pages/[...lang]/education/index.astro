---
import { getCollection } from "astro:content";
import BlogList from "../../../components/BlogList.astro";
import { getTranslations, locales } from "../../../lib/i18n";
import { siteConfig } from "../../../config/site.config";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang: lang === "en" ? undefined : lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

const posts = await getCollection("education");

// Education is primarily structured by category (course), but to show a feed we can sort by date or title
// Since most education items don't have pubDates naturally, we sort by ID or simple alphabetical order if no dates.
posts.sort((a, b) => {
  if (a.data.pubDate && b.data.pubDate) {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  }
  return a.id.localeCompare(b.id);
});

// For education, we only want to show locale-matched posts
const localePosts = posts.filter((post) => post.id.startsWith(`${locale}/`));

const paginationEnabled = siteConfig.features.pagination;
const postsPerPage = 6;
const totalPages = Math.ceil(localePosts.length / postsPerPage);

// Create a mock 'page' object compatible with BlogList props
const page = {
  data: paginationEnabled ? localePosts.slice(0, postsPerPage) : localePosts,
  currentPage: 1,
  lastPage: totalPages,
};
---

<BlogList
  page={page}
  locale={locale}
  baseUrl="/education"
  title="Education"
  subtitle="Curated courses and long-form technical deep dives."
/>
