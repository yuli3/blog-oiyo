---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnitConverter from "../../components/tools/UnitConverter";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "무게 변환기 — kg·파운드·온스 변환 (kg lb oz)", description: "킬로그램(kg), 파운드(lb), 온스(oz), 그램, 스톤을 즉시 상호 변환합니다. 값을 입력하면 모든 단위로 환산됩니다." },
  en: { title: "Weight Converter — kg, Pounds, Ounces (kg lb oz)", description: "Instantly convert kilograms (kg), pounds (lb), ounces (oz), grams, and stone. Enter a value and see all units." },
  ja: { title: "重さ変換 — kg・ポンド・オンス (kg lb oz)", description: "キログラム(kg)、ポンド(lb)、オンス(oz)、グラム、ストーンを即時に相互変換します。" },
  fr: { title: "Convertisseur de Poids — kg, livres, onces", description: "Convertissez kilogrammes (kg), livres (lb), onces (oz), grammes et stone." },
  es: { title: "Conversor de Peso — kg, libras, onzas", description: "Convierte kilogramos (kg), libras (lb), onzas (oz), gramos y stone." },
  zh: { title: "重量转换器 — 千克、磅、盎司 (kg lb oz)", description: "在千克(kg)、磅(lb)、盎司(oz)、克、英石之间即时换算。" },
  cn: { title: "重量转换器 — 千克、磅、盎司 (kg lb oz)", description: "在千克(kg)、磅(lb)、盎司(oz)、克、英石之间即时换算。" },
};
const m = meta[locale] ?? meta.en;

const content = {
  ko: {
    eyebrow: "단위 변환 도구",
    introTitle: "무게 변환기란?",
    intro: "킬로그램(kg), 그램(g), 파운드(lb), 온스(oz), 스톤(st) 사이를 변환하는 도구입니다. 한 단위에 입력하면 나머지로 즉시 환산됩니다.",
    howToTitle: "사용 방법",
    steps: ["변환할 값을 입력합니다.", "기준 단위를 선택합니다.", "모든 단위의 변환 결과를 확인합니다."],
    highlightsTitle: "주요 특징",
    highlights: [
      { title: "표준 계수", body: "1kg=2.20462lb, 1oz=28.3495g 등 정확한 계수를 사용합니다." },
      { title: "동시 변환", body: "한 번 입력으로 모든 단위를 보여줍니다." },
      { title: "즉시 계산", body: "값을 바꾸면 바로 갱신됩니다." },
    ],
    relatedTitle: "관련 변환기",
    related: [
      { href: "/ko/temperature-converter/", label: "온도 변환기", desc: "°C·°F·K를 변환합니다." },
      { href: "/ko/volume-converter/", label: "부피 변환기", desc: "L·mL·컵·온스를 변환합니다." },
      { href: "/ko/height-converter/", label: "키 변환기", desc: "cm·피트·인치를 변환합니다." },
    ],
    disclaimer: "본 변환기는 국제 표준 단위 정의에 따른 계산이며, 일반적인 참고용입니다.",
  },
  en: {
    eyebrow: "Unit Converter",
    introTitle: "What is the weight converter?",
    intro: "It converts between kilograms (kg), grams (g), pounds (lb), ounces (oz), and stone (st). Enter a value in one unit and the rest update instantly.",
    howToTitle: "How to use",
    steps: ["Enter the value to convert.", "Choose the source unit.", "Read the converted results in every unit."],
    highlightsTitle: "Highlights",
    highlights: [
      { title: "Standard factors", body: "Uses exact factors such as 1kg=2.20462lb and 1oz=28.3495g." },
      { title: "All at once", body: "One input shows every unit simultaneously." },
      { title: "Instant", body: "Results update as you type." },
    ],
    relatedTitle: "Related converters",
    related: [
      { href: "/en/temperature-converter/", label: "Temperature Converter", desc: "Convert °C, °F, K." },
      { href: "/en/volume-converter/", label: "Volume Converter", desc: "Convert L, mL, cups, fl oz." },
      { href: "/en/height-converter/", label: "Height Converter", desc: "Convert cm, feet, inches." },
    ],
    disclaimer: "This converter uses international standard unit definitions and is for general reference.",
  },
  ja: {
    eyebrow: "単位変換ツール",
    introTitle: "重さ変換とは？",
    intro: "キログラム(kg)、グラム(g)、ポンド(lb)、オンス(oz)、ストーン(st)を相互変換するツールです。1つの単位に入力すると他が即時更新されます。",
    howToTitle: "使い方",
    steps: ["変換する値を入力します。", "基準単位を選びます。", "全単位の変換結果を確認します。"],
    highlightsTitle: "主な特徴",
    highlights: [
      { title: "標準係数", body: "1kg=2.20462lb、1oz=28.3495gなど正確な係数を使用します。" },
      { title: "同時変換", body: "1回の入力で全単位を表示します。" },
      { title: "即時計算", body: "入力するとすぐに更新されます。" },
    ],
    relatedTitle: "関連変換ツール",
    related: [
      { href: "/ja/temperature-converter/", label: "温度変換", desc: "°C・°F・Kを変換します。" },
      { href: "/ja/volume-converter/", label: "体積変換", desc: "L・mL・カップ・ozを変換します。" },
      { href: "/ja/height-converter/", label: "身長変換", desc: "cm・フィート・インチを変換します。" },
    ],
    disclaimer: "本変換ツールは国際標準の単位定義に基づく計算で、一般的な参考用です。",
  },
};

const faqs = {
  ko: [
    { q: "1kg은 몇 파운드인가요?", a: "1kg = 약 2.20462lb 입니다." },
    { q: "1파운드는 몇 g인가요?", a: "1lb = 453.592g 입니다." },
    { q: "스톤(stone)은 무엇인가요?", a: "영국에서 쓰는 단위로 1스톤 = 14파운드 ≈ 6.35kg 입니다." },
  ],
  en: [
    { q: "How many pounds is 1 kg?", a: "1 kg is about 2.20462 lb." },
    { q: "How many grams in a pound?", a: "1 lb = 453.592 g." },
    { q: "What is a stone?", a: "A British unit: 1 stone = 14 pounds ≈ 6.35 kg." },
  ],
  ja: [
    { q: "1kgは何ポンド？", a: "1kg = 約2.20462lb です。" },
    { q: "1ポンドは何g？", a: "1lb = 453.592g です。" },
    { q: "ストーンとは？", a: "英国の単位で、1ストーン = 14ポンド ≈ 6.35kg です。" },
  ],
};

const { content: c, faqHeading, faqItems } = buildToolShell(content, faqs, locale);
---

<BaseLayout title={m.title} description={m.description}>
  <ToolShell
    title={m.title}
    description={m.description}
    siteUrl={siteConfig.url}
    locale={locale}
    slug="weight-converter"
    content={c}
    applicationCategory="UtilityApplication"
  >
    <div class="mx-auto max-w-2xl">
      <UnitConverter client:load locale={locale} category="weight" />
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
