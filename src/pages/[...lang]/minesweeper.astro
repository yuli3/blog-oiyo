---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MinesweeperComp from "../../components/games/Minesweeper";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "지뢰 찾기 — 클래식 마인스위퍼",
    description: "클래식 지뢰 찾기 게임을 온라인에서 즐겨보세요. 논리적 추리로 모든 지뢰를 피해 깃발을 꽂아보세요.",
  },
  en: {
    title: "Minesweeper",
    description: "Play the classic Minesweeper game online. Use logical deduction to avoid all mines and flag them safely.",
  },
  ja: {
    title: "マインスイーパー — クラシック地雷探し",
    description: "クラシックなマインスイーパーゲームをオンラインでお楽しみください。論理的推理で地雷を避けてフラグを立てましょう。",
  },
  fr: {
    title: "Démineur — Minesweeper Classique",
    description: "Jouez au classique jeu du Démineur en ligne. Utilisez la déduction logique pour éviter toutes les mines.",
  },
  es: {
    title: "Buscaminas — Minesweeper Clásico",
    description: "Juega al clásico Buscaminas en línea. Usa la deducción lógica para evitar todas las minas y marcarlas de forma segura.",
  },
  zh: {
    title: "踩地雷 — 經典掃雷遊戲",
    description: "在線享受經典踩地雷遊戲。用邏輯推理避開所有地雷並插上旗幟。",
  },
  cn: {
    title: "扫雷 — 经典踩地雷游戏",
    description: "在线享受经典扫雷游戏。用逻辑推理避开所有地雷并插上旗帜。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <MinesweeperComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
  </main>
</BaseLayout>
