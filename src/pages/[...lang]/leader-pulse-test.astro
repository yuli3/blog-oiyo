---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeaderPulseTestComp from "../../components/tests/LeaderPulseTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "리더십 진단 테스트 — 나의 리더십 맥박은?", description: "비전·실행·소통·공감·결단 5가지 리더십 역량을 진단하고 나의 리더십 유형을 찾아보세요." },
  en: { title: "Leader Pulse Test — What's Your Leadership Strength?", description: "Diagnose your leadership strengths across vision, execution, communication, empathy, and decisiveness." },
  ja: { title: "リーダーシップ診断テスト — あなたのリーダーシップの強みは？", description: "ビジョン・実行・コミュニケーション・共感・決断力の5つのリーダーシップ能力を診断します。" },
  fr: { title: "Test de Leadership — Quelle est la force de votre leadership?", description: "Diagnostiquez vos forces en vision, exécution, communication, empathie et prise de décision." },
  es: { title: "Test de Liderazgo — ¿Cuál es tu fortaleza de liderazgo?", description: "Diagnostica tus fortalezas en visión, ejecución, comunicación, empatía y toma de decisiones." },
  zh: { title: "領導力診斷測試 — 你的領導力強項是什麼？", description: "診斷你在願景、執行、溝通、共情和決斷力方面的領導力。" },
  cn: { title: "领导力诊断测试 — 你的领导力强项是什么？", description: "诊断你在愿景、执行、沟通、共情和决断力方面的领导力。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <LeaderPulseTestComp client:load locale={locale} />
  </main>
</BaseLayout>
