---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Base64ConverterComp from "../../components/tools/Base64Converter";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "Base64 인코더/디코더 — 텍스트·파일 변환",
    description: "이미지 및 텍스트를 Base64로 즉시 인코딩·디코딩하세요. Data URI 형식과 순수 Base64 출력을 모두 지원합니다.",
  },
  en: {
    title: "Base64 Encoder / Decoder",
    description: "Instantly encode and decode images and text to Base64. Supports both Data URI format and raw Base64 output.",
  },
  ja: {
    title: "Base64エンコーダー / デコーダー",
    description: "画像やテキストをBase64に即時エンコード・デコードします。Data URI形式と純粋なBase64出力の両方をサポートします。",
  },
  fr: {
    title: "Encodeur / Décodeur Base64",
    description: "Encodez et décodez instantanément des images et du texte en Base64. Supporte le format Data URI et la sortie Base64 brute.",
  },
  es: {
    title: "Codificador / Decodificador Base64",
    description: "Codifica y decodifica imágenes y texto en Base64 al instante. Soporta el formato Data URI y la salida Base64 pura.",
  },
  zh: {
    title: "Base64 编码器 / 解码器",
    description: "即时将图片和文字编码或解码为 Base64。支持 Data URI 格式和纯 Base64 输出。",
  },
};

const m = meta[locale] ?? meta.en;

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "Base64는 바이너리를 텍스트로 옮기기 위한 인코딩입니다",
    intro: "이미지나 파일 데이터를 JSON, HTML, CSS, 이메일 본문처럼 텍스트만 안전하게 오가는 환경에 넣어야 할 때 Base64가 자주 쓰입니다. 이 도구는 브라우저에서 이미지를 읽어 Data URI와 순수 Base64 문자열을 나란히 보여주므로 작은 아이콘, 테스트 픽스처, 임시 임베드 값을 빠르게 확인할 수 있습니다.",
    formulaTitle: "핵심 개념",
    formulas: [
      { title: "Base64", body: "바이너리 데이터를 64개 문자 집합으로 표현해 텍스트 채널에서도 깨지지 않게 합니다." },
      { title: "Data URI", body: "MIME 타입과 Base64 본문을 함께 담아 HTML이나 CSS에 바로 넣을 수 있는 형식입니다." },
      { title: "Raw Base64", body: "접두 정보 없이 인코딩 본문만 필요한 API, 테스트, 저장 필드에 쓰기 좋습니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "이미지 파일을 선택해 브라우저에서 읽습니다.",
      "HTML/CSS에 바로 넣을 때는 Data URI를, 데이터 본문만 필요할 때는 순수 Base64를 복사합니다.",
      "큰 파일은 문자열이 매우 길어지므로 실제 서비스에서는 파일 저장소나 CDN 사용을 함께 검토합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "Base64로 만들면 파일이 작아지나요?", answer: "아니요. Base64는 압축이 아니라 인코딩이며 일반적으로 원본보다 약 33% 커집니다." },
      { question: "Data URI와 순수 Base64는 무엇이 다른가요?", answer: "Data URI는 `data:image/png;base64,` 같은 접두 정보가 포함되어 브라우저가 파일 종류를 알 수 있습니다. 순수 Base64는 인코딩된 본문만 남긴 값입니다." },
      { question: "이미지가 서버로 업로드되나요?", answer: "이 페이지의 변환은 브라우저의 FileReader로 처리됩니다. 다만 민감한 파일은 조직의 보안 정책을 먼저 확인하세요." },
    ],
    disclaimer: "민감한 파일이나 대용량 자산은 Base64 임베드보다 전용 저장소와 접근 제어를 우선 검토하세요.",
  },
  en: {
    introTitle: "Base64 turns binary data into text-safe output",
    intro: "Base64 is useful when image or file bytes need to travel through text-only places such as JSON, HTML, CSS, email, or test fixtures. This browser-side tool reads an image and shows both the full Data URI and the raw Base64 body, so you can quickly choose the format your code needs.",
    formulaTitle: "Key concepts",
    formulas: [
      { title: "Base64", body: "Represents binary data with a 64-character alphabet so it survives text channels." },
      { title: "Data URI", body: "Combines the MIME type and Base64 body for direct use in HTML or CSS." },
      { title: "Raw Base64", body: "Keeps only the encoded payload for APIs, tests, or storage fields that already know the media type." },
    ],
    howToTitle: "How to use",
    steps: [
      "Select an image file and let the browser read it locally.",
      "Copy the Data URI for HTML/CSS embedding, or copy raw Base64 when only the payload is needed.",
      "For large files, remember that Base64 strings are long and usually belong in storage or a CDN instead.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Does Base64 make a file smaller?", answer: "No. Base64 is an encoding, not compression, and it usually makes the payload about one third larger." },
      { question: "What is the difference between Data URI and raw Base64?", answer: "A Data URI includes a prefix such as `data:image/png;base64,` so the browser knows the media type. Raw Base64 is only the encoded body." },
      { question: "Is my image uploaded to a server?", answer: "The conversion on this page uses the browser FileReader API. For sensitive files, still follow your organization’s security policy." },
    ],
    disclaimer: "For sensitive or large assets, prefer controlled storage and access rules instead of long Base64 embeds.",
  },
  ja: {
    introTitle: "Base64はバイナリをテキストで扱える形にするエンコードです",
    intro: "画像やファイルのデータをJSON、HTML、CSS、メール、テストデータなどテキスト前提の場所に入れるとき、Base64がよく使われます。このツールはブラウザ内で画像を読み取り、Data URIと純粋なBase64本文を分けて表示します。",
    formulaTitle: "基本概念",
    formulas: [
      { title: "Base64", body: "バイナリデータを64種類の文字で表し、テキスト環境でも壊れにくくします。" },
      { title: "Data URI", body: "MIMEタイプとBase64本文を含み、HTMLやCSSに直接書ける形式です。" },
      { title: "Raw Base64", body: "接頭辞を除いた本文だけで、APIやテスト、保存項目に向いています。" },
    ],
    howToTitle: "使い方",
    steps: [
      "画像ファイルを選択し、ブラウザで読み込みます。",
      "HTML/CSSに埋め込む場合はData URIを、本文だけ必要な場合はRaw Base64をコピーします。",
      "大きなファイルは文字列が長くなるため、実運用ではストレージやCDNも検討します。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "Base64にするとファイルは小さくなりますか？", answer: "いいえ。Base64は圧縮ではなくエンコードなので、通常は元データより約3分の1大きくなります。" },
      { question: "Data URIとRaw Base64の違いは？", answer: "Data URIには`data:image/png;base64,`のような種類情報が含まれます。Raw Base64はエンコード本文だけです。" },
      { question: "画像はサーバーへアップロードされますか？", answer: "このページの変換はブラウザのFileReaderで処理されます。ただし機密ファイルは所属先の規定を確認してください。" },
    ],
    disclaimer: "機密ファイルや大容量素材は、Base64埋め込みより管理された保存先とアクセス制御を優先してください。",
  },
  fr: {
    introTitle: "Base64 transforme des données binaires en texte transportable",
    intro: "Base64 sert lorsqu'une image ou un fichier doit passer par du JSON, du HTML, du CSS, un e-mail ou un jeu de test. L'outil lit l'image dans le navigateur et affiche à la fois l'URI de données complète et le corps Base64 brut.",
    formulaTitle: "Concepts clés",
    formulas: [
      { title: "Base64", body: "Représente des octets avec un alphabet de 64 caractères pour les canaux textuels." },
      { title: "Data URI", body: "Ajoute le type MIME au corps Base64 pour une insertion directe en HTML ou CSS." },
      { title: "Base64 brut", body: "Ne garde que la charge encodée, utile pour les API, tests ou champs de stockage." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Choisissez une image et laissez le navigateur la lire localement.",
      "Copiez l'URI de données pour HTML/CSS, ou le Base64 brut si seul le contenu est attendu.",
      "Pour de gros fichiers, privilégiez un stockage ou un CDN plutôt qu'une longue chaîne Base64.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Base64 réduit-il la taille d'un fichier ?", answer: "Non. C'est un encodage, pas une compression, et la taille augmente souvent d'environ un tiers." },
      { question: "Quelle différence entre Data URI et Base64 brut ?", answer: "Une Data URI inclut un préfixe comme `data:image/png;base64,`. Le Base64 brut contient seulement le corps encodé." },
      { question: "Mon image est-elle envoyée au serveur ?", answer: "La conversion utilise l'API FileReader du navigateur. Pour des fichiers sensibles, respectez quand même votre politique de sécurité." },
    ],
    disclaimer: "Pour les ressources sensibles ou volumineuses, préférez un stockage contrôlé et des règles d'accès plutôt que des embeds Base64.",
  },
  es: {
    introTitle: "Base64 convierte datos binarios en texto transportable",
    intro: "Base64 se usa cuando una imagen o archivo debe pasar por JSON, HTML, CSS, correo o datos de prueba. La herramienta lee la imagen en el navegador y muestra tanto la Data URI completa como el cuerpo Base64 sin prefijo.",
    formulaTitle: "Conceptos clave",
    formulas: [
      { title: "Base64", body: "Representa bytes con un alfabeto de 64 caracteres para canales de texto." },
      { title: "Data URI", body: "Incluye el tipo MIME y el cuerpo Base64 para pegarlo directamente en HTML o CSS." },
      { title: "Base64 puro", body: "Conserva solo la carga codificada para APIs, pruebas o campos que ya conocen el tipo." },
    ],
    howToTitle: "Cómo usarlo",
    steps: [
      "Selecciona una imagen y deja que el navegador la lea localmente.",
      "Copia la Data URI para HTML/CSS o el Base64 puro cuando solo necesites el contenido.",
      "Con archivos grandes, usa almacenamiento o CDN en lugar de incrustar cadenas Base64 largas.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Base64 reduce el tamaño del archivo?", answer: "No. Es codificación, no compresión, y normalmente aumenta el tamaño alrededor de un tercio." },
      { question: "¿Qué diferencia hay entre Data URI y Base64 puro?", answer: "La Data URI incluye un prefijo como `data:image/png;base64,`. El Base64 puro contiene solo el cuerpo codificado." },
      { question: "¿La imagen se sube a un servidor?", answer: "La conversión usa FileReader en el navegador. Aun así, aplica la política de seguridad correspondiente para archivos sensibles." },
    ],
    disclaimer: "Para recursos sensibles o grandes, prioriza almacenamiento controlado y reglas de acceso sobre incrustaciones Base64.",
  },
  zh: {
    introTitle: "Base64 把二进制数据转换成可传输的文本",
    intro: "当图片或文件字节需要放进 JSON、HTML、CSS、邮件或测试数据时，Base64 很常见。这个工具在浏览器内读取图片，同时给出完整 Data URI 和纯 Base64 正文，方便按使用场景复制。",
    formulaTitle: "核心概念",
    formulas: [
      { title: "Base64", body: "用 64 个字符表示二进制数据，让内容能通过文本通道传递。" },
      { title: "Data URI", body: "把 MIME 类型和 Base64 正文放在一起，可直接用于 HTML 或 CSS。" },
      { title: "纯 Base64", body: "只保留编码正文，适合 API、测试数据或已知文件类型的存储字段。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "选择图片文件，让浏览器在本地读取。",
      "嵌入 HTML/CSS 时复制 Data URI，只需要内容时复制纯 Base64。",
      "大文件会生成很长的字符串，正式场景应优先考虑文件存储或 CDN。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "Base64 会让文件变小吗？", answer: "不会。Base64 是编码不是压缩，通常会让数据量增加约三分之一。" },
      { question: "Data URI 和纯 Base64 有什么区别？", answer: "Data URI 包含 `data:image/png;base64,` 这类前缀，纯 Base64 只有编码正文。" },
      { question: "图片会上传到服务器吗？", answer: "本页转换使用浏览器 FileReader 处理。敏感文件仍应遵守所在组织的安全规则。" },
    ],
    disclaimer: "敏感或大体积资源应优先使用受控存储和访问规则，而不是长 Base64 嵌入。",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-4xl px-4 py-8">
    <Base64ConverterComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
  </main>
</BaseLayout>
