---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };
// lab/academy articles exist in ko/en only (#27)
const labLocale = locale === 'ko' ? 'ko' : 'en';

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "경제학 학습 허브 — 수요공급·IS-LM·거시경제 시뮬레이터",
    description: "수요공급 시뮬레이터, IS-LM 모델, 탄력성 계산기, 게임이론 등 경제학 인터랙티브 도구를 한곳에서 만나보세요.",
  },
  en: {
    title: "Economics Learning Hub — Supply & Demand, IS-LM, Macro Simulators",
    description: "Explore interactive economics tools: supply-demand simulator, IS-LM model, elasticity calculator, and game theory.",
  },
  ja: {
    title: "経済学学習ハブ — 需要供給・IS-LM・マクロ経済シミュレーター",
    description: "需要供給シミュレーター、IS-LMモデル、弾力性計算機など経済学インタラクティブツールを一覧できます。",
  },
  fr: {
    title: "Hub d'apprentissage Économie",
    description: "Explorez les outils interactifs d'économie : offre-demande, IS-LM, élasticité et théorie des jeux.",
  },
  es: {
    title: "Hub de Aprendizaje de Economía",
    description: "Explora herramientas interactivas de economía: oferta-demanda, IS-LM, elasticidad y teoría de juegos.",
  },
  zh: {
    title: "经济学学习中心",
    description: "探索供需模拟器、IS-LM模型、弹性计算机等经济学互动工具。",
  },
};

interface ToolCard {
  title: string;
  description: string;
  href: string;
  badge: string;
  category: string;
}

const tools: ToolCard[] = [
  {
    title: "수요공급 시뮬레이터",
    description: "수요·공급 곡선을 직접 이동하며 균형가격과 수량을 확인합니다. 소비자·생산자 잉여, 종량세의 자중손실도 시각화됩니다.",
    href: `/${locale}/supply-demand-simulator`,
    badge: "신규",
    category: "미시경제",
  },
  {
    title: "탄력성 계산기",
    description: "가격 변화에 따른 수요량·공급량 변화를 입력하면 호탄력성(Arc Elasticity)을 계산하고 비탄력적/탄력적을 분류합니다.",
    href: `/${locale}/supply-demand-simulator`,
    badge: "신규",
    category: "미시경제",
  },
  {
    title: "IS-LM 모델 시뮬레이터",
    description: "재정정책(G 증가)과 통화정책(M 증가)이 IS-LM 균형에 미치는 영향을 실시간으로 확인합니다.",
    href: `/${labLocale}/magazine-education-macro-lab`,
    badge: "인기",
    category: "거시경제",
  },
  {
    title: "게임이론 인터랙티브",
    description: "죄수의 딜레마·내쉬균형·우월전략을 보수행렬로 직접 조작하며 학습합니다.",
    href: `/${labLocale}/magazine-education-game-theory-lab`,
    badge: "",
    category: "게임이론",
  },
  {
    title: "행동경제학 시리즈",
    description: "편향·휴리스틱·프레이밍 효과를 10개 챕터로 학습하는 행동경제학 아카데미입니다.",
    href: `/${labLocale}/academy-behavioral-economics-ch1`,
    badge: "",
    category: "행동경제학",
  },
  {
    title: "무역·국제경제 시뮬레이터",
    description: "비교우위·관세·환율 효과를 시뮬레이션하는 국제무역 인터랙티브 도구입니다.",
    href: `/${labLocale}/magazine-education-trade-lab`,
    badge: "",
    category: "국제경제",
  },
];

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 text-xs font-bold px-3 py-1 rounded-full mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
        </svg>
        경제학 학습 허브
      </div>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">수요공급·IS-LM·거시경제 시뮬레이터</h1>
      <p class="text-sm text-slate-500 leading-relaxed">
        경제학 이론을 직접 조작하며 이해하는 인터랙티브 도구들입니다. 교과서의 그래프를 손으로 움직여 보세요.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group flex flex-col gap-2 p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500"
          aria-label={tool.title}
        >
          <div class="flex items-start justify-between gap-2">
            <h2 class="text-sm font-bold text-slate-800 group-hover:text-green-700 transition-colors leading-snug">{tool.title}</h2>
            <div class="flex flex-col items-end gap-1 shrink-0">
              {tool.badge && (
                <span class="text-[10px] font-bold bg-green-100 text-green-700 px-2 py-0.5 rounded-full">{tool.badge}</span>
              )}
              <span class="text-[10px] font-bold text-slate-400 px-2 py-0.5 rounded-full bg-slate-50 border border-slate-200">{tool.category}</span>
            </div>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">{tool.description}</p>
          <div class="mt-auto pt-1 flex items-center gap-1 text-xs font-bold text-green-600">
            <span>열기</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  @media (prefers-reduced-motion: reduce) {
    a { transition: none !important; }
    a:hover { transform: none !important; }
  }
</style>
