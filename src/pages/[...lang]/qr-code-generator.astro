---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalOnlyNote from "../../components/tools/LocalOnlyNote.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import QrGenerator from "../../components/tools/QrGenerator";
import { locales } from "../../lib/i18n";
import { siteConfig } from "../../config/site.config";
import { toolStructuredData } from "../../lib/seo/structured-data";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: { title: "QR 코드 생성기 — 링크·와이파이·이메일, 무료·무기한", description: "링크, 글자, 와이파이, 이메일을 QR 코드로 만들어요. 브라우저 안에서만 만들어서 입력한 내용이 서버로 가지 않고, 만든 코드는 기한 없이 쓸 수 있어요. PNG·SVG 저장." },
  en: { title: "QR Code Generator — Links, Wi-Fi, Email, Free and Permanent", description: "Make a QR code for a link, text, Wi-Fi or email. It is built in your browser, so nothing you type is sent anywhere, and the code never expires. Save as PNG or SVG." },
  ja: { title: "QRコード作成 — リンク・Wi-Fi・メール、無料・無期限", description: "リンク、文字、Wi-Fi、メールをQRコードにします。ブラウザーの中だけで作るので入力内容は送信されず、作ったコードに期限はありません。PNG・SVGで保存できます。" },
  zh: { title: "二维码生成器 — 链接·Wi-Fi·邮件，免费且永久有效", description: "把链接、文字、Wi-Fi、邮件做成二维码。全部在浏览器内生成，输入的内容不会发送到服务器，生成的二维码没有有效期。可保存为PNG或SVG。" },
  fr: { title: "Générateur de QR code — lien, Wi-Fi, e-mail, gratuit et permanent", description: "Créez un QR code pour un lien, un texte, un Wi-Fi ou un e-mail. Il est fabriqué dans votre navigateur : rien n’est envoyé, et le code n’expire jamais. Export PNG ou SVG." },
  es: { title: "Generador de códigos QR — enlace, Wi-Fi, correo, gratis y permanente", description: "Crea un código QR para un enlace, un texto, un Wi-Fi o un correo. Se genera en tu navegador: no se envía nada y el código no caduca. Guarda en PNG o SVG." },
};

type SeoContent = { introTitle: string; intro: string; factsTitle: string; facts: { title: string; body: string }[]; howToTitle: string; steps: string[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string };

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "만든 코드는 내용 그 자체예요",
    intro: "이 생성기가 만드는 것은 정적 QR 코드예요. 링크나 와이파이 정보가 코드 무늬 안에 그대로 들어가므로, 중간에 다른 서버를 거치지 않고 기한도 없어요. 대신 인쇄한 뒤에는 내용을 바꿀 수 없으니, 인쇄 전에 휴대폰으로 한 번 찍어 보세요.",
    factsTitle: "알아 두면 좋은 것",
    facts: [
      { title: "담을 수 있는 양", body: "QR 코드 하나에는 오류 복원 '낮음' 기준으로 최대 2,953바이트가 들어가요. 한글은 한 글자가 3바이트라 약 980자예요. 내용이 길수록 무늬가 촘촘해져 읽기 어려워져요." },
      { title: "오류 복원", body: "코드 일부가 가려지거나 손상돼도 읽히게 하는 여유분이에요. 낮음 7%, 보통 15%, 높음 25%, 최고 30%까지 복원돼요. 인쇄물이나 스티커는 '높음' 이상이 안전해요." },
      { title: "인쇄 크기", body: "코드 둘레의 흰 여백이 있어야 카메라가 테두리를 찾아요. 명함이나 전단에는 가로 2cm 이상을 권해요. 크게 인쇄할 때는 SVG로 저장하면 깨지지 않아요." },
    ],
    howToTitle: "사용 방법",
    steps: ["링크·글자, 와이파이, 이메일 중 하나를 골라요.", "내용을 입력하면 QR 코드가 바로 만들어져요.", "크기와 오류 복원 수준, 색을 정해요.", "PNG나 SVG로 저장하고, 쓰기 전에 휴대폰으로 찍어 확인해요."],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "만든 QR 코드에 유효 기간이 있나요?", answer: "없어요. 내용이 코드 안에 직접 들어 있어서 이 사이트가 없어져도 계속 읽혀요. 다만 코드에 담은 링크의 주소가 바뀌거나 사라지면 열리지 않아요." },
      { question: "입력한 와이파이 비밀번호가 서버로 가나요?", answer: "가지 않아요. 코드는 브라우저 안에서만 만들어지고, 입력한 내용을 어디로도 보내지 않아요." },
      { question: "나중에 내용을 바꿀 수 있나요?", answer: "바꿀 수 없어요. 내용이 달라지면 무늬도 달라지므로 새 코드를 만들어야 해요. 내용을 바꿀 수 있는 QR은 중간 주소를 거치는 방식이라 그 서비스가 유지되는 동안만 작동해요." },
      { question: "와이파이 QR 코드는 어떻게 쓰나요?", answer: "휴대폰 기본 카메라로 찍으면 네트워크에 연결할지 묻는 알림이 떠요. 기본 카메라가 반응하지 않는 기종은 와이파이 설정 화면의 QR 스캔을 쓰면 돼요." },
    ],
    disclaimer: "누가 만든 것인지 모르는 QR 코드는 찍기 전에 주소를 확인하세요. 이 도구는 코드를 만들기만 하고, 담긴 링크가 안전한지는 확인하지 않아요.",
  },
  en: {
    introTitle: "The code is the content itself",
    intro: "This generator makes static QR codes. The link or the Wi-Fi details sit inside the pattern, so nothing passes through another server and nothing expires. The trade-off is that a printed code cannot be changed, so scan it with your phone once before you print.",
    factsTitle: "Worth knowing",
    facts: [
      { title: "How much fits", body: "One QR code holds up to 2,953 bytes at the lowest error-correction level, about 2,950 plain Latin characters. The more you put in, the denser the pattern and the harder it is to scan." },
      { title: "Error correction", body: "The spare data that keeps a code readable when part of it is covered or damaged: 7% at low, 15% at medium, 25% at high and 30% at the highest level. Use high or above for print and stickers." },
      { title: "Print size", body: "A camera needs the white margin around the code to find its edge. For a card or flyer keep the code at least 2 cm wide. For large prints save the SVG so it stays sharp." },
    ],
    howToTitle: "How to use it",
    steps: ["Choose link or text, Wi-Fi, or email.", "Type the content and the QR code appears at once.", "Set the size, the error-correction level and the colours.", "Save the PNG or SVG, and scan it with your phone before using it."],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Do these QR codes expire?", answer: "No. The content is stored in the code itself, so it keeps working even if this site disappears. A code that holds a link stops working only if that link's address changes or goes away." },
      { question: "Is my Wi-Fi password sent to a server?", answer: "No. The code is drawn in your browser and what you type is not sent anywhere." },
      { question: "Can I change the content later?", answer: "No. A different content gives a different pattern, so you make a new code. QR codes that can be edited later work through a redirect address, and only for as long as that service keeps running." },
      { question: "How do I use a Wi-Fi QR code?", answer: "Point the phone's built-in camera at it and a prompt offers to join the network. If the camera does not react on your phone, use the QR scanner in the Wi-Fi settings screen." },
    ],
    disclaimer: "Check the address before you open a QR code from an unknown source. This tool only makes codes and does not check whether a link is safe.",
  },
  ja: {
    introTitle: "作ったコードは内容そのものです",
    intro: "このツールが作るのは静的QRコードです。リンクやWi-Fiの情報が模様の中にそのまま入るため、ほかのサーバーを経由せず、期限もありません。その代わり印刷した後は内容を変えられないので、印刷前に一度スマートフォンで読み取ってください。",
    factsTitle: "知っておくと便利なこと",
    facts: [
      { title: "入る量", body: "QRコード1つには、誤り訂正「低」で最大2,953バイトまで入ります。日本語は1文字3バイトなので約980文字です。内容が長いほど模様が細かくなり、読み取りにくくなります。" },
      { title: "誤り訂正", body: "コードの一部が隠れたり傷んだりしても読めるようにする余裕です。低7%、中15%、高25%、最高30%まで復元できます。印刷物やシールには「高」以上が安心です。" },
      { title: "印刷サイズ", body: "カメラが端を見つけるには、コードのまわりの白い余白が必要です。名刺やチラシでは幅2cm以上をおすすめします。大きく印刷するときはSVGで保存すると粗くなりません。" },
    ],
    howToTitle: "使い方",
    steps: ["リンク・文字、Wi-Fi、メールから1つ選びます。", "内容を入力すると、すぐにQRコードができます。", "サイズ、誤り訂正レベル、色を決めます。", "PNGまたはSVGで保存し、使う前にスマートフォンで読み取って確認します。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "作ったQRコードに有効期限はありますか？", answer: "ありません。内容がコードの中に直接入っているので、このサイトがなくなっても読み取れます。ただし、入れたリンクのアドレスが変わったり消えたりすると開けません。" },
      { question: "入力したWi-Fiのパスワードはサーバーに送られますか？", answer: "送られません。コードはブラウザーの中だけで作られ、入力した内容はどこにも送信しません。" },
      { question: "あとから内容を変えられますか？", answer: "変えられません。内容が変わると模様も変わるので、新しいコードを作る必要があります。あとから編集できるQRは転送用アドレスを経由する方式で、そのサービスが続いている間だけ動きます。" },
      { question: "Wi-FiのQRコードはどう使いますか？", answer: "スマートフォンの標準カメラをかざすと、ネットワークに接続するかどうかの通知が出ます。カメラが反応しない機種では、Wi-Fi設定画面のQRスキャンを使ってください。" },
    ],
    disclaimer: "だれが作ったかわからないQRコードは、開く前にアドレスを確認してください。このツールはコードを作るだけで、リンクの安全性は確認しません。",
  },
  zh: {
    introTitle: "生成的二维码就是内容本身",
    intro: "这个工具生成的是静态二维码。链接或Wi-Fi信息直接写在图案里，不经过其他服务器，也没有有效期。相应地，印出来之后内容就不能再改，所以印刷前请先用手机扫一次。",
    factsTitle: "值得了解的几点",
    facts: [
      { title: "能放多少内容", body: "一个二维码在最低容错级别下最多可放2,953字节。中文每个字占3字节，约980个字。内容越长，图案越密，越难扫描。" },
      { title: "容错级别", body: "让二维码在部分被遮挡或损坏时仍能读取的冗余：低7%，中15%，高25%，最高30%。用于印刷品或贴纸时建议选“高”以上。" },
      { title: "印刷尺寸", body: "相机需要二维码四周的白边才能找到边界。名片或传单上建议宽度不小于2厘米。大幅面印刷时保存为SVG，放大也不会模糊。" },
    ],
    howToTitle: "使用方法",
    steps: ["在链接·文字、Wi-Fi、邮件中选择一种。", "输入内容后，二维码会立即生成。", "设置尺寸、容错级别和颜色。", "保存为PNG或SVG，使用前先用手机扫码确认。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "生成的二维码有有效期吗？", answer: "没有。内容直接存放在二维码里，即使本网站不存在了也能读取。只有当二维码里的链接地址变更或失效时才会打不开。" },
      { question: "输入的Wi-Fi密码会发送到服务器吗？", answer: "不会。二维码只在浏览器内生成，输入的内容不会发送到任何地方。" },
      { question: "以后可以修改内容吗？", answer: "不能。内容变了图案也会变，需要重新生成。可以事后修改的二维码是通过跳转地址实现的，只有在该服务持续运营期间才有效。" },
      { question: "Wi-Fi二维码怎么用？", answer: "用手机自带相机对准它，会弹出是否加入网络的提示。如果相机没有反应，请使用Wi-Fi设置页面里的扫码功能。" },
    ],
    disclaimer: "来源不明的二维码，打开前请先确认地址。本工具只负责生成二维码，不检查链接是否安全。",
  },
  fr: {
    introTitle: "Le code, c’est le contenu lui-même",
    intro: "Ce générateur crée des QR codes statiques. Le lien ou les informations Wi-Fi sont inscrits dans le motif : rien ne passe par un autre serveur et rien n’expire. En contrepartie, un code imprimé ne peut plus être modifié ; scannez-le une fois avec votre téléphone avant d’imprimer.",
    factsTitle: "Bon à savoir",
    facts: [
      { title: "Capacité", body: "Un QR code contient jusqu’à 2 953 octets au niveau de correction le plus bas, soit environ 2 950 caractères latins simples. Plus le contenu est long, plus le motif est dense et difficile à lire." },
      { title: "Correction d’erreur", body: "La marge qui garde le code lisible quand une partie est masquée ou abîmée : 7 % en faible, 15 % en moyenne, 25 % en haute et 30 % au maximum. Choisissez haute ou plus pour l’impression et les autocollants." },
      { title: "Taille d’impression", body: "L’appareil photo a besoin de la marge blanche autour du code pour en trouver le bord. Sur une carte ou un prospectus, gardez au moins 2 cm de large. Pour un grand format, enregistrez le SVG : il reste net." },
    ],
    howToTitle: "Mode d’emploi",
    steps: ["Choisissez lien ou texte, Wi-Fi ou e-mail.", "Saisissez le contenu : le QR code apparaît aussitôt.", "Réglez la taille, le niveau de correction et les couleurs.", "Enregistrez le PNG ou le SVG, puis scannez-le avec votre téléphone avant de l’utiliser."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Ces QR codes expirent-ils ?", answer: "Non. Le contenu est stocké dans le code lui-même : il continue de fonctionner même si ce site disparaît. Un code contenant un lien cesse de fonctionner seulement si l’adresse de ce lien change ou disparaît." },
      { question: "Mon mot de passe Wi-Fi est-il envoyé à un serveur ?", answer: "Non. Le code est dessiné dans votre navigateur et ce que vous saisissez n’est envoyé nulle part." },
      { question: "Puis-je modifier le contenu plus tard ?", answer: "Non. Un autre contenu donne un autre motif : il faut créer un nouveau code. Les QR codes modifiables passent par une adresse de redirection et ne fonctionnent que tant que ce service existe." },
      { question: "Comment utiliser un QR code Wi-Fi ?", answer: "Pointez l’appareil photo du téléphone dessus : une notification propose de rejoindre le réseau. Si l’appareil photo ne réagit pas, utilisez le lecteur de QR code des réglages Wi-Fi." },
    ],
    disclaimer: "Vérifiez l’adresse avant d’ouvrir un QR code d’origine inconnue. Cet outil crée seulement des codes et ne vérifie pas si un lien est sûr.",
  },
  es: {
    introTitle: "El código es el contenido mismo",
    intro: "Este generador crea códigos QR estáticos. El enlace o los datos del Wi-Fi quedan dentro del patrón: nada pasa por otro servidor y nada caduca. A cambio, un código impreso ya no se puede modificar, así que escanéalo una vez con el móvil antes de imprimir.",
    factsTitle: "Conviene saber",
    facts: [
      { title: "Cuánto cabe", body: "Un código QR admite hasta 2.953 bytes en el nivel de corrección más bajo, unos 2.950 caracteres latinos sencillos. Cuanto más contenido, más denso es el patrón y más cuesta leerlo." },
      { title: "Corrección de errores", body: "El margen que mantiene el código legible cuando una parte está tapada o dañada: 7 % en baja, 15 % en media, 25 % en alta y 30 % en la máxima. Para impresos y pegatinas usa alta o superior." },
      { title: "Tamaño de impresión", body: "La cámara necesita el margen blanco alrededor del código para encontrar su borde. En una tarjeta o un folleto, que mida al menos 2 cm de ancho. Para tamaños grandes guarda el SVG: no pierde nitidez." },
    ],
    howToTitle: "Cómo se usa",
    steps: ["Elige enlace o texto, Wi-Fi o correo.", "Escribe el contenido y el código QR aparece al momento.", "Ajusta el tamaño, el nivel de corrección y los colores.", "Guarda el PNG o el SVG y escanéalo con el móvil antes de usarlo."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Caducan estos códigos QR?", answer: "No. El contenido está guardado en el propio código, así que sigue funcionando aunque este sitio desaparezca. Un código con un enlace solo deja de funcionar si la dirección de ese enlace cambia o desaparece." },
      { question: "¿Se envía mi contraseña del Wi-Fi a un servidor?", answer: "No. El código se dibuja en tu navegador y lo que escribes no se envía a ningún sitio." },
      { question: "¿Puedo cambiar el contenido más adelante?", answer: "No. Otro contenido da otro patrón, así que hay que crear un código nuevo. Los códigos QR editables funcionan mediante una dirección de redirección y solo mientras ese servicio siga activo." },
      { question: "¿Cómo se usa un código QR de Wi-Fi?", answer: "Apunta con la cámara del móvil y aparecerá un aviso para unirte a la red. Si la cámara no reacciona, usa el lector de QR de los ajustes de Wi-Fi." },
    ],
    disclaimer: "Comprueba la dirección antes de abrir un código QR de origen desconocido. Esta herramienta solo crea códigos y no verifica si un enlace es seguro.",
  },
};

const m = meta[locale] ?? meta.en;
const c = content[locale] ?? content.en;
const pageUrl = `${siteConfig.url}/${locale}/qr-code-generator/`;

const structuredData = toolStructuredData({
  name: m.title,
  description: m.description,
  steps: c.steps,
  faqs: c.faqs,
  url: pageUrl,
  webApplication: true,
  breadcrumbs: [
    { name: "Tools", url: `${siteConfig.url}/${locale}/tools/` },
    { name: m.title, url: pageUrl },
  ],
});
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-5 sm:py-8">
    <QrGenerator client:load locale={locale} />
    <LocalOnlyNote locale={locale} />

    <section class="mt-6 border-t border-border pt-5 sm:mt-10 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-foreground">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.factsTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.facts.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-foreground">
        {c.steps.map((step) => <li class="leading-7">{step}</li>)}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-border rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="p-4">
            <summary class="cursor-pointer font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 leading-7 text-muted-foreground">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedToolLinks locale={locale} current="qr-code-generator" slugs={["password-generator", "uuid-generator", "hash-generator", "base64-converter", "word-counter", "image-cropper", "favicon-generator", "pdf-merge-split", "image-converter"]} />

    <p class="mt-5 rounded-xl border border-warning bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground sm:mt-8">{c.disclaimer}</p>
  </div>
</BaseLayout>
