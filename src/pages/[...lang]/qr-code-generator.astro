---
import { locales } from "../../lib/i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
// Tools owns this utility in every locale; keep old bookmarks working (2026-10-19).
return Astro.redirect(`https://tools.oiyo.net/${Astro.params.lang}/qr-code-generator/`, 301);
---
