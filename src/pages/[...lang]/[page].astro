---
import { getCollection } from "astro:content";
import BlogList from "../../components/BlogList.astro";
import { getTranslations, locales } from "../../lib/i18n";

export async function getStaticPaths() {
  const postsPerPage = 30;
  const paths = [];

  // per-locale page counts, so the language switcher only offers locales
  // that actually have the current page number (#27 link audit)
  const totalPagesByLocale: Record<string, number> = {};
  for (const lang of locales) {
    const posts = await getCollection("blog", ({ data }) => data.draft !== true && data.locale === lang);
    totalPagesByLocale[lang] = Math.ceil(posts.length / postsPerPage);
  }

  for (const lang of locales) {
    const posts = await getCollection("blog", ({ data }) => {
      return data.draft !== true && data.locale === lang;
    });

    posts.sort((a, b) => {
      const aMatch = a.slug.match(/-ch(\d+)$/);
      const bMatch = b.slug.match(/-ch(\d+)$/);
      if (aMatch && bMatch && a.data.category === b.data.category) {
        return parseInt(aMatch[1], 10) - parseInt(bMatch[1], 10);
      }
      return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
    });
    const totalPages = Math.ceil(posts.length / postsPerPage);

    // Only generate pages 2+; page 1 is handled by index.astro
    for (let p = 2; p <= totalPages; p++) {
      paths.push({
        params: { lang, page: String(p) },
        props: {
          locale: lang,
          pageData: posts.slice((p - 1) * postsPerPage, p * postsPerPage),
          currentPage: p,
          totalPages,
          availableLocales: locales.filter((l) => totalPagesByLocale[l] >= p),
        },
      });
    }
  }

  return paths;
}

const { locale, pageData, currentPage, totalPages, availableLocales } = Astro.props;
const t = await getTranslations(locale);

const page = {
  data: pageData,
  currentPage,
  lastPage: totalPages,
};
---

<BlogList
  page={page}
  locale={locale}
  baseUrl={`/${locale}`}
  title={t.nav.home}
  subtitle={t.home.tagline}
  availableLocales={availableLocales}
  noindex={true}
/>
