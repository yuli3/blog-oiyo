---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "타로 리딩",
  "en": "Tarot Reading",
  "ja": "タロットリーディング",
  "fr": "tirage de tarot",
  "es": "lectura de tarot",
  "zh": "塔罗占卜",
  "cn": "塔羅占卜"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/tarot/reading" kind="tool" />
