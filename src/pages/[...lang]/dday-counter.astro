---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DdayCounter from "../../components/tools/DdayCounter";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "D-Day 카운터 — 이벤트별 디데이 관리",
    description: "생일, 시험, 기념일 등 중요한 날을 D-Day로 등록하고 남은 날수를 실시간으로 확인하세요. 7일 이내는 초 단위 카운트다운 제공.",
  },
  en: {
    title: "D-Day Counter — Track Important Dates",
    description: "Add birthdays, exams, anniversaries and more as D-Day events. See countdowns in real-time. Events within 7 days show a live seconds countdown.",
  },
  ja: {
    title: "Dデイカウンター — 重要な日程を管理",
    description: "誕生日、試験、記念日などをDデイとして登録し、残り日数をリアルタイムで確認。7日以内のイベントは秒単位のカウントダウンも表示。",
  },
  fr: {
    title: "Compteur J-Day — Suivez vos dates importantes",
    description: "Ajoutez vos anniversaires, examens et événements spéciaux. Voyez le compte à rebours en temps réel. Les événements dans les 7 jours affichent un décompte en secondes.",
  },
  es: {
    title: "Contador D-Day — Gestiona tus fechas importantes",
    description: "Agrega cumpleaños, exámenes, aniversarios y más como eventos D-Day. Ve las cuentas regresivas en tiempo real. Los eventos en 7 días muestran cuenta regresiva en segundos.",
  },
  zh: {
    title: "倒数计时器 — 追踪重要日期",
    description: "将生日、考试、纪念日等重要日期设为倒数事件，即时查看剩余天数。7天以内的事件显示秒数倒计时。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "D-Day는 중요한 날짜를 남은 시간과 지난 시간으로 나누어 관리하는 방식입니다",
    intro: "이 카운터는 시험, 생일, 여행, 기념일처럼 기억해야 할 날짜를 등록하고 오늘 기준 D-일수 또는 D+일수로 정렬합니다. 7일 이내의 미래 이벤트는 초 단위 카운트다운을 함께 보여주어 가까운 일정의 긴박감을 바로 확인할 수 있습니다.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "D-일수", body: "목표일이 미래이면 목표일-오늘 날짜를 D-n으로 표시합니다." },
      { title: "D-Day", body: "목표일과 오늘이 같으면 D-Day로 표시합니다." },
      { title: "D+일수", body: "목표일이 지났으면 오늘-목표일을 D+n으로 표시합니다." },
    ],
    howToTitle: "사용 방법",
    steps: ["이벤트 이름과 목표 날짜를 입력합니다.", "최대 10개까지 등록해 가까운 미래 일정부터 확인합니다.", "완료했거나 더 이상 필요 없는 이벤트는 삭제합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "등록한 일정은 어디에 저장되나요?", answer: "브라우저의 localStorage에 저장되므로 같은 브라우저에서는 다시 열어도 유지됩니다." },
      { question: "다른 기기와 동기화되나요?", answer: "아니요. 이 도구는 계정 기반 동기화를 하지 않으며 기기와 브라우저별로 저장됩니다." },
      { question: "7일 이내만 초 단위 카운트다운이 보이는 이유는 무엇인가요?", answer: "가까운 일정에만 실시간 초 단위 표시를 제공해 화면 부담을 줄이고 중요한 이벤트를 강조하기 위해서입니다." },
    ],
    disclaimer: "이 도구는 개인 일정 관리를 돕는 일반 계산기이며 공식 마감일은 해당 기관의 공지를 확인하세요.",
  },
  en: {
    introTitle: "A D-Day counter tracks important dates as time remaining or time passed",
    intro: "This counter lets you save exams, birthdays, trips, anniversaries, and other dates, then sorts them as D-minus, D-Day, or D-plus from today. Events within the next 7 days also show a live seconds countdown for closer planning.",
    formulaTitle: "Calculation rules",
    formulas: [
      { title: "D-minus", body: "If the target is in the future, target date - today is shown as D-n." },
      { title: "D-Day", body: "If the target date is today, it is shown as D-Day." },
      { title: "D-plus", body: "If the target has passed, today - target date is shown as D+n." },
    ],
    howToTitle: "How to use",
    steps: ["Enter an event name and target date.", "Save up to 10 events and review the closest future dates first.", "Delete completed or unnecessary events."],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Where are events stored?", answer: "They are stored in your browser's localStorage, so they remain on the same browser." },
      { question: "Do events sync across devices?", answer: "No. This tool does not use account sync; storage is local to each browser and device." },
      { question: "Why do only events within 7 days show seconds?", answer: "The live countdown is limited to near-term events to keep the page focused and lightweight." },
    ],
    disclaimer: "This tool is for personal date tracking. Confirm official deadlines with the relevant institution or organizer.",
  },
  ja: {
    introTitle: "D-Dayは大切な日までの残り時間と過ぎた時間を管理する方法です",
    intro: "このカウンターでは試験、誕生日、旅行、記念日などを登録し、今日を基準にD-、D-Day、D+で並べます。7日以内の未来イベントは秒単位のカウントダウンも表示します。",
    formulaTitle: "計算ルール",
    formulas: [
      { title: "D-日数", body: "目標日が未来なら、目標日-今日をD-nで表示します。" },
      { title: "D-Day", body: "目標日が今日ならD-Dayで表示します。" },
      { title: "D+日数", body: "目標日が過ぎていれば、今日-目標日をD+nで表示します。" },
    ],
    howToTitle: "使い方",
    steps: ["イベント名と目標日を入力します。", "最大10件まで登録し、近い予定から確認します。", "完了したイベントや不要なイベントは削除します。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "予定はどこに保存されますか？", answer: "ブラウザのlocalStorageに保存されるため、同じブラウザでは保持されます。" },
      { question: "別の端末と同期されますか？", answer: "いいえ。アカウント同期はなく、端末とブラウザごとの保存です。" },
      { question: "7日以内だけ秒表示なのはなぜ？", answer: "近い予定だけを強調し、画面を軽く保つためです。" },
    ],
    disclaimer: "このツールは個人の予定管理用です。公式な締切は各機関や主催者の案内をご確認ください。",
  },
  zh: {
    introTitle: "倒数日用剩余时间与已过时间管理重要日期",
    intro: "这个计数器可登录考试、生日、旅行、纪念日等日期，并依今天显示为 D-、D-Day 或 D+。未来 7 天内的事件还会显示秒级倒数，方便掌握临近安排。",
    formulaTitle: "计算规则",
    formulas: [
      { title: "D-天数", body: "目标日在未来时，以目标日-今天显示为 D-n。" },
      { title: "D-Day", body: "目标日就是今天时显示 D-Day。" },
      { title: "D+天数", body: "目标日已过时，以今天-目标日显示为 D+n。" },
    ],
    howToTitle: "使用方法",
    steps: ["输入事件名称与目标日期。", "最多登录 10 个事件，先查看最近的未来日期。", "完成或不需要的事件可以删除。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "事件储存在哪里？", answer: "事件会储存在浏览器 localStorage，因此同一浏览器再次开启仍会保留。" },
      { question: "会跨装置同步吗？", answer: "不会。此工具没有帐号同步，资料只存在各自的浏览器与装置。" },
      { question: "为什么只有 7 天内显示秒数？", answer: "即时秒数倒数只用于近期事件，让页面更清楚也更轻量。" },
    ],
    disclaimer: "本工具用于个人日期管理；正式截止日期请以相关机构或主办方公告为准。",
  },
  fr: {
    introTitle: "Un compteur J-Day suit les dates importantes en temps restant ou écoulé",
    intro: "Ce compteur permet d'enregistrer examens, anniversaires, voyages ou dates spéciales, puis les trie en J-, J-Day ou J+ depuis aujourd'hui. Les événements dans les 7 prochains jours affichent aussi un compte à rebours en secondes.",
    formulaTitle: "Règles de calcul",
    formulas: [
      { title: "J-", body: "Si la date cible est future, cible - aujourd'hui est affiché en J-n." },
      { title: "J-Day", body: "Si la date cible est aujourd'hui, elle est affichée comme J-Day." },
      { title: "J+", body: "Si la date est passée, aujourd'hui - cible est affiché en J+n." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez un nom d'événement et une date cible.", "Enregistrez jusqu'à 10 événements et consultez les plus proches d'abord.", "Supprimez les événements terminés ou inutiles."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Où les événements sont-ils stockés ?", answer: "Dans le localStorage du navigateur, donc ils restent sur le même navigateur." },
      { question: "Sont-ils synchronisés entre appareils ?", answer: "Non. Il n'y a pas de compte ni de synchronisation ; le stockage est local." },
      { question: "Pourquoi les secondes seulement sous 7 jours ?", answer: "Le compte à rebours en direct est réservé aux dates proches pour garder l'interface légère." },
    ],
    disclaimer: "Cet outil sert au suivi personnel des dates. Pour les échéances officielles, vérifiez auprès de l'organisme concerné.",
  },
  es: {
    introTitle: "Un contador D-Day muestra el tiempo restante o transcurrido para fechas importantes",
    intro: "Este contador permite guardar exámenes, cumpleaños, viajes, aniversarios y otras fechas, ordenándolas como D-, D-Day o D+ desde hoy. Los eventos dentro de 7 días muestran además una cuenta regresiva en segundos.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      { title: "D-", body: "Si la fecha está en el futuro, objetivo - hoy se muestra como D-n." },
      { title: "D-Day", body: "Si la fecha objetivo es hoy, se muestra como D-Day." },
      { title: "D+", body: "Si la fecha ya pasó, hoy - objetivo se muestra como D+n." },
    ],
    howToTitle: "Cómo usarlo",
    steps: ["Introduce nombre del evento y fecha objetivo.", "Guarda hasta 10 eventos y revisa primero los más cercanos.", "Elimina eventos completados o innecesarios."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Dónde se guardan los eventos?", answer: "En el localStorage del navegador, por lo que se mantienen en el mismo navegador." },
      { question: "¿Se sincronizan entre dispositivos?", answer: "No. No hay sincronización por cuenta; el almacenamiento es local por navegador y dispositivo." },
      { question: "¿Por qué solo hay segundos en eventos de 7 días?", answer: "La cuenta regresiva en vivo se limita a fechas cercanas para mantener la página clara y ligera." },
    ],
    disclaimer: "Esta herramienta es para seguimiento personal de fechas. Confirma plazos oficiales con la institución u organizador correspondiente.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <DdayCounter client:load locale={locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 font-mono text-sm leading-6 text-indigo-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
