---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import FreelancerTaxCalculatorComp from "../../components/tools/FreelancerTaxCalculator";
import FreelancerTaxCountryCalculator from "../../components/tools/FreelancerTaxCountryCalculator";
import type { FreelancerCountry } from "../../lib/freelancer-tax-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, FreelancerCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "프리랜서 세금 계산기 — 종합소득세·건강보험료 예상 계산",
    description: "프리랜서 연 수입에 따른 종합소득세와 건강보험료를 미리 계산하세요. 절세 전략 수립에 활용하세요.",
  },
  en: {
    title: "Freelancer Tax Calculator (South Korea)",
    description: "Estimate comprehensive income tax and health insurance premiums for freelancers in Korea. Plan your tax strategy.",
  },
  ja: {
    title: "個人事業主・フリーランスの税金計算機（令和8年分）— 所得税・住民税・個人事業税・国保",
    description: "売上と経費から事業所得を出し、青色申告特別控除、所得税・復興特別所得税、住民税、個人事業税（事業主控除290万円）、国民健康保険・国民年金を合わせた負担と手取りを計算します。",
  },
  fr: {
    title: "Simulateur micro-entrepreneur 2026 — cotisations URSSAF et impôt",
    description: "Calculez les cotisations sociales 2026 d'un micro-entrepreneur (BNC 25,6 %, BIC services 21,2 %, vente 12,3 %), la CFP, l'impôt au barème après abattement ou par versement libératoire, et le revenu restant.",
  },
  es: {
    title: "Calculadora de autónomos 2026 — cuota por tramos e IRPF",
    description: "Calcula la cuota de autónomos 2026 según tus rendimientos netos, el IRPF de la actividad en estimación directa simplificada con la retención del 15 % o 7 %, y lo que te queda neto al año.",
  },
  zh: {
    title: "个体工商户经营所得个税计算器 — 含劳务报酬预扣",
    description: "按经营所得5%–35%税率表计算个体工商户、个人独资企业的个人所得税，含200万元以下部分减半征收；并计算劳务报酬每次预扣预缴税额。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "프리랜서 세금은 원천징수와 종합소득세 정산을 나누어 봐야 합니다",
    intro: "이 계산기는 월 세전 소득에서 3.3% 원천징수를 뺀 실수령액과, 단순 경비율을 가정한 연간 종합소득세 정산 방향을 추정해요. 실제 신고에서는 업종 코드, 필요경비, 공제, 건강보험료, 기납부세액이 모두 달라질 수 있어요.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "원천징수", body: "원천징수 = 월 소득 × 3.3%" },
      { title: "월 실수령", body: "실수령액 = 월 소득 - 원천징수" },
      { title: "정산 예상", body: "정산 = 추정 종합소득세 - 연간 원천징수액" },
    ],
    howToTitle: "사용 방법",
    steps: ["월 세전 프리랜서 소득을 입력합니다.", "3.3% 원천징수 후 월 실수령액을 확인합니다.", "연간 정산 예상액을 참고해 세금 준비금을 따로 관리합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "3.3%를 떼면 세금이 끝난 건가요?", answer: "아닙니다. 3.3%는 원천징수된 선납 세금 성격이며, 다음 해 종합소득세 신고 때 정산합니다." },
      { question: "건강보험료도 정확히 계산하나요?", answer: "이 페이지의 컴포넌트는 주로 3.3% 원천징수와 간이 종합소득세 정산을 보여줍니다. 건강보험료는 지역가입자 요건과 재산·소득에 따라 달라집니다." },
      { question: "한국 프리랜서 기준인가요?", answer: "네. 3.3% 원천징수와 5월 종합소득세 신고라는 한국 세무 맥락을 전제로 합니다." },
    ],
    disclaimer: "이 도구는 일반적인 계산용이에요. 공식 프리랜서 세액과 보험료는 국세청·건강보험공단 또는 세무전문가 기준을 확인하세요.",
  },
  en: {
    introTitle: "Korean freelancer tax separates 3.3% withholding from annual settlement",
    intro: "This calculator estimates monthly take-home pay after 3.3% withholding and a simplified annual comprehensive income tax settlement. Real filing can change with business code, deductible expenses, credits, health insurance, and tax already withheld.",
    formulaTitle: "Calculation rules",
    formulas: [
      { title: "Withholding", body: "Withholding = monthly gross income × 3.3%" },
      { title: "Monthly net", body: "Net pay = monthly gross income - withholding" },
      { title: "Settlement", body: "Settlement = estimated annual income tax - annual withholding" },
    ],
    howToTitle: "How to use",
    steps: ["Enter your monthly pre-tax freelance income.", "Check take-home pay after 3.3% withholding.", "Use the annual settlement estimate to plan a tax reserve."],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Does 3.3% withholding finish the tax obligation?", answer: "No. It is prepaid withholding. The final amount is settled during Korea's comprehensive income tax filing." },
      { question: "Does this precisely calculate health insurance?", answer: "No. The component focuses on 3.3% withholding and simplified income tax; health insurance depends on separate eligibility and assessment rules." },
      { question: "Is this Korea-specific?", answer: "Yes. It assumes the Korean freelance withholding and May income-tax filing context." },
    ],
    disclaimer: "This tool is for general calculation. Confirm official freelancer tax and insurance figures with the relevant Korean authority or tax professional.",
  },
  ja: {
    introTitle: "個人事業主の税金は、所得税・住民税・個人事業税と国保・国民年金をまとめて見ます",
    intro: "フリーランスや個人事業主は、売上から経費を引いた事業所得に所得税（5%〜45%＋復興特別所得税2.1%）と住民税（10%）がかかります。青色申告なら最大65万円の特別控除が使えます。さらに事業所得が290万円を超えると、業種によって3%〜5%の個人事業税がかかります。会社員と違って健康保険と年金は自分で払い、国民健康保険料は市区町村ごと、国民年金は令和8年度 月17,920円の定額です。報酬から10.21%が源泉徴収されている場合は、確定申告で精算します。",
    formulaTitle: "計算基準",
    formulas: [
      { title: "事業所得", body: "売上 − 必要経費 − 青色申告特別控除（65万・55万・10万円）" },
      { title: "所得税・住民税", body: "（事業所得 − 国保・年金などの社会保険料 − 基礎控除 − その他の控除）× 税率。所得税は×102.1%、住民税は10%＋均等割" },
      { title: "個人事業税", body: "（青色控除前の事業所得 − 事業主控除290万円）× 5%（業種により4%・3%、法定業種外は非課税）" },
    ],
    howToTitle: "使い方",
    steps: ["売上と必要経費、青色申告の区分を入力します。", "国民健康保険料（市区町村の試算額）と国民年金、源泉徴収された税額を入れます。", "所得税・住民税・個人事業税と手取りの見込みを確認します。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "報酬から10.21%引かれていれば税金は終わりですか？", answer: "いいえ。源泉徴収は所得税の前払いです。確定申告で年税額を計算し、源泉徴収税額が多ければ還付、少なければ納付します。住民税と個人事業税は源泉徴収されないので、別に納めます。" },
      { question: "個人事業税はいつからかかりますか？", answer: "青色申告特別控除を引く前の事業所得が年290万円（事業主控除）を超えた部分にかかります。デザイン業やコンサルタント業など多くの業種は5%で、文筆業や翻訳業などは法定業種に当たらず課税されないこともあります。納付は翌年8月と11月です。" },
      { question: "国民健康保険料はどう決まりますか？", answer: "前年の所得から住民税の基礎控除43万円を引いた額に、市区町村ごとの所得割率をかけ、加入者ごとの均等割などを足して決まります。上限があり、自治体によって大きく違うため、市区町村のサイトの試算額を入力してください。" },
    ],
    disclaimer: "このツールは一般的な見積もり用です。正確な税額は国税庁の確定申告書等作成コーナー、都道府県税事務所、市区町村、税理士にご確認ください。",
  },
  zh: {
    introTitle: "自由职业者先分清：经营所得还是劳务报酬",
    intro: "个体工商户、个人独资企业投资人以及独立从事设计、咨询等经营活动的个人，取得的是经营所得，以全年收入减除成本、费用和损失后的余额，适用5%至35%的五级超额累进税率，按月或按季预缴，次年3月31日前汇算清缴。个体工商户年应纳税所得额不超过200万元的部分减半征收（执行至2027年底）。为单位临时提供劳务取得的报酬则是劳务报酬，由支付方按次预扣20%–40%，年度汇算时并入综合所得。",
    formulaTitle: "计算规则",
    formulas: [
      { title: "应纳税所得额", body: "全年收入 − 成本费用及损失；没有综合所得的，再减除60,000元、专项扣除、专项附加扣除和其他扣除" },
      { title: "经营所得税率表", body: "不超过30,000元 5%，90,000元 10%，300,000元 20%，500,000元 30%，超过 35%（速算扣除 0 / 1,500 / 10,500 / 40,500 / 65,500）" },
      { title: "劳务报酬预扣", body: "每次收入不超过4,000元减800元，超过的减20%；预扣率 20%（20,000元以下）、30%、40%" },
    ],
    howToTitle: "使用方法",
    steps: ["输入全年经营收入和成本费用，选择是否同时有工资等综合所得。", "选择是否为个体工商户以适用减半征收，填写已预缴税额。", "如为单位提供劳务，输入单次劳务报酬查看预扣税额。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "我是自由职业者，应该按经营所得还是劳务报酬纳税？", answer: "看是否独立从事经营活动。办理了个体工商户登记、或独立承接业务并自负盈亏的，一般按经营所得；与单位之间是临时性劳务关系、由单位支付报酬并代扣税款的，按劳务报酬。" },
      { question: "减半征收怎么计算？", answer: "先按经营所得税率表计算应纳税额，再对年应纳税所得额不超过200万元部分的应纳税额减征50%。超过200万元的，按200万元套用税率表计算这部分税额后减半。" },
      { question: "核定征收也能用这个计算器吗？", answer: "不能。核定征收按税务机关核定的应税所得率或定额计税。本计算器适用于查账征收。" },
    ],
    disclaimer: "本工具仅供一般估算。以电子税务局或个人所得税App的申报结果为准。",
  },
  fr: {
    introTitle: "Micro-entrepreneur : cotisations sur le chiffre d'affaires et impôt sur un revenu forfaitaire",
    intro: "Le régime micro-entrepreneur calcule tout à partir du chiffre d'affaires encaissé, sans déduire les frais réels. Les cotisations sociales sont un pourcentage fixe déclaré à l'URSSAF chaque mois ou trimestre : en 2026, 25,6 % pour les professions libérales non réglementées (BNC), 23,2 % pour les libéraux relevant de la Cipav, 21,2 % pour les prestations de services BIC et 12,3 % pour la vente. S'y ajoute la contribution à la formation professionnelle. Pour l'impôt sur le revenu, l'administration retient le chiffre d'affaires après abattement forfaitaire, sauf option pour le versement libératoire, qui solde l'impôt par un petit pourcentage payé en même temps que les cotisations.",
    formulaTitle: "Règles de calcul",
    formulas: [
      { title: "Cotisations", body: "CA × 25,6 % (BNC), 23,2 % (Cipav), 21,2 % (BIC services) ou 12,3 % (vente) + CFP 0,1 à 0,3 %. ACRE : −50 % ou −25 % la première année" },
      { title: "Impôt au barème", body: "Revenu imposable = CA − abattement (34 % BNC, 50 % BIC services, 71 % vente, min. 305 €), ajouté aux autres revenus du foyer" },
      { title: "Versement libératoire", body: "CA × 2,2 % (BNC), 1,7 % (BIC services) ou 1 % (vente), si le revenu fiscal de référence 2024 ne dépasse pas 29 315 € par part" },
    ],
    howToTitle: "Mode d'emploi",
    steps: ["Saisissez le chiffre d'affaires annuel et choisissez l'activité.", "Indiquez l'ACRE, l'option pour le versement libératoire et les autres revenus du foyer.", "Lisez les cotisations, l'impôt et le revenu qui vous reste."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Pourquoi le taux BNC a-t-il augmenté en 2026 ?", answer: "La réforme de 2024 relève progressivement les cotisations retraite des micro-entrepreneurs libéraux non réglementés : 23,1 % en 2024, 24,6 % en 2025 puis 25,6 % au 1er janvier 2026 (décret 2025-943, au lieu des 26,1 % initialement prévus)." },
      { question: "Le versement libératoire est-il avantageux ?", answer: "Il l'est surtout si votre taux marginal d'imposition est de 11 % ou plus. Si le foyer n'est pas imposable, le barème avec abattement coûte souvent moins. L'option doit être demandée avant le 30 septembre pour l'année suivante." },
      { question: "Quels sont les plafonds de chiffre d'affaires ?", answer: "83 600 € pour les prestations de services et les activités libérales, 203 100 € pour la vente de marchandises et l'hébergement. La franchise en base de TVA a des seuils plus bas et distincts." },
    ],
    disclaimer: "Cet outil sert au calcul général. Vérifiez vos taux sur autoentrepreneur.urssaf.fr et votre impôt sur impots.gouv.fr.",
  },
  es: {
    introTitle: "Autónomos: la cuota se paga por tramos de rendimientos y el IRPF va por la actividad",
    intro: "Desde 2023 los autónomos cotizan según sus rendimientos netos reales. Eliges un tramo según lo que prevés ganar al mes (ingresos menos gastos y un 7 % de gastos genéricos) y pagas la cuota mínima de ese tramo, del 31,5 % de la base en 2026. Al año siguiente la Seguridad Social regulariza con los datos de Hacienda. En el IRPF, los rendimientos de la actividad se suman a la base general; en estimación directa simplificada se restan además los gastos de difícil justificación. Las facturas a empresas llevan una retención del 15 % (7 % al empezar) que se descuenta en la declaración.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      { title: "Cuota de autónomo", body: "Rendimiento mensual = (ingresos − gastos) × 93 % / 12 → tramo → base mínima × 31,5 %. Tarifa plana de 80 €/mes los primeros 12 meses" },
      { title: "Rendimiento neto IRPF", body: "Ingresos − gastos − cuotas de autónomo − 5 % de gastos de difícil justificación (máx. 2.000 €)" },
      { title: "Resultado de la renta", body: "Escala general 2026 sobre el rendimiento menos la escala sobre el mínimo personal y familiar, menos las retenciones de las facturas" },
    ],
    howToTitle: "Cómo se usa",
    steps: ["Introduce los ingresos y gastos anuales de tu actividad, sin IVA.", "Indica si tienes tarifa plana y qué retención aplicas en tus facturas.", "Consulta la cuota mensual, el IRPF y lo que te queda neto."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Cuánto cuesta la cuota de autónomo en 2026?", answer: "Va desde unos 206 € al mes para rendimientos de hasta 670 € al mes hasta unos 607 € para más de 6.000 €. Las bases mínimas de 2026 son las de 2025; el tipo sube al 31,5 % por el MEI." },
      { question: "¿Cuándo aplico la retención del 7 %?", answer: "En el año de alta y los dos siguientes, si no has ejercido una actividad en el año anterior. Después es el 15 %. A particulares no se aplica retención: en ese caso pagas el 20 % trimestral con el modelo 130." },
      { question: "¿Qué gastos de difícil justificación puedo restar?", answer: "En estimación directa simplificada, un 5 % del rendimiento neto previo, con un máximo de 2.000 € al año, sin justificar facturas. No se aplica si usas la reducción para autónomos económicamente dependientes." },
    ],
    disclaimer: "Esta herramienta es para cálculo general. Consulta tu cuota en Import@ss (Seguridad Social) y tu declaración en Renta WEB de la Agencia Tributaria.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  { "@context": "https://schema.org", "@type": "HowTo", name: m.title, description: m.description, step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-6 sm:py-10">
    {country ? <FreelancerTaxCountryCalculator client:load country={country} /> : <FreelancerTaxCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 font-mono text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="freelancer-tax-calculator" slugs={["comprehensive-income-tax-calculator", "global-income-tax-calculator", "gift-tax-calculator", "inheritance-tax-calculator", "property-tax-calculator", "year-end-settlement-calculator", "severance-calculator", "freelancer-tax-calculator"]} />
  </div>
</BaseLayout>
