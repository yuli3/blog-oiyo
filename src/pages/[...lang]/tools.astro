                  <span class="text-2xl leading-none" aria-hidden="true">{tool.emoji}</span>
                  <div class="space-y-1 min-w-0">
                    <p class="font-bold text-sm leading-snug group-hover:text-secondary transition-colors line-clamp-2">
                      {title}
                    </p>
                    <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">
                      {desc}
                    </p>
                  </div>
                  <span class="mt-auto text-[10px] font-bold uppercase tracking-widest text-secondary/60 group-hover:text-secondary transition-colors">
                    →
                  </span>
                </a>
              );
            })}
          </div>

          {/* "더보기" — only for psychology since it's the largest */}
          {cat.id === "psychology" && (
            <div class="mt-6 text-center">
              <a
                href={`/${locale}/`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-secondary hover:underline"
              >
                {moreLabel[locale]} →
              </a>
            </div>
          )}
        </section>
      ))}

    </div>
  </section>
</BaseLayout>
