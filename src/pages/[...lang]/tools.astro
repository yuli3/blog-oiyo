// ─── IA unification: merge interactive (tool-embedding articles) into the catalog ──
// /interactive and /tools were two views of the same thing (every interactive post
// embeds a tool). We fold the interactive collection into the curated category
// buckets so "도구들" is one coherent directory. Deduped against curated slugs.
// Fortune/divination execution surfaces are owned by oiyo.net (saju, tarot, zodiac,
// numerology), so the blog catalog carries no mystic bucket. The five curated
// fortune tools that sat inside psychologyTools (tarot-daily-card,
// chinese-zodiac{,-compatibility}, daily-fortune, daily-horoscope) were pulled for
// the same reason — dropping the bucket while leaving them in a neighbouring one
// would have moved the 운세 tools rather than removed them (2026-08-17). Psychology
// and games buckets followed on 2026-08-18: oiyo.net and game.oiyo.net own those
// intents too, and every curated slug that used to live here was already a
// 2026-07-04 redirect stub. All excluded rather than left unmapped so the intent
// is explicit, not an accident of the "learning" fallback.
const EXCLUDED_CATEGORIES = new Set(["Mysticism", "Mind & Psychology", "Games", "Strategy"]);
const CAT_TO_BUCKET: Record<string, string> = {
  "Finance": "finance", "Tax": "finance", "Real Estate": "finance", "Business": "finance", "Career": "finance",
  "Health": "health",
  "Computer Science": "utilities",
  "Design": "image",
  "Education": "learning", "Exam": "learning", "Science & Nature": "learning", "Humanities": "learning", "Philosophy & Spirit": "learning",
  "Lifestyle": "lifestyle", "Beauty": "lifestyle",
};
const BUCKET_EMOJI: Record<string, string> = {
  converters: "🧮", finance: "💰", health: "💪", image: "🎨",
  utilities: "💻", learning: "📚", lifestyle: "🌿",
};

// Folded-in interactive posts previously all inherited their bucket's single emoji,
// so a whole section rendered identical icons (e.g. 30× 🧠). Derive a distinct icon
// per post: first a keyword match on slug/title, else a deterministic pick from the
// bucket's palette so no two neighbours collapse to the same glyph.
