  [/personal.?color/, "🎨"], [/blood/, "🩸"], [/zodiac|astro|\bstar\b/, "⭐"], [/tarot/, "🃏"],
  [/numerolog/, "🔢"], [/dream/, "🌙"], [/saju|four.?pillar/, "☯️"], [/hsp|sensitiv/, "🌿"],
  [/social/, "👥"], [/happi/, "😊"], [/gratitude/, "🙏"], [/animal/, "🐾"], [/disc|leadership/, "📊"],
  [/tax|vat|irpf|income/, "🧾"], [/salary|wage|payroll/, "💵"], [/loan|mortgage/, "🏦"],
  [/invest|stock|etf|portfolio/, "📈"], [/pension|retire/, "👴"], [/budget|saving/, "🐷"],
  [/crypto|bitcoin|blockchain/, "🪙"], [/real.?estate|rent|property/, "🏠"], [/interest|bond/, "💹"],
