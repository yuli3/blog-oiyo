const BUCKET_PALETTE: Record<string, string[]> = {
  finance: ["💰", "💵", "📊", "🏦", "💹", "🪙", "📈", "🧾"],
  health: ["💪", "🩺", "🍎", "🏃", "😴", "💧", "🧘", "❤️"],
  image: ["🎨", "🖼️", "📷", "✂️", "🌈", "🎭"],
  utilities: ["💻", "🔧", "⌨️", "📋", "🔢", "📐"],
  learning: ["📚", "🎓", "✏️", "🧪", "🌍", "🔬"],
  lifestyle: ["🌿", "☕", "🌸", "🧺", "🕯️", "🛋️"],
  converters: ["🧮", "📏", "⚖️", "🌡️", "⏱️", "💱"],
};
function pickEmoji(slug: string, title: string, bucket: string): string {
  const hay = `${slug} ${title}`.toLowerCase();
  for (const [re, e] of KEYWORD_EMOJI) if (re.test(hay)) return e;
  const pal = BUCKET_PALETTE[bucket] ?? [BUCKET_EMOJI[bucket] ?? "✨"];
  let h = 0;
  for (let i = 0; i < slug.length; i++) h = (h * 31 + slug.charCodeAt(i)) >>> 0;
  return pal[h % pal.length];
}
const interactivePosts = await getCollection("blog", ({ data }) =>
  data.draft !== true && data.locale === locale && getTrackFromData(data) === "interactive");
const curatedSlugs = new Set(categories.flatMap((c) => c.tools.map((t) => t.slug)));
const interactiveByBucket = new Map<string, Tool[]>();
for (const post of interactivePosts) {
  const slug = post.slug.split("/").slice(1).join("/");
  if (!slug || curatedSlugs.has(slug)) continue;
  if (EXCLUDED_CATEGORIES.has(post.data.category ?? "")) continue;
  const bucket = CAT_TO_BUCKET[post.data.category ?? ""] ?? "learning";
  const emoji = pickEmoji(slug, post.data.title ?? "", bucket);
  const title = post.data.title;
  const desc = post.data.description ?? "";
  const entry: Tool = {
    slug,
    emoji,
    title: { ko: title, en: title, ja: title, fr: title, es: title, zh: title, },
    description: { ko: desc, en: desc, ja: desc, fr: desc, es: desc, zh: desc, },
  };
  // Folded post is a consolidated duplicate → link straight to its oiyo canonical.
  const rt = (post.data as { redirectTo?: string }).redirectTo;
  if (rt) entry.href = `https://oiyo.net/${locale}${rt}`;
  const arr = interactiveByBucket.get(bucket) ?? [];
  arr.push(entry);
  interactiveByBucket.set(bucket, arr);
}
for (const cat of categories) {
  const extra = interactiveByBucket.get(cat.id);
  if (extra && extra.length) cat.tools = [...cat.tools, ...extra];
}

// Direct-link any test/tool whose canonical lives on oiyo.net, so the catalog points
// straight at the real interactive page instead of bouncing through a blog redirect stub.
const oiyoLocale = locale;
const canonicalMap = oiyoCanonicalMap as Record<string, string>;
for (const cat of categories) {
  for (const tool of cat.tools) {
    const path = canonicalMap[tool.slug];
    if (path) tool.href = `https://oiyo.net/${oiyoLocale}${path}`;
  }
}

const totalCount = categories.reduce((sum, c) => sum + c.tools.length, 0);
const m = meta[locale] ?? meta.en;

const catalogJsonLd = JSON.stringify(
  collectionPageJsonLd({
    name: m.title,
    description: m.description,
    url: `${siteConfig.url}/${locale}/tools/`,
    inLanguage: locale,
    items: categories.flatMap((c) =>
      c.tools.map((tool) => ({
        name: tool.title[locale] ?? tool.title.en,
        url: tool.href ?? `${siteConfig.url}/${locale}/${tool.slug}/`,
      })),
    ),
  }),
);

