---
// Educational teardown of a slot machine, not a slot machine.
// Deliberately lives in blog (linked from the gambling-prevention series) rather
// than the game arcade: a visitor browsing an arcade for a slot game is the wrong
// audience for this, and the readers who need it arrive from ch3/ch6.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SlotAnatomy from "../../components/tools/SlotAnatomy";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "슬롯머신 해부 — 환수율과 니어미스가 설계되는 방식",
    description: "슬롯머신의 릴 배치, 배당표, 설계 환수율을 열어 보고 100만 회 시뮬레이션으로 확인합니다. 베팅도 잔고도 없는 교육용 해부 자료입니다.",
  },
  en: {
    title: "Slot Machine Anatomy — How Return Rate and Near Misses Are Designed",
    description: "Open up a slot machine's reel layout, payout table and designed return rate, then verify it across a million simulated spins. A teaching teardown with no bet and no balance.",
  },
  ja: {
    title: "スロットマシン解剖 — 還元率とニアミスが設計される仕組み",
    description: "スロットのリール配置・配当表・設計還元率を開いて見て、100万回のシミュレーションで確認します。ベットも残高もない教育用の解剖資料です。",
  },
  zh: {
    title: "老虎机解剖 — 回报率与「差一点」是如何被设计的",
    description: "打开老虎机的转轴排列、赔付表与设计回报率，并用一百万次模拟加以验证。没有下注、没有余额的教学拆解资料。",
  },
  fr: {
    title: "Anatomie d'une machine à sous — comment le taux de retour et les quasi-gains sont conçus",
    description: "Ouvrez la disposition des rouleaux, la table de paiement et le taux de retour conçu, puis vérifiez-les sur un million de tours simulés. Un démontage pédagogique sans mise ni solde.",
  },
  es: {
    title: "Anatomía de una máquina tragamonedas — cómo se diseñan el retorno y los casi-premios",
    description: "Abre la disposición de los rodillos, la tabla de pagos y el retorno de diseño, y compruébalo con un millón de giros simulados. Un desmontaje didáctico sin apuesta ni saldo.",
  },
};

const m = meta[locale] ?? meta.en;

const intro: Record<ActiveLocale, string> = {
  ko: "슬롯머신에서 지는 이유는 운이 나빠서가 아닙니다. 릴에 심볼을 어떻게 배치하고 배당을 어떻게 매기는지가 결과를 미리 정해 둡니다. 이 페이지는 그 설계를 열어서 보여주고, 100만 회를 돌려 확인합니다. 베팅 버튼도, 잔고도, 당첨 연출도 없습니다.",
  en: "You do not lose at slots because of bad luck. How symbols sit on the reels and how payouts are set decides the outcome in advance. This page opens that design up and verifies it across a million spins. There is no bet button, no balance and no win animation.",
  ja: "スロットで負けるのは運が悪いからではありません。リールへのシンボル配置と配当の設定が結果をあらかじめ決めています。このページはその設計を開いて示し、100万回回して確認します。ベットボタンも残高も当選演出もありません。",
  zh: "在老虎机上输钱不是因为运气差。符号在转轴上的排列方式与赔付的设定，事先就决定了结果。本页把这套设计打开给你看，并用一百万次旋转加以验证。没有下注按钮、没有余额、没有中奖动画。",
  fr: "Vous ne perdez pas aux machines à sous par malchance. La façon dont les symboles sont placés sur les rouleaux et dont les gains sont fixés décide du résultat à l'avance. Cette page ouvre cette conception et la vérifie sur un million de tours. Pas de bouton de mise, pas de solde, pas d'animation de gain.",
  es: "No pierdes en las tragamonedas por mala suerte. Cómo se colocan los símbolos en los rodillos y cómo se fijan los pagos decide el resultado de antemano. Esta página abre ese diseño y lo comprueba con un millón de giros. Sin botón de apuesta, sin saldo y sin animación de premio.",
};

const seriesLink: Record<ActiveLocale, { label: string; ch3: string; ch6: string }> = {
  ko: { label: "함께 읽기", ch3: "대수의 법칙 — 시뮬레이션으로 센 파산률", ch6: "뇌를 속이는 설계 — 왜 알면서도 멈추지 못하는가" },
  en: { label: "Read alongside", ch3: "The law of large numbers — ruin rates, counted", ch6: "Designed to fool the brain — why knowing does not stop it" },
  ja: { label: "あわせて読む", ch3: "大数の法則 — シミュレーションで数えた破産率", ch6: "脳を騙す設計 — 知っていてもやめられない理由" },
  zh: { label: "一并阅读", ch3: "大数法则 — 用模拟数出的破产率", ch6: "欺骗大脑的设计 — 为何明知却停不下来" },
  fr: { label: "À lire aussi", ch3: "La loi des grands nombres — taux de ruine mesurés", ch6: "Conçu pour tromper le cerveau — pourquoi savoir ne suffit pas" },
  es: { label: "Leer también", ch3: "La ley de los grandes números — tasas de ruina medidas", ch6: "Diseñado para engañar al cerebro — por qué saberlo no basta" },
};

const helpline: Record<ActiveLocale, string> = {
  ko: "도박 문제로 힘들다면 — 도박문제 헬프라인 국번 없이 1336 (365일 24시간, 무료).",
  en: "Struggling with gambling? Korea's gambling helpline: 1336 (24/7, free).",
  ja: "ギャンブルの問題で困っていたら — ギャンブル問題ヘルプライン 1336（365日24時間・無料）。",
  zh: "若为赌博问题困扰 — 赌博问题求助热线 1336（全年24小时，免费）。",
  fr: "Difficultés liées au jeu ? Ligne d'aide coréenne : 1336 (24h/24, gratuit).",
  es: "¿Problemas con el juego? Línea de ayuda de Corea: 1336 (24/7, gratis).",
};

const s = seriesLink[locale] ?? seriesLink.en;
---

<BaseLayout
  title={m.title}
  description={m.description}
  availableLocales={[...locales]}
  heading={m.title}
  intro={intro[locale] ?? intro.en}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <SlotAnatomy locale={locale} client:load />

    <aside class="mt-12 rounded-xl border border-slate-200 bg-slate-50 p-5">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">{s.label}</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="font-semibold text-slate-900 underline" href={`/${locale}/academy-gambling-prevention-ch3/`}>{s.ch3}</a>
        </li>
        <li>
          <a class="font-semibold text-slate-900 underline" href={`/${locale}/academy-gambling-prevention-ch6/`}>{s.ch6}</a>
        </li>
      </ul>
      <p class="mt-4 text-xs font-semibold text-slate-700">{helpline[locale] ?? helpline.en}</p>
    </aside>
  </div>
</BaseLayout>
