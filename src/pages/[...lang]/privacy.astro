---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTranslations, locales } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
---

<BaseLayout title={t.legal.privacy.title} description={t.legal.privacy.description}>
  <section class="py-24 md:py-32 overflow-hidden">
    <div class="container px-4">
      <div class="max-w-3xl mx-auto">
        <header class="mb-16 animate-fade-up">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-[0.2em] mb-8 border border-primary/20"
          >
            {t.legal.badge}
          </div>
          <h1
            class="text-5xl md:text-6xl font-extrabold tracking-tighter mb-6 font-heading text-primary leading-tight"
          >
            {t.legal.privacy.title}
          </h1>
          <p class="text-xl text-muted-foreground leading-relaxed">
            {t.legal.privacy.description}
          </p>
          <p class="text-xs font-bold uppercase tracking-widest text-muted-foreground/50 mt-4">
            {t.legal.lastUpdated}: January 1, 2026
          </p>
        </header>

        <div class="prose prose-stone lg:prose-lg max-w-none animate-fade-up delay-200">

          <h2>1. Information We Collect</h2>
          <p>When you use Oiyo Blog, we may collect the following types of information:</p>
          <ul>
            <li><strong>Usage Data:</strong> Pages visited, time spent, browser type, device type, and referring URL — collected automatically via Google Analytics 4.</li>
            <li><strong>Cookies:</strong> We use cookies for analytics (Google Analytics) and advertising (Google AdSense). These cookies help us understand how visitors interact with the site and allow us to show relevant ads.</li>
            <li><strong>Contact Information:</strong> If you contact us via email (support@oiyo.net), we receive your email address and the content of your message.</li>
          </ul>
          <p>We do not collect names, passwords, or payment information directly. We do not require account registration to read content.</p>

          <h2>2. How We Use Your Information</h2>
          <ul>
            <li>To analyze traffic and improve site content and performance.</li>
            <li>To display relevant advertisements through Google AdSense.</li>
            <li>To respond to support inquiries.</li>
            <li>To comply with legal obligations.</li>
          </ul>
          <p>We do not sell your personal data to third parties.</p>

          <h2>3. Google Analytics</h2>
          <p>
            We use Google Analytics 4 to understand how visitors use our site. Google Analytics collects anonymized usage data. You can opt out by installing the
            <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
          </p>

          <h2>4. Google AdSense & Advertising</h2>
          <p>
            We use Google AdSense to display advertisements. Google AdSense uses cookies and similar technologies to serve ads based on your prior visits to this and other websites. You may opt out of personalized advertising by visiting
            <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ads Settings</a> or
            <a href="https://optout.aboutads.info/" target="_blank" rel="noopener noreferrer">aboutads.info</a>.
          </p>

          <h2>5. Cookies</h2>
          <p>We use the following types of cookies:</p>
          <ul>
            <li><strong>Analytics Cookies:</strong> Set by Google Analytics to track site usage.</li>
            <li><strong>Advertising Cookies:</strong> Set by Google AdSense to serve and measure advertisements.</li>
          </ul>
          <p>You can control cookies through your browser settings. Disabling cookies may affect some functionality of the site.</p>

          <h2>6. Third-Party Services</h2>
          <p>Our site links to third-party services. We are not responsible for the privacy practices of external websites. We encourage you to review their privacy policies.</p>

          <h2>7. Data Retention</h2>
          <p>Analytics data is retained according to Google's data retention settings (default: 14 months). Contact information is retained only as long as necessary to respond to your inquiry.</p>

          <h2>8. Your Rights</h2>
          <p>Depending on your jurisdiction, you may have the right to:</p>
          <ul>
            <li>Access data we hold about you.</li>
            <li>Request deletion of your data.</li>
            <li>Opt out of analytics tracking.</li>
            <li>Withdraw consent for cookies.</li>
          </ul>
          <p>To exercise these rights, contact us at <a href="mailto:support@oiyo.net">support@oiyo.net</a>.</p>

          <h2>9. Children's Privacy</h2>
          <p>Oiyo Blog is not directed at children under 13. We do not knowingly collect personal information from children. If you believe we have inadvertently collected information from a child, please contact us.</p>

          <h2>10. Changes to This Policy</h2>
          <p>We may update this Privacy Policy from time to time. The date of the most recent update appears at the top of this page. Continued use of the site after any changes constitutes acceptance of the updated policy.</p>

          <h2>11. Contact</h2>
          <p>If you have questions about this Privacy Policy, please contact us at <a href="mailto:support@oiyo.net">support@oiyo.net</a>.</p>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>
