---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "오늘의 별자리 운세",
  en: "daily horoscope",
  ja: "今日の星座運勢",
  fr: "horoscope du jour",
  es: "horóscopo del día",
  zh: "今日星座运势",
  cn: "今日星座運勢",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/zodiac/fortune" kind="tool" />
