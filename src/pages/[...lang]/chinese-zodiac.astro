---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "중국 십이지",
  en: "Chinese zodiac",
  ja: "中国星座",
  fr: "zodiaque chinois",
  es: "zodiaco chino",
  zh: "中国生肖",
  cn: "中國生肖",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/chinese-zodiac" kind="tool" />
