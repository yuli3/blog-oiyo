---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VaccinationSchedule from "../../components/tools/VaccinationSchedule";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "예방접종 스케줄러 — 아이 생년월일로 접종 일정 확인",
    description: "아이 생년월일을 입력하면 BCG·B형간염·DTaP 등 16종 예방접종 일정을 자동으로 계산해 드립니다.",
  },
  en: {
    title: "Vaccination Schedule — Baby Immunization Timeline",
    description: "Enter your baby's birth date to get a personalized vaccination schedule covering 16 vaccines including BCG, Hepatitis B, DTaP, MMR, and more.",
  },
  ja: {
    title: "予防接種スケジューラー — 接種時期を自動計算",
    description: "お子様の生年月日を入力すると、BCG・B型肝炎・DTaPなど16種類の予防接種スケジュールを自動計算します。",
  },
  fr: {
    title: "Calendrier de Vaccination — Programme d'immunisation pour bébé",
    description: "Entrez la date de naissance de votre bébé pour obtenir un calendrier de vaccination personnalisé couvrant 16 vaccins.",
  },
  es: {
    title: "Calendario de Vacunación — Programa de inmunización para bebés",
    description: "Ingresa la fecha de nacimiento de tu bebé para obtener un calendario de vacunación personalizado con 16 vacunas.",
  },
  zh: {
    title: "疫苗接种时间表 — 宝宝免疫接种日程",
    description: "输入宝宝出生日期，自动生成包含BCG、乙肝、DTaP等16种疫苗的个性化接种时间表。",
  },
  cn: {
    title: "疫苗接種時間表 — 寶寶免疫接種日程",
    description: "輸入寶寶出生日期，自動生成包含BCG、乙肝、DTaP等16種疫苗的個性化接種時間表。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <VaccinationSchedule client:load locale={locale} />
  </main>
</BaseLayout>
