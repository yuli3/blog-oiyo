---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoanCalculatorComp from "../../components/calculators/LoanCalculator";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "대출 계산기 — 월 상환액·총 이자 간편 계산 (원리금균등)",
    description: "대출금액, 금리, 기간을 입력해 월 상환액과 총 이자를 계산합니다. 원리금균등상환 방식 기준으로 첫 12개월 상환 스케줄을 제공합니다.",
  },
  en: {
    title: "Loan Repayment Calculator — Monthly Payment & Total Interest",
    description: "Calculate monthly payments and total interest for equal principal-and-interest (annuity) loans.",
  },
  ja: {
    title: "ローン返済計算機 — 月額返済額・総利息計算",
    description: "元利均等返済方式で月額返済額と総利息を計算します。",
  },
  fr: {
    title: "Calculateur de Prêt — Mensualité et Intérêts Totaux",
    description: "Calculez les mensualités et les intérêts totaux pour votre prêt à annuités constantes.",
  },
  es: {
    title: "Calculadora de Préstamo — Cuota Mensual e Intereses",
    description: "Calcula la cuota mensual y los intereses totales de tu préstamo con amortización francesa.",
  },
  zh: {
    title: "贷款计算机 — 月还款额与总利息计算",
    description: "输入贷款金额、利率和期限，计算等额本息还款的月还款额和总利息。",
  },
  cn: {
    title: "贷款计算器 — 月还款额与总利息计算",
    description: "输入贷款金额、利率和期限，计算等额本息还款的月还款额和总利息。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <LoanCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
  </main>
</BaseLayout>
