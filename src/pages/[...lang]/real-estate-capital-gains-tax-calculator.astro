---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RealEstateCapitalGainsTaxCalc from "../../components/tools/RealEstateCapitalGainsTaxCalc";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "부동산 양도소득세 계산기 — 1주택·2주택·3주택 세금 비교",
    description: "2024년 기준 부동산 양도소득세를 보유주택 수(1·2·3주택)별, 보유기간별로 자동 계산합니다. 단기양도세율과 누진세율을 차트로 비교하세요.",
  },
  en: {
    title: "Real Estate Capital Gains Tax Calculator — 1, 2 & 3+ Properties (Korea)",
    description: "Calculate Korean real estate capital gains tax by number of properties owned and holding period. Compare short-term rates and progressive brackets with charts.",
  },
  ja: {
    title: "不動産譲渡所得税計算機 — 1住宅・2住宅・3住宅の税金比較",
    description: "2024年基準で保有住宅数（1・2・3住宅）と保有期間別に不動産譲渡所得税を自動計算します。短期譲渡税率と累進税率をグラフで比較。",
  },
  fr: {
    title: "Calculateur de Plus-Value Immobilière — 1, 2 et 3+ Biens (Corée)",
    description: "Calculez l'impôt coréen sur les plus-values immobilières selon le nombre de biens détenus et la durée de détention. Comparez les taux à l'aide de graphiques.",
  },
  es: {
    title: "Calculadora de Impuesto a la Plusvalía Inmobiliaria — 1, 2 y 3+ Propiedades (Corea)",
    description: "Calcula el impuesto coreano a la ganancia de capital inmobiliaria según el número de propiedades y el período de tenencia. Compara tramos con gráficos.",
  },
  zh: {
    title: "房地产资本利得税计算机 — 1户、2户、3户以上税金比较",
    description: "依2024年标准，按持有房屋数（1·2·3户）及持有期间自动计算房地产资本利得税，图表比较短期税率与累进税率。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "부동산 양도소득세 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 부동산 양도소득세를 설명과 함께 계산합니다. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전합니다.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "요건 충족 1세대 1주택은 12억원 이하 비과세 또는 초과분 과세를 봅니다."
    }, {
      title: "기준 2",
      body: "일반 최대 30%, 요건 충족 1주택 최대 80% 장기보유특별공제를 반영합니다."
    }, {
      title: "기준 3",
      body: "1년 미만 70%, 2년 미만 60% 단기 보유 세율을 우선 적용합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "고가주택, 다주택, 임대사업, 조정대상지역 규정은 연도별로 달라질 수 있습니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용입니다. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Real estate capital gains tax is country-specific",
    intro: "This page estimates real estate capital gains tax under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Qualifying one-house cases may be exempt up to KRW 1.2B or taxed only on the excess."
    }, {
      title: "Rule 2",
      body: "Long-term deduction can reach 30% generally and 80% for qualifying one-house cases."
    }, {
      title: "Rule 3",
      body: "Short-term rates are 70% under one year and 60% under two years."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "High-value homes, multi-home status, rentals, and regulated-area rules can change by year."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "不動産譲渡所得税は国ごとの制度確認が必要です",
    intro: "このページは韓国基準の不動産譲渡所得税を説明付きで試算します。税率や控除は国ごとに異なり毎年変わるため、申告前の参考値として扱ってください。",
    formulaTitle: "主な計算基準",
    formulas: [{
      title: "基準 1",
      body: "要件を満たす1住宅は12億ウォン以下非課税または超過分課税です。"
    }, {
      title: "基準 2",
      body: "一般最大30%、1住宅最大80%の長期控除です。"
    }, {
      title: "基準 3",
      body: "1年未満70%、2年未満60%です。"
    }],
    howToTitle: "使い方",
    steps: ["必要な金額と条件を入力します。", "税金・控除・社会保険の内訳を確認します。", "申告・納付・判断前に最新の公式基準と照合します。"],
    faqTitle: "よくある質問",
    faqs: [{
      question: "どの国の制度を基準にしていますか？",
      answer: "韓国の制度です。他国の税率、控除、社会保険にはそのまま使えません。"
    }, {
      question: "実際の金額と異なる理由は？",
      answer: "高額住宅、多住宅、賃貸、規制地域の規則は年度で変わります。"
    }, {
      question: "制度は毎年変わりますか？",
      answer: "はい。税率、控除限度、社会保険料率は毎年変わる可能性があります。申告や納付前に最新年度の基準を確認してください。"
    }],
    disclaimer: "この計算は一般的な概算です。実際の税額は税務当局または税理士に確認してください。"
  },
  zh: {
    introTitle: "房地产资本利得税必须先确认适用国家的制度",
    intro: "本页依韩国规则估算房地产资本利得税。税率、扣除与社会保险具有国别差异且可能逐年变动，结果应作为申报前的初步参考。",
    formulaTitle: "主要计算基准",
    formulas: [{
      title: "规则 1",
      body: "符合条件1户住宅12亿韩元以下免税或仅超过部分课税。"
    }, {
      title: "规则 2",
      body: "一般最高30%，符合条件1户最高80%长期扣除。"
    }, {
      title: "规则 3",
      body: "未满1年70%，未满2年60%。"
    }],
    howToTitle: "使用方法",
    steps: ["输入所需金额与条件。", "分别查看税金、扣除与社会保险明细。", "申报、缴纳或决策前请核对最新官方规定。"],
    faqTitle: "常见问题",
    faqs: [{
      question: "这个计算机采用哪个国家的规则？",
      answer: "采用韩国规则，不能直接套用其他国家的税率、扣除或社会保险制度。"
    }, {
      question: "为什么可能和实际金额不同？",
      answer: "高价住宅、多屋、出租与调整地区规则可能依年度改变。"
    }, {
      question: "规则每年都会变吗？",
      answer: "会。税率、扣除上限与社会保险费率都可能按年度调整。申报或缴纳前请确认当年度官方规定。"
    }],
    disclaimer: "本工具仅为一般估算。实际税额请向税务机关或税务专业人士确认。"
  },
  fr: {
    introTitle: "Plus-value immobilière dépend du pays concerné",
    intro: "Cette page estime la plus-value immobilière selon les règles de la Corée. Les tranches, déductions et cotisations sont propres au pays et peuvent changer chaque année; utilisez le résultat comme point de départ.",
    formulaTitle: "Bases de calcul",
    formulas: [{
      title: "Règle 1",
      body: "Logement unique qualifié: jusqu'à 1,2 Md KRW exonéré ou excédent taxé."
    }, {
      title: "Règle 2",
      body: "Déduction long terme jusqu’à 30% générale, 80% logement unique."
    }, {
      title: "Règle 3",
      body: "70% sous un an, 60% sous deux ans."
    }],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez les montants et conditions nécessaires.", "Vérifiez séparément impôts, déductions et cotisations.", "Comparez avec les règles officielles avant déclaration, paiement ou décision."],
    faqTitle: "Questions fréquentes",
    faqs: [{
      question: "Quel pays sert de référence ?",
      answer: "Il utilise les règles de la Corée. Ne l’appliquez pas directement à un autre système fiscal ou social."
    }, {
      question: "Pourquoi le montant réel peut-il différer ?",
      answer: "Biens de grande valeur, multipropriété, location et zones réglementées changent selon les années."
    }, {
      question: "Les règles changent-elles chaque année ?",
      answer: "Oui. Les taux, plafonds de déduction et cotisations peuvent changer chaque année. Vérifiez l'année en vigueur avant de déclarer ou payer."
    }],
    disclaimer: "Ce calcul est une estimation générale. Confirmez le montant auprès de l'administration fiscale ou d'un fiscaliste."
  },
  es: {
    introTitle: "Plusvalía inmobiliaria depende del país aplicado",
    intro: "Esta página estima la plusvalía inmobiliaria con reglas de Corea. Los tramos, deducciones y cotizaciones son propios de cada país y pueden cambiar cada año; úsalo como estimación inicial.",
    formulaTitle: "Bases de cálculo",
    formulas: [{
      title: "Regla 1",
      body: "Vivienda única cualificada: hasta 1.200 M KRW exento o exceso gravado."
    }, {
      title: "Regla 2",
      body: "Deducción largo plazo hasta 30% general y 80% vivienda única."
    }, {
      title: "Regla 3",
      body: "70% bajo un año, 60% bajo dos años."
    }],
    howToTitle: "Cómo usarla",
    steps: ["Introduce los importes y condiciones necesarios.", "Revisa por separado impuestos, deducciones y cotizaciones.", "Compáralo con reglas oficiales antes de declarar, pagar o tomar una decisión."],
    faqTitle: "Preguntas frecuentes",
    faqs: [{
      question: "¿Qué país usa esta calculadora?",
      answer: "Usa reglas de Corea. No lo apliques directamente a otro sistema fiscal o social."
    }, {
      question: "¿Por qué puede cambiar el importe final?",
      answer: "Alto valor, varias viviendas, alquiler y zonas reguladas pueden cambiar por año."
    }, {
      question: "¿Las reglas cambian cada año?",
      answer: "Sí. Los tipos, límites de deducción y cotizaciones pueden cambiar cada año. Comprueba la norma vigente antes de declarar o pagar."
    }],
    disclaimer: "Este cálculo es una estimación general. Confirma el importe con la autoridad fiscal o un profesional tributario."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <RealEstateCapitalGainsTaxCalc client:load locale={locale === "ko" ? "ko" : "en"} />
  

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
  </main>
</BaseLayout>
