---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTranslations, locales } from "../../../lib/i18n";
import { isOtherArticle, otherCategoryLabel, otherGroupOf, OTHER_COPY, OTHER_GROUPS } from "../../../lib/other-articles";
import { siteConfig } from "../../../config/site.config";
import { collectionPageJsonLd } from "../../../lib/seo/structured-data";

export async function getStaticPaths() {
  const all = await getCollection("blog", isOtherArticle);
  return locales.flatMap((lang) => OTHER_GROUPS.map((group) => ({
    params: { lang, group },
    props: {
      locale: lang,
      group,
      articles: all.filter((post) => post.data.locale === lang && otherGroupOf(post) === group),
    },
  })));
}

const { locale, group, articles } = Astro.props;
const copy = OTHER_COPY[locale] ?? OTHER_COPY.en;
const groupCopy = copy.groups[group as keyof typeof copy.groups];
const t = await getTranslations(locale);
const categoryNames = (t.category.names ?? {}) as Record<string, string>;
const byCategory = new Map<string, typeof articles>();
for (const post of articles) {
  const category = post.data.category ?? "Other";
  const list = byCategory.get(category) ?? [];
  list.push(post);
  byCategory.set(category, list);
}
const sections = [...byCategory.entries()].map(([category, list]) => ({
  category,
  label: otherCategoryLabel(locale, category, categoryNames[category] ?? category),
  articles: list.sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()),
})).sort((a, b) => b.articles.length - a.articles.length || a.label.localeCompare(b.label, locale));
const jsonLd = JSON.stringify(collectionPageJsonLd({
  name: `${groupCopy.title} — ${siteConfig.name}`,
  description: groupCopy.intro,
  url: `${siteConfig.url}/${locale}/other/${group}/`,
  inLanguage: locale,
  items: articles.map((post) => ({
    name: post.data.title,
    url: `${siteConfig.url}/${locale}/${post.slug.split("/").slice(1).join("/")}/`,
  })),
}));
---

<BaseLayout title={groupCopy.title} description={groupCopy.intro} availableLocales={[...locales]}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="container px-4 py-10 sm:py-14">
    <nav aria-label={copy.title} class="mb-5 text-sm">
      <a href={`/${locale}/other/`} class="text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">{copy.title}</a>
      <span aria-hidden="true" class="mx-2 text-muted-foreground">/</span>
      <span aria-current="page" class="text-muted-foreground">{groupCopy.title}</span>
    </nav>
    <header class="max-w-3xl border-b border-border pb-7">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{groupCopy.title}</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">{groupCopy.intro}</p>
      <p class="mt-3 text-sm tabular-nums text-muted-foreground">{articles.length}</p>
    </header>
    {sections.length ? (
      <div class="mt-8 space-y-10 sm:mt-10 sm:space-y-12">
        {sections.map(({ category, label, articles: list }) => (
          <section aria-labelledby={`cat-${category.replace(/[^a-z0-9]/gi, "-")}`}>
            <h2 id={`cat-${category.replace(/[^a-z0-9]/gi, "-")}`} class="border-b border-border pb-3 text-xl font-bold text-foreground">{label} <span class="ml-2 text-sm font-normal tabular-nums text-muted-foreground">{list.length}</span></h2>
            <ul class="mt-2 grid gap-x-8 sm:grid-cols-2">
              {list.map((post) => (
                <li class="border-b border-border/60">
                  <a href={`/${locale}/${post.slug.split("/").slice(1).join("/")}/`} class="block py-3 text-sm leading-snug text-foreground hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">{post.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : <p class="mt-8 text-sm text-muted-foreground">{copy.empty}</p>}
  </div>
</BaseLayout>
