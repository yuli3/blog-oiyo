---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import MonitorPpiCalculator from "../../components/tools/MonitorPpiCalculator";
import { monitorPpiCopy, type PpiLocale } from "../../data/monitor-ppi-copy";
import { locales } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map(lang => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: PpiLocale };
const t = monitorPpiCopy[locale];
---

<BaseLayout title={t.title} description={t.description} heading={t.title}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <p class="mb-2 text-xs font-semibold text-primary">{t.eyebrow}</p>
    <p class="mb-6 text-sm text-muted-foreground">{t.description}</p>
    <MonitorPpiCalculator client:visible locale={locale} />
    <section class="mt-8 space-y-6 rounded-2xl border border-border bg-card p-4 sm:p-6">
      <div>
        <h2 class="mb-2 text-lg font-semibold">{t.mathTitle}</h2>
        <p class="text-sm leading-relaxed">{t.math}</p>
        <p class="mt-3 rounded-lg border border-border bg-background p-4 text-sm">{t.example}</p>
        <p class="mt-3 text-sm text-muted-foreground">{t.note}</p>
      </div>
      <div>
        <h2 class="mb-2 text-lg font-semibold">{t.scalingTitle}</h2>
        <p class="text-sm leading-relaxed">{t.scaling}</p>
      </div>
      <div>
        <h2 class="mb-2 text-lg font-semibold">{t.sources}</h2>
        <ul class="list-disc space-y-2 pl-5 text-sm">
          <li><a class="text-primary underline" href="https://www.nist.gov/pml/owm/si-units-length">{t.nist}</a></li>
          <li><a class="text-primary underline" href="https://support.apple.com/guide/mac-help/change-your-displays-resolution-mchl86d72b76/mac">{t.apple}</a></li>
        </ul>
      </div>
    </section>
    <div class="mt-8">
      <RelatedToolLinks locale={locale} current="monitor-ppi-calculator" slugs={["aspect-ratio-calculator", "color-converter", "palette-extractor", "image-cropper", "image-metadata-viewer"]} />
    </div>
  </div>
</BaseLayout>
