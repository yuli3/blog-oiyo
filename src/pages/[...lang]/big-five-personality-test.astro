---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "빅파이브 성격",
  en: "Big Five personality",
  ja: "ビッグファイブ性格",
  fr: "personnalité Big Five",
  es: "personalidad Big Five",
  zh: "大五人格",
  cn: "大五人格",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/big5/test" kind="test" />
