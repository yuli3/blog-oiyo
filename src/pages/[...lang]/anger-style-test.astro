---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "분노 표현 스타일",
  "en": "Anger expression style",
  "ja": "怒りの表現スタイル",
  "fr": "style de colère",
  "es": "estilo de ira",
  "zh": "愤怒表达风格",
  "cn": "憤怒表達風格"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/anger-style/test" kind="test" />
