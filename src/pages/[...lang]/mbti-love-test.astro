---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MbtiLoveTestComp from "../../components/tests/MbtiLoveTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "MBTI 연애 유형 테스트 — 나의 사랑 방식은?",
    description: "12가지 연애 상황 질문으로 나의 MBTI 연애 유형을 알아보세요. 이상적인 파트너, 사랑의 언어, 연애 강점과 약점까지 분석해드립니다.",
  },
  en: {
    title: "MBTI Love Type Test — What's Your Love Style?",
    description: "Discover your MBTI love type through 12 relationship scenario questions. Find your ideal partner types, love languages, and relationship strengths.",
  },
  ja: {
    title: "MBTI 恋愛タイプテスト — あなたの愛し方は？",
    description: "12の恋愛シナリオで自分のMBTI恋愛タイプを発見。理想のパートナー、愛の言語、恋愛の強みと弱みを分析します。",
  },
  fr: {
    title: "Test de Type Amoureux MBTI — Quel est votre style d'amour?",
    description: "Découvrez votre type d'amour MBTI à travers 12 scénarios de relations. Trouvez vos types de partenaires idéaux et vos langages de l'amour.",
  },
  es: {
    title: "Test de Tipo de Amor MBTI — ¿Cuál es tu estilo de amor?",
    description: "Descubre tu tipo de amor MBTI con 12 preguntas sobre situaciones románticas. Encuentra tus tipos de pareja ideales y tus lenguajes del amor.",
  },
  zh: {
    title: "MBTI 恋爱类型测试 — 你的爱情方式是什么？",
    description: "透过12个恋爱情境问题发现你的MBTI恋爱类型。找到你的理想伴侣类型、爱的语言和恋爱优缺点。",
  },
  cn: {
    title: "MBTI 恋爱类型测试 — 你的爱情方式是什么？",
    description: "通过12个恋爱情境问题发现你的MBTI恋爱类型。找到你的理想伴侣类型、爱的语言和恋爱优缺点。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <MbtiLoveTestComp client:load locale={locale} />
  </main>
</BaseLayout>
