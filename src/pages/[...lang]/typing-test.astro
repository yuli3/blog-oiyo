---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TypingTest from "../../components/tools/TypingTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale & Locale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "타이핑 속도 테스트 — WPM 측정",
    description: "15초·30초·1분 모드로 타이핑 속도(WPM)와 정확도를 즉시 측정해보세요.",
  },
  en: {
    title: "Typing Speed Test — Measure Your WPM",
    description: "Test your typing speed and accuracy in 15s, 30s or 1-minute mode. Track WPM, accuracy, and errors in real time.",
  },
  ja: {
    title: "タイピング速度テスト — WPM測定",
    description: "15秒・30秒・1分モードでタイピング速度(WPM)と正確率を即時測定できます。",
  },
  fr: {
    title: "Test de vitesse de frappe — Mesurez votre WPM",
    description: "Testez votre vitesse et précision de frappe en mode 15s, 30s ou 1 minute. Suivi en temps réel.",
  },
  es: {
    title: "Test de velocidad de escritura — Mide tu PPM",
    description: "Prueba tu velocidad y precisión de escritura en modo 15s, 30s o 1 minuto. Seguimiento en tiempo real.",
  },
  zh: {
    title: "打字速度测试 — 测量你的WPM",
    description: "在15秒、30秒或1分钟模式下测试你的打字速度和准确率，实时追踪WPM。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "타이핑 속도는 빠르기와 정확도를 함께 봐야 합니다",
    intro: "WPM은 분당 입력한 단어 수를 뜻하지만, 실전 타이핑에서는 오타를 줄이는 능력도 똑같이 중요합니다. 이 테스트는 15초, 30초, 1분 모드로 현재 속도와 정확도를 빠르게 확인하게 해주며, 반복 측정으로 연습 방향을 잡는 데 적합합니다.",
    formulaTitle: "결과를 해석하는 기준",
    formulas: [
      { title: "WPM", body: "분당 단어 수는 속도를 보여주지만, 짧은 테스트에서는 문장 난이도와 집중도에 영향을 받습니다." },
      { title: "정확도", body: "높은 WPM이라도 오타가 많으면 실제 문서 작성 효율은 떨어질 수 있습니다." },
      { title: "시간 모드", body: "15초는 빠른 감각 확인, 1분은 더 안정적인 평균 확인에 적합합니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "15초, 30초, 1분 중 테스트 시간을 선택합니다.",
      "화면의 문장을 가능한 한 정확하게 입력합니다.",
      "WPM과 정확도를 함께 보고 다음 연습 목표를 정합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "좋은 WPM은 어느 정도인가요?", answer: "일반적인 문서 작업은 40~60 WPM이면 무난한 편이고, 숙련자는 70 WPM 이상도 가능합니다. 다만 정확도가 함께 중요합니다." },
      { question: "짧은 테스트와 1분 테스트 중 무엇이 좋나요?", answer: "짧은 테스트는 워밍업이나 빠른 확인에 좋고, 1분 테스트는 평균 실력을 보기 더 좋습니다." },
      { question: "속도를 올리려면 어떻게 해야 하나요?", answer: "오타를 먼저 줄이고, 자주 쓰는 단어와 문장 패턴을 반복 연습한 뒤 속도를 높이는 편이 안정적입니다." },
    ],
    disclaimer: "이 테스트는 연습용 속도 측정입니다. 채용, 자격, 공식 능력 증빙에는 기관이 요구하는 별도 기준을 확인하세요.",
  },
  en: {
    introTitle: "Typing speed only matters together with accuracy",
    intro: "WPM means words per minute, but useful typing also depends on avoiding errors. This test lets you check speed and accuracy in 15-second, 30-second, or 1-minute modes. Repeating the test over time is more meaningful than judging yourself from one run.",
    formulaTitle: "How to read the result",
    formulas: [
      { title: "WPM", body: "Words per minute shows speed, but short tests are affected by text difficulty and focus." },
      { title: "Accuracy", body: "High WPM with many errors may be less useful than slightly slower, cleaner typing." },
      { title: "Duration", body: "15 seconds is good for a quick check; 1 minute gives a more stable average." },
    ],
    howToTitle: "How to use",
    steps: [
      "Choose a 15-second, 30-second, or 1-minute test.",
      "Type the displayed text as accurately as you can.",
      "Review WPM and accuracy together, then set your next practice goal.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "What is a good WPM?", answer: "For everyday writing, 40-60 WPM is often comfortable, while experienced typists may exceed 70 WPM. Accuracy still matters." },
      { question: "Is a short test or 1-minute test better?", answer: "Short tests are useful for quick checks or warmups. A 1-minute test usually gives a more stable average." },
      { question: "How can I type faster?", answer: "Reduce errors first, practice common words and sentence patterns, then increase speed gradually." },
    ],
    disclaimer: "This test is for practice and informal measurement. For hiring, certification, or official proof, follow the standard required by the institution.",
  },
  ja: {
    introTitle: "タイピング速度は正確さと一緒に見る必要があります",
    intro: "WPMは1分あたりの単語数を表しますが、実用的なタイピングではミスを減らす力も重要です。このテストでは15秒、30秒、1分モードで速度と正確率を確認できます。一度の結果より、継続して測ることが練習に役立ちます。",
    formulaTitle: "結果の見方",
    formulas: [
      { title: "WPM", body: "速度を示す指標ですが、短いテストでは文章の難しさや集中力に左右されます。" },
      { title: "正確率", body: "WPMが高くてもミスが多いと、実際の作業効率は下がることがあります。" },
      { title: "時間モード", body: "15秒は素早い確認、1分はより安定した平均を見るのに向いています。" },
    ],
    howToTitle: "使い方",
    steps: [
      "15秒、30秒、1分の中から時間を選びます。",
      "表示された文章をできるだけ正確に入力します。",
      "WPMと正確率を合わせて確認し、次の練習目標を決めます。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "良いWPMはどのくらいですか？", answer: "日常的な文書作成では40〜60 WPM程度が目安で、慣れた人は70 WPMを超えることもあります。正確さも重要です。" },
      { question: "短いテストと1分テストはどちらがよいですか？", answer: "短いテストはウォームアップや簡単な確認に向き、1分テストは平均を見やすいです。" },
      { question: "速く打つには？", answer: "まずミスを減らし、よく使う単語や文のパターンを繰り返してから速度を上げると安定します。" },
    ],
    disclaimer: "このテストは練習用の速度測定です。採用、資格、公式証明には各機関の基準を確認してください。",
  },
  fr: {
    introTitle: "La vitesse de frappe doit être lue avec la précision",
    intro: "Le WPM indique le nombre de mots par minute, mais une frappe utile dépend aussi du nombre d'erreurs. Ce test mesure vitesse et précision en modes 15 secondes, 30 secondes ou 1 minute. Le suivi dans le temps vaut mieux qu'un seul résultat.",
    formulaTitle: "Lire le résultat",
    formulas: [
      { title: "WPM", body: "Il mesure la vitesse, mais les tests courts dépendent du texte et de la concentration." },
      { title: "Précision", body: "Un WPM élevé avec beaucoup d'erreurs peut être moins utile qu'une frappe un peu plus lente et propre." },
      { title: "Durée", body: "15 secondes conviennent à un contrôle rapide ; 1 minute donne une moyenne plus stable." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Choisissez 15 secondes, 30 secondes ou 1 minute.",
      "Tapez le texte affiché aussi précisément que possible.",
      "Comparez WPM et précision, puis fixez un objectif d'entraînement.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Quel WPM est considéré comme bon ?", answer: "Pour l'écriture courante, 40 à 60 WPM est souvent confortable ; des personnes entraînées dépassent 70 WPM. La précision reste essentielle." },
      { question: "Test court ou test d'une minute ?", answer: "Un test court est pratique pour s'échauffer. Une minute donne généralement une moyenne plus fiable." },
      { question: "Comment taper plus vite ?", answer: "Réduisez d'abord les erreurs, entraînez les mots fréquents et augmentez la vitesse progressivement." },
    ],
    disclaimer: "Ce test sert à l'entraînement et à la mesure informelle. Pour recrutement, certification ou preuve officielle, suivez le standard demandé.",
  },
  es: {
    introTitle: "La velocidad de escritura debe leerse junto con la precisión",
    intro: "WPM indica palabras por minuto, pero escribir bien también requiere evitar errores. Este test mide velocidad y precisión en modos de 15 segundos, 30 segundos o 1 minuto. Repetirlo con el tiempo es más útil que juzgarse por una sola ronda.",
    formulaTitle: "Cómo leer el resultado",
    formulas: [
      { title: "WPM", body: "Mide velocidad, pero en pruebas cortas influyen dificultad del texto y concentración." },
      { title: "Precisión", body: "Un WPM alto con muchos errores puede ser menos útil que una escritura algo más lenta y limpia." },
      { title: "Duración", body: "15 segundos sirve para una revisión rápida; 1 minuto ofrece un promedio más estable." },
    ],
    howToTitle: "Cómo usarlo",
    steps: [
      "Elige una prueba de 15 segundos, 30 segundos o 1 minuto.",
      "Escribe el texto mostrado con la mayor precisión posible.",
      "Revisa WPM y precisión juntos, y define tu siguiente objetivo de práctica.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Qué WPM es bueno?", answer: "Para escritura cotidiana, 40-60 WPM suele ser cómodo; personas con práctica pueden superar 70 WPM. La precisión sigue siendo clave." },
      { question: "¿Es mejor prueba corta o de 1 minuto?", answer: "Las pruebas cortas sirven para calentar o revisar rápido. Una de 1 minuto suele dar un promedio más estable." },
      { question: "¿Cómo puedo escribir más rápido?", answer: "Reduce errores primero, practica palabras y patrones frecuentes, y aumenta la velocidad de forma gradual." },
    ],
    disclaimer: "Este test es para práctica y medición informal. Para empleo, certificación o prueba oficial, sigue el estándar requerido por la institución.",
  },
  zh: {
    introTitle: "打字速度必须和准确率一起看",
    intro: "WPM 表示每分钟输入的单词数，但实用打字同样依赖低错误率。这个测试提供 15 秒、30 秒和 1 分钟模式，帮助你快速查看速度和准确率。持续记录比单次成绩更有参考价值。",
    formulaTitle: "如何理解结果",
    formulas: [
      { title: "WPM", body: "WPM 显示速度，但短测试会受到文本难度和注意力影响。" },
      { title: "准确率", body: "高 WPM 如果伴随大量错误，实际写作效率可能不如稍慢但更准确的输入。" },
      { title: "测试时长", body: "15 秒适合快速检查，1 分钟更适合观察稳定平均值。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "选择 15 秒、30 秒或 1 分钟测试。",
      "尽量准确地输入屏幕上的文本。",
      "同时查看 WPM 和准确率，并设定下一次练习目标。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "多少 WPM 算不错？", answer: "日常写作中 40-60 WPM 通常比较顺手，熟练者可能超过 70 WPM。但准确率同样重要。" },
      { question: "短测试和 1 分钟测试哪个好？", answer: "短测试适合热身或快速检查；1 分钟测试通常更能反映稳定平均水平。" },
      { question: "怎样提高速度？", answer: "先减少错误，再反复练习常见单词和句型，然后逐步提高速度。" },
    ],
    disclaimer: "本测试用于练习和非正式测量。招聘、认证或官方能力证明请以相关机构要求为准。",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <TypingTest client:load locale={locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
