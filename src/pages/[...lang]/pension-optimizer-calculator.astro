  ja: [
    { q: "iDeCoとNISA、どちらを優先すべきですか？", a: "所得税がかかっていて60歳まで使わないお金なら、所得控除のあるiDeCoから埋めるのが税金面では有利です。途中で使う可能性があるお金や、所得が低く節税効果が小さい場合はNISAを優先します。" },
    { q: "NISAの生涯枠1,800万円はどう数えますか？", a: "買付時の金額（簿価）で数え、うち成長投資枠は1,200万円までです。売却すると翌年に簿価分の枠が復活します。このツールは売却による枠の復活を考慮していません。" },
    { q: "iDeCoの節税額は毎年同じですか？", a: "所得や扶養の状況が変われば変わります。このツールは今の所得が続く前提で、年間の節税額に年数を掛けています。" },
    { q: "受取時の税金はどう計算していますか？", a: "積立期間を拠出年数として退職所得控除を計算し、一時金で一度に受け取る前提で所得税・住民税を出しています。会社の退職金と同じ時期に受け取る場合は控除が重なるため、税金が増えることがあります。" },
  ],
  zh: [
    { q: "收益率越高，个人养老金越划算吗？", a: "不一定。领取时余额（含收益）要按3%缴税，收益越高，这部分税也越多；但同样的收益在账户内免税滚存。净收益主要取决于缴费时的边际税率。" },
    { q: "边际税率3%的人还值得缴吗？", a: "单看税收没有净收益：缴费时少缴3%，领取时再交3%（还包括收益）。如果看重强制储蓄或特定产品，可以另作考虑。" },
    { q: "本测算假设了什么？", a: "假设每年收入和扣除不变、每年年末缴费、收益率固定，退休时一次性按3%计税。实际收益随产品而变。" },
  ],
  fr: [
    { q: "Le PER est-il toujours plus rentable qu'un placement hors PER ?", a: "Non. Il l'est surtout quand votre tranche marginale pendant la vie active est plus élevée qu'à la retraite. À tranche égale, l'avantage tient au différé d'impôt et peut être faible ; pour un foyer non imposable, il est négatif." },
    { q: "Quelles hypothèses utilise la projection ?", a: "Un versement en fin d'année, un rendement constant identique dans les deux enveloppes, une sortie en capital au barème 2026 et au PFU de 31,4 % sur les gains, et des économies d'impôt non réinvesties." },
    { q: "Puis-je dépasser le plafond de déduction ?", a: "Oui, mais l'excédent n'est pas déductible. Le simulateur le place hors PER. Les plafonds non utilisés des années précédentes peuvent être ajoutés." },
  ],
  es: [
    { q: "¿Cuándo compensa un plan de pensiones frente a un fondo?", a: "Cuando tu tipo marginal al aportar es claramente mayor que el que pagarás al rescatar. Si en la jubilación vas a estar en un tramo similar, el fondo suele ganar porque solo tributa la ganancia y a tipos del ahorro." },
    { q: "¿Qué supone la simulación?", a: "Aportaciones a final de año, rentabilidad constante igual en ambos productos, rescate del plan repartido en los años que indiques y venta del fondo de una vez. El ahorro de IRPF se suma sin reinvertirlo." },
    { q: "¿Puedo traspasar un fondo sin pagar impuestos?", a: "Sí, los traspasos entre fondos de inversión no tributan hasta que vendes. Los planes de pensiones también se pueden traspasar entre sí sin coste fiscal." },
  ],
};

const { content: c, faqHeading, faqItems } = buildToolShell(content, faqs, locale);
const sourcesHeading = { ko: "공식 출처", en: "Official sources", ja: "公式情報", zh: "官方来源", fr: "Sources officielles", es: "Fuentes oficiales" }[locale] ?? "Official sources";
const KR_SOURCES = {
  links: [
    { href: "https://www.nps.or.kr", label: "국민연금공단 — 예상연금액 조회·조기노령연금·연기연금" },
    { href: "https://www.law.go.kr", label: "국가법령정보센터 — 국민연금법" },
  ],
  note: "확인일 2026-09 · 감액·가산률과 개시 연령은 제도 개정으로 달라질 수 있습니다. 본인 예상액은 가입 이력으로 조회하세요.",
};
const LOCAL_SOURCES: Partial<Record<Locale, typeof KR_SOURCES>> = {
  ja: {
    links: [
      { href: "https://www.ideco-koushiki.jp/", label: "iDeCo公式サイト（国民年金基金連合会）— 拠出限度額・受取方法" },
      { href: "https://www.mhlw.go.jp/content/12500000/001620594.pdf", label: "厚生労働省 — iDeCoの概要と2026年12月からの拠出限度額" },
      { href: "https://www.fsa.go.jp/policy/nisa2/", label: "金融庁 — 新しいNISA" },
      { href: "https://www.nta.go.jp/taxes/shiraberu/taxanswer/shotoku/1420.htm", label: "国税庁 No.1420 退職金を受け取ったとき（退職所得）" },
    ],
    note: "確認日 2026-10-20 · 拠出限度額は2026年12月分から改正。利回りは仮定で、運用成果は保証されません。",
  },
  zh: {
    links: [
      { href: "https://fgk.chinatax.gov.cn/zcfgk/c102416/c5237110/content.html", label: "财政部 税务总局公告2024年第21号 — 在全国范围实施个人养老金个人所得税优惠政策" },
      { href: "https://www.mohrss.gov.cn/", label: "人力资源社会保障部 — 个人养老金" },
    ],
    note: "确认日期 2026-10-20 · 收益率为假设值，实际收益随所选产品变化。",
  },
  fr: {
    links: [
      { href: "https://www.service-public.gouv.fr/particuliers/vosdroits/F34982", label: "Service-public.fr — Plan d'épargne retraite (PER)" },
      { href: "https://www.impots.gouv.fr/", label: "impots.gouv.fr — Plafond épargne retraite sur l'avis d'impôt" },
    ],
    note: "Vérifié le 2026-10-20 · PASS 2025 47 100 €, PASS 2026 48 060 €, prélèvements sociaux 18,6 %. Rendement supposé, non garanti.",
  },
  es: {
    links: [
      { href: "https://sede.agenciatributaria.gob.es/Sede/ayuda/manuales-videos-folletos/manuales-practicos/irpf-2025/c13-determinacion-renta-contribuyente-sujeta-gravamen/reducciones-base-imponible-general/cuadro-resumen-reducciones-base-imponible-general.html", label: "Agencia Tributaria — Manual Renta 2025: reducciones por aportaciones a sistemas de previsión social" },
      { href: "https://www.boe.es/buscar/act.php?id=BOE-A-2006-20764", label: "BOE — Ley 35/2006 del IRPF (arts. 51 y 52)" },
    ],
    note: "Comprobado el 2026-10-20 · Límites de 2026 iguales a los del Manual de Renta 2025. Rentabilidad supuesta, no garantizada.",
  },
};
const sources = (country && LOCAL_SOURCES[locale]) || KR_SOURCES;
---

<BaseLayout title={m.title} description={m.description}>
  <ToolShell
    title={m.title}
    description={m.description}
    siteUrl={siteConfig.url}
    locale={locale}
    slug="pension-optimizer-calculator"
    content={c}
    applicationCategory="FinanceApplication"
  >
    <div class="mx-auto max-w-2xl">
      {country ? <PensionCountryCalculator client:load country={country} initialTab="plan" /> : <PensionOptimizerCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}
      <section class="mt-5 sm:mt-8 rounded-xl border border-border bg-card p-5 text-sm leading-6 text-slate-700">
        <h2 class="mb-2 text-base font-bold text-foreground">{sourcesHeading}</h2>
        <ul class="list-disc space-y-1 pl-5">
          {sources.links.map((l) => (<li><a class="underline" href={l.href} rel="noopener nofollow" target="_blank">{l.label}</a></li>))}
        </ul>
        <p class="mt-3 text-xs text-muted-foreground">{sources.note}</p>
      </section>
      <RelatedToolLinks locale={locale} current="pension-optimizer-calculator" slugs={["pension-calculator", "pension-tax-calculator", "early-repayment-calculator", "expense-ratio-calculator", "financial-investment-tax-calculator", "isa-vs-pension-calculator", "latte-factor-calculator", "overseas-stock-saver-calculator", "compound2-calculator", "macro-economics-calculator", "compound-interest-calculator", "roi-calculator"]} />
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
