---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InheritanceGiftTaxCalculator from "../../components/tools/InheritanceGiftTaxCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { INHERITANCE_GIFT_2026 } from "../../lib/kr-payroll-2026";

const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const IG = INHERITANCE_GIFT_2026;
const eok = (won: number) => (won >= 100_000_000 ? `${won / 100_000_000}억` : `${(won / 10_000).toLocaleString()}만`);
const marriageTotal = IG.giftDeductions.child_adult + IG.marriageBirthDeduction;
const rateRange = `${IG.brackets[0][1] * 100}~${IG.brackets[IG.brackets.length - 1][1] * 100}%`;

const title = "상속세·증여세 계산기 2026 — 공제 한도별 세액 추정과 혼인·출산 공제";
const description = `혼인·출산 증여재산공제(성년 자녀 최대 ${eok(marriageTotal)} 원), 상속 일괄공제 ${eok(IG.inheritanceLumpSum)} 원, 배우자상속공제(${eok(IG.spouseInheritanceMin)}~${eok(IG.spouseInheritanceMax)} 원)를 반영해 2026년 상속세와 증여세를 추정해요.`;

const ko = {
  eyebrow: "자산 승계와 세금",
  introTitle: "상속세와 증여세의 법정 공제를 비교해 세 부담을 미리 확인해요",
  intro: `상속세와 증여세는 같은 5단계 누진세율(${rateRange})을 쓰지만 공제 방식이 달라요. 상속세는 돌아가신 분의 전체 유산에 일괄공제(${eok(IG.inheritanceLumpSum)} 원)와 배우자상속공제(${eok(IG.spouseInheritanceMin)}~${eok(IG.spouseInheritanceMax)} 원)를 적용하는 유산세 방식이에요. 증여세는 받는 사람 기준으로 10년 합산 공제와 혼인·출산 공제(${eok(IG.marriageBirthDeduction)} 원)를 적용해요.`,
  howToTitle: "사용 방법",
  steps: [
    "위쪽 탭에서 '상속세 시뮬레이션' 또는 '증여세 시뮬레이션'을 골라요.",
    "상속세는 총 상속재산, 채무, 배우자 유무와 실제 상속액, 순금융재산을 넣어요.",
    "증여세는 받는 사람과의 관계(혼인·출산 공제, 성년 자녀, 배우자 등)와 증여가액을 넣어요.",
    `공제 후 과세표준, 누진세율, 신고세액공제 ${IG.filingCredit * 100}%를 반영한 납부세액을 확인해요.`,
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "혼인·출산 증여재산공제 반영", body: `직계존속에게서 혼인신고 전후 2년 또는 출생 후 2년 안에 받으면 기본 ${eok(IG.giftDeductions.child_adult)} 원에 ${eok(IG.marriageBirthDeduction)} 원을 더해 ${eok(marriageTotal)} 원까지 공제해요(상속세 및 증여세법 제53조의2, 평생 한도).` },
    { title: "일괄공제·배우자공제 계산", body: `일괄공제 ${eok(IG.inheritanceLumpSum)} 원과 배우자상속공제(최소 ${eok(IG.spouseInheritanceMin)} 원)를 적용해요. 배우자 법정상속분 한도는 반영하지 않아요.` },
    { title: "금융재산·장례비용 공제", body: `순금융재산 공제(최대 ${eok(IG.financialAsset.max)} 원)와 장례비용 공제(${eok(IG.funeral.min)}~${eok(IG.funeral.max)} 원)를 함께 계산해요.` },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/retirement-tax-calculator/", label: "퇴직소득세 계산기", desc: "근속연수 공제와 퇴직금 실수령액을 계산해요." },
    { href: "/ko/property-tax-calculator/", label: "부동산 재산세 계산기", desc: "공시가격 기준 재산세와 종부세를 계산해요." },
    { href: "/ko/global-income-tax-calculator/", label: "종합소득세 계산기", desc: "사업·금융·근로 종합소득세를 계산해요." },
  ],
  disclaimer: "상속세 및 증여세법의 기본 산식으로 만든 추정 계산기예요. 세대생략 할증(30~40%), 사전증여재산 10년(상속인 외 5년) 합산, 재산 평가, 배우자 법정상속분 한도 등은 반영하지 않아서 실제 신고세액과 다를 수 있어요. 신고 전에는 세무 전문가와 확인해 주세요.",
};

const faqs = [
  { q: "배우자가 있으면 최소 10억 원까지 상속세가 안 나오나요?", a: `배우자와 자녀가 함께 상속하면 일괄공제 ${eok(IG.inheritanceLumpSum)} 원과 배우자상속공제 최소 ${eok(IG.spouseInheritanceMin)} 원을 같이 받을 수 있어서, 채무 등을 뺀 순재산이 10억 원 이하라면 보통 낼 상속세가 없어요. 배우자 혼자 상속하면 일괄공제를 받지 못해요.` },
  { q: "혼인·출산 공제는 신랑·신부가 각각 받을 수 있나요?", a: `네. 신랑과 신부가 각자 자기 직계존속(부모·조부모)에게서 받는 증여에 대해 각각 최대 ${eok(marriageTotal)} 원(기본 ${eok(IG.giftDeductions.child_adult)} 원 + ${eok(IG.marriageBirthDeduction)} 원)까지 공제받을 수 있어서, 부부 합산 최대 ${eok(marriageTotal * 2)} 원이에요. 다른 10년 내 증여가 있으면 그만큼 기본공제가 줄어요.` },
  { q: "증여세 10년 합산은 무엇인가요?", a: "같은 사람(증여자가 직계존속이면 그 배우자 포함, 예: 아버지와 어머니)에게서 10년 안에 받은 증여 합계가 1,000만 원 이상이면 이번 증여와 합쳐서 누진세율을 적용해요." },
  { q: `신고세액공제 ${IG.filingCredit * 100}%는 언제 받나요?`, a: `상속세는 상속개시일이 속한 달의 말일부터 6개월 안에, 증여세는 증여일이 속한 달의 말일부터 3개월 안에 신고하면 산출세액의 ${IG.filingCredit * 100}%를 공제받아요.` },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="inheritance-gift-tax-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <InheritanceGiftTaxCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 상속세 및 증여세법 제19조·제21조·제22조·제26조·제53조·제53조의2·제69조. 2026년 기준 추정이에요.</p>
    </div>
    <div class="mt-12">
      <h2 class="text-xl font-bold tracking-tight mb-4">{faqHeading}</h2>
      <FaqAccordion items={faqItems} />
    </div>
  </ToolShell>
</BaseLayout>
