---
import { getCollection } from "astro:content";
import BlogList from "../../../../components/BlogList.astro";
import { getTranslations, locales } from "../../../../lib/i18n";
import { getTrack, getTrackFromData, slugifyCategory } from "../../../../lib/taxonomy";

export async function getStaticPaths() {
  const postsPerPage = 6;
  const paths = [];

  const allPosts = await getCollection(
    "blog",
    ({ data }) => data.draft !== true,
  );

  // per category-slug, per locale page counts — feeds the language switcher (#27)
  const pagesByCatLocale: Record<string, Record<string, number>> = {};
  for (const post of allPosts) {
    if (!post.data.category || !post.data.locale) continue;
    const cslug = slugifyCategory(post.data.category);
    pagesByCatLocale[cslug] ??= {};
    pagesByCatLocale[cslug][post.data.locale] = (pagesByCatLocale[cslug][post.data.locale] ?? 0) + 1;
  }
  for (const cslug of Object.keys(pagesByCatLocale)) {
    for (const l of Object.keys(pagesByCatLocale[cslug])) {
      pagesByCatLocale[cslug][l] = Math.ceil(pagesByCatLocale[cslug][l] / postsPerPage);
    }
  }

  for (const lang of locales) {
    const langPosts = allPosts.filter((post) => post.data.locale === lang);
    const categories = [
      ...new Set(
        langPosts
          .map((post) => post.data.category)
          .filter((cat): cat is string => !!cat),
      ),
    ];

    for (const category of categories) {
      if (!category) continue;

      const normalizedCategorySlug = slugifyCategory(category);

      const categoryPosts = langPosts.filter(
        (post) =>
          post.data.category && slugifyCategory(post.data.category) === normalizedCategorySlug,
      );

      categoryPosts.sort((a, b) => {
        const aMatch = a.slug.match(/-ch(\d+)$/);
        const bMatch = b.slug.match(/-ch(\d+)$/);
        if (aMatch && bMatch) {
          return parseInt(aMatch[1], 10) - parseInt(bMatch[1], 10);
        }
        return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
      });

      const totalPages = Math.ceil(categoryPosts.length / postsPerPage);

      // Only generate pages 2+; page 1 is handled by index.astro
      for (let p = 2; p <= totalPages; p++) {
        paths.push({
          params: { lang, category: normalizedCategorySlug, page: String(p) },
          props: {
            locale: lang,
            originalCategory: category,
            pageData: categoryPosts.slice(
              (p - 1) * postsPerPage,
              p * postsPerPage,
            ),
            currentPage: p,
            totalPages,
            availableLocales: locales.filter(
              (l) => (pagesByCatLocale[normalizedCategorySlug]?.[l] ?? 0) >= p,
            ),
          },
        });
      }
    }
  }

  return paths;
}

const { category } = Astro.params;
const { locale, originalCategory, pageData, currentPage, totalPages, availableLocales } =
  Astro.props;
const t = await getTranslations(locale);

const page = {
  data: pageData,
  currentPage,
  lastPage: totalPages,
};

const localePrefix = `/${locale}`;
const track = pageData[0] ? getTrackFromData(pageData[0].data) : getTrack(originalCategory);

const displayName = (t.category.names as Record<string, string>)?.[originalCategory] ?? originalCategory;
const displaySubtitle = track === "academy"
  ? t.category.academySubtitle.replace("{category}", displayName)
  : track === "interactive"
    ? (((t as Record<string, unknown>).interactive as Record<string, string> | undefined)?.categorySubtitle ?? "Interactive reading and embedded tools related to {category}.").replace("{category}", displayName)
    : t.category.magazineSubtitle.replace("{category}", displayName);
---

<BlogList
  page={page}
  locale={locale}
  baseUrl={`${localePrefix}/category/${category}`}
  title={displayName}
  subtitle={displaySubtitle}
  activeCategory={category}
  availableLocales={availableLocales}
/>
