    formulaTitle: "How it calculates",
    formulas: [
      { title: "Splitting your pay", body: "Plan A needs 50 · wants 30 · save 20; B 50 · 20 · 30; C 45 · 10 · 45. If essentials exceed the share, wants and savings shrink in proportion." },
      { title: "Emergency fund and goals", body: "Emergency fund = (needs + wants) × 6 months (3 in France and Spain). Goals compound monthly at your expected return." },
      { title: "Minimum wage", body: "Hourly minimum × monthly hours. Korea adds paid weekly rest from 15 hours a week; China and Spain use their statutory monthly amounts for full-time work." },
