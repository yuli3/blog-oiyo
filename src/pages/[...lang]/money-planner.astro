---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import LocalOnlyNote from "../../components/tools/LocalOnlyNote.astro";
import MoneyPlanner from "../../components/tools/MoneyPlanner";
import type { PlanCountry } from "../../lib/money-plan-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// Each locale opens on its own country (ko and en on South Korea); the planner lets anyone switch.
const COUNTRY_BY_LOCALE: Record<ActiveLocale, PlanCountry> = { ko: "kr", en: "kr", ja: "jp", zh: "cn", fr: "fr", es: "es" };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "월급 나누기·저축 플래너 — 시드머니 1,000만 원은 언제? 최저임금·최저생계비까지",
    description: "월 실수령액과 지출을 넣으면 A·B·C 세 가지 월급 나누기 안, 비상금과 100만·1,000만·5,000만 원 달성 시점, 청년미래적금·연금저축·IRP·ISA 배분, 최저임금과 최저생계비 비교, 증여세 줄이는 법을 보여 줍니다. 한국·일본·중국·프랑스·스페인 선택 가능.",
  },
  en: {
    title: "Paycheck Split & Savings Planner — When Will You Hit Your Savings Goals?",
    description: "Enter take-home pay and spending to get three ways to split your paycheck, emergency-fund and savings-goal timelines, tax-advantaged account order, minimum wage and minimum living cost checks for South Korea, Japan, China, France and Spain.",
  },
  ja: {
    title: "給料の分け方・貯蓄プランナー — 100万円はいつ貯まる？最低賃金・最低生活費も",
    description: "手取りと支出を入れると、給料の分け方A・B・C案、生活防衛資金と10万・100万・500万円の到達時期、iDeCo・NISAへの配分、令和8年度最低賃金と最低生活費の比較、贈与税を抑えるポイントがわかります。",
  },
  zh: {
    title: "工资分配与储蓄规划器 — 10万元存款需要多久？含最低工资与最低生活费",
    description: "输入到手收入和支出，查看A·B·C三种工资分配方案、应急资金和1万·10万·50万元的达成时间、个人养老金配置、上海最低工资与低保标准对比，以及赠与与遗产规划要点。",
  },
  fr: {
    title: "Planificateur de budget et d’épargne — Quand atteindrez-vous 10 000 € ?",
    description: "Saisissez votre salaire net et vos dépenses : trois façons de répartir votre salaire, délai pour l’épargne de précaution et pour 1 000 €, 10 000 € et 50 000 €, ordre Livret A, PER et PEA, comparaison avec le SMIC et le RSA, conseils de donation.",
  },
  es: {
    title: "Planificador de nómina y ahorro — ¿Cuándo llegarás a 10.000 €?",
    description: "Introduce tu sueldo neto y tus gastos: tres formas de repartir la nómina, plazo para el fondo de emergencia y para 1.000 €, 10.000 € y 50.000 €, plan de pensiones y fondos indexados, comparación con el SMI 2026 y el IMV, y claves de donaciones.",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "얼마를 모을 수 있는지는 필수지출에서 시작합니다",
    intro: "월급을 나누는 비율보다 먼저 봐야 할 것은 줄일 수 없는 돈, 곧 주거비·식비·공과금 같은 필수지출이에요. 이 플래너는 필수지출 합계를 내 최저생계비로 보고 생계급여 기준과 최저임금 월급에 견준 다음, 남는 돈을 지금 그대로·안정형·균형형·공격형 네 가지로 나눠 비상금과 목표 금액에 닿는 시점을 계산해요. 비상금을 채운 뒤에는 나이에 맞춰 청년미래적금, 연금저축, IRP, ISA 순서로 한도까지 채우는 배분을 보여 줘요.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "월급 나누기", body: "A안 필수 50·선택 30·저축 20, B안 50·20·30, C안 45·10·45. 필수지출이 비율보다 크면 선택지출과 저축을 같은 비율로 줄여요." },
      { title: "비상금과 목표", body: "비상금 = (필수 + 선택지출) × 6개월. 목표 금액까지는 매달 저축액을 넣고 기대 수익률로 월복리 계산해요." },
      { title: "최저임금", body: "2026년 시급 10,320원. 주 15시간 이상이면 주휴시간(최대 8시간)을 더해 월 환산(주 40시간 = 209시간, 2,156,880원)." },
      { title: "최저생계비", body: "2026년 생계급여 선정기준(기준중위소득 32%): 1인 820,556원, 4인 2,078,316원과 비교해요." },
    ],
