---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonaScopeTestComp from "../../components/tests/PersonaScopeTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "퍼스나스코프: 나의 빅 파이브 성격은?", description: "10개의 질문으로 개방성, 성실성, 외향성, 친화성, 신경증의 5가지 성격 요인 프로파일을 알아보세요." },
  en: { title: "PersonaScope: What's Your Big Five Personality Profile?", description: "Explore your personality profile across 5 factors — Openness, Conscientiousness, Extraversion, Agreeableness, and Neuroticism — with 10 questions." },
  ja: { title: "ペルソナスコープ：あなたのビッグファイブ性格は？", description: "10の質問で開放性・誠実性・外向性・協調性・神経症傾向の5因子性格プロファイルを診断します。" },
  fr: { title: "PersonaScope : Quel est votre profil de personnalité Big Five?", description: "Explorez votre profil de personnalité selon 5 facteurs — Ouverture, Conscienciosité, Extraversion, Agréabilité et Névrosisme — avec 10 questions." },
  es: { title: "PersonaScope: ¿Cuál es tu perfil de personalidad Big Five?", description: "Explora tu perfil de personalidad en 5 factores — Apertura, Responsabilidad, Extraversión, Amabilidad y Neuroticismo — con 10 preguntas." },
  zh: { title: "人格探索：你的大五人格特質是什麼？", description: "通過10個問題了解你在開放性、盡責性、外傾性、宜人性和神經質5個人格維度上的側寫。" },
  cn: { title: "人格探索：你的大五人格特质是什么？", description: "通过10个问题了解你在开放性、尽责性、外倾性、宜人性和神经质5个人格维度上的侧写。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <PersonaScopeTestComp client:load locale={locale} />
  </main>
</BaseLayout>
