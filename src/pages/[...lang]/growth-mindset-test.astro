---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GrowthMindsetTestComp from "../../components/tests/GrowthMindsetTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "성장 마인드셋 테스트 — 고정형인가, 성장형인가?", description: "캐럴 드웩의 마인드셋 이론 기반 10가지 질문으로 나의 마인드셋을 진단하고, 더 나은 성장을 위한 방향을 찾아보세요." },
  en: { title: "Growth Mindset Test — Fixed or Growth?", description: "Diagnose your mindset with 10 questions based on Carol Dweck's theory and find direction for greater growth." },
  ja: { title: "成長マインドセットテスト — 固定型か成長型か？", description: "キャロル・ドゥエックの理論に基づく10の質問でマインドセットを診断し、より良い成長への方向を見つけましょう。" },
  fr: { title: "Test de Mentalité de Croissance — Fixe ou de Croissance?", description: "Diagnostiquez votre mentalité avec 10 questions basées sur la théorie de Carol Dweck." },
  es: { title: "Test de Mentalidad de Crecimiento — ¿Fija o de Crecimiento?", description: "Diagnostica tu mentalidad con 10 preguntas basadas en la teoría de Carol Dweck." },
  zh: { title: "成長心態測試 — 固定型還是成長型？", description: "通過基於卡羅爾·德韋克理論的10個問題診斷你的心態。" },
  cn: { title: "成长心态测试 — 固定型还是成长型？", description: "通过基于卡罗尔·德韦克理论的10个问题诊断你的心态。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <GrowthMindsetTestComp client:load locale={locale} />
  </main>
</BaseLayout>
