---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MemoryCardGameComp from "../../components/games/MemoryCardGame";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "카드 짝 맞추기 — 기억력 훈련 메모리 게임",
    description: "이모지 카드 짝 맞추기 게임을 즐겨보세요. 4×4, 6×4, 6×6 크기 중 선택해 뒤집기 횟수와 시간을 단축하세요.",
  },
  en: {
    title: "Memory Card Matching Game",
    description: "Play the classic memory card matching game with emoji cards. Choose 4×4, 6×4, or 6×6 grids and train your memory.",
  },
  ja: {
    title: "カード合わせゲーム — 記憶力トレーニングメモリーゲーム",
    description: "絵文字カードの神経衰弱ゲームを楽しもう。4×4、6×4、6×6サイズから選んで記憶力を鍛えましょう。",
  },
  fr: {
    title: "Jeu de Mémoire — Memory Card Matching",
    description: "Jouez au jeu classique de mémoire avec des cartes emoji. Choisissez 4×4, 6×4 ou 6×6 et entraînez votre mémoire.",
  },
  es: {
    title: "Juego de Memoria — Emparejar Cartas",
    description: "Juega al clásico juego de memoria con cartas emoji. Elige entre 4×4, 6×4 o 6×6 y entrena tu memoria.",
  },
  zh: {
    title: "翻牌記憶遊戲 — 記憶力訓練",
    description: "享受表情符號翻牌配對遊戲。選擇4×4、6×4或6×6大小，鍛煉您的記憶力。",
  },
  cn: {
    title: "翻牌记忆游戏 — 记忆力训练",
    description: "享受表情符号翻牌配对游戏。选择4×4、6×4或6×6大小，锻炼您的记忆力。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <MemoryCardGameComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
  </main>
</BaseLayout>
