---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "혈액형 성격 분석",
  en: "blood type personality",
  ja: "血液型性格分析",
  fr: "personnalité par groupe sanguin",
  es: "personalidad por tipo de sangre",
  zh: "血型性格分析",
  cn: "血型性格分析",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/blood-type" kind="tool" />
