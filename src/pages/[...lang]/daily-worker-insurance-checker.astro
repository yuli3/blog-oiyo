---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DailyWorkerInsuranceChecker from "../../components/tools/DailyWorkerInsuranceChecker";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { RATES, RATES_AS_OF } from "../../lib/kr-payroll-2026";

// Korean only (2026-10-12): item 2 of the tax-practice toolkit plan. Built from the tax office
// notes on day-worker pay tables ("월 7일·60시간 미만") and the 근로내용확인신고 deadline.
const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "일용직·알바 4대보험 판정기 — 한 달 8일·60시간 기준 확인";
const description = "한 달 근무일수와 근무시간, 일당을 넣으면 국민연금·건강보험·고용보험·산재보험 가입 여부와 근로자 부담액, 일용근로 원천세를 계산합니다. 2026년 요율 기준.";
const pct = (n: number) => `${Number((n * 100).toFixed(3))}%`;

const ko = {
  eyebrow: "인건비 도구",
  introTitle: "일용직도 4대보험에 가입하나요?",
  intro: "고용보험과 산재보험은 하루만 일한 일용근로자에게도 적용됩니다. 판단이 갈리는 것은 국민연금과 건강보험입니다. 같은 사업장에서 1개월 이상 일하면서 한 달 8일 이상 또는 60시간 이상 일하면 두 보험 모두 가입 대상이 되고, 국민연금은 월 소득이 220만 원 이상이어도 가입합니다. 세무사무소에서 일용직 급여를 처리할 때 가장 먼저 확인하는 것도 이 기준이라서, 근무표를 받으면 한 달 7일·60시간 미만인지부터 봅니다. 이 판정기는 근무일수·시간·일당으로 각 보험의 가입 여부와 이유, 근로자 부담 예상액, 일당에서 떼는 원천세까지 한 번에 보여 줍니다.",
  howToTitle: "사용 방법",
  steps: [
    "\"이번 달 7일 56시간 일당 12만원\"처럼 한 줄로 적거나 예시를 누릅니다.",
    "근무일수·근무시간·일당과 1개월 이상 근무 여부를 확인합니다.",
    "보험별 가입 여부와 이유, 근로자 부담액, 원천세를 확인합니다.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "보험별 이유", body: "가입·미가입을 일수·시간·소득 기준 중 무엇 때문인지 문장으로 알려 줍니다." },
    { title: "2026 요율", body: `국민연금 ${pct(RATES.pensionEmployee)}, 건강보험 ${pct(RATES.healthEmployee)}, 장기요양 건강보험료의 ${pct(RATES.longTermCareOfHealth)}, 고용보험 ${pct(RATES.employmentEmployee)}(근로자분).` },
    { title: "원천세까지", body: "일당 15만 원 공제, 6% 세율, 55% 세액공제, 1천 원 미만 소액부징수를 반영합니다." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/weekly-holiday-pay-calculator/", label: "주휴수당 계산기", desc: "주 15시간 이상이면 주휴수당을 계산합니다." },
    { href: "/ko/salary-calculator/", label: "연봉 실수령액 계산기", desc: "상용직 월급의 4대보험·소득세를 계산합니다." },
    { href: "/ko/freelancer-tax-calculator/", label: "프리랜서 3.3% 계산기", desc: "사업소득 원천징수를 계산합니다." },
  ],
  disclaimer: `참고용 판정입니다. 건설업 일용근로자, 65세 이후 신규 고용, 외국인, 여러 사업장 합산 등은 기준이 다릅니다. 보험료는 지급액 × 요율의 단순 추정이며 기준소득월액 상·하한을 반영하지 않았습니다. 정확한 판단은 국민연금공단(1355)·건강보험공단(1577-1000)·근로복지공단(1588-0075)에 확인하세요. 기준일 ${RATES_AS_OF}.`,
};

const faqs = [
  { q: "알바를 한 달에 7일만 쓰면 4대보험을 안 들어도 되나요?", a: "국민연금·건강보험은 한 달 8일 미만이고 60시간 미만이며 월 소득이 220만 원 미만이면 가입하지 않습니다. 고용보험·산재보험은 일수와 관계없이 적용되므로 근로내용확인신고는 해야 합니다." },
  { q: "근로내용확인신고는 언제 하나요?", a: "일용근로자를 쓴 달의 다음 달 15일까지 근로복지공단에 냅니다. 이 신고를 하면 일용근로소득 지급명세서를 따로 내지 않아도 되는 경우가 있으니 세무대리인과 확인하세요." },
  { q: "일당 15만 원이면 세금이 없나요?", a: "일용근로소득은 하루 15만 원을 공제한 뒤 6%를 곱하고 55%를 세액공제합니다. 하루 15만 원까지는 세금이 0원이고, 계산한 세액이 1천 원 미만이면 떼지 않으므로 일당 18만 7천 원까지는 원천세가 없습니다." },
  { q: "1개월 미만으로 일하면 건강보험은 안 되나요?", a: "1개월 미만 근로하는 일용근로자는 건강보험 직장가입 대상에서 빠집니다. 다만 처음부터 1개월 이상 일하기로 했다면 첫 달부터 따집니다." },
  { q: "주 15시간 넘게 일하면 달라지나요?", a: "주 15시간 이상이면 주휴수당과 퇴직금(1년 이상) 요건에 영향을 줍니다. 4대보험 판단은 한 달 60시간(주 15시간 정도)과 8일 기준을 봅니다." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="daily-worker-insurance-checker" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <DailyWorkerInsuranceChecker client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 국민연금법 시행령 제2조, 국민건강보험법 시행령 제9조, 고용보험법 시행령 제3조, 소득세법 제47조·제59조(일용근로소득), 2026년 보험료율. 기준일 {RATES_AS_OF}.</p>
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
