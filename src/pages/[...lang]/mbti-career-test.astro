---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "MBTI 직업 적성",
  en: "MBTI career",
  ja: "MBTI 職業適性",
  fr: "carrière MBTI",
  es: "carrera MBTI",
  zh: "MBTI 职业适性",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/mbti/career" kind="test" />
