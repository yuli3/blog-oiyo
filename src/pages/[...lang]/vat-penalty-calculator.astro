---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VatPenaltyCalculator from "../../components/tools/VatPenaltyCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { VAT_RATES_AS_OF, vatPenalty } from "../../lib/kr-vat-2026";

// Korean only (2026-10-12): Korean VAT tool from the tax-practice toolkit plan
// (company-brain projects/oiyo-ecosystem/tax-practice-toolkit-plan-2026-10-12.md, item 3).
const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "부가세 가산세 계산기 2026 — 기한후신고·수정신고 감면, 세금계산서 가산세";
const description = "부가세를 늦게 신고하거나 적게 냈을 때, 세금계산서를 늦게·종이로 발급했을 때 붙는 가산세와 감면을 계산합니다. 무신고 20%, 과소신고 10%, 납부지연 1일 0.022%.";

const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const sample = vatPenalty({ filing: "late", tax: 3_000_000, fraud: false, deadline: "2026-07-27", filed: "2026-08-10", invoice: "none", supply: 0 });

const ko = {
  eyebrow: "세무 실무 도구",
  introTitle: "부가세를 늦게 내면 가산세는 얼마인가요?",
  intro: `부가세 신고를 기한 안에 하지 못하면 무신고가산세(납부세액의 20%)와 납부지연가산세(하루 0.022%)가 붙습니다. 다만 기한 후 1개월 안에 신고하면 무신고가산세의 50%를 깎아 줍니다. 예를 들어 1기 확정신고(2026년은 7월 25일이 토요일이라 7월 27일까지)를 놓치고 8월 10일에 300만 원을 신고·납부하면 무신고가산세 30만 원과 납부지연가산세 9,240원, 합계 ${won(sample.total)}입니다. 세금계산서를 늦게 발급하거나 종이로 발급해도 공급가액의 1%가 붙습니다. 상황을 한 줄로 적으면 칸이 채워지고, 항목별 금액과 감면을 단계별로 보여 줍니다.`,
  howToTitle: "사용 방법",
  steps: [
    "맨 위 칸에 \"1기 확정 기한후신고 세액 300만원 8월 10일 신고\"처럼 적거나 예시를 누릅니다.",
    "신고 상황, 더 낼 세액, 법정기한과 실제 신고일을 확인하고 필요하면 고칩니다.",
    "세금계산서 문제가 있었다면 종류와 공급가액을 고릅니다. 항목별 가산세와 감면이 바로 나옵니다.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "감면 자동 적용", body: "기한후신고 1·3·6개월, 수정신고 1개월~2년 구간을 날짜로 판단합니다." },
    { title: "세금계산서 가산세", body: "미발급 2%, 지연발급·종이발급 1%, 지연전송 0.3%, 미전송 0.5%." },
    { title: "입력은 브라우저 안에만", body: "한 줄 입력은 규칙으로 읽고, 저장하거나 보내지 않습니다." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/vat-calculator/", label: "부가세 계산기", desc: "공급가액·부가세·합계를 서로 바꿔 계산합니다." },
    { href: "/ko/deemed-rent-vat-calculator/", label: "간주임대료 계산기", desc: "상가 보증금에 붙는 부가세를 계산합니다." },
    { href: "/ko/tax-calendar/", label: "세무 캘린더", desc: "부가세·원천세 신고기한을 달력으로 봅니다." },
  ],
  disclaimer: `일반적인 계산을 돕는 참고 도구입니다. 세무서가 경정할 것을 알고 신고한 경우의 감면 배제, 영세율 과세표준 가산세, 합계표 가산세와의 중복 배제, 가산세 한도 등은 반영하지 않았습니다. 정확한 금액은 홈택스 신고 화면이나 세무 전문가에게 확인하세요. 기준일 ${VAT_RATES_AS_OF}.`,
};

const faqs = [
  { q: "기한후신고와 수정신고는 무엇이 다른가요?", a: "기한후신고는 법정기한까지 신고를 아예 하지 않았을 때, 수정신고는 기한 안에 신고했지만 세액을 적게 신고했을 때 합니다. 기한후신고는 무신고가산세(20%)에 6개월 이내까지, 수정신고는 과소신고가산세(10%)에 2년 이내까지 감면이 있습니다(국세기본법 제48조 제2항)." },
  { q: "납부지연가산세도 감면되나요?", a: "아니요. 납부지연가산세는 늦게 낸 날수만큼 하루 0.022%씩 붙고 기한후·수정신고 감면이 없습니다. 하루라도 빨리 내는 것이 유일한 방법입니다." },
  { q: "환급받을 세액이면 가산세가 없나요?", a: "환급세액을 실제보다 많이 신고했다면 과소신고와 같이 초과환급신고가산세(10%)와 환급불성실가산세가 붙습니다. 이 계산기의 '더 내야 하는 세액'에 차이 금액을 넣어 대략 확인할 수 있습니다." },
  { q: "세금계산서 가산세는 여러 개가 같이 붙나요?", a: "같은 공급분에는 가장 무거운 하나만 붙습니다. 예를 들어 미발급 가산세가 붙으면 매출처별 세금계산서합계표 관련 가산세는 따로 붙지 않습니다(부가가치세법 제60조 제6항 등)." },
  { q: "신고기한이 주말이면 어떻게 되나요?", a: "기한이 토요일·일요일·공휴일이면 그다음 날이 기한입니다(국세기본법 제5조). 2026년 1기 확정신고는 7월 25일이 토요일이라 7월 27일까지입니다." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="vat-penalty-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <VatPenaltyCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 국세기본법 제47조의2(무신고), 제47조의3(과소신고), 제47조의4(납부지연), 제48조 제2항(감면), 부가가치세법 제60조(세금계산서 등 가산세). 기준일 {VAT_RATES_AS_OF}.</p>
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
