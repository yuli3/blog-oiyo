---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "나르시시즘",
  "en": "Narcissism",
  "ja": "ナルシシズム",
  "fr": "narcissisme",
  "es": "narcisismo",
  "zh": "自恋倾向",
  "cn": "自戀傾向"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/narcissism/test" kind="test" />
