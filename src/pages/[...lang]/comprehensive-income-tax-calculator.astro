---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import ComprehensiveIncomeTaxCalc from "../../components/tools/ComprehensiveIncomeTaxCalc";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "종합소득세 계산기 — 사업·금융·근로소득 세금 비교",
    description: "2024년 기준 종합소득세를 사업소득·금융소득·근로소득별로 계산하고 분리과세와 비교합니다. 누진세율과 세율 구간을 차트로 확인하세요.",
  },
  en: {
    title: "Comprehensive Income Tax Calculator — Compare Business, Investment & Employment Income",
    description: "Calculate Korean comprehensive income tax for 2024 across business, financial, and employment income. Visualize progressive brackets and compare with separate taxation.",
  },
  ja: {
    title: "総合所得税計算機 — 事業・金融・勤労所得の税金比較",
    description: "2024年基準で事業所得・金融所得・勤労所得の総合所得税を計算し、分離課税と比較します。累進税率をグラフで確認。",
  },
  fr: {
    title: "Calculateur d'Impôt Global sur le Revenu — Comparaison des Sources de Revenus",
    description: "Calculez l'impôt global coréen sur le revenu pour 2024 selon les revenus d'activité, financiers et salariaux. Visualisez les tranches progressives.",
  },
  es: {
    title: "Calculadora de Impuesto Global sobre la Renta — Comparación de Fuentes de Ingreso",
    description: "Calcula el impuesto global coreano sobre la renta para 2024 por ingresos de negocio, financieros y laborales. Visualiza los tramos progresivos.",
  },
  zh: {
    title: "综合所得税计算机 — 比较事业、金融与劳动所得税",
    description: "依2024年标准计算事业所得、金融所得与勤劳所得的综合所得税，并与分离课税比较，图表显示累进税率。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "종합소득세 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 종합소득세를 설명과 함께 계산합니다. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전합니다.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "근로·사업·금융·기타소득을 하나의 과세표준으로 합산합니다."
    }, {
      title: "기준 2",
      body: "1,400만원 이하 6%에서 10억원 초과 45%까지 누진세율을 적용합니다."
    }, {
      title: "기준 3",
      body: "근로소득공제, 본인 기본공제 150만원, 지방소득세 10%를 반영합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "부양가족, 특별공제, 세액공제, 실제 필요경비가 반영되지 않으면 결과가 달라집니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용입니다. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Comprehensive income tax is country-specific",
    intro: "This page estimates comprehensive income tax under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Combines employment, business, financial, and other income into one taxable base."
    }, {
      title: "Rule 2",
      body: "Uses progressive rates from 6% to 45%."
    }, {
      title: "Rule 3",
      body: "Reflects employment deduction, KRW 1.5M basic deduction, and 10% local income tax."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Dependents, special deductions, credits, and actual expenses can materially change the result."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "総合所得税は国ごとの制度確認が必要です",
    intro: "このページは韓国基準の総合所得税を説明付きで試算します。税率や控除は国ごとに異なり毎年変わるため、申告前の参考値として扱ってください。",
    formulaTitle: "主な計算基準",
    formulas: [{
      title: "基準 1",
      body: "勤労・事業・金融・その他所得を一つの課税標準に合算します。"
    }, {
      title: "基準 2",
      body: "6%から45%まで累進税率を適用します。"
    }, {
      title: "基準 3",
      body: "給与所得控除、150万ウォン基本控除、地方所得税10%を反映します。"
    }],
    howToTitle: "使い方",
    steps: ["必要な金額と条件を入力します。", "税金・控除・社会保険の内訳を確認します。", "申告・納付・判断前に最新の公式基準と照合します。"],
    faqTitle: "よくある質問",
    faqs: [{
      question: "どの国の制度を基準にしていますか？",
      answer: "韓国の制度です。他国の税率、控除、社会保険にはそのまま使えません。"
    }, {
      question: "実際の金額と異なる理由は？",
      answer: "扶養、特別控除、税額控除、実際経費で変わります。"
    }, {
      question: "制度は毎年変わりますか？",
      answer: "はい。税率、控除限度、社会保険料率は毎年変わる可能性があります。申告や納付前に最新年度の基準を確認してください。"
    }],
    disclaimer: "この計算は一般的な概算です。実際の税額は税務当局または税理士に確認してください。"
  },
  zh: {
    introTitle: "综合所得税必须先确认适用国家的制度",
    intro: "本页依韩国规则估算综合所得税。税率、扣除与社会保险具有国别差异且可能逐年变动，结果应作为申报前的初步参考。",
    formulaTitle: "主要计算基准",
    formulas: [{
      title: "规则 1",
      body: "合并薪资、事业、金融与其他所得为同一课税基础。"
    }, {
      title: "规则 2",
      body: "使用6%至45%累进税率。"
    }, {
      title: "规则 3",
      body: "反映薪资扣除、150万韩元基本扣除与10%地方所得税。"
    }],
    howToTitle: "使用方法",
    steps: ["输入所需金额与条件。", "分别查看税金、扣除与社会保险明细。", "申报、缴纳或决策前请核对最新官方规定。"],
    faqTitle: "常见问题",
    faqs: [{
      question: "这个计算机采用哪个国家的规则？",
      answer: "采用韩国规则，不能直接套用其他国家的税率、扣除或社会保险制度。"
    }, {
      question: "为什么可能和实际金额不同？",
      answer: "扶养、特别扣除、抵免与实际费用会改变结果。"
    }, {
      question: "规则每年都会变吗？",
      answer: "会。税率、扣除上限与社会保险费率都可能按年度调整。申报或缴纳前请确认当年度官方规定。"
    }],
    disclaimer: "本工具仅为一般估算。实际税额请向税务机关或税务专业人士确认。"
  },
  fr: {
    introTitle: "Impôt global sur le revenu dépend du pays concerné",
    intro: "Cette page estime l'impôt global sur le revenu selon les règles de la Corée. Les tranches, déductions et cotisations sont propres au pays et peuvent changer chaque année; utilisez le résultat comme point de départ.",
    formulaTitle: "Bases de calcul",
    formulas: [{
      title: "Règle 1",
      body: "Regroupe salaires, revenus professionnels, financiers et divers."
    }, {
      title: "Règle 2",
      body: "Utilise des taux progressifs de 6% à 45%."
    }, {
      title: "Règle 3",
      body: "Reflète déduction salariale, 1,5 M KRW de base et 10% de taxe locale."
    }],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez les montants et conditions nécessaires.", "Vérifiez séparément impôts, déductions et cotisations.", "Comparez avec les règles officielles avant déclaration, paiement ou décision."],
    faqTitle: "Questions fréquentes",
    faqs: [{
      question: "Quel pays sert de référence ?",
      answer: "Il utilise les règles de la Corée. Ne l’appliquez pas directement à un autre système fiscal ou social."
    }, {
      question: "Pourquoi le montant réel peut-il différer ?",
      answer: "Personnes à charge, déductions, crédits et frais réels peuvent changer le résultat."
    }, {
      question: "Les règles changent-elles chaque année ?",
      answer: "Oui. Les taux, plafonds de déduction et cotisations peuvent changer chaque année. Vérifiez l'année en vigueur avant de déclarer ou payer."
    }],
    disclaimer: "Ce calcul est une estimation générale. Confirmez le montant auprès de l'administration fiscale ou d'un fiscaliste."
  },
  es: {
    introTitle: "Impuesto global sobre la renta depende del país aplicado",
    intro: "Esta página estima el impuesto global sobre la renta con reglas de Corea. Los tramos, deducciones y cotizaciones son propios de cada país y pueden cambiar cada año; úsalo como estimación inicial.",
    formulaTitle: "Bases de cálculo",
    formulas: [{
      title: "Regla 1",
      body: "Agrupa empleo, negocio, rentas financieras y otras."
    }, {
      title: "Regla 2",
      body: "Usa tipos progresivos del 6% al 45%."
    }, {
      title: "Regla 3",
      body: "Refleja deducción laboral, 1,5 M KRW básica e impuesto local 10%."
    }],
    howToTitle: "Cómo usarla",
    steps: ["Introduce los importes y condiciones necesarios.", "Revisa por separado impuestos, deducciones y cotizaciones.", "Compáralo con reglas oficiales antes de declarar, pagar o tomar una decisión."],
    faqTitle: "Preguntas frecuentes",
    faqs: [{
      question: "¿Qué país usa esta calculadora?",
      answer: "Usa reglas de Corea. No lo apliques directamente a otro sistema fiscal o social."
    }, {
      question: "¿Por qué puede cambiar el importe final?",
      answer: "Dependientes, deducciones, créditos y gastos reales pueden cambiar el resultado."
    }, {
      question: "¿Las reglas cambian cada año?",
      answer: "Sí. Los tipos, límites de deducción y cotizaciones pueden cambiar cada año. Comprueba la norma vigente antes de declarar o pagar."
    }],
    disclaimer: "Este cálculo es una estimación general. Confirma el importe con la autoridad fiscal o un profesional tributario."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-8">
    <ComprehensiveIncomeTaxCalc client:load locale={locale === "ko" ? "ko" : "en"} />
  

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="comprehensive-income-tax-calculator" slugs={["comprehensive-income-tax-calculator", "global-income-tax-calculator", "gift-tax-calculator", "inheritance-tax-calculator", "property-tax-calculator", "year-end-settlement-calculator", "severance-calculator", "freelancer-tax-calculator"]} />
  </div>
</BaseLayout>
