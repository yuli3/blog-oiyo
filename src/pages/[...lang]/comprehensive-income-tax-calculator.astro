---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import ComprehensiveIncomeTaxCalc from "../../components/tools/ComprehensiveIncomeTaxCalc";
import ComprehensiveIncomeTaxCountryCalculator from "../../components/tools/ComprehensiveIncomeTaxCountryCalculator";
import type { IncomeTaxCountry } from "../../lib/comprehensive-income-tax-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, IncomeTaxCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "종합소득세 계산기 — 사업·금융·근로소득 세금 비교",
    description: "2024년 기준 종합소득세를 사업소득·금융소득·근로소득별로 계산하고 분리과세와 비교합니다. 누진세율과 세율 구간을 차트로 확인하세요.",
  },
  en: {
    title: "Comprehensive Income Tax Calculator (South Korea) — Compare Business, Investment & Employment Income",
    description: "Calculate Korean comprehensive income tax for 2024 across business, financial, and employment income. Visualize progressive brackets and compare with separate taxation.",
  },
  ja: {
    title: "確定申告 所得税・住民税シミュレーター（令和8年分）— 給与＋事業所得",
    description: "給与と事業所得・副業の所得を合算して、令和8年分の所得税・復興特別所得税と翌年度の住民税を計算します。青色申告特別控除（65万・55万・10万円）、基礎控除104万円の特例、源泉徴収税額との差額に対応。",
  },
  fr: {
    title: "Simulateur d'impôt sur le revenu 2026 — salaires, micro-entreprise et autres revenus",
    description: "Calculez l'impôt sur le revenu du foyer au barème 2026 en additionnant salaires (abattement 10 %), revenus de micro-entreprise (abattement 34 %, 50 % ou 71 %) et autres revenus, avec quotient familial, plafonnement et décote.",
  },
  es: {
    title: "Calculadora del IRPF 2026 — trabajo, actividades económicas y alquileres",
    description: "Calcula la cuota del IRPF de la base general sumando rendimientos del trabajo, de actividades económicas y de alquileres con la escala 2026, el mínimo personal y familiar y la reducción por rendimientos del trabajo.",
  },
  zh: {
    title: "个人所得税综合所得计算器 — 工资、劳务报酬、稿酬、特许权使用费",
    description: "把工资薪金、劳务报酬、稿酬和特许权使用费合并为综合所得，按年度税率表3%–45%计算全年个人所得税，并与已预缴税额比较得出年度汇算应补或应退税额。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "종합소득세 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 종합소득세를 설명과 함께 계산해요. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전해요.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "근로·사업·금융·기타소득을 하나의 과세표준으로 합산합니다."
    }, {
      title: "기준 2",
      body: "1,400만원 이하 6%에서 10억원 초과 45%까지 누진세율을 적용합니다."
    }, {
      title: "기준 3",
      body: "근로소득공제, 본인 기본공제 150만원, 지방소득세 10%를 반영합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "부양가족, 특별공제, 세액공제, 실제 필요경비가 반영되지 않으면 결과가 달라집니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용이에요. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Comprehensive income tax is country-specific",
    intro: "This page estimates comprehensive income tax under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Combines employment, business, financial, and other income into one taxable base."
    }, {
      title: "Rule 2",
      body: "Uses progressive rates from 6% to 45%."
    }, {
      title: "Rule 3",
      body: "Reflects employment deduction, KRW 1.5M basic deduction, and 10% local income tax."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Dependents, special deductions, credits, and actual expenses can materially change the result."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "給与以外の所得があれば、確定申告ですべての所得を合算して税額を計算します",
    intro: "日本の所得税は、給与所得・事業所得・不動産所得・雑所得などを合計した「合計所得金額」から所得控除を引き、超過累進税率5%〜45%をかける総合課税です。会社員でも副業の所得が20万円を超えれば確定申告が必要で、個人事業主は青色申告で最大65万円の特別控除を受けられます。所得税には2.1%の復興特別所得税が加わり、同じ所得をもとに翌年度の住民税（所得割10%＋均等割）も決まります。",
    formulaTitle: "計算基準",
    formulas: [
      {
        title: "合計所得金額",
        body: "給与所得（収入 − 給与所得控除、最低74万円）＋ 事業所得（売上 − 経費 − 青色申告特別控除）＋ その他の所得。事業の赤字は給与所得と損益通算"
      },
      {
        title: "所得税",
        body: "（合計所得 − 社会保険料 − 基礎控除 − 配偶者・扶養控除 − その他の所得控除）× 5%〜45% − 控除額。これに102.1%をかけ、源泉徴収税額・予定納税額を引いて納付・還付"
      },
      {
        title: "住民税",
        body: "所得割 10%（基礎控除43万円など住民税の控除で計算、調整控除あり）＋ 均等割5,000円。翌年6月から納付"
      }
    ],
    howToTitle: "使い方",
    steps: [
      "源泉徴収票の給与の支払金額と源泉徴収税額を入力します。",
      "事業の売上・経費と青色申告特別控除の区分、その他の所得を入力します。",
      "社会保険料・所得控除・扶養を入れ、所得税・住民税と申告での納付・還付額を確認します。"
    ],
    faqTitle: "よくある質問",
    faqs: [
      {
        question: "会社員の副業はいくらから確定申告が必要ですか？",
        answer: "給与を1か所から受け、年末調整を受けている人は、給与以外の所得（収入から経費を引いた額）が20万円を超えると確定申告が必要です。20万円以下でも住民税の申告は必要で、医療費控除などで還付を受けるときは副業分も含めて申告します。"
      },
      {
        question: "青色申告特別控除の65万円・55万円・10万円の違いは？",
        answer: "複式簿記で記帳して貸借対照表を添付し期限内に申告すると55万円、さらにe-Taxで申告するか優良な電子帳簿保存を行うと65万円です。簡易な記帳だけなら10万円です。控除は事業所得（不動産所得を含む）の金額が上限です。"
      },
      {
        question: "令和8年分は何が変わりましたか？",
        answer: "基礎控除が本則62万円になり、合計所得489万円以下は104万円、655万円以下は67万円に上乗せされます。給与所得控除の最低保障額も74万円に上がりました。住民税の基礎控除は43万円のままです。"
      }
    ],
    disclaimer: "このツールは一般的な見積もり用です。正確な税額は国税庁の確定申告書等作成コーナーやお住まいの市区町村、税理士にご確認ください。"
  },
  zh: {
    introTitle: "综合所得：四项劳动性所得合并按年计税",
    intro: "居民个人取得的工资薪金、劳务报酬、稿酬和特许权使用费合并为综合所得，按纳税年度计算个人所得税。劳务报酬和特许权使用费以收入减除20%后的余额为收入额，稿酬在此基础上再减按70%计算。全年收入额减除60,000元基本减除费用、三险一金等专项扣除、专项附加扣除和其他扣除后，适用3%至45%的七级超额累进税率。平时由支付方预扣预缴，次年3月1日至6月30日办理年度汇算，多退少补。",
    formulaTitle: "计算规则",
    formulas: [
      {
        title: "收入额",
        body: "工资薪金 + 劳务报酬×80% + 特许权使用费×80% + 稿酬×80%×70%"
      },
      {
        title: "应纳税所得额",
        body: "收入额 − 60,000元 − 专项扣除（三险一金）− 专项附加扣除 − 依法确定的其他扣除"
      },
      {
        title: "年度税率表",
        body: "不超过36,000元 3%，144,000元 10%，300,000元 20%，420,000元 25%，660,000元 30%，960,000元 35%，超过 45%。应补（退）税额 = 应纳税额 − 已预缴税额"
      }
    ],
    howToTitle: "使用方法",
    steps: [
      "分别输入全年工资薪金、劳务报酬、特许权使用费和稿酬收入。",
      "填写个人缴纳的三险一金、专项附加扣除合计和其他扣除。",
      "输入已预扣预缴的税额，查看全年应纳税额和年度汇算应补或应退税额。"
    ],
    faqTitle: "常见问题",
    faqs: [
      {
        question: "劳务报酬预扣的税和年度汇算有什么不同？",
        answer: "支付方每次按收入减除费用后适用20%–40%的预扣率预扣税款，比较高；年度汇算时劳务报酬按收入的80%并入综合所得，与工资一起适用3%–45%的税率表，所以很多人可以退税。"
      },
      {
        question: "个体工商户的经营所得也算综合所得吗？",
        answer: "不算。经营所得单独适用5%–35%的税率表，次年3月31日前办理经营所得汇算。可以使用本站的自由职业者税务计算器估算。"
      },
      {
        question: "哪些情况可以不办年度汇算？",
        answer: "综合所得年收入不超过12万元但需要补税的、补税金额不超过400元的，以及已预缴税额与应纳税额一致或不申请退税的，可以不办理年度汇算。"
      }
    ],
    disclaimer: "本工具仅供一般估算。以个人所得税App年度汇算的计算结果为准。"
  },
  fr: {
    introTitle: "L'impôt sur le revenu additionne tous les revenus du foyer avant d'appliquer le barème",
    intro: "En France, l'impôt sur le revenu est calculé par foyer fiscal. Chaque catégorie de revenus est d'abord déterminée selon ses propres règles : salaires après abattement de 10 % pour frais professionnels, bénéfices d'une micro-entreprise après abattement forfaitaire (34 % en BNC, 50 % pour les prestations BIC, 71 % pour la vente), revenus fonciers, pensions. Le revenu net global est ensuite divisé par le nombre de parts, soumis au barème progressif, puis multiplié par le nombre de parts, avec plafonnement du quotient familial et décote pour les impôts modestes.",
    formulaTitle: "Règles de calcul",
    formulas: [
      {
        title: "Revenu net imposable",
        body: "Salaires − 10 % (min. 509 €, max. 14 555 €) + chiffre d'affaires micro − abattement forfaitaire (min. 305 €) + autres revenus nets catégoriels"
      },
      {
        title: "Barème 2026",
        body: "Par part : 0 % jusqu'à 11 600 €, 11 % jusqu'à 29 579 €, 30 % jusqu'à 84 577 €, 41 % jusqu'à 181 917 €, 45 % au-delà. Avantage plafonné à 1 807 € par demi-part"
      },
      {
        title: "Décote et solde",
        body: "Décote : 897 € (seul) ou 1 483 € (couple) − 45,25 % de l'impôt brut. Solde = impôt − prélèvement à la source et acomptes déjà payés"
      }
    ],
    howToTitle: "Mode d'emploi",
    steps: [
      "Saisissez les salaires nets imposables et le chiffre d'affaires de la micro-entreprise, en choisissant son activité.",
      "Ajoutez les autres revenus nets imposables, la situation familiale et le prélèvement déjà payé.",
      "Lisez le revenu imposable, l'impôt et le solde à payer ou à rembourser."
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      {
        question: "Mon chiffre d'affaires de micro-entrepreneur est-il imposé en entier ?",
        answer: "Non. Au régime micro-fiscal, l'administration applique un abattement forfaitaire pour frais : 71 % pour la vente de marchandises, 50 % pour les prestations de services BIC et 34 % pour les BNC, avec un minimum de 305 €. Si vous avez opté pour le versement libératoire, ce revenu n'entre pas dans ce calcul."
      },
      {
        question: "Les dividendes et intérêts sont-ils inclus ?",
        answer: "Par défaut, ils sont soumis au prélèvement forfaitaire unique : 12,8 % d'impôt sur le revenu, plus les prélèvements sociaux. L'option globale pour le barème est possible mais n'est pas modélisée ici."
      },
      {
        question: "Quand l'impôt sur ces revenus est-il payé ?",
        answer: "Les revenus non salariaux donnent lieu à des acomptes mensuels ou trimestriels prélevés par l'administration. La déclaration du printemps régularise ensuite l'ensemble : remboursement l'été ou solde prélevé de septembre à décembre."
      }
    ],
    disclaimer: "Cet outil sert au calcul général. Le montant exact figure sur votre avis d'impôt ; vous pouvez aussi utiliser le simulateur officiel sur impots.gouv.fr."
  },
  es: {
    introTitle: "En el IRPF, el trabajo, las actividades y los alquileres tributan juntos en la base general",
    intro: "El IRPF separa dos bases. La base general suma los rendimientos del trabajo, de actividades económicas (autónomos) y del capital inmobiliario, y tributa con la escala progresiva estatal más la autonómica, del 19 % al 47 %. La base del ahorro, con intereses, dividendos y ganancias por ventas, tributa aparte del 19 % al 30 %. Sobre la cuota de la base general se descuenta el mínimo personal y familiar, que tributa al 0 %, y el resultado se compara con las retenciones y pagos fraccionados en la declaración de la renta.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      {
        title: "Base liquidable general",
        body: "Trabajo (íntegro − Seguridad Social − 2.000 € − reducción si las demás rentas no superan 6.500 €) + rendimiento neto de actividades + alquileres y otras rentas generales"
      },
      {
        title: "Escala 2026",
        body: "19 % hasta 12.450 €, 24 % hasta 20.200 €, 30 % hasta 35.200 €, 37 % hasta 60.000 €, 45 % hasta 300.000 €, 47 % por encima, menos la misma escala aplicada al mínimo personal y familiar"
      },
      {
        title: "Resultado",
        body: "Cuota − retenciones del trabajo y de facturas − pagos fraccionados (modelo 130). Positivo: a ingresar. Negativo: a devolver"
      }
    ],
    howToTitle: "Cómo se usa",
    steps: [
      "Introduce los rendimientos del trabajo y la Seguridad Social del certificado de tu empresa.",
      "Añade el rendimiento neto de tu actividad económica y de alquileres.",
      "Indica retenciones, pagos fraccionados e hijos, y consulta la cuota y el resultado."
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      {
        question: "¿Por qué pierdo la reducción por rendimientos del trabajo?",
        answer: "La reducción de hasta 7.302 € para sueldos bajos solo se aplica si las rentas distintas del trabajo, excluidas las exentas, no superan 6.500 €. Con una actividad o alquileres por encima de ese importe desaparece."
      },
      {
        question: "¿Qué rentas no entran en esta base?",
        answer: "Intereses, dividendos, seguros de ahorro y ganancias patrimoniales por transmisión van a la base del ahorro (19 % a 30 %). Las ganancias que no proceden de transmisiones, como premios, van a la base general."
      },
      {
        question: "¿Por qué el resultado real puede ser distinto?",
        answer: "Cada comunidad autónoma aplica su propia escala y sus deducciones, y existen deducciones estatales (maternidad, donativos, vivienda habitual anterior a 2013) no incluidas. Renta WEB las aplica con tus datos fiscales."
      }
    ],
    disclaimer: "Esta herramienta es para cálculo general. El resultado oficial es el del borrador en Renta WEB de la Agencia Tributaria."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {country ? <ComprehensiveIncomeTaxCountryCalculator client:load country={country} /> : <ComprehensiveIncomeTaxCalc client:load locale={locale === "ko" ? "ko" : "en"} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="comprehensive-income-tax-calculator" slugs={["comprehensive-income-tax-calculator", "global-income-tax-calculator", "gift-tax-calculator", "inheritance-tax-calculator", "property-tax-calculator", "year-end-settlement-calculator", "severance-calculator", "freelancer-tax-calculator"]} />
  </div>
</BaseLayout>
