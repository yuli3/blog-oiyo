---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalOnlyNote from "../../components/tools/LocalOnlyNote.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import PdfTool from "../../components/tools/PdfTool";
import { locales } from "../../lib/i18n";
import { siteConfig } from "../../config/site.config";
import { toolStructuredData } from "../../lib/seo/structured-data";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: { title: "PDF 합치기·나누기 — 설치 없이, 파일을 올리지 않고", description: "여러 PDF를 원하는 순서로 합치고, 한 PDF를 쪽 범위나 한 쪽씩 나눠요. 파일은 서버로 올라가지 않고 브라우저 안에서만 처리돼요. 무료, 설치 없음, 워터마크 없음." },
  en: { title: "Merge and Split PDF — No Install, No Upload", description: "Merge PDFs in the order you want and split a PDF by page ranges or into single pages. Files stay in your browser and are never uploaded. Free, no install, no watermark." },
  ja: { title: "PDF結合・分割 — インストール不要、アップロードなし", description: "複数のPDFを好きな順番で結合し、1つのPDFをページ範囲や1ページずつに分割します。ファイルはアップロードされず、ブラウザーの中だけで処理します。無料・インストール不要・透かしなし。" },
  zh: { title: "PDF合并·拆分 — 免安装，不上传文件", description: "按想要的顺序合并多个PDF，或按页码范围、逐页拆分一个PDF。文件不会上传，全部在浏览器内处理。免费、免安装、无水印。" },
  fr: { title: "Fusionner et diviser un PDF — sans installation, sans envoi", description: "Fusionnez des PDF dans l’ordre voulu et divisez un PDF par plages de pages ou page par page. Les fichiers restent dans votre navigateur. Gratuit, sans installation, sans filigrane." },
  es: { title: "Unir y dividir PDF — sin instalar, sin subir archivos", description: "Une varios PDF en el orden que quieras y divide un PDF por rangos de páginas o página a página. Los archivos se quedan en tu navegador. Gratis, sin instalar, sin marca de agua." },
};

type SeoContent = { introTitle: string; intro: string; factsTitle: string; facts: { title: string; body: string }[]; howToTitle: string; steps: string[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string };

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "계약서와 증빙을 남의 서버에 올리지 않고",
    intro: "PDF는 계약서, 급여명세서, 신분증 사본처럼 남에게 보이기 싫은 문서가 많아요. 이 도구는 파일을 기기에서 읽어 브라우저 안에서 다시 묶거나 나눈 뒤 바로 저장해요. 쪽을 그대로 옮기므로 글자는 선택할 수 있는 상태로 남고 화질도 변하지 않아요.",
    factsTitle: "할 수 있는 일",
    facts: [
      { title: "합치기", body: "PDF를 여러 개 넣고 위아래 버튼으로 순서를 정한 뒤 하나로 묶어요. 한 번에 30개까지 넣을 수 있어요." },
      { title: "범위로 나누기", body: "'1-3, 5, 8-10'처럼 적으면 적은 범위마다 파일이 하나씩 만들어져요. 필요한 쪽만 뽑을 때도 이 방법을 써요." },
      { title: "고르게 나누기", body: "한 쪽씩 모두 나누거나 5쪽씩처럼 묶어서 나눠요. 파일이 여러 개면 ZIP 하나로 받아요." },
    ],
    howToTitle: "사용 방법",
    steps: ["합치기 또는 나누기를 골라요.", "PDF를 끌어다 놓거나 파일을 골라요.", "합칠 때는 순서를, 나눌 때는 쪽 범위나 나누는 방법을 정해요.", "버튼을 누르면 결과 파일이 바로 저장돼요."],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "PDF가 서버로 올라가나요?", answer: "올라가지 않아요. 파일은 브라우저 안에서만 읽고 처리해요. 처음 쓸 때 PDF 처리 도구를 한 번 내려받지만, 문서를 보내는 것은 아니에요." },
      { question: "합치거나 나누면 화질이 떨어지나요?", answer: "떨어지지 않아요. 쪽을 그림으로 다시 만들지 않고 원래 내용 그대로 옮겨요. 글자 선택과 검색도 그대로 돼요." },
      { question: "암호가 걸린 PDF도 되나요?", answer: "안 돼요. 암호가 걸린 파일은 열 수 없어서 처리하지 못해요. 암호를 푼 사본을 넣어 주세요." },
      { question: "책갈피나 양식은 유지되나요?", answer: "쪽의 내용은 그대로 옮겨지지만, 문서 전체에 걸린 책갈피(목차)와 일부 양식 필드는 합치거나 나눈 뒤에 사라질 수 있어요. 중요한 문서는 결과를 한 번 확인해 주세요." },
      { question: "쪽 범위는 어떻게 적나요?", answer: "쉼표나 띄어쓰기로 구분해요. '1-3'은 1쪽부터 3쪽, '5'는 5쪽 하나예요. '1-3, 5, 8-10'이면 파일 세 개가 만들어져요." },
    ],
    disclaimer: "쪽수가 아주 많거나 용량이 큰 PDF는 기기 메모리에 따라 느리거나 실패할 수 있어요. 원본은 지우지 말고 보관해 주세요.",
  },
  en: {
    introTitle: "Without handing your contract to someone else's server",
    intro: "PDFs tend to be the documents you least want strangers to see: contracts, payslips, ID scans. This tool reads the file from your device, rebuilds it in the browser and saves it straight back. Pages are copied as they are, so text stays selectable and nothing loses quality.",
    factsTitle: "What it does",
    facts: [
      { title: "Merge", body: "Add several PDFs, set the order with the up and down buttons, and join them into one. Up to 30 files at a time." },
      { title: "Split by ranges", body: "Type something like \"1-3, 5, 8-10\" and each range becomes its own file. This is also how you pull out just the pages you need." },
      { title: "Split evenly", body: "Separate every page, or cut the document into groups such as five pages each. Several files come as one ZIP." },
    ],
    howToTitle: "How to use it",
    steps: ["Choose Merge or Split.", "Drop PDFs in or choose files.", "Set the order to merge, or the page ranges or method to split.", "Press the button and the result is saved at once."],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Are my PDFs uploaded?", answer: "No. Files are read and processed only in your browser. The first time you use it a PDF library is downloaded once, but your document is not sent anywhere." },
      { question: "Does merging or splitting reduce quality?", answer: "No. Pages are not re-drawn as images; their original content is copied over. Text can still be selected and searched." },
      { question: "Does it work with password-protected PDFs?", answer: "No. A protected file cannot be opened, so it cannot be processed. Add a copy with the password removed." },
      { question: "Are bookmarks and forms kept?", answer: "The content of each page is copied as it is, but document-wide bookmarks (the outline) and some form fields can be lost after merging or splitting. Check the result for important documents." },
      { question: "How do I write page ranges?", answer: "Separate them with commas or spaces. \"1-3\" means pages 1 to 3 and \"5\" means page 5 alone. \"1-3, 5, 8-10\" makes three files." },
    ],
    disclaimer: "PDFs with very many pages or a large file size can be slow or fail, depending on your device's memory. Keep your originals.",
  },
  ja: {
    introTitle: "契約書や証明書類を他人のサーバーに預けずに",
    intro: "PDFは契約書、給与明細、身分証のコピーなど、人に見せたくない文書であることが多いものです。このツールはファイルを端末から読み込み、ブラウザーの中でまとめ直したり分けたりして、そのまま保存します。ページをそのまま移すので、文字は選択できる状態のままで、画質も変わりません。",
    factsTitle: "できること",
    facts: [
      { title: "結合", body: "PDFを複数入れ、上下のボタンで順番を決めて1つにまとめます。一度に30個まで入れられます。" },
      { title: "範囲で分割", body: "「1-3, 5, 8-10」のように入力すると、範囲ごとに1つずつファイルができます。必要なページだけ取り出すときもこの方法です。" },
      { title: "均等に分割", body: "1ページずつすべて分けるか、5ページずつのようにまとめて分けます。ファイルが複数ならZIP1つで保存します。" },
    ],
    howToTitle: "使い方",
    steps: ["結合か分割を選びます。", "PDFをドラッグするか、ファイルを選びます。", "結合では順番を、分割ではページ範囲や方法を決めます。", "ボタンを押すと、結果のファイルがすぐ保存されます。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "PDFはサーバーにアップロードされますか？", answer: "されません。ファイルはブラウザーの中だけで読み込み、処理します。初回にPDF処理ライブラリを一度ダウンロードしますが、文書を送信するわけではありません。" },
      { question: "結合や分割で画質は落ちますか？", answer: "落ちません。ページを画像として作り直さず、元の内容をそのまま移します。文字の選択や検索もそのまま使えます。" },
      { question: "パスワード付きのPDFも使えますか？", answer: "使えません。パスワード付きのファイルは開けないため処理できません。パスワードを解除したコピーを入れてください。" },
      { question: "しおりやフォームは残りますか？", answer: "各ページの内容はそのまま移りますが、文書全体のしおり(目次)や一部のフォーム欄は、結合・分割後に消えることがあります。大事な文書は結果を一度確認してください。" },
      { question: "ページ範囲はどう書きますか？", answer: "カンマか空白で区切ります。「1-3」は1〜3ページ、「5」は5ページだけです。「1-3, 5, 8-10」なら3つのファイルができます。" },
    ],
    disclaimer: "ページ数が非常に多いPDFや容量の大きいPDFは、端末のメモリによって遅くなったり失敗したりすることがあります。元のファイルは消さずに保管してください。",
  },
  zh: {
    introTitle: "不必把合同和证件交给别人的服务器",
    intro: "PDF往往是合同、工资单、证件扫描件这类不想让别人看到的文件。这个工具从设备读取文件，在浏览器内重新合并或拆分后直接保存。页面原样复制，所以文字仍可选中，清晰度也不会变化。",
    factsTitle: "可以做什么",
    facts: [
      { title: "合并", body: "放入多个PDF，用上下按钮排好顺序后合成一个。一次最多放入30个。" },
      { title: "按范围拆分", body: "填写“1-3, 5, 8-10”这样的范围，每个范围生成一个文件。只想取出需要的几页时也用这个方法。" },
      { title: "均匀拆分", body: "逐页全部拆开，或按每5页一份这样拆分。文件有多个时打包成一个ZIP保存。" },
    ],
    howToTitle: "使用方法",
    steps: ["选择合并或拆分。", "拖入PDF或选择文件。", "合并时排好顺序，拆分时填写页码范围或选择方式。", "点击按钮后，结果文件会立即保存。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "PDF会上传到服务器吗？", answer: "不会。文件只在浏览器内读取和处理。第一次使用时会下载一次PDF处理库，但不会发送你的文档。" },
      { question: "合并或拆分会降低清晰度吗？", answer: "不会。页面不是重新生成图片，而是把原有内容原样复制过去。文字依然可以选中和搜索。" },
      { question: "加密的PDF可以处理吗？", answer: "不可以。加密文件无法打开，所以无法处理。请放入已解除密码的副本。" },
      { question: "书签和表单会保留吗？", answer: "每一页的内容会原样复制，但整个文档的书签(目录)和部分表单字段在合并或拆分后可能丢失。重要文档请检查一下结果。" },
      { question: "页码范围怎么写？", answer: "用逗号或空格分隔。“1-3”表示第1到3页，“5”表示只有第5页。“1-3, 5, 8-10”会生成三个文件。" },
    ],
    disclaimer: "页数特别多或体积很大的PDF，可能因设备内存不足而变慢或失败。请保留原始文件。",
  },
  fr: {
    introTitle: "Sans confier votre contrat au serveur de quelqu’un d’autre",
    intro: "Les PDF sont souvent les documents que l’on veut le moins montrer : contrats, bulletins de paie, copies de pièces d’identité. Cet outil lit le fichier sur votre appareil, le recompose dans le navigateur et l’enregistre aussitôt. Les pages sont copiées telles quelles : le texte reste sélectionnable et rien ne perd en qualité.",
    factsTitle: "Ce qu’il fait",
    facts: [
      { title: "Fusionner", body: "Ajoutez plusieurs PDF, réglez l’ordre avec les boutons monter et descendre, puis réunissez-les en un seul. Jusqu’à 30 fichiers à la fois." },
      { title: "Diviser par plages", body: "Saisissez par exemple « 1-3, 5, 8-10 » : chaque plage devient un fichier. C’est aussi la façon d’extraire seulement les pages utiles." },
      { title: "Diviser régulièrement", body: "Séparez chaque page, ou découpez le document par groupes, de cinq pages par exemple. Plusieurs fichiers sont livrés dans un seul ZIP." },
    ],
    howToTitle: "Mode d’emploi",
    steps: ["Choisissez Fusionner ou Diviser.", "Déposez des PDF ou choisissez des fichiers.", "Réglez l’ordre pour fusionner, ou les plages de pages ou la méthode pour diviser.", "Cliquez sur le bouton : le résultat est enregistré aussitôt."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Mes PDF sont-ils envoyés sur un serveur ?", answer: "Non. Les fichiers sont lus et traités uniquement dans votre navigateur. À la première utilisation, une bibliothèque PDF est téléchargée une fois, mais votre document n’est envoyé nulle part." },
      { question: "La fusion ou la division dégrade-t-elle la qualité ?", answer: "Non. Les pages ne sont pas redessinées en images : leur contenu d’origine est copié. Le texte reste sélectionnable et consultable." },
      { question: "Cela fonctionne-t-il avec un PDF protégé par mot de passe ?", answer: "Non. Un fichier protégé ne peut pas être ouvert, donc pas traité. Ajoutez une copie sans mot de passe." },
      { question: "Les signets et les formulaires sont-ils conservés ?", answer: "Le contenu de chaque page est copié tel quel, mais les signets du document (le plan) et certains champs de formulaire peuvent disparaître après fusion ou division. Vérifiez le résultat pour les documents importants." },
      { question: "Comment écrire les plages de pages ?", answer: "Séparez-les par des virgules ou des espaces. « 1-3 » désigne les pages 1 à 3 et « 5 » la page 5 seule. « 1-3, 5, 8-10 » donne trois fichiers." },
    ],
    disclaimer: "Les PDF très longs ou très lourds peuvent être lents ou échouer selon la mémoire de l’appareil. Conservez vos originaux.",
  },
  es: {
    introTitle: "Sin entregar tu contrato al servidor de otro",
    intro: "Los PDF suelen ser los documentos que menos quieres enseñar: contratos, nóminas, copias del DNI. Esta herramienta lee el archivo de tu dispositivo, lo recompone en el navegador y lo guarda al momento. Las páginas se copian tal cual, así que el texto sigue siendo seleccionable y no se pierde calidad.",
    factsTitle: "Qué hace",
    facts: [
      { title: "Unir", body: "Añade varios PDF, ordénalos con los botones de subir y bajar y júntalos en uno. Hasta 30 archivos a la vez." },
      { title: "Dividir por rangos", body: "Escribe algo como «1-3, 5, 8-10» y cada rango se convierte en un archivo. También sirve para sacar solo las páginas que necesitas." },
      { title: "Dividir por igual", body: "Separa cada página o corta el documento en grupos, por ejemplo de cinco páginas. Varios archivos llegan en un único ZIP." },
    ],
    howToTitle: "Cómo se usa",
    steps: ["Elige Unir o Dividir.", "Suelta los PDF o elige archivos.", "Fija el orden para unir, o los rangos de páginas o el método para dividir.", "Pulsa el botón y el resultado se guarda al momento."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Se suben mis PDF a un servidor?", answer: "No. Los archivos se leen y procesan solo en tu navegador. La primera vez se descarga una biblioteca de PDF, pero tu documento no se envía a ningún sitio." },
      { question: "¿Se pierde calidad al unir o dividir?", answer: "No. Las páginas no se vuelven a dibujar como imágenes: se copia su contenido original. El texto se puede seguir seleccionando y buscando." },
      { question: "¿Funciona con PDF protegidos con contraseña?", answer: "No. Un archivo protegido no se puede abrir y, por tanto, no se puede procesar. Añade una copia sin contraseña." },
      { question: "¿Se conservan los marcadores y los formularios?", answer: "El contenido de cada página se copia tal cual, pero los marcadores del documento (el índice) y algunos campos de formulario pueden perderse al unir o dividir. Revisa el resultado en documentos importantes." },
      { question: "¿Cómo se escriben los rangos de páginas?", answer: "Sepáralos con comas o espacios. «1-3» son las páginas 1 a 3 y «5» es solo la página 5. «1-3, 5, 8-10» crea tres archivos." },
    ],
    disclaimer: "Los PDF con muchísimas páginas o muy pesados pueden ir lentos o fallar según la memoria del dispositivo. Conserva los originales.",
  },
};

const m = meta[locale] ?? meta.en;
const c = content[locale] ?? content.en;
const pageUrl = `${siteConfig.url}/${locale}/pdf-merge-split/`;

const structuredData = toolStructuredData({
  name: m.title,
  description: m.description,
  steps: c.steps,
  faqs: c.faqs,
  url: pageUrl,
  webApplication: true,
  breadcrumbs: [
    { name: "Tools", url: `${siteConfig.url}/${locale}/tools/` },
    { name: m.title, url: pageUrl },
  ],
});
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-5 sm:py-8">
    <PdfTool client:load locale={locale} />
    <LocalOnlyNote locale={locale} />

    <section class="mt-6 border-t border-border pt-5 sm:mt-10 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-foreground">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.factsTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.facts.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-foreground">
        {c.steps.map((step) => <li class="leading-7">{step}</li>)}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-border rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="p-4">
            <summary class="cursor-pointer font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 leading-7 text-muted-foreground">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedToolLinks locale={locale} current="pdf-merge-split" slugs={["image-converter", "qr-code-generator", "word-counter", "password-generator", "image-cropper", "legal-docs-generator"]} />

    <p class="mt-5 rounded-xl border border-warning bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground sm:mt-8">{c.disclaimer}</p>
  </div>
</BaseLayout>
