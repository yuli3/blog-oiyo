---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmotionalMindTestComp from "../../components/tests/EmotionalMindTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "감정 지능 테스트 — 나는 감정을 얼마나 잘 이해하는가?", description: "감정 인식·공감·자기조절·동기부여·사회적 기술을 측정하는 감정 지능(EQ) 진단 테스트입니다." },
  en: { title: "Emotional Intelligence Test — How Well Do You Understand Emotions?", description: "Measure your emotional intelligence across awareness, empathy, self-regulation, motivation, and social skills." },
  ja: { title: "感情知性テスト — 感情をどれだけ理解していますか？", description: "感情認識・共感・自己調整・モチベーション・社会的スキルを測定する感情知性(EQ)テスト。" },
  fr: { title: "Test d'Intelligence Émotionnelle — Comment comprenez-vous les émotions?", description: "Mesurez votre intelligence émotionnelle en reconnaissance, empathie, et régulation des émotions." },
  es: { title: "Test de Inteligencia Emocional — ¿Qué tan bien entiendes las emociones?", description: "Mide tu inteligencia emocional en reconocimiento, empatía, autorregulación y habilidades sociales." },
  zh: { title: "情緒智力測試 — 你多了解情緒？", description: "測量你在情緒認知、共情、自我調節、動力和社交技能方面的情緒智力。" },
  cn: { title: "情商测试 — 你多了解情绪？", description: "测量你在情绪认知、共情、自我调节、动力和社交技能方面的情商。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <EmotionalMindTestComp client:load locale={locale} />
  </main>
</BaseLayout>
