---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MindsetCompassTestComp from "../../components/tests/MindsetCompassTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "마인드셋 나침반 테스트: 나는 성장형인가 고정형인가?", description: "10개의 질문으로 나의 마인드셋 유형을 알아보세요. 도전·피드백·노력·학습 4가지 차원에서 성장형 마인드셋과 고정형 마인드셋 중 나는 어느 쪽에 가까운가요?" },
  en: { title: "Mindset Compass Test: Are You Growth or Fixed Mindset?", description: "Find out your mindset type through 10 questions. Across challenges, feedback, effort, and learning — where do you land on the growth vs. fixed mindset spectrum?" },
  ja: { title: "マインドセットコンパステスト：成長型か固定型か？", description: "10の質問でマインドセットタイプを探りましょう。挑戦・フィードバック・努力・学習の4次元で、成長型マインドセットと固定型マインドセットのどちら寄りですか？" },
  fr: { title: "Test Mindset Compass : État d'esprit de croissance ou fixe ?", description: "Découvrez votre type d'état d'esprit à travers 10 questions. Défis, feedback, effort, apprentissage — où vous situez-vous sur le spectre croissance vs fixe ?" },
  es: { title: "Test Mindset Compass: ¿Mentalidad de crecimiento o fija?", description: "Descubre tu tipo de mentalidad a través de 10 preguntas. En desafíos, retroalimentación, esfuerzo y aprendizaje — ¿hacia dónde te inclinas en el espectro crecimiento vs fijo?" },
  zh: { title: "心態羅盤測試：你是成長型還是固定型心態？", description: "透過10個問題了解你的心態類型。在挑戰、反饋、努力和學習4個維度上，你更接近成長型心態還是固定型心態？" },
  cn: { title: "心态罗盘测试：你是成长型还是固定型心态？", description: "通过10个问题了解你的心态类型。在挑战、反馈、努力和学习4个维度上，你更接近成长型心态还是固定型心态？" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <MindsetCompassTestComp client:load locale={locale} />
  </main>
</BaseLayout>
