---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AptSubscriptionScore from "../../components/tools/AptSubscriptionScore";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "청약 가점 계산기 — 무주택·부양가족·청약통장 점수 자동 계산",
    description: "청약 가점제 3가지 항목(무주택 기간 32점+부양가족 수 35점+청약통장 가입기간 17점)을 자동으로 계산하세요. 최대 84점.",
  },
  en: {
    title: "Korean Housing Subscription Score Calculator — Free Apt Lottery Score",
    description: "Calculate your Korean apartment subscription lottery score: homeless period (32pts) + dependents (35pts) + savings account (17pts). Max 84 points.",
  },
  ja: {
    title: "청약 가점 계산기 — 韓国住宅申込みポイント自動計算",
    description: "韓国のアパート申込みポイント（無住宅期間32点＋扶養家族35点＋청약통장17点）を自動計算します。最大84点。",
  },
  fr: {
    title: "Calculateur de Points de Loterie Immobilière Coréenne",
    description: "Calculez votre score de loterie pour les appartements coréens : période sans logement (32pts) + personnes à charge (35pts) + compte d'épargne (17pts). Max 84 points.",
  },
  es: {
    title: "Calculadora de Puntos de Lotería de Vivienda Coreana",
    description: "Calcula tu puntuación para la lotería de apartamentos coreanos: período sin vivienda (32pts) + dependientes (35pts) + cuenta de ahorro (17pts). Máx 84 puntos.",
  },
  zh: {
    title: "韩国购房积分计算器 — 无房期间·扶养家属·认购账户",
    description: "计算韩国公寓认购积分：无房期间（32分）+扶养家属（35分）+认购账户期间（17分），最高84分。",
  },
};

const m = meta[locale] ?? meta.en;

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "청약 가점은 세 항목 합산 84점 체계입니다",
    intro: "한국 민영주택 청약 가점제는 무주택 기간, 부양가족 수, 청약통장 가입기간을 점수화합니다. 이 계산기는 2024년 기준 구조를 바탕으로 세 항목을 합산해 현재 점수를 빠르게 확인하고, 어떤 항목이 점수 개선에 영향을 주는지 보여 줍니다.",
    formulaTitle: "점수 기준",
    formulas: [
      { title: "무주택 기간", body: "최대 32점입니다. 만 30세 미만 미혼 등 일부 조건에서는 0점 처리될 수 있습니다." },
      { title: "부양가족 수", body: "최대 35점입니다. 배우자와 주민등록상 같은 세대의 직계존비속 등 요건을 확인해야 합니다." },
      { title: "청약통장 기간", body: "가입 기간에 따라 최대 17점까지 반영됩니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "무주택 기간과 만 30세 미만 미혼 여부를 선택합니다.",
      "부양가족 수와 청약통장 가입 개월 수를 입력합니다.",
      "총점과 항목별 점수를 확인하고 모집공고의 자격요건과 당첨 커트라인을 따로 확인합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "84점이면 당첨이 보장되나요?", answer: "아닙니다. 가점은 경쟁 요소 중 하나입니다. 지역, 주택형, 공급 유형, 특별공급 여부, 경쟁률, 모집공고 기준에 따라 결과가 달라집니다." },
      { question: "무주택 기간은 언제부터 계산하나요?", answer: "일반적으로 만 30세 이후 또는 혼인 후 무주택 기간을 봅니다. 세대 구성과 과거 주택 보유 이력에 따라 달라질 수 있습니다." },
      { question: "부양가족은 누구를 포함하나요?", answer: "배우자, 직계존속, 직계비속 등이 요건을 충족해야 하며 주민등록, 부양 기간, 주택 보유 여부 등 세부 기준을 확인해야 합니다." },
    ],
    disclaimer: "이 도구는 일반적인 추정용입니다. 실제 청약 자격, 가점, 당첨 가능성은 모집공고와 관련 기관 또는 전문가에게 확인하세요.",
  },
  en: {
    introTitle: "Korean apartment subscription scoring is a three-part 84-point system",
    intro: "The Korean housing subscription score for many private apartment lotteries combines no-home period, dependents, and subscription savings account duration. This calculator follows the 2024-style structure to estimate your current score and show which category drives it.",
    formulaTitle: "Score basis",
    formulas: [
      { title: "No-home period", body: "Up to 32 points. Some cases, such as unmarried applicants under 30, can receive zero for this category." },
      { title: "Dependents", body: "Up to 35 points. Eligible household members and registration conditions must be checked." },
      { title: "Subscription account", body: "Account duration contributes up to 17 points." },
    ],
    howToTitle: "How to use",
    steps: [
      "Set no-home years and whether the under-30 unmarried condition applies.",
      "Enter dependents and subscription account months.",
      "Review total and category scores, then check the official announcement for eligibility and winning cutoff data.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Does a high score guarantee winning?", answer: "No. Results depend on location, unit type, supply category, applicant pool, competition rate, and the official announcement." },
      { question: "When does the no-home period start?", answer: "Often from age 30 or marriage, but household structure and previous ownership history can change the calculation." },
      { question: "Who counts as a dependent?", answer: "Spouse, lineal ascendants, and lineal descendants may count only when detailed residence, support-period, and home-ownership conditions are met." },
    ],
    disclaimer: "This tool is a general estimate. Confirm actual subscription eligibility, score, and winning probability with the official announcement or a qualified professional.",
  },
  ja: {
    introTitle: "韓国の청약加点は3項目84点満点の仕組みです",
    intro: "民営住宅の청약加点制では、無住宅期間、扶養家族数、청약通帳加入期間を点数化します。この計算機は2024年基準の構造で現在の点数と項目別内訳を確認するためのものです。",
    formulaTitle: "点数の基準",
    formulas: [
      { title: "無住宅期間", body: "最大32点です。30歳未満未婚など一部条件では0点になることがあります。" },
      { title: "扶養家族数", body: "最大35点です。住民登録上の同一世帯や家族関係など要件確認が必要です。" },
      { title: "通帳加入期間", body: "청약通帳の加入期間により最大17点です。" },
    ],
    howToTitle: "使い方",
    steps: [
      "無住宅期間と30歳未満未婚条件を選びます。",
      "扶養家族数と通帳加入月数を入力します。",
      "総点と項目別点数を確認し、募集公告の資格要件を別途確認します。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "高得点なら必ず当選しますか？", answer: "いいえ。地域、住宅型、供給区分、競争率、募集公告の基準で結果は変わります。" },
      { question: "無住宅期間はいつからですか？", answer: "一般に30歳以降または婚姻後を基準にしますが、世帯構成や過去の住宅保有履歴で変わります。" },
      { question: "扶養家族は誰を含みますか？", answer: "配偶者、直系尊属、直系卑属などが要件を満たす必要があります。住民登録や保有住宅の条件も確認してください。" },
    ],
    disclaimer: "このツールは一般的な概算です。実際の資格、加点、当選可能性は募集公告または専門家に確認してください。",
  },
  zh: {
    introTitle: "韩国购房认购积分是三项合计84分",
    intro: "韩国公寓认购加分通常由无房期间、扶养家属数和认购存款账户期间组成。本工具按2024年结构估算当前总分，并显示各项目对分数的影响。",
    formulaTitle: "分数依据",
    formulas: [
      { title: "无房期间", body: "最高32分。未满30岁且未婚等情况可能按0分处理。" },
      { title: "扶养家属", body: "最高35分。需确认同一住民登记户、亲属关系和住宅持有等条件。" },
      { title: "认购账户期间", body: "根据账户加入期间，最高17分。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "选择无房年数和是否未满30岁未婚。",
      "输入扶养家属数和认购账户月数。",
      "查看总分和分项分数，再核对募集公告中的资格和中签分数。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "高分就保证中签吗？", answer: "不保证。结果取决于地区、户型、供应类型、竞争率和募集公告标准。" },
      { question: "无房期间从什么时候算？", answer: "一般从满30岁后或结婚后计算，但家庭结构和过去房屋持有历史可能影响结果。" },
      { question: "哪些人算扶养家属？", answer: "配偶、直系尊亲属、直系卑亲属等需满足居住登记、扶养期间和房屋持有等细项条件。" },
    ],
    disclaimer: "本工具仅作一般估算。实际认购资格、积分和中签可能性请以募集公告、相关机构或专业人士意见为准。",
  },
  fr: {
    introTitle: "Le score coréen de souscription logement est un système à 84 points",
    intro: "Pour beaucoup de loteries d'appartements privés en Corée, le score combine période sans logement, personnes à charge et durée du compte de souscription. Ce calculateur estime le score et son détail.",
    formulaTitle: "Bases du score",
    formulas: [
      { title: "Période sans logement", body: "Jusqu'à 32 points. Certains cas, comme moins de 30 ans non marié, peuvent valoir zéro." },
      { title: "Personnes à charge", body: "Jusqu'à 35 points, sous conditions de foyer, résidence et lien familial." },
      { title: "Compte de souscription", body: "La durée du compte apporte jusqu'à 17 points." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Indiquez les années sans logement et la condition moins de 30 ans non marié.",
      "Saisissez personnes à charge et mois du compte de souscription.",
      "Vérifiez total et détail, puis comparez avec l'annonce officielle et les scores gagnants.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Un score élevé garantit-il la réussite ?", answer: "Non. Localisation, type de logement, catégorie d'offre, concurrence et annonce officielle déterminent le résultat." },
      { question: "Quand commence la période sans logement ?", answer: "Souvent à partir de 30 ans ou du mariage, mais l'historique de propriété et le foyer peuvent modifier le calcul." },
      { question: "Qui compte comme personne à charge ?", answer: "Conjoint, ascendants ou descendants peuvent compter si les conditions de résidence, soutien et propriété sont remplies." },
    ],
    disclaimer: "Cet outil fournit une estimation générale. Confirmez éligibilité, score et chances avec l'annonce officielle ou un professionnel.",
  },
  es: {
    introTitle: "La puntuación coreana de suscripción de vivienda suma tres categorías hasta 84 puntos",
    intro: "Muchas loterías privadas de apartamentos en Corea combinan años sin vivienda, dependientes y duración de la cuenta de suscripción. Esta calculadora estima el total y muestra qué categoría pesa más.",
    formulaTitle: "Bases de puntuación",
    formulas: [
      { title: "Periodo sin vivienda", body: "Hasta 32 puntos. Casos como menor de 30 años no casado pueden recibir cero." },
      { title: "Dependientes", body: "Hasta 35 puntos, sujetos a reglas de hogar, residencia y parentesco." },
      { title: "Cuenta de suscripción", body: "La duración de la cuenta aporta hasta 17 puntos." },
    ],
    howToTitle: "Cómo usarla",
    steps: [
      "Indica años sin vivienda y si aplica menor de 30 años no casado.",
      "Introduce dependientes y meses de cuenta de suscripción.",
      "Revisa total y desglose, luego compara con el anuncio oficial y cortes históricos.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Un puntaje alto garantiza ganar?", answer: "No. Ubicación, tipo de unidad, categoría de oferta, competencia y anuncio oficial determinan el resultado." },
      { question: "¿Cuándo empieza el periodo sin vivienda?", answer: "A menudo desde los 30 años o matrimonio, pero historial de propiedad y hogar pueden cambiar el cálculo." },
      { question: "¿Quién cuenta como dependiente?", answer: "Cónyuge, ascendientes o descendientes pueden contar si cumplen residencia, apoyo y condiciones de propiedad." },
    ],
    disclaimer: "Esta herramienta ofrece una estimación general. Confirma elegibilidad, puntuación y probabilidad con el anuncio oficial o un profesional.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-8">
    <AptSubscriptionScore client:load locale={locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </div>
</BaseLayout>
