    highlightsTitle: "確認できること",
    highlights: [
      { title: "新しい平均取得単価", body: "既存保有分と追加購入分を合算して調整後の取得単価を表示します。" },
      { title: "総投資額", body: "追加購入後のポジション規模を把握できます。" },
      { title: "未実現損益", body: "現在株価をもとに評価額と損益率を計算します。" },
    ],
    relatedTitle: "関連計算機",
    related: [
      { href: "/ja/dividend-tracker/", label: "配当トラッカー", desc: "予想配当と支払い周期を記録します。" },
      { href: "/ja/dividend-calendar/", label: "配当カレンダー", desc: "配当落ち日と支払日を確認します。" },
      { href: "/ja/savings-comparison-calculator/", label: "貯蓄商品比較", desc: "預金・積立・ISAの税引き後額を比較します。" },
    ],
    disclaimer: "投資助言ではありません。実際の収益率は手数料、税金、為替、約定価格、配当、市場変動により変わります。",
  },
  zh: {
    eyebrow: "投资计算工具",
    introTitle: "什么是股票收益率计算机？",
    intro: "输入当前持股、平均成本以及计划追加买入的数量和价格，即可估算新的平均成本、总投入、当前市值和未实现盈亏。适合在补仓前查看盈亏平衡点如何变化。",
    howToTitle: "使用方法",
    steps: ["输入当前持股数量和平均成本。", "输入追加买入数量和买入价格。", "如果输入当前股价，可同时查看市值和未实现盈亏。", "最终决策前请另行考虑手续费、税费、汇率、分红和组合风险。"],
    highlightsTitle: "可查看的结果",
    highlights: [
      { title: "新平均成本", body: "将现有持仓和追加买入合并计算调整后的成本。" },
      { title: "总投入", body: "显示追加买入后的整体仓位规模。" },
      { title: "未实现盈亏", body: "按当前价格估算市值和盈亏率。" },
    ],
    relatedTitle: "相关计算器",
    related: [
      { href: "/zh/dividend-tracker/", label: "股息追踪器", desc: "记录预期股息和支付周期。" },
      { href: "/zh/dividend-calendar/", label: "股息日历", desc: "查看除息日和支付日。" },
      { href: "/zh/savings-comparison-calculator/", label: "储蓄商品比较", desc: "比较定存、定期储蓄和 ISA 的税后收益。" },
    ],
    disclaimer: "这不是投资建议。实际收益会受手续费、税费、汇率、成交价、分红和市场波动影响。",
  },
  fr: {
    eyebrow: "Calculateur d'investissement",
    introTitle: "Qu'est-ce que ce calculateur boursier ?",
    intro: "Il combine vos actions actuelles, votre prix de revient moyen et un achat supplémentaire pour estimer le nouveau prix moyen, le total investi, la valeur de marché et la P&L non réalisée.",
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez vos actions actuelles et le prix moyen.", "Ajoutez le nombre d'actions et le prix du nouvel achat.", "Indiquez le prix actuel pour voir valeur de marché et P&L.", "Vérifiez séparément frais, impôts, change, dividendes et risque de portefeuille."],
    highlightsTitle: "Ce qu'il affiche",
    highlights: [
      { title: "Nouveau prix moyen", body: "Fusionne les positions existantes et le nouvel achat." },
      { title: "Total investi", body: "Montre la taille de position après renforcement." },
      { title: "P&L non réalisée", body: "Estime gain ou perte avec le prix actuel." },
    ],
    relatedTitle: "Calculateurs liés",
    related: [
      { href: "/fr/dividend-tracker/", label: "Suivi des dividendes", desc: "Suivre dividendes attendus et fréquence." },
      { href: "/fr/dividend-calendar/", label: "Calendrier des dividendes", desc: "Voir dates ex-dividende et paiement." },
      { href: "/fr/savings-comparison-calculator/", label: "Comparateur d'épargne", desc: "Comparer les rendements après impôt." },
    ],
    disclaimer: "Ceci n'est pas un conseil en investissement. Les rendements réels varient avec frais, impôts, change, prix d'exécution, dividendes et volatilité.",
  },
  es: {
    eyebrow: "Calculadora de inversión",
    introTitle: "¿Qué es la calculadora de rentabilidad?",
    intro: "Combina tus acciones actuales, precio medio y una compra adicional para estimar el nuevo coste medio, inversión total, valor de mercado y ganancias o pérdidas no realizadas.",
    howToTitle: "Cómo usarla",
    steps: ["Ingresa las acciones actuales y el coste medio.", "Añade acciones y precio de la nueva compra.", "Introduce el precio actual para ver valor de mercado y P&L.", "Revisa aparte comisiones, impuestos, divisas, dividendos y riesgo de cartera."],
    highlightsTitle: "Qué muestra",
    highlights: [
      { title: "Nuevo coste medio", body: "Combina la posición actual y la compra adicional." },
      { title: "Inversión total", body: "Muestra el tamaño de la posición después de comprar más." },
      { title: "P&L no realizada", body: "Estima ganancia o pérdida con el precio actual." },
    ],
    relatedTitle: "Calculadoras relacionadas",
    related: [
      { href: "/es/dividend-tracker/", label: "Rastreador de dividendos", desc: "Registra dividendos esperados y frecuencia." },
      { href: "/es/dividend-calendar/", label: "Calendario de dividendos", desc: "Consulta fechas ex-dividendo y pagos." },
      { href: "/es/savings-comparison-calculator/", label: "Comparador de ahorro", desc: "Compara rendimientos después de impuestos." },
    ],
    disclaimer: "No es asesoramiento de inversión. Los rendimientos reales cambian con comisiones, impuestos, divisas, precio de ejecución, dividendos y volatilidad.",
  },
