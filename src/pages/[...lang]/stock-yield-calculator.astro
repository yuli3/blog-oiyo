  },
  en: {
    title: "Stock Yield Calculator — Average Down Cost Basis",
    description: "Enter your current holdings and new purchase to calculate the new average cost, total invested, and unrealized P&L.",
  },
  ja: {
    title: "株式利回り計算機 — 平均取得単価・損益計算",
    description: "現在の保有株と追加購入情報を入力して、新しい平均取得単価と未実現損益を計算します。",
  },
  fr: {
    title: "Calculateur de Rendement Boursier — Prix de Revient Moyen",
    description: "Entrez vos actions actuelles et vos nouveaux achats pour calculer le nouveau prix de revient moyen et la P&L.",
  },
  es: {
    title: "Calculadora de Rentabilidad de Acciones — Precio Medio",
    description: "Ingrese sus acciones actuales y nuevas compras para calcular el nuevo precio promedio y las ganancias no realizadas.",
