    howToTitle: "사용 방법",
    steps: ["현재 보유 주수와 평균 매수가를 입력합니다.", "추가로 매수할 주수와 매수 단가를 입력합니다.", "현재 주가를 넣으면 평가금액과 미실현 손익까지 함께 확인할 수 있습니다.", "거래 수수료, 세금, 환율, 배당금은 별도로 고려해 최종 판단합니다."],
    highlightsTitle: "확인할 수 있는 값",
    highlights: [
      { title: "새 평균단가", body: "기존 보유분과 추가 매수분을 합산해 조정된 평균 취득단가를 보여줍니다." },
      { title: "총 투자금", body: "추가 매수 후 전체 원금 규모를 확인해 포지션 과대화를 방지할 수 있습니다." },
      { title: "미실현 손익", body: "현재가를 입력하면 평가금액과 손익률을 함께 계산합니다." },
    ],
    relatedTitle: "관련 계산기",
    related: [
      { href: "/ko/dividend-tracker/", label: "배당 추적기", desc: "예상 배당금과 지급 주기를 기록합니다." },
      { href: "/ko/dividend-calendar/", label: "배당 캘린더", desc: "배당락·지급 일정을 확인합니다." },
      { href: "/ko/savings-comparison-calculator/", label: "저축 상품 비교", desc: "예금·적금·ISA의 세후 수령액을 비교합니다." },
    ],
    disclaimer: "투자 자문이 아닙니다. 실제 수익률은 거래 수수료, 세금, 환율, 체결가, 배당금, 시장 변동성에 따라 달라질 수 있습니다.",
  },
  en: {
    eyebrow: "Investment calculator",
    introTitle: "What is the stock yield calculator?",
    intro: "This tool combines your current shares, average cost, and a planned additional purchase to estimate the new average cost, total invested, market value, and unrealized P&L. Use it to understand how averaging down changes your break-even point before committing more capital.",
    howToTitle: "How to use",
    steps: ["Enter your current shares and average cost.", "Enter the shares and price for the additional purchase.", "Add the current price if you want market value and unrealized P&L.", "Review fees, taxes, FX, dividends, and portfolio risk separately before deciding."],
    highlightsTitle: "What it shows",
    highlights: [
      { title: "New average cost", body: "Blends current holdings and the new purchase into a revised cost basis." },
      { title: "Total invested", body: "Shows the enlarged position size after the additional purchase." },
      { title: "Unrealized P&L", body: "Uses the current price to estimate market value and percentage gain or loss." },
    ],
    relatedTitle: "Related calculators",
