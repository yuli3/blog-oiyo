const faqs = {
  ko: [
    { q: "물타기하면 항상 손실이 줄어드나요?", a: "평균단가는 낮아질 수 있지만 총 투자금과 종목 집중도도 커집니다. 주가가 계속 하락하면 손실 규모가 더 커질 수 있습니다." },
    { q: "수수료와 세금은 포함되나요?", a: "아니요. 이 계산기는 단순 평균단가와 평가손익 계산용이며, 거래 수수료·세금·환율은 별도로 반영해야 합니다." },
    { q: "현재 주가를 입력하지 않아도 되나요?", a: "가능합니다. 현재 주가를 비워두면 평균단가 계산 중심으로 사용할 수 있고, 손익 계산은 제한됩니다." },
  ],
  en: [
    { q: "Does averaging down always reduce my loss?", a: "It can lower the average cost, but it also increases total capital at risk. If the stock keeps falling, the loss can grow." },
    { q: "Are fees and taxes included?", a: "No. The tool estimates cost basis and unrealized P&L only. Add brokerage fees, taxes, and FX separately." },
    { q: "Do I need to enter the current price?", a: "No. Without a current price, the tool is mainly for the new average cost; P&L output is limited." },
  ],
  ja: [
    { q: "ナンピンすれば必ず損失は減りますか？", a: "平均取得単価は下がる場合がありますが、総投資額と集中リスクも増えます。下落が続けば損失は拡大します。" },
    { q: "手数料や税金は含まれますか？", a: "含まれません。取得単価と未実現損益の簡易計算であり、手数料・税金・為替は別途考慮してください。" },
    { q: "現在株価は必須ですか？", a: "必須ではありません。空欄の場合は平均取得単価の確認が中心になります。" },
  ],
};

const m = meta[locale] ?? meta.en;
const { content: c, faqHeading, faqItems } = buildToolShell(content, faqs, locale);
const componentLocale = locale === "ko" ? "ko" : "en";
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <ToolShell
    title={m.title}
    description={m.description}
    siteUrl={siteConfig.url}
    locale={locale}
    slug="stock-yield-calculator"
    content={c}
    applicationCategory="FinanceApplication"
  >
    <StockYieldCalculatorComp client:visible locale={componentLocale} />
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>