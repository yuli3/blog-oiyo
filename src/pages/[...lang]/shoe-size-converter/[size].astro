---
import { shoeSizePages } from "../../../lib/shoe-size-equivalent";
export function getStaticPaths() {
  return (["ko", "en"] as const).flatMap((lang) => shoeSizePages(lang).map((page) => ({ params: { lang, size: page.slug } })));
}
// WHY 2026-10-27 (W6b): the per-size pages moved to Tools with the converter; same paths there.
return Astro.redirect(`https://tools.oiyo.net/${Astro.params.lang}/shoe-size-converter/${Astro.params.size}/`, 301);
---
