---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InsightQuestTestComp from "../../components/tests/InsightQuestTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "인사이트 퀘스트: 나의 MBTI 성격 유형은?", description: "8개의 이분법적 질문으로 16가지 MBTI 성격 유형 중 나의 유형을 알아보세요." },
  en: { title: "Insight Quest: What's Your MBTI Personality Type?", description: "Discover your personality type among 16 MBTI types with 8 binary-choice questions." },
  ja: { title: "インサイトクエスト：あなたのMBTI性格タイプは？", description: "8つの二択質問で16のMBTI性格タイプの中からあなたのタイプを診断します。" },
  fr: { title: "Insight Quest : Quel est votre type de personnalité MBTI?", description: "Découvrez votre type de personnalité parmi 16 types MBTI avec 8 questions à choix binaire." },
  es: { title: "Insight Quest: ¿Cuál es tu tipo de personalidad MBTI?", description: "Descubre tu tipo de personalidad entre 16 tipos MBTI con 8 preguntas de elección binaria." },
  zh: { title: "洞察探索：你的MBTI性格類型是什麼？", description: "通過8個二元選擇題，在16種MBTI性格類型中找出你的類型。" },
  cn: { title: "洞察探索：你的MBTI性格类型是什么？", description: "通过8个二元选择题，在16种MBTI性格类型中找出你的类型。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <InsightQuestTestComp client:load locale={locale} />
  </main>
</BaseLayout>
