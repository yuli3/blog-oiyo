---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CheckersComp from "../../components/games/Checkers";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "체커스 — 클래식 체커 보드 게임",
    description: "온라인 체커스 게임을 즐겨보세요. 상대방의 말을 모두 잡거나 움직임을 막으면 승리합니다.",
  },
  en: {
    title: "Checkers Board Game",
    description: "Play Checkers online. Capture all your opponent's pieces or block their moves to win.",
  },
  ja: {
    title: "チェッカーズ — クラシックチェッカーボードゲーム",
    description: "オンラインチェッカーズを楽しもう。相手の駒をすべて取るか、動きを封じれば勝利です。",
  },
  fr: {
    title: "Jeu de Dames — Le classique jeu de plateau",
    description: "Jouez aux dames en ligne. Capturez toutes les pièces de votre adversaire ou bloquez ses mouvements pour gagner.",
  },
  es: {
    title: "Juego de Damas — El clásico juego de tablero",
    description: "Juega a las damas en línea. Captura todas las piezas de tu oponente o bloquea sus movimientos para ganar.",
  },
  zh: {
    title: "西洋跳棋 — 经典跳棋棋盘游戏",
    description: "享受线上西洋跳棋游戏。吃掉对方所有棋子或封锁其移动即可获胜。",
  },
  cn: {
    title: "西洋跳棋 — 经典跳棋棋盘游戏",
    description: "享受在线西洋跳棋游戏。吃掉对方所有棋子或封锁其移动即可获胜。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <CheckersComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
  </main>
</BaseLayout>
