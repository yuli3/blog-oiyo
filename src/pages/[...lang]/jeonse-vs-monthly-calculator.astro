---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JeonseVsMonthlyCalculator from "../../components/tools/JeonseVsMonthlyCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";

const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "전세 vs 월세 기회비용 비교 계산기 2026 — 실질 주거비 & 전월세전환율 분석";
const description = "전세대출 이자, 예금 기회비용, 월세 세액공제(최대 17%), 법정 전월세전환율(5.25%)을 입체적으로 대조하여 실질적으로 가장 저렴한 임대차 방식을 도출합니다.";

const ko = {
  eyebrow: "부동산 임대차 도구",
  introTitle: "전세와 월세, 무엇이 내 통장에 진짜 이득일까요?",
  intro: "단순히 월세 100만 원과 전세 보증금 3억 원을 비교하면 안 됩니다. 전세 보증금에 묶이는 자기자본의 예금·투자 기회비용, 전세대출 금리(연 3~4%), 그리고 월세 세액공제(총급여 7천만 원 이하 15~17%) 혜택까지 반영해야 실제 매달 빠져나가는 실질 주거비가 드러납니다. 이 계산기로 두 선택지의 월·연간 주거비용과 법정 전월세전환율을 정밀 비교해 보세요.",
  howToTitle: "사용 방법",
  steps: [
    "비교 대상 주택의 전세 보증금, 대출 예상 비율(0~80%), 대출 금리와 예금 금리를 입력합니다.",
    "월세 보증금, 월세액 및 연말정산 월세 세액공제 해당 여부를 선택합니다.",
    "양측의 월 실질 주거비용과 매달 절약되는 금액 차이를 확인합니다.",
    "해당 매물의 실질 전월세전환율과 한국은행 기준 법정 전월세전환율(5.25%)을 비교 분석합니다.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "기회비용 정밀 연산", body: "목돈 보증금의 정기예금 이자 기회비용과 전세대출 이자액을 정확히 분리 계산합니다." },
    { title: "월세 세액공제 반영", body: "무주택 근로소득자의 월세액 최대 15~17%(연 127.5만 원 한도) 절세 환급금을 월 비용에서 자동 차감합니다." },
    { title: "전월세전환율 검증", body: "주택임대차보호법 제7조의2 기준금리+2% 법정 상한과 매물 실제 전환율을 대조합니다." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/jeonse-guarantee-calculator/", label: "전세보증보험 계산기", desc: "HUG 반환보증료와 안심전세 요건을 봅니다." },
    { href: "/ko/first-home-tax-calculator/", label: "생애최초 취득세 계산기", desc: "내 집 마련 시 최대 200만 원 감면을 봅니다." },
    { href: "/ko/salary-calculator/", label: "연봉 실수령액 계산기", desc: "월 소득 대비 주거비 지출 비중을 점검합니다." },
  ],
  disclaimer: "본 계산기는 세전 금리와 표준 월세 세액공제율을 바탕으로 산출한 시뮬레이션입니다. 실제 대출 금리(가산금리 및 우대조건), 집주인의 전세보증금 반환보증 가입 여부 및 관리비 항목 차이에 따라 최종 체감 비용이 달라질 수 있습니다.",
};

const faqs = [
  { q: "전월세전환율이란 무엇인가요?", a: "전세 보증금을 월세로 전환할 때 적용하는 연이율입니다. 계산식은 (월세 × 12개월) ÷ (전세금 - 월세보증금) × 100입니다. 이 비율이 전세대출 금리보다 높으면 전세가 유리하고, 낮으면 월세가 유리합니다." },
  { q: "법정 전월세전환율 상한선은 얼마인가요?", a: "주택임대차보호법상 '한국은행 기준금리 + 연 2.0%' 또는 '연 10%' 중 낮은 비율이 상한입니다. 현재 기준 약 5.25% 수준입니다." },
  { q: "월세 세액공제는 누구나 받을 수 있나요?", a: "과세기간 종료일 기준 무주택 세대주로서 총급여 7,000만 원 이하(종합소득 6,000만 원 이하)인 근로자가 국민주택규모(85㎡ 이하) 또는 기준시가 4억 원 이하 주택에 전입신고 후 거주하는 경우 최대 15%(총급여 5,500만 원 이하는 17%) 공제받을 수 있습니다." },
  { q: "최근 역전세·전세사기 우려 시 어떤 점을 더 봐야 하나요?", a: "전세금이 매매가의 70%를 넘지 않는지(전세가율), 집주인의 국세·지방세 체납 여부, 그리고 HUG/SGI 전세보증금반환보증 가입이 가능한지 반드시 확인해야 합니다." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="jeonse-vs-monthly-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <JeonseVsMonthlyCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 주택임대차보호법 제7조의2(월차임 전환 시 산정률의 제한), 조세특례제한법 제95조의2(월세액에 대한 세액공제). 기준일 2026년 10월.</p>
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
