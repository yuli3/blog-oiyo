    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": c.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Tools",
          "item": `https://blog.oiyo.net/${locale}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": m.title,
          "item": pageUrl
        }
      ]
    }
  ]
};
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl overflow-x-hidden px-4 py-8">
    <section class="mb-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-green-600">Height converter</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">{m.title}</h1>
    </section>

    {/* Tool first so gender-compare result is above the fold / one tab away. */}
    <HeightConverter client:load locale={locale as Locale} />

    {/* Optional S: one cross-link tile to existing ring/shoe channel only. */}
    <RelatedToolLinks locale={locale} current="height-converter" slugs={["ring-size-converter", "shoe-size-converter"]} />

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <figure class="mt-8">
      <img
        src="/img/explainers/height-converter/height-comparison.jpg"
        alt={
          locale === "ko" ? "같은 바닥선에 선 세 사람의 키가 계단처럼 다른 비교 그림"
          : locale === "ja" ? "同じ床に立つ3人の身長が階段のように違う比較イラスト"
          : locale === "zh" ? "三人站在同一地平线上、身高呈阶梯差的示意图"
          : locale === "fr" ? "Illustration de trois adultes de tailles clairement différentes sur la même ligne de sol"
          : locale === "es" ? "Ilustración de tres adultos de estaturas claramente distintas sobre la misma línea de suelo"
          : "Three adults of clearly different heights standing on the same floor line"
        }
        width="1600"
        height="900"
        class="w-full rounded-2xl border border-slate-200 bg-stone-50"
        loading="lazy"
      />
    </figure>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {c.formulas.map((formula) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="text-sm font-semibold text-slate-500">{formula.label}</h3>
            <p class="mt-2 text-lg font-black text-slate-950">{formula.value}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-green-50 p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-green-300 hover:bg-green-50" href={item.href}>
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{e.title}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-700">{e.desc}</p>
      <pre class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs leading-6 text-slate-800"><code>{embedSnippet}</code></pre>
    </section>

    <p class="mt-10 rounded-xl bg-slate-100 p-4 text-sm leading-6 text-slate-700">
      {c.disclaimer}
    </p>
  </div>
</BaseLayout>
