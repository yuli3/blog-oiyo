---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeightConverter from "../../components/tools/HeightConverter";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "키 변환기 — cm↔ft/in, 남자키 여자키 환산",
    description: "키를 cm와 ft/in으로 즉시 변환하고, 한국 평균 신장 기준의 남녀 동등 키를 계산합니다. 공식, 예시, FAQ를 함께 제공합니다.",
  },
  en: {
    title: "Height Converter — cm to ft/in, Male to Female Height",
    description: "Convert height between centimeters and feet/inches, then estimate male-to-female or female-to-male equivalent height using Korean average distributions.",
  },
  ja: {
    title: "身長変換ツール — cm↔ft/in、男女身長換算",
    description: "身長をcmとフィート/インチで変換し、韓国平均身長を基準に男女の同等身長を計算します。公式、例、FAQ付き。",
  },
  fr: {
    title: "Convertisseur de taille — cm ↔ ft/in, équivalence homme/femme",
    description: "Convertissez une taille entre cm et pieds/pouces, puis estimez l'équivalent homme-femme selon les distributions moyennes coréennes.",
  },
  es: {
    title: "Conversor de estatura — cm ↔ ft/in, equivalencia hombre/mujer",
    description: "Convierte estatura entre cm y pies/pulgadas y estima la equivalencia hombre-mujer usando promedios coreanos.",
  },
  zh: {
    title: "身高换算器 — 厘米↔英尺/英寸、男女身高换算",
    description: "在厘米与英尺/英寸之间即时换算身高，并按韩国平均身高分布估算男女等效身高。包含公式、示例与 FAQ。",
  },
};

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { label: string; value: string }[];
  useTitle: string;
  useCases: { title: string; body: string }[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  readingTitle: string;
  reading: { href: string; label: string; desc: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "cm, 피트/인치, 남녀 동등 키를 한 번에 비교하세요",
    intro: "이 키 변환기는 센티미터를 피트와 인치로 바꾸고, 반대로 ft/in을 cm로 환산합니다. 또한 한국 평균 신장 분포를 기준으로 같은 백분위에 해당하는 상대 성별 동등 키를 계산해, '남자 180cm는 여자 키로 어느 정도일까?' 같은 질문을 빠르게 확인할 수 있습니다.",
    formulaTitle: "기본 변환 공식",
    formulas: [
      { label: "cm → inch", value: "cm ÷ 2.54" },
      { label: "inch → cm", value: "inch × 2.54" },
      { label: "ft → cm", value: "ft × 30.48" },
    ],
    useTitle: "이렇게 활용하세요",
    useCases: [
      { title: "해외 표기 읽기", body: "5'7\", 5'11\", 6'1\"처럼 표시된 키를 cm로 바로 바꿉니다." },
      { title: "상대 성별 환산", body: "같은 백분위라는 관점에서 남성/여성 기준 동등 키를 봅니다." },
      { title: "평균과 비교", body: "국가별 평균 신장 표를 함께 보며 대략적인 위치를 이해합니다." },
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "남자키 여자키 환산은 정확한가요?", answer: "동등 키는 한국 평균과 표준편차를 이용해 같은 백분위에 해당하는 값을 추정한 것입니다. 문화권, 연령, 데이터 출처에 따라 달라질 수 있는 참고값입니다." },
      { question: "5'11\"은 몇 cm인가요?", answer: "5피트 11인치는 71인치이고, 71 × 2.54 = 180.34cm입니다. 보통 약 180cm로 말합니다." },
      { question: "피트와 인치를 cm로 바꾸는 공식은 무엇인가요?", answer: "(feet × 30.48) + (inches × 2.54)입니다. 예를 들어 5ft 7in은 152.4 + 17.78 = 170.18cm입니다." },
      { question: "이 페이지가 의학적 성장 예측을 하나요?", answer: "아니요. 이 도구는 단위 변환과 평균 분포 비교만 제공합니다. 성장 예측이나 건강 판단에는 의료 전문가의 조언이 필요합니다." },
    ],
    readingTitle: "더 읽기",
    reading: [
      { href: "/ko/height-converter/", label: "키 변환 공식 가이드", desc: "cm, feet, inch 변환 공식과 표준 키 표기를 정리했습니다." },
      { href: "/ko/tool-body-fat-calculator/", label: "체지방률 계산기", desc: "키와 몸무게를 함께 보는 건강 계산 도구입니다." },
    ],
    disclaimer: "성별 동등 키와 국가 평균은 통계적 참고값입니다. 개인의 건강, 성장, 신체 평가를 대신하지 않습니다.",
  },
  en: {
    introTitle: "Convert cm, feet/inches, and equivalent gender height in one place",
    intro: "This height converter changes centimeters into feet and inches, converts ft/in back to cm, and estimates an equivalent height for the opposite gender using Korean average height distributions. It is built for searches like 'female to male height converter', 'male to female height converter', and quick cm-to-feet checks.",
    formulaTitle: "Core conversion formulas",
    formulas: [
      { label: "cm → inches", value: "cm ÷ 2.54" },
      { label: "inches → cm", value: "inches × 2.54" },
      { label: "feet → cm", value: "feet × 30.48" },
    ],
    useTitle: "How to use it",
    useCases: [
      { title: "Read foreign height notation", body: "Turn heights like 5'7\", 5'11\", or 6'1\" into centimeters instantly." },
      { title: "Compare gender-equivalent height", body: "Estimate the opposite-gender height at roughly the same percentile." },
      { title: "Check average context", body: "Use country averages as context, not as a judgment about any individual body." },
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Is male-to-female height conversion exact?", answer: "No. It estimates the height at a similar percentile using Korean average and standard deviation values. It is a reference, not a universal biological rule." },
      { question: "How many cm is 5'11\"?", answer: "5 feet 11 inches is 71 inches. 71 × 2.54 = 180.34 cm, usually rounded to about 180 cm." },
      { question: "What is the ft/in to cm formula?", answer: "(feet × 30.48) + (inches × 2.54). For example, 5ft 7in is 152.4 + 17.78 = 170.18 cm." },
      { question: "Does this predict growth or health?", answer: "No. This page converts units and compares statistical averages. It does not predict growth or provide medical advice." },
    ],
    readingTitle: "Read more",
    reading: [
      { href: "/en/height-converter/", label: "Height conversion formula guide", desc: "A compact guide to cm, feet, inches, and common reference heights." },
      { href: "/en/child-height-calculator/", label: "Child height predictor", desc: "Estimate a child's adult height from the parents' heights (mid-parental formula)." },
      { href: "/en/height-predictor/", label: "Adult height predictor", desc: "Project likely adult height and see how the numbers compare." },
      { href: "/en/tool-body-fat-calculator/", label: "Body fat calculator", desc: "A related body metric tool that also uses height and weight." },
    ],
    disclaimer: "Gender-equivalent height and country averages are statistical references only. They do not define health, attractiveness, or personal value.",
  },
  ja: {
    introTitle: "cm、フィート/インチ、男女の同等身長をまとめて比較",
    intro: "この身長変換ツールは、センチメートルをフィート/インチへ、また ft/in を cm へ変換します。さらに韓国の平均身長分布を基準に、同じパーセンタイルに近い男女の同等身長を推定します。",
    formulaTitle: "基本の変換公式",
    formulas: [
      { label: "cm → inch", value: "cm ÷ 2.54" },
      { label: "inch → cm", value: "inch × 2.54" },
      { label: "ft → cm", value: "ft × 30.48" },
    ],
    useTitle: "使い方",
    useCases: [
      { title: "海外表記を読む", body: "5'7\"、5'11\"、6'1\" のような表記をすぐ cm に変換します。" },
      { title: "男女の同等身長を見る", body: "同じパーセンタイルという見方で、別の性別基準の身長を推定します。" },
      { title: "平均と比較する", body: "国別平均身長は文脈として見て、個人評価には使わないでください。" },
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "男女身長換算は正確ですか？", answer: "韓国平均と標準偏差を使い、近いパーセンタイルの値を推定した参考値です。国、年齢、データで変わります。" },
      { question: "5'11\"は何cmですか？", answer: "5フィート11インチは71インチで、71 × 2.54 = 180.34cmです。通常は約180cmです。" },
      { question: "ft/inをcmにする公式は？", answer: "(feet × 30.48) + (inches × 2.54)です。5ft 7inなら約170.18cmです。" },
      { question: "成長や健康を予測できますか？", answer: "いいえ。単位変換と統計的比較のみで、成長予測や医療判断ではありません。" },
    ],
    readingTitle: "詳しく読む",
    reading: [
      { href: "/ja/height-converter/", label: "身長変換公式ガイド", desc: "cm、feet、inch の変換式と参考表です。" },
      { href: "/ja/tool-body-fat-calculator/", label: "体脂肪率計算機", desc: "身長と体重を使う関連ツールです。" },
    ],
    disclaimer: "男女の同等身長と国別平均は統計上の参考値です。健康や個人の価値を判断するものではありません。",
  },
  fr: {
    introTitle: "Convertir cm, pieds/pouces et taille équivalente homme/femme",
    intro: "Ce convertisseur transforme les centimètres en pieds/pouces, reconvertit ft/in en cm et estime une taille équivalente pour l'autre sexe à partir des distributions moyennes coréennes.",
    formulaTitle: "Formules de conversion",
    formulas: [
      { label: "cm → pouces", value: "cm ÷ 2.54" },
      { label: "pouces → cm", value: "pouces × 2.54" },
      { label: "pieds → cm", value: "pieds × 30.48" },
    ],
    useTitle: "Comment l'utiliser",
    useCases: [
      { title: "Lire les notations étrangères", body: "Convertissez 5'7\", 5'11\" ou 6'1\" en centimètres." },
      { title: "Comparer l'équivalent homme/femme", body: "Estimez la taille de l'autre sexe à percentile similaire." },
      { title: "Ajouter le contexte moyen", body: "Les moyennes par pays donnent un contexte, pas une évaluation personnelle." },
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "La conversion homme/femme est-elle exacte ?", answer: "Non. Elle estime un percentile similaire avec moyenne et écart type coréens. C'est un repère statistique, pas une règle universelle." },
      { question: "Combien font 5'11\" en cm ?", answer: "5 pieds 11 pouces font 71 pouces. 71 × 2.54 = 180.34 cm, soit environ 180 cm." },
      { question: "Quelle est la formule ft/in vers cm ?", answer: "(pieds × 30.48) + (pouces × 2.54). Par exemple, 5ft 7in fait environ 170.18 cm." },
      { question: "Cet outil prédit-il la croissance ou la santé ?", answer: "Non. Il convertit des unités et compare des moyennes statistiques; il ne fournit pas d'avis médical." },
    ],
    readingTitle: "Lire plus",
    reading: [
      { href: "/fr/height-converter/", label: "Guide des formules de taille", desc: "Un guide cm, pieds, pouces et tailles courantes." },
      { href: "/fr/tool-body-fat-calculator/", label: "Calculateur de masse grasse", desc: "Un outil lié qui utilise aussi taille et poids." },
    ],
    disclaimer: "Les équivalences homme/femme et les moyennes par pays sont seulement des références statistiques.",
  },
  es: {
    introTitle: "Convierte cm, pies/pulgadas y estatura equivalente hombre/mujer",
    intro: "Este conversor cambia centímetros a pies y pulgadas, convierte ft/in a cm y estima una estatura equivalente para el otro género usando distribuciones promedio coreanas.",
    formulaTitle: "Fórmulas básicas",
    formulas: [
      { label: "cm → pulgadas", value: "cm ÷ 2.54" },
      { label: "pulgadas → cm", value: "pulgadas × 2.54" },
      { label: "pies → cm", value: "pies × 30.48" },
    ],
    useTitle: "Cómo usarlo",
    useCases: [
      { title: "Leer medidas extranjeras", body: "Convierte alturas como 5'7\", 5'11\" o 6'1\" a centímetros." },
      { title: "Comparar equivalencia por género", body: "Estima una altura del otro género con un percentil parecido." },
      { title: "Ver contexto promedio", body: "Usa promedios por país como contexto, no como juicio personal." },
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿La conversión hombre/mujer es exacta?", answer: "No. Estima un valor de percentil similar con media y desviación estándar coreanas. Es una referencia estadística, no una regla universal." },
      { question: "¿Cuántos cm son 5'11\"?", answer: "5 pies 11 pulgadas son 71 pulgadas. 71 × 2.54 = 180.34 cm, normalmente unos 180 cm." },
      { question: "¿Cuál es la fórmula de ft/in a cm?", answer: "(pies × 30.48) + (pulgadas × 2.54). Por ejemplo, 5ft 7in son unos 170.18 cm." },
      { question: "¿Predice crecimiento o salud?", answer: "No. Solo convierte unidades y compara promedios estadísticos; no ofrece consejo médico." },
    ],
    readingTitle: "Leer más",
    reading: [
      { href: "/es/height-converter/", label: "Guía de fórmulas de estatura", desc: "Una guía de cm, pies, pulgadas y alturas comunes." },
      { href: "/es/tool-body-fat-calculator/", label: "Calculadora de grasa corporal", desc: "Herramienta relacionada que usa estatura y peso." },
    ],
    disclaimer: "La equivalencia hombre/mujer y los promedios por país son solo referencias estadísticas.",
  },
  zh: {
    introTitle: "一次换算厘米、英尺/英寸与男女等效身高",
    intro: "这个身高换算器可将厘米转换为英尺/英寸，也可将 ft/in 转回厘米，并按韩国平均身高分布估算另一性别中相近百分位的等效身高。",
    formulaTitle: "基础换算公式",
    formulas: [
      { label: "cm → inch", value: "cm ÷ 2.54" },
      { label: "inch → cm", value: "inch × 2.54" },
      { label: "ft → cm", value: "ft × 30.48" },
    ],
    useTitle: "如何使用",
    useCases: [
      { title: "读懂海外身高写法", body: "将 5'7\"、5'11\"、6'1\" 这类写法快速换成厘米。" },
      { title: "查看男女等效身高", body: "用相近百分位的角度估算另一性别基准下的身高。" },
      { title: "结合平均身高参考", body: "国家平均身高只适合作背景，不应作为个人评价。" },
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "男女身高换算准确吗？", answer: "它使用韩国平均值和标准差估算相近百分位，是统计参考值，不是普遍规则。" },
      { question: "5'11\"是多少厘米？", answer: "5英尺11英寸等于71英寸，71 × 2.54 = 180.34厘米，通常约为180厘米。" },
      { question: "ft/in 转 cm 的公式是什么？", answer: "(feet × 30.48) + (inches × 2.54)。例如 5ft 7in 约为170.18厘米。" },
      { question: "它能预测成长或健康吗？", answer: "不能。本页面只做单位换算和统计平均比较，不提供医疗建议。" },
    ],
    readingTitle: "延伸阅读",
    reading: [
      { href: "/zh/height-converter/", label: "身高换算公式指南", desc: "厘米、英尺、英寸与常见身高参考表。" },
      { href: "/zh/tool-body-fat-calculator/", label: "体脂率计算器", desc: "同样使用身高与体重的相关工具。" },
    ],
    disclaimer: "男女等效身高与国家平均身高仅为统计参考，不代表健康、吸引力或个人价值。",
  },
};

const m = meta[locale];
const c = content[locale];
const pageUrl = `https://blog.oiyo.net/${locale}/height-converter/`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      "name": m.title,
      "url": pageUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web",
      "description": m.description,
      "isAccessibleForFree": true
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      "name": c.useTitle,
      "step": c.useCases.map((item, index) => ({
        "@type": "HowToStep",
        "position": index + 1,
        "name": item.title,
        "text": item.body
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": c.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Tools",
          "item": `https://blog.oiyo.net/${locale}/tools/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": m.title,
          "item": pageUrl
        }
      ]
    }
  ]
};
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-8">
    <section class="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Height converter</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">{m.title}</h1>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <HeightConverter client:load locale={locale as Locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-950">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {c.formulas.map((formula) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="text-sm font-semibold text-slate-500">{formula.label}</h3>
            <p class="mt-2 text-lg font-black text-slate-950">{formula.value}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.useTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.useCases.map((item) => (
          <article class="rounded-xl bg-indigo-50 p-4">
            <h3 class="font-semibold text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-950">
              {faq.question}
            </summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-950">{c.readingTitle}</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {c.reading.map((item) => (
          <a class="rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-indigo-300 hover:bg-indigo-50" href={item.href}>
            <span class="font-semibold text-slate-950">{item.label}</span>
            <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <p class="mt-10 rounded-xl bg-slate-100 p-4 text-sm leading-6 text-slate-700">
      {c.disclaimer}
    </p>
  </div>
</BaseLayout>
