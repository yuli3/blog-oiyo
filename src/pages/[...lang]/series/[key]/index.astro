---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WikiTable from "../../../../components/WikiTable.astro";
import { getTranslations, locales } from "../../../../lib/i18n";
import type { Locale } from "../../../../lib/i18n";
import { buildSeriesIndex, isRedirectStub, isUrlSafeSeriesKey, type SeriesEntry } from "../../../../lib/wiki-index";
import { seriesDisplayName } from "../../../../data/priority-series";
import { collectionPageJsonLd } from "../../../../lib/seo/structured-data";
import { siteConfig } from "../../../../config/site.config";

export async function getStaticPaths() {
  // Without the stub filter a series whose chapters were all redirected away
  // still builds a hub page — /ko/series/corporate-finance/ rendered
  // "재무관리의 기초 · 8 챕터" where every one of the 8 links redirects
  // elsewhere. Stubs are noindex ex-URLs, so they must not count as chapters.
  const allPosts = await getCollection(
    "blog",
    ({ data }) => data.draft !== true && !isRedirectStub(data),
  );
  const seriesByLocale = new Map(
    locales.map((lang) => [
      lang,
      buildSeriesIndex(allPosts.filter((p) => p.data.locale === lang)),
    ]),
  );

  return locales.flatMap((lang) => {
    const series = Array.from(seriesByLocale.get(lang)?.values() ?? []);
    const validSeries = series.filter(
      (s) => s.chapterCount >= 2 && isUrlSafeSeriesKey(s.key),
    );
    // Single-post "series" would just duplicate the article itself — only
    // multi-chapter series get a dedicated hub page.
    return validSeries.map((s) => {
      const siblingSeries = validSeries
        .filter((other) => other.key !== s.key && other.category === s.category)
        .sort((a, b) => b.chapterCount - a.chapterCount || a.key.localeCompare(b.key))
        .slice(0, 24)
        .map((other) => ({
          key: other.key,
          title: seriesDisplayName(other.key, lang, other.firstPost.data.title),
          chapterCount: other.chapterCount,
        }));
      return {
        params: { lang, key: s.key },
        props: {
          locale: lang,
          series: s,
          siblingSeries,
          availableLocales: locales.filter((candidate) => {
            const candidateSeries = seriesByLocale.get(candidate)?.get(s.key);
            return candidateSeries !== undefined && candidateSeries.chapterCount >= 2;
          }),
        },
      };
    });
  });
}

const { locale, series, siblingSeries, availableLocales } = Astro.props as {
  locale: Locale;
  series: SeriesEntry;
  siblingSeries: Array<{ key: string; title: string; chapterCount: number }>;
  availableLocales: Locale[];
};
const t = await getTranslations(locale);
const courseT = (t as Record<string, unknown>).courses as Record<string, string> | undefined;
const categoryNames = (t.category.names ?? {}) as Record<string, string>;

const displayName = seriesDisplayName(series.key, locale, series.firstPost.data.title);
const categoryLabel = categoryNames[series.category] ?? series.category;
const chaptersLabel = courseT?.chapters ?? "chapters";
const startLabel = courseT?.startCourse ?? "Start";
const navT = (t as Record<string, unknown>).nav as Record<string, string> | undefined;
const homeLabel = navT?.home ?? "Home";
const siblingHeading: Record<Locale, string> = {
  ko: `${categoryLabel} 분야의 다른 강의`,
  en: `More courses in ${categoryLabel}`,
  ja: `${categoryLabel}分野の他のコース`,
  zh: `${categoryLabel}领域的其他课程`,
  fr: `Autres cours en ${categoryLabel}`,
  es: `Más cursos de ${categoryLabel}`,
};

const firstSlug = series.firstPost.slug.split("/").slice(1).join("/");
const firstHref = `/${locale}/${firstSlug}/`;
const pageUrl = `${siteConfig.url}/${locale}/series/${series.key}/`;

const jsonLd = JSON.stringify(
  collectionPageJsonLd({
    name: displayName,
    description: series.firstPost.data.description ?? displayName,
    url: pageUrl,
    inLanguage: locale,
    items: series.posts.map((p) => ({
      name: p.data.title,
      url: `${siteConfig.url}/${locale}/${p.slug.split("/").slice(1).join("/")}/`,
    })),
  }),
);
---

<BaseLayout
  title={`${displayName} — ${series.chapterCount} ${chaptersLabel}`}
  description={series.firstPost.data.description ?? displayName}
  canonicalUrl={pageUrl}
  availableLocales={availableLocales}
>
  <script is:inline type="application/ld+json" set:html={jsonLd} />

  <section class="py-10 md:py-16">
    <div class="container px-4">
      <div class="mb-5 sm:mb-8 max-w-3xl">
        <a href={`/${locale}/`} class="mb-4 inline-block text-xs font-semibold text-muted-foreground hover:text-primary">
          ← {homeLabel}
        </a>
        <p class="mb-2 text-[11px] font-black uppercase tracking-[0.2em] text-primary">{categoryLabel}</p>
        <h1 class="mb-3 text-3xl font-extrabold tracking-tight md:text-4xl">{displayName}</h1>
        <p class="text-sm text-muted-foreground">
          {series.chapterCount} {chaptersLabel}
        </p>
      </div>

      <div class="mb-5 sm:mb-8 max-w-3xl">
        <WikiTable posts={series.posts} locale={locale} showSeries={false} />
      </div>

      <a
        href={firstHref}
        class="inline-flex items-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        {startLabel}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </a>

      {siblingSeries && siblingSeries.length > 0 && (
        <aside class="mt-12 max-w-3xl border-t border-border pt-8" aria-label={siblingHeading[locale] ?? siblingHeading.en}>
          <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-muted-foreground">
            {siblingHeading[locale] ?? siblingHeading.en}
          </h2>
          <div class="grid gap-2.5 sm:grid-cols-2">
            {siblingSeries.map((sib) => (
              <a
                href={`/${locale}/series/${sib.key}/`}
                class="flex items-baseline justify-between gap-3 rounded-lg border border-border bg-card/60 px-4 py-3 text-sm font-semibold text-foreground transition-colors hover:border-primary/50 hover:text-primary"
              >
                <span class="truncate">{sib.title}</span>
                <span class="shrink-0 font-mono text-xs font-normal tabular-nums text-muted-foreground">
                  {sib.chapterCount} {chaptersLabel}
                </span>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
