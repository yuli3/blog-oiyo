---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import ToolsCompanionBanner from "../../components/ToolsCompanionBanner.astro";
import TypingSpeedCalculator from "../../components/tools/TypingSpeedCalculator";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string; eyebrow: string }> = {
  ko: {
    title: "타자 속도 CPM·WPM 측정기 — 타자 자격증 등급 판정 및 정확도 테스트",
    description: "실시간 타자 속도(타/분, CPM) 및 분당 단어수(WPM), 정확도를 측정하고 대한상공회의소 워드프로세서 실기 및 속기사 기준 자격증 등급을 즉시 판정합니다.",
    eyebrow: "타자 실력과 타이핑 생산성의 과학",
  },
  en: {
    title: "Typing Speed CPM & WPM Test — Typing Certificate Tier & Accuracy Test",
    description: "Measure live typing speed in Characters Per Minute (CPM) and Words Per Minute (WPM), test accuracy, and evaluate official typing speed certification tiers.",
    eyebrow: "Productivity & Speed Metrics",
  },
  ja: {
    title: "タイピング速度測定器 (CPM/WPM) — タイピング検定級数判定＆正確度テスト",
    description: "リアルタイムで文字数/分(CPM)と単語数/分(WPM)、打건正確度を測定し、タイピング検定の級数や全国ランキング目安を即時判定します。",
    eyebrow: "タイピング生産性の測定",
  },
  zh: {
    title: "打字速度测试仪 (CPM/WPM) — 打字等级评估与准确率测试",
    description: "实时测试每分钟字符数(CPM)与词数(WPM)、打字准确率，评估打字速度认证等级，助力提升数字办公与编码生产力。",
    eyebrow: "打字速度与办公效率",
  },
  fr: {
    title: "Test de vitesse de frappe CPM & WPM — Précision et niveau de dactylographie",
    description: "Mesurez en direct votre vitesse de frappe en caractères par minute (CPM) et mots par minute (WPM), évaluez votre précision et découvrez votre niveau de dactylo.",
    eyebrow: "Vitesse et Précision",
  },
  es: {
    title: "Test de velocidad de mecanografía CPM y WPM — Nivel y precisión de tipeo",
    description: "Calcula en tiempo real tu velocidad de escritura en caracteres por minuto (CPM) y palabras por minuto (WPM), precisión y nivel certificado de mecanografía.",
    eyebrow: "Métricas de Mecanografía",
  },
};

const content: Record<
  ActiveLocale,
  {
    introTitle: string;
    intro: string;
    guideTitle: string;
    guides: Array<{ title: string; body: string }>;
    faqTitle: string;
    faqs: Array<{ question: string; answer: string }>;
  }
> = {
  ko: {
    introTitle: "CPM과 WPM의 차이와 자격증 기준",
    intro: "CPM(Characters Per Minute, 타/분)은 공백을 포함하거나 제외한 순수 글자 수를 1분 기준으로 환산한 지표이며, 한국어와 일본어, 중국어 등 음절 문자권에서 널리 쓰입니다. WPM(Words Per Minute, 분당 단어수)은 영미권 표준으로 표준 5글자를 1단어로 간주(CPM ÷ 5)하여 측정합니다.",
    guideTitle: "타자 속도 등급 및 향상 팁",
    guides: [
      {
        title: "홈 포지션과 핑거링",
        body: "키보드의 F키와 J키 돌기에 양손 검지를 두고, 각 손가락이 담당하는 자판 구역을 일정하게 유지하면 시선을 모니터에 고정한 채 타자 속도를 200타 이상 끌어올릴 수 있습니다.",
      },
      {
        title: "정확도가 속도보다 우선",
        body: "오타를 내고 백스페이스로 수정하는 시간은 일반 타건 시간의 3~4배를 소모합니다. 98% 이상의 정확도를 유지하는 것이 최종 CPM을 극대화하는 지름길입니다.",
      },
      {
        title: "워드 실기 및 공공 자격증 기준",
        body: "대한상공회의소 워드프로세서 실기 합격 기준은 통상 300~350 CPM 이상이며, 전문 속기사는 600~800 CPM 이상의 경이적인 속도를 발휘합니다.",
      },
    ],
    faqTitle: "자주 묻는 질문 (FAQ)",
    faqs: [
      {
        question: "일반 직장인의 평균 타자 속도는 얼마인가요?",
        answer: "일반 성인 사무직의 한글 평균 타자 속도는 약 250~350 CPM 내외입니다. 400 CPM 이상이면 상위 10% 이내의 빠른 타이퍼에 속합니다.",
      },
      {
        question: "영문 WPM을 한글 CPM으로 환산하려면 어떻게 하나요?",
        answer: "영문 1단어는 표준적으로 5글자로 계산되므로, WPM에 5를 곱하면 대략적인 CPM이 됩니다. (예: 60 WPM = 약 300 CPM)",
      },
    ],
  },
  en: {
    introTitle: "Understanding CPM, WPM and Typing Standards",
    intro: "CPM measures raw characters typed per minute, while WPM (Words Per Minute) divides CPM by 5 (standard word length). High typing speed coupled with high accuracy directly multiplies daily writing and coding productivity.",
    guideTitle: "Speed Tiers & Improvement Tips",
    guides: [
      {
        title: "Home Row Mastery",
        body: "Anchor your index fingers on the F and J bumps. Memorizing key reaches without looking at the keyboard is essential for breaking the 80 WPM threshold.",
      },
      {
        title: "Accuracy Over Raw Speed",
        body: "Backspacing penalties kill your speed momentum. Maintain 98%+ accuracy for the smoothest rhythm and highest sustainable WPM.",
      },
      {
        title: "Professional Benchmarks",
        body: "Average office workers type 40 WPM. Coders and writers typically hit 65-85 WPM, while competitive speed-typists exceed 120+ WPM.",
      },
    ],
    faqTitle: "Frequently Asked Questions",
    faqs: [
      {
        question: "What is considered a good typing speed?",
        answer: "Above 50 WPM (250 CPM) is above average, while 70-80 WPM represents high professional proficiency.",
      },
      {
        question: "How do CPM and WPM relate?",
        answer: "In international typing benchmarks, 1 Word is universally standardized as 5 characters. Thus WPM = CPM / 5.",
      },
    ],
  },
  ja: {
    introTitle: "CPM・WPMとタイピング技能基準",
    intro: "CPM（打鍵数/分）は1分間に入力できた文字数を示し、WPM（ワード数/分）は英単語換算の速度です。正確性を維持しながら練習を重ねることで、ビジネス文書作成速度が劇的に向上します。",
    guideTitle: "速度等級と上達のコツ",
    guides: [
      {
        title: "ホームポジションの徹底",
        body: "FキーとJキーを基点とし、ブラインドタッチを身につけることが300打/分突破の最重要ポイントです。",
      },
      {
        title: "正確率98%を目指す",
        body: "ミスタッチによる修正時間を減らすことが、結果的に平均打鍵速度を大きく押し上げます。",
      },
      {
        title: "検定級数の目安",
        body: "日本タイピング技能検定では200〜300 CPMで3〜2級、400 CPM以上で準1級以上の実力と評価されます。",
      },
    ],
    faqTitle: "よくある質問",
    faqs: [
      {
        question: "一般ビジネスパーソンの平均速度は？",
        answer: "日本語入力でおよそ200〜300 CPM（打/分）が標準的な実務速度です。",
      },
      {
        question: "WPMとCPMの換算式は？",
        answer: "標準規格として1単語＝5文字と定義されており、WPM＝CPM÷5で換算できます。",
      },
    ],
  },
  zh: {
    introTitle: "CPM与WPM打字速度标准解析",
    intro: "CPM代表每分钟击键/字符数，WPM代表每分钟词数。准确率与输入速度相辅相成，是现代办公与编程开发的基础核心生产力指标。",
    guideTitle: "速度分级与提升指南",
    guides: [
      {
        title: "盲打与指法基准",
        body: "双手食指归位在F与J定位键上，建立肌肉记忆，无需低头看键盘即可稳定突破300 CPM。",
      },
      {
        title: "控制准确率",
        body: "退格消除错误所损耗的时间极其高昂。保持98%以上的击键准确率是冲刺高分的最快途径。",
      },
      {
        title: "专业职业门槛",
        body: "普通办公人员速度在40-60 WPM之间，程序员通常在70 WPM左右，速记员可达120 WPM以上。",
      },
    ],
    faqTitle: "常见问题解答",
    faqs: [
      {
        question: "打字多快算熟练？",
        answer: "中文输入达到60-80字/分，英文达到50 WPM（250 CPM）以上即算熟练水平。",
      },
      {
        question: "CPM与WPM如何互相转换？",
        answer: "国际标准通常将5个字符换算为1个标准词，即 WPM = CPM ÷ 5。",
      },
    ],
  },
  fr: {
    introTitle: "Comprendre les unités CPM et WPM",
    intro: "Le CPM mesure le nombre de caractères frappés par minute, tandis que le WPM divise ce résultat par 5 mots standards. La précision est le facteur clé pour atteindre une frappe fluide et rapide.",
    guideTitle: "Niveaux de vitesse et conseils",
    guides: [
      {
        title: "Position des mains",
        body: "Placez vos index sur les touches F et J pour mémoriser l'emplacement des touches sans regarder le clavier.",
      },
      {
        title: "Priorité à la précision",
        body: "Corriger une erreur coûte trois fois plus de temps. Visez 98 % de précision constante.",
      },
      {
        title: "Repères de performance",
        body: "40 WPM est la moyenne bureautique. Au-delà de 70 WPM, vous appartenez aux utilisateurs très rapides.",
      },
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      {
        question: "Quelle est la bonne vitesse de frappe ?",
        answer: "Entre 45 et 60 WPM est un excellent niveau pour la plupart des professions numériques.",
      },
      {
        question: "Comment convertir WPM en CPM ?",
        answer: "Il suffit de multiplier le nombre de WPM par 5 pour obtenir le CPM approximatif.",
      },
    ],
  },
  es: {
    introTitle: "Entendiendo las métricas CPM y WPM",
    intro: "El CPM evalúa caracteres por minuto y el WPM palabras por minuto (CPM ÷ 5). Mantener una alta precisión sin mirar el teclado es clave para maximizar la productividad.",
    guideTitle: "Niveles de mecanografía y consejos",
    guides: [
      {
        title: "Fila guía y tacto",
        body: "Coloca los dedos índices sobre las teclas F y J. La mecanografía al tacto te permitirá superar los 60 WPM.",
      },
      {
        title: "Precisión antes que prisa",
        body: "Borrar errores ralentiza drásticamente el ritmo. Concéntrate en mantener una precisión superior al 98%.",
      },
      {
        title: "Estándares profesionales",
        body: "40 WPM es el promedio general, 70 WPM es avanzado y más de 100 WPM es nivel experto.",
      },
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      {
        question: "¿Qué velocidad de escritura se considera buena?",
        answer: "Entre 50 y 65 WPM es una velocidad excelente para el trabajo diario.",
      },
      {
        question: "¿Cómo se calcula el WPM a partir de CPM?",
        answer: "Por convención internacional, una palabra estándar equivale a 5 caracteres: WPM = CPM ÷ 5.",
      },
    ],
  },
};

const m = meta[locale] ?? meta.en;
const c = content[locale] ?? content.en;
---

<BaseLayout title={m.title} description={m.description}>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-8 text-center">
      <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-2">
        {m.eyebrow}
      </span>
      <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-foreground">
        {m.title.split("—")[0].trim()}
      </h1>
      <p class="text-sm text-muted-foreground mt-2 max-w-2xl mx-auto leading-relaxed">
        {m.description}
      </p>
    </div>

    <TypingSpeedCalculator client:visible locale={locale} />

    <ToolsCompanionBanner tool="tools-hub" />

    <!-- Educational Content Section -->
    <div class="mt-12 space-y-8 rounded-2xl border border-border bg-card p-6 sm:p-8">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-foreground mb-3">{c.introTitle}</h2>
        <p class="text-sm text-muted-foreground leading-relaxed">{c.intro}</p>
      </div>

      <div class="border-t border-border pt-6">
        <h2 class="text-base font-bold text-foreground mb-4">{c.guideTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {c.guides.map((g) => (
            <div class="rounded-xl border border-border bg-background p-4">
              <h3 class="text-xs font-bold text-foreground mb-1">{g.title}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{g.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="border-t border-border pt-6">
        <h2 class="text-base font-bold text-foreground mb-4">{c.faqTitle}</h2>
        <div class="space-y-4">
          {c.faqs.map((faq) => (
            <div class="rounded-xl border border-border bg-background p-4">
              <h3 class="text-xs font-bold text-foreground mb-1">Q. {faq.question}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">A. {faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8">
      <RelatedToolLinks locale={locale} current="typing-speed-calculator" slugs={["word-counter", "ascii-art-generator", "korean-spelling-quiz", "pomodoro", "timer"]} />
    </div>
  </div>
</BaseLayout>
