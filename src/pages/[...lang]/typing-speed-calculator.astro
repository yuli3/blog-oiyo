---
import { locales } from "../../lib/i18n";
export function getStaticPaths() {
  return locales.map(lang => ({params:{lang}}));
}
// WHY 2026-10-21: Keep bookmarks while retiring duplicate, unsupported certification claims.
// OIYO provides language-specific practice, not an official typing qualification.
return Astro.redirect(`https://oiyo.net/${Astro.params.lang}/typing-speed-test/`, 301);
---
