---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CreativityTypeTestComp from "../../components/tests/CreativityTypeTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "창의성 유형 테스트 — 나의 창의성은 어떤 형태인가?", description: "6가지 질문으로 발산형·수렴형·내러티브형·시스템형·미적형 중 나의 창의성 유형을 발견하세요." },
  en: { title: "Creativity Type Test — What Form Does Your Creativity Take?", description: "Discover your creativity type — Divergent, Convergent, Narrative, Systems, or Aesthetic — through 6 questions." },
  ja: { title: "創造性タイプテスト — あなたの創造性はどんな形？", description: "6つの質問で発散型・収束型・ナラティブ型・システム型・美的型のどれかを発見しましょう。" },
  fr: { title: "Test de Type de Créativité — Quelle forme prend votre créativité?", description: "Découvrez votre type de créativité à travers 6 questions." },
  es: { title: "Test de Tipo de Creatividad — ¿Qué forma tiene tu creatividad?", description: "Descubre tu tipo de creatividad a través de 6 preguntas." },
  zh: { title: "创造力类型测试 — 你的创造力是什么形式？", description: "通过6个问题发现你的创造力类型。" },
  cn: { title: "创造力类型测试 — 你的创造力是什么形式？", description: "通过6个问题发现你的创造力类型。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <CreativityTypeTestComp client:load locale={locale} />
  </main>
</BaseLayout>
