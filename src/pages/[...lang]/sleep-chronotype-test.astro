---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "수면 크로노타입",
  en: "sleep chronotype",
  ja: "睡眠クロノタイプ",
  fr: "chronotype sommeil",
  es: "cronotipo del sueño",
  zh: "睡眠时型",
  cn: "睡眠時型",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/sleep-type/test" kind="test" />
