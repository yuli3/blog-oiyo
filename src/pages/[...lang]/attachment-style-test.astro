---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "애착 유형",
  "en": "Attachment style",
  "ja": "愛着スタイル",
  "fr": "style d'attachement",
  "es": "estilo de apego",
  "zh": "依恋风格",
  "cn": "依戀風格"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/attachment-style/test" kind="test" />
