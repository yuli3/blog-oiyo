---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "별자리 성격",
  en: "Zodiac personality",
  ja: "星座性格",
  fr: "personnalité astrologique",
  es: "personalidad zodiacal",
  zh: "星座性格",
  cn: "星座性格",
};
---

<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/zodiac/personality" kind="tool" />
