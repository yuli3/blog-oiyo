---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JapanSalaryCalculatorComp from "../../components/tools/JapanSalaryCalculator";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ja: {
    title: "日本の給与手取り計算機 2024 — 所得税・社会保険・住民税を自動計算",
    description: "年収を入力するだけで健康保険・厚生年金・雇用保険・所得税・住民税を自動計算。令和6年度の最新税率に対応した日本向け給与手取りシミュレーター。",
  },
  en: {
    title: "Japan Salary Calculator 2024 — Income Tax & Social Insurance",
    description: "Enter your annual salary to instantly calculate health insurance, pension, employment insurance, income tax, and resident tax under Japan's FY2024 rules.",
  },
  ko: {
    title: "일본 급여 실수령액 계산기 2024",
    description: "일본 소득세·사회보험·주민세를 자동 계산합니다.",
  },
  fr: {
    title: "Calculateur de salaire japonais 2024",
    description: "Calculez votre salaire net au Japon avec les taux 2024.",
  },
  es: {
    title: "Calculadora de salario japonés 2024",
    description: "Calcula tu salario neto en Japón con las tasas de 2024.",
  },
  zh: {
    title: "日本薪资计算机 2024",
    description: "计算日本所得税、社会保险及住民税后的实际到手薪资。",
  },
};

const m = meta[locale] ?? meta.en;
const calcLocale = locale === 'ja' ? 'ja' : 'en';

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "일본 급여 실수령액 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 일본 기준의 일본 급여 실수령액을 설명과 함께 계산합니다. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전합니다.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "건강보험 4.985%, 후생연금 9.15%, 고용보험 0.6%를 추정합니다."
    }, {
      title: "기준 2",
      body: "40세 이상은 개호보험 0.91%를 추가합니다."
    }, {
      title: "기준 3",
      body: "기초공제 48만엔 후 소득세·부흥특별소득세·주민세를 추정합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "일본 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "건강보험 조합, 거주지, 전년도 소득, 부양공제와 회사 공제 방식에 따라 달라질 수 있습니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용입니다. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Japan net salary is country-specific",
    intro: "This page estimates Japan net salary under Japan rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Estimates health insurance 4.985%, pension 9.15%, and employment insurance 0.6%."
    }, {
      title: "Rule 2",
      body: "Age 40+ adds 0.91% long-term care insurance."
    }, {
      title: "Rule 3",
      body: "After JPY 480K basic deduction, estimates income tax, reconstruction surtax, and resident tax."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Japan rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Health insurer, municipality, prior-year income, dependents, and employer withholding can change the result."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "日本の給与手取りは国ごとの制度確認が必要です",
    intro: "このページは日本基準の日本の給与手取りを説明付きで試算します。税率や控除は国ごとに異なり毎年変わるため、申告前の参考値として扱ってください。",
    formulaTitle: "主な計算基準",
    formulas: [{
      title: "基準 1",
      body: "健康保険4.985%、年金9.15%、雇用0.6%を見積もります。"
    }, {
      title: "基準 2",
      body: "40歳以上は介護保険0.91%を追加。"
    }, {
      title: "基準 3",
      body: "48万円控除後に所得税、復興税、住民税を見積もります。"
    }],
    howToTitle: "使い方",
    steps: ["必要な金額と条件を入力します。", "税金・控除・社会保険の内訳を確認します。", "申告・納付・判断前に最新の公式基準と照合します。"],
    faqTitle: "よくある質問",
    faqs: [{
      question: "どの国の制度を基準にしていますか？",
      answer: "日本の制度です。他国の税率、控除、社会保険にはそのまま使えません。"
    }, {
      question: "実際の金額と異なる理由は？",
      answer: "保険組合、自治体、前年所得、扶養、会社の源泉徴収で変わります。"
    }, {
      question: "制度は毎年変わりますか？",
      answer: "はい。税率、控除限度、社会保険料率は毎年変わる可能性があります。申告や納付前に最新年度の基準を確認してください。"
    }],
    disclaimer: "この計算は一般的な概算です。実際の税額は税務当局または税理士に確認してください。"
  },
  zh: {
    introTitle: "日本到手薪资必须先确认适用国家的制度",
    intro: "本页依日本规则估算日本到手薪资。税率、扣除与社会保险具有国别差异且可能逐年变动，结果应作为申报前的初步参考。",
    formulaTitle: "主要计算基准",
    formulas: [{
      title: "规则 1",
      body: "估算健康保险4.985%、年金9.15%、雇用0.6%。"
    }, {
      title: "规则 2",
      body: "40岁以上追加0.91%介护保险。"
    }, {
      title: "规则 3",
      body: "48万日圆扣除后估算所得税、复兴税与住民税。"
    }],
    howToTitle: "使用方法",
    steps: ["输入所需金额与条件。", "分别查看税金、扣除与社会保险明细。", "申报、缴纳或决策前请核对最新官方规定。"],
    faqTitle: "常见问题",
    faqs: [{
      question: "这个计算机采用哪个国家的规则？",
      answer: "采用日本规则，不能直接套用其他国家的税率、扣除或社会保险制度。"
    }, {
      question: "为什么可能和实际金额不同？",
      answer: "保险组合、居住地、前一年所得、扶养与公司扣缴会改变结果。"
    }, {
      question: "规则每年都会变吗？",
      answer: "会。税率、扣除上限与社会保险费率都可能按年度调整。申报或缴纳前请确认当年度官方规定。"
    }],
    disclaimer: "本工具仅为一般估算。实际税额请向税务机关或税务专业人士确认。"
  },
  fr: {
    introTitle: "Salaire net japonais dépend du pays concerné",
    intro: "Cette page estime le salaire net japonais selon les règles de le Japon. Les tranches, déductions et cotisations sont propres au pays et peuvent changer chaque année; utilisez le résultat comme point de départ.",
    formulaTitle: "Bases de calcul",
    formulas: [{
      title: "Règle 1",
      body: "Santé 4,985%, pension 9,15%, chômage 0,6%."
    }, {
      title: "Règle 2",
      body: "40 ans et plus: +0,91%."
    }, {
      title: "Règle 3",
      body: "Après 480 000 JPY, impôt, surtaxe et taxe résidentielle."
    }],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez les montants et conditions nécessaires.", "Vérifiez séparément impôts, déductions et cotisations.", "Comparez avec les règles officielles avant déclaration, paiement ou décision."],
    faqTitle: "Questions fréquentes",
    faqs: [{
      question: "Quel pays sert de référence ?",
      answer: "Il utilise les règles de le Japon. Ne l’appliquez pas directement à un autre système fiscal ou social."
    }, {
      question: "Pourquoi le montant réel peut-il différer ?",
      answer: "Caisse, commune, revenu précédent, famille et retenue employeur peuvent changer."
    }, {
      question: "Les règles changent-elles chaque année ?",
      answer: "Oui. Les taux, plafonds de déduction et cotisations peuvent changer chaque année. Vérifiez l'année en vigueur avant de déclarer ou payer."
    }],
    disclaimer: "Ce calcul est une estimation générale. Confirmez le montant auprès de l'administration fiscale ou d'un fiscaliste."
  },
  es: {
    introTitle: "Salario neto en Japón depende del país aplicado",
    intro: "Esta página estima el salario neto en Japón con reglas de Japón. Los tramos, deducciones y cotizaciones son propios de cada país y pueden cambiar cada año; úsalo como estimación inicial.",
    formulaTitle: "Bases de cálculo",
    formulas: [{
      title: "Regla 1",
      body: "Salud 4,985%, pensión 9,15%, desempleo 0,6%."
    }, {
      title: "Regla 2",
      body: "Desde 40 años: +0,91%."
    }, {
      title: "Regla 3",
      body: "Tras 480.000 JPY, renta, recargo e impuesto residencial."
    }],
    howToTitle: "Cómo usarla",
    steps: ["Introduce los importes y condiciones necesarios.", "Revisa por separado impuestos, deducciones y cotizaciones.", "Compáralo con reglas oficiales antes de declarar, pagar o tomar una decisión."],
    faqTitle: "Preguntas frecuentes",
    faqs: [{
      question: "¿Qué país usa esta calculadora?",
      answer: "Usa reglas de Japón. No lo apliques directamente a otro sistema fiscal o social."
    }, {
      question: "¿Por qué puede cambiar el importe final?",
      answer: "Aseguradora, municipio, renta previa, familia y retención pueden cambiar."
    }, {
      question: "¿Las reglas cambian cada año?",
      answer: "Sí. Los tipos, límites de deducción y cotizaciones pueden cambiar cada año. Comprueba la norma vigente antes de declarar o pagar."
    }],
    disclaimer: "Este cálculo es una estimación general. Confirma el importe con la autoridad fiscal o un profesional tributario."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <JapanSalaryCalculatorComp client:load locale={calcLocale} />
  

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
