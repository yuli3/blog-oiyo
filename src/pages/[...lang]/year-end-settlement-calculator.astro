---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import YearEndSettlementCalculatorComp from "../../components/tools/YearEndSettlementCalculator";
import YearEndSettlementCountryCalculator from "../../components/tools/YearEndSettlementCountryCalculator";
import type { YearEndCountry } from "../../lib/year-end-settlement-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, YearEndCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "연말정산 환급 예측기 — 내 환급액 미리 계산해보기",
    description: "연봉과 주요 공제 항목을 입력해 연말정산 예상 환급액 또는 추가 납부 세액을 미리 계산합니다. 절세 전략 수립에 활용하세요.",
  },
  en: {
    title: "Year-End Tax Settlement Estimator (South Korea) — Predict Your Refund",
    description: "Enter your salary and deduction items to predict your year-end tax refund or additional payment in Korea. Plan your tax savings strategy.",
  },
  ja: {
    title: "年末調整 還付金シミュレーター（令和8年分）",
    description: "源泉徴収された所得税と年調年税額を比べて、年末調整の還付額・追加徴収額を見積もります。給与所得控除・基礎控除（令和8年分）、社会保険料、生命保険料控除、扶養控除、住宅ローン控除に対応。",
  },
  fr: {
    title: "Simulateur de régularisation du prélèvement à la source",
    description: "Estimez l'impôt sur le revenu 2026 (revenus 2025) avec le barème, le quotient familial et la décote, puis comparez-le au prélèvement à la source déjà payé : remboursement ou solde à payer.",
  },
  es: {
    title: "Simulador de la declaración de la renta (IRPF)",
    description: "Calcula si tu declaración de la renta sale a pagar o a devolver: cuota del IRPF con la escala general 2026, el mínimo personal de 5.550 € y la reducción por rendimientos del trabajo, menos las retenciones.",
  },
  zh: {
    title: "个人所得税年度汇算 退税计算器",
    description: "按综合所得年度税率表3%–45%、每年60,000元减除费用和专项附加扣除（子女教育、赡养老人、住房租金、住房贷款利息等）计算全年应纳税额，与已预缴税额比较得出应退或应补税额。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "연말정산 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 연말정산을 설명과 함께 계산해요. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전해요.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "총급여 구간별 근로소득공제를 먼저 적용합니다."
    }, {
      title: "기준 2",
      body: "본인 포함 부양가족 1인당 150만원 인적공제를 반영합니다."
    }, {
      title: "기준 3",
      body: "보험료, 연금저축, 의료비 등 주요 세액공제를 간이 반영합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "회사 제출자료, 국세청 간소화자료, 공제 한도와 요건에 따라 실제 결과가 달라집니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용이에요. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Year-end tax settlement is country-specific",
    intro: "This page estimates year-end tax settlement under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Applies salary-bracket employment deduction first."
    }, {
      title: "Rule 2",
      body: "Reflects KRW 1.5M personal deduction per eligible person."
    }, {
      title: "Rule 3",
      body: "Simplifies key credits such as insurance, pension savings, and medical expenses."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Employer data, NTS records, deduction caps, and eligibility rules can change the result."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "年末調整は、1年間の源泉徴収税額と本来の年税額の差を精算する手続きです",
    intro: "会社は毎月の給与から源泉徴収税額表で所得税を差し引きますが、その額は扶養や保険料控除を細かく反映していません。12月の最終給与で1年間の給与総額から年税額を計算し直し、取りすぎていれば還付、不足していれば追加で徴収します。令和8年分は給与所得控除の最低保障74万円と基礎控除の引上げが毎月の源泉徴収に反映されず、年末調整でまとめて精算されるため、還付が出やすい年です。",
    formulaTitle: "計算基準",
    formulas: [
      {
        title: "課税給与所得",
        body: "給与 − 給与所得控除（最低74万円）− 社会保険料 − 生命保険料控除 − 基礎控除（合計所得489万円以下は104万円）− 配偶者・扶養控除。千円未満切捨て"
      },
      {
        title: "年調年税額",
        body: "（課税給与所得 × 税率 − 控除額 − 住宅借入金等特別控除）× 102.1%。百円未満切捨て"
      },
      {
        title: "還付・徴収",
        body: "1〜12月に源泉徴収された所得税 − 年調年税額。プラスなら12月か1月の給与で還付、マイナスなら追加徴収"
      }
    ],
    howToTitle: "使い方",
    steps: [
      "給与の年間支払額、源泉徴収された所得税、社会保険料を入力します。",
      "生命保険料、配偶者・扶養親族、住宅ローン控除額を入力します。",
      "年調年税額と還付（または追加徴収）の見込額を確認します。"
    ],
    faqTitle: "よくある質問",
    faqs: [
      {
        question: "生命保険料控除はいくらになりますか？",
        answer: "新制度（2012年以降の契約）は一般・介護医療・個人年金の区分ごとに、保険料2万円以下は全額、4万円以下は半額＋1万円、8万円以下は4分の1＋2万円、8万円超は4万円で、3区分の合計は12万円が上限です。"
      },
      {
        question: "住宅ローン控除は年末調整でできますか？",
        answer: "1年目は確定申告が必要です。2年目以降は税務署から届く証明書と金融機関の残高証明書を会社に出せば、年末調整で控除されます。所得税から引ききれない分は住民税から控除されます。"
      },
      {
        question: "年末調整の対象にならない人は？",
        answer: "給与が2,000万円を超える人、年の途中で退職して年末まで再就職しない人（一部を除く）、2か所以上から給与を受けて乙欄で源泉徴収されている人は対象外で、確定申告をします。"
      }
    ],
    disclaimer: "このツールは一般的な見積もり用です。実際の年税額は会社が年末調整で計算した源泉徴収票の金額をご確認ください。"
  },
  zh: {
    introTitle: "个人所得税年度汇算：多退少补",
    intro: "居民个人取得的工资薪金、劳务报酬、稿酬和特许权使用费合并为综合所得，按年计算个人所得税。平时由单位按月预扣预缴，次年3月1日至6月30日办理年度汇算，把全年收入和扣除重新算一遍：预缴多了申请退税，少了补缴。没有在预扣时享受的专项附加扣除、大病医疗和个人养老金等，都可以在汇算时补充扣除。",
    formulaTitle: "计算规则",
    formulas: [
      {
        title: "应纳税所得额",
        body: "综合所得收入额 − 60,000元 − 专项扣除（三险一金）− 专项附加扣除 − 依法确定的其他扣除"
      },
      {
        title: "专项附加扣除",
        body: "子女教育、3岁以下婴幼儿照护 每孩每月2,000元；赡养老人 每月3,000元；住房租金 每月800–1,500元或住房贷款利息 每月1,000元；继续教育；大病医疗"
      },
      {
        title: "年度税率表",
        body: "不超过36,000元 3%，144,000元 10%，300,000元 20%，420,000元 25%，660,000元 30%，960,000元 35%，超过 45%。应退（补）税额 = 已预缴 − 应纳"
      }
    ],
    howToTitle: "使用方法",
    steps: [
      "输入全年综合所得收入额、个人缴纳的三险一金和已预缴税额。",
      "填写子女、赡养老人、住房、继续教育、大病医疗等专项附加扣除。",
      "查看全年应纳税额以及应退或应补税额。"
    ],
    faqTitle: "常见问题",
    faqs: [
      {
        question: "哪些人可以不办年度汇算？",
        answer: "年度汇算需补税但综合所得年收入不超过12万元的，或年度汇算需补税金额不超过400元的，以及已预缴税额与应纳税额一致或不申请退税的，可以不办理。"
      },
      {
        question: "住房租金和住房贷款利息能同时扣吗？",
        answer: "不能，两者只能选择其一。住房贷款利息限首套住房贷款，扣除期限最长240个月；住房租金按工作城市分为每月1,500元、1,100元和800元三档。"
      },
      {
        question: "全年一次性奖金怎么处理？",
        answer: "全年一次性奖金可以选择单独计税（按月换算后的税率表），也可以并入综合所得。本计算器只计算并入综合所得的部分，选择单独计税的奖金不要填入收入。"
      }
    ],
    disclaimer: "本工具仅供一般估算。以个人所得税App中年度汇算的计算结果为准。"
  },
  fr: {
    introTitle: "En France, il n'y a pas de régularisation de fin d'année : l'impôt est recalculé après la déclaration",
    intro: "Depuis 2019, l'impôt sur le revenu est prélevé à la source chaque mois par l'employeur, au taux transmis par l'administration. Ce taux est calculé sur des revenus anciens : le vrai montant de l'impôt n'est connu qu'après la déclaration de revenus du printemps. L'avis d'impôt de l'été compare alors l'impôt dû au prélèvement déjà payé. Le trop-perçu est remboursé fin juillet ou début août ; le solde est prélevé à partir de septembre.",
    formulaTitle: "Règles de calcul",
    formulas: [
      {
        title: "Revenu imposable",
        body: "Salaires nets imposables − abattement de 10 % pour frais professionnels (minimum 509 €, maximum 14 555 € par personne)"
      },
      {
        title: "Barème 2026 (revenus 2025)",
        body: "Par part : 0 % jusqu'à 11 600 €, 11 % jusqu'à 29 579 €, 30 % jusqu'à 84 577 €, 41 % jusqu'à 181 917 €, 45 % au-delà. Avantage du quotient familial plafonné à 1 807 € par demi-part"
      },
      {
        title: "Décote et solde",
        body: "Décote : 897 € (seul) ou 1 483 € (couple) − 45,25 % de l'impôt brut. Solde = prélèvement à la source payé − impôt dû"
      }
    ],
    howToTitle: "Mode d'emploi",
    steps: [
      "Saisissez le cumul annuel des salaires nets imposables du foyer (bulletin de décembre).",
      "Indiquez la situation familiale, le nombre d'enfants et le prélèvement déjà payé.",
      "Lisez l'impôt dû et le remboursement ou le solde à payer."
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      {
        question: "Comment sont comptées les parts ?",
        answer: "Une part pour une personne seule, deux pour un couple marié ou pacsé, une demi-part pour chacun des deux premiers enfants et une part entière à partir du troisième. Un parent isolé a une demi-part supplémentaire, non prise en compte ici."
      },
      {
        question: "Pourquoi un remboursement alors que mon taux était correct ?",
        answer: "Les réductions et crédits d'impôt (emploi à domicile, frais de garde, dons) ne sont pas pris en compte dans le taux de prélèvement. Une avance de 60 % est versée en janvier et le reste après la déclaration."
      },
      {
        question: "Comment le solde est-il payé ?",
        answer: "Un solde inférieur ou égal à 300 € est prélevé en une fois fin septembre. Au-delà, il est prélevé en quatre fois, de septembre à décembre. En dessous de 12 €, il n'est pas réclamé."
      }
    ],
    disclaimer: "Cet outil sert au calcul général. Le montant exact figure sur votre avis d'impôt ; vous pouvez aussi utiliser le simulateur officiel sur impots.gouv.fr."
  },
  es: {
    introTitle: "En España, la regularización anual del IRPF es la declaración de la renta",
    intro: "La empresa retiene cada mes una parte del sueldo a cuenta del IRPF. Entre abril y junio del año siguiente, la declaración de la renta calcula la cuota real del año con la escala general y el mínimo personal y familiar, y la compara con las retenciones: si retuvieron de más, Hacienda devuelve la diferencia; si retuvieron de menos, hay que ingresarla. La escala autonómica cambia según la comunidad, por lo que este cálculo usa la escala supletoria, igual a la estatal.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      {
        title: "Base liquidable general",
        body: "Rendimientos del trabajo − Seguridad Social − 2.000 € de otros gastos − reducción por rendimientos del trabajo (hasta 7.302 €) − aportaciones a planes de pensiones (hasta 1.500 €)"
      },
      {
        title: "Cuota íntegra",
        body: "Escala estatal + autonómica: 19 % hasta 12.450 €, 24 % hasta 20.200 €, 30 % hasta 35.200 €, 37 % hasta 60.000 €, 45 % hasta 300.000 €, 47 % por encima, menos la misma escala aplicada al mínimo personal y familiar"
      },
      {
        title: "Resultado",
        body: "Cuota − retenciones e ingresos a cuenta. Positivo: a ingresar. Negativo: a devolver"
      }
    ],
    howToTitle: "Cómo se usa",
    steps: [
      "Introduce los rendimientos íntegros del trabajo, la Seguridad Social y las retenciones del certificado de tu empresa.",
      "Añade hijos, edad y aportaciones a planes de pensiones.",
      "Consulta la cuota y si la declaración sale a pagar o a devolver."
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      {
        question: "¿Estoy obligado a presentar la declaración?",
        answer: "Con rendimientos del trabajo de un solo pagador no es obligatorio hasta 22.000 €. Con dos o más pagadores, el límite baja a 15.876 € si el segundo y siguientes pagaron más de 1.500 €. Aunque no estés obligado, conviene presentarla si sale a devolver."
      },
      {
        question: "¿Cuál es el mínimo personal?",
        answer: "5.550 € al año, 6.700 € desde los 65 años y 8.100 € desde los 75. Por hijos se añaden 2.400 €, 2.700 €, 4.000 € y 4.500 € (el cuarto y siguientes), más 2.800 € por cada hijo menor de 3 años, que este cálculo no incluye."
      },
      {
        question: "¿Por qué mi resultado real es distinto?",
        answer: "Cada comunidad autónoma tiene su escala y sus deducciones (alquiler, nacimiento, gastos educativos), y existen deducciones estatales como la de maternidad o por rendimientos del trabajo bajos. El programa Renta WEB las aplica con tus datos fiscales."
      }
    ],
    disclaimer: "Esta herramienta es para cálculo general. El resultado oficial es el del borrador en Renta WEB de la Agencia Tributaria."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {country ? <YearEndSettlementCountryCalculator client:load country={country} /> : <YearEndSettlementCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
