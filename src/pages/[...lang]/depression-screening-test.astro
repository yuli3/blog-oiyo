---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DepressionScreeningTestComp from "../../components/tests/DepressionScreeningTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "우울감 자가 점검 (PHQ-9) — 내 마음 상태 확인하기",
    description: "PHQ-9 기반 9가지 질문으로 나의 우울 수준을 점검해보세요. 선별 검사이며 전문적 진단이 아닙니다. 결과에 따른 전문 자원 안내도 포함됩니다.",
  },
  en: {
    title: "Depression Screening (PHQ-9) — Check Your Mental State",
    description: "Check your depression level with 9 PHQ-9 based questions. This is a screening tool, not a diagnosis. Includes professional resource guidance based on your result.",
  },
  ja: {
    title: "うつ病スクリーニング (PHQ-9) — 心の状態を確認する",
    description: "PHQ-9に基づく9つの質問でうつのレベルを確認しましょう。スクリーニングツールであり診断ではありません。結果に応じた専門家リソースの案内も含まれます。",
  },
  fr: {
    title: "Dépistage de la Dépression (PHQ-9) — Vérifiez votre état mental",
    description: "Vérifiez votre niveau de dépression avec 9 questions basées sur le PHQ-9. Outil de dépistage, pas un diagnostic. Inclut des ressources professionnelles selon votre résultat.",
  },
  es: {
    title: "Cribado de Depresión (PHQ-9) — Verifica tu Estado Mental",
    description: "Verifica tu nivel de depresión con 9 preguntas basadas en el PHQ-9. Es una herramienta de cribado, no un diagnóstico. Incluye recursos profesionales según tu resultado.",
  },
  zh: {
    title: "抑鬱症篩查 (PHQ-9) — 檢查您的心理狀態",
    description: "通過9個基於PHQ-9的問題檢查您的抑鬱程度。這是篩查工具，不是診斷。根據您的結果提供專業資源指引。",
  },
  cn: {
    title: "抑郁症筛查 (PHQ-9) — 检查您的心理状态",
    description: "通过9个基于PHQ-9的问题检查您的抑郁程度。这是筛查工具，不是诊断。根据您的结果提供专业资源指引。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <DepressionScreeningTestComp client:load locale={locale} />
  </main>
</BaseLayout>
