---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "별자리 궁합",
  en: "zodiac compatibility",
  ja: "星座相性",
  fr: "compatibilité zodiacale",
  es: "compatibilidad zodiacal",
  zh: "星座相容性",
  cn: "星座相容性",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/zodiac/compatibility" kind="calculator" />
