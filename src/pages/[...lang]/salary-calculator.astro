---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SalaryCalculatorComp from "../../components/tests/SalaryCalculator";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "월급 실수령액 계산기 — 4대 보험·소득세 공제 후 실제 수령액",
    description: "2024년 기준 국민연금(4.5%)·건강보험(3.545%)·장기요양·고용보험·근로소득세·지방소득세를 자동 계산합니다. 세전 월급을 입력하면 실수령액이 즉시 계산됩니다.",
  },
  en: {
    title: "Korean Salary After-Tax Calculator — Take-Home Pay with 4 Social Insurances",
    description: "Calculate your Korean take-home pay after national pension, health insurance, long-term care, employment insurance, and income tax deductions.",
  },
  ja: {
    title: "韓国給与手取り額計算機 — 4大保険・所得税後の実受取額",
    description: "2024年基準で国民年金・健康保険・介護保険・雇用保険・勤労所得税・地方所得税を自動計算。",
  },
  fr: { title: "Calculateur de Salaire Net Coréen", description: "Calculez votre salaire net coréen après déduction des 4 assurances sociales et de l'impôt sur le revenu (base 2024)." },
  es: { title: "Calculadora de Salario Neto Coreano", description: "Calcula tu salario neto coreano después de deducir los 4 seguros sociales y el impuesto sobre la renta (base 2024)." },
  zh: { title: "韩国薪资税后计算器", description: "按2024年标准自动计算四大保险扣除后的实收薪资。" },
  cn: { title: "韩国薪资税后计算器", description: "按2024年标准自动计算四大保险扣除后的实收薪资。" },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-xl px-4 py-8">
    <SalaryCalculatorComp client:load locale={locale} />
  </main>
</BaseLayout>
