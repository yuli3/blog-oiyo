---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SalaryCalculatorComp from "../../components/tests/SalaryCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "월급 실수령액 계산기 — 4대 보험·소득세 공제 후 실제 수령액",
    description: "2026년 요율(국민연금 4.75%·건강보험 3.595%·장기요양 13.14%·고용보험 0.9%)과 근로소득공제·기본세율 6~45%로 월급 실수령액을 추정해요. 소득세는 간이세액표가 아닌 추정값이에요.",
  },
  en: {
    title: "Korean Salary After-Tax Calculator — Take-Home Pay with 4 Social Insurances",
    description: "Estimate Korean take-home pay with 2026 rates: national pension 4.75%, health 3.595%, long-term care 13.14%, employment 0.9%, plus an income-tax estimate (6–45% brackets).",
  },
  ja: {
    title: "韓国給与手取り額計算機 — 4大保険・所得税後の実受取額",
    description: "2026年料率で国民年金・健康保険・介護保険・雇用保険を計算し、勤労所得税を推定します。",
  },
  fr: { title: "Calculateur de Salaire Net Coréen", description: "Calculez votre salaire net coréen après déduction des 4 assurances sociales et de l'impôt sur le revenu (taux 2026, impôt estimé)." },
  es: { title: "Calculadora de Salario Neto Coreano", description: "Calcula tu salario neto coreano después de deducir los 4 seguros sociales y el impuesto sobre la renta (tasas 2026, impuesto estimado)." },
  zh: { title: "韩国薪资税后计算器", description: "按2026年费率计算四大保险，并估算所得税后的实收薪资。" },
};
const m = meta[locale] ?? meta.en;

// ToolShell SEO content — ko/en/ja authored, others fall back to en.
const content = {
  ko: {
    eyebrow: "급여 계산 도구",
    introTitle: "월급 실수령액 계산기란?",
    intro: "세전 월급에서 국민연금·건강보험·장기요양보험·고용보험과 근로소득세·지방소득세를 공제한 실제 수령액을 계산하는 도구예요. 2026년 요율(기준일 2026-10-17)로 계산하고, 근로소득세는 근로소득공제·인적공제·보험료공제·근로소득세액공제를 넣은 연간 추정액이에요. 국세청 간이세액표 값과는 다를 수 있어요.",
    howToTitle: "사용 방법",
    steps: ["세전 월급 또는 연봉을 입력합니다.", "부양가족 수 등 공제 조건을 설정합니다.", "계산을 실행하면 4대 보험과 세금이 자동 공제됩니다.", "실수령액과 항목별 공제 내역을 확인합니다."],
    highlightsTitle: "주요 특징",
    highlights: [
      { title: "4대 보험 2026년 요율", body: "국민연금 4.75%(기준소득월액 41만~659만 원), 건강보험 3.595%, 장기요양 13.14%(건강보험료 기준), 고용보험 0.9%를 비과세를 뺀 보수에 적용해요." },
      { title: "소득세는 추정값", body: "2026년 근로소득공제와 기본세율 8구간(6~45%)을 쓰지만 간이세액표가 아니라서 '추정'으로 표시해요. 출처: 국세청 근로소득 안내, 국민건강보험공단 2026 보험료율." },
      { title: "즉시 계산", body: "입력하면 바로 실수령액이 계산돼요." },
    ],
    relatedTitle: "관련 계산기",
    related: [
      { href: "/ko/annual-leave-calculator/", label: "연차 계산기", desc: "입사일 기준 연차 일수를 계산합니다." },
      { href: "https://tools.oiyo.net/ko/auto-tax-calculator/", label: "자동차세 계산기", desc: "배기량별 자동차세를 계산합니다." },
      { href: "/ko/acquisition-tax-calculator/", label: "취득세 계산기", desc: "부동산 취득세를 계산합니다." },
    ],
    disclaimer: "본 계산기는 참고용이며, 실제 공제액은 회사 정책·비과세 항목·연말정산에 따라 달라질 수 있어요. 정확한 세무는 전문가 상담을 권장해요.",
  },
  en: {
    eyebrow: "Salary Tool",
    introTitle: "What is the Korean salary after-tax calculator?",
    intro: "It estimates your Korean take-home pay by deducting the four social insurances (national pension, health, long-term care, employment) and income/local taxes from gross salary, using 2026 rates (as of 2026-10-17). Income tax is an annual estimate, not the NTS withholding table.",
    howToTitle: "How to use",
    steps: ["Enter your gross monthly or annual salary.", "Set deduction conditions such as number of dependents.", "Run the calculation to apply the four insurances and taxes automatically.", "Review your take-home pay and the itemized deductions."],
    highlightsTitle: "Highlights",
    highlights: [
      { title: "Four insurances, 2026 rates", body: "National pension 4.75% (base 410k–6.59M KRW), health 3.595%, long-term care 13.14% of health, and employment 0.9% on taxable pay." },
      { title: "Income tax is an estimate", body: "Uses the 2026 earned-income deduction and the eight 6–45% brackets, but not the simplified withholding table." },
      { title: "Instant result", body: "Take-home pay is computed as soon as you enter your salary." },
    ],
    relatedTitle: "Related calculators",
    related: [
      { href: "/en/annual-leave-calculator/", label: "Annual Leave Calculator", desc: "Compute leave days from your start date." },
      { href: "https://tools.oiyo.net/ko/auto-tax-calculator/", label: "Auto Tax Calculator", desc: "Estimate vehicle tax by engine displacement." },
      { href: "/en/acquisition-tax-calculator/", label: "Acquisition Tax Calculator", desc: "Estimate real-estate acquisition tax." },
    ],
    disclaimer: "This calculator is for reference only. Actual deductions vary with company policy, non-taxable allowances, and year-end settlement. Consult a tax professional for accuracy.",
  },
  ja: {
    eyebrow: "給与計算ツール",
    introTitle: "韓国給与手取り額計算機とは？",
    intro: "税引前給与から4大保険（国民年金・健康保険・介護保険・雇用保険）と所得税・地方所得税を控除し、実際の手取り額を2026年料率で計算するツールです。所得税は簡易税額表ではなく推定値です。",
    howToTitle: "使い方",
    steps: ["税引前の月給または年収を入力します。", "扶養家族数などの控除条件を設定します。", "計算を実行すると4大保険と税金が自動控除されます。", "手取り額と項目別の控除内訳を確認します。"],
    highlightsTitle: "主な特徴",
    highlights: [
      { title: "4大保険を自動計算", body: "国民年金4.75%、健康保険3.595%、介護保険（健康保険料の13.14%）、雇用保険0.9%を反映します。" },
      { title: "所得税は推定", body: "2026年の勤労所得控除と基本税率6～45%を使った推定値です。" },
      { title: "即時計算", body: "入力するとすぐに手取り額が計算されます。" },
    ],
    relatedTitle: "関連計算機",
    related: [
      { href: "/ja/annual-leave-calculator/", label: "年次有給計算機", desc: "入社日基準の年休日数を計算します。" },
      { href: "https://tools.oiyo.net/ko/auto-tax-calculator/", label: "自動車税計算機", desc: "排気量別の自動車税を計算します。" },
      { href: "/ja/acquisition-tax-calculator/", label: "取得税計算機", desc: "不動産取得税を計算します。" },
    ],
    disclaimer: "本計算機は参考用です。実際の控除額は会社の方針・非課税項目・年末調整により異なります。正確な税務は専門家にご相談ください。",
  },
};

const faqs = {
  ko: [
    { q: "4대 보험은 무엇인가요?", a: "국민연금, 건강보험, 장기요양보험, 고용보험을 말합니다. 산재보험은 전액 사업주 부담이라 실수령액 계산에서 제외됩니다." },
    { q: "실수령액은 어떻게 계산되나요?", a: "세전 급여에서 4대 보험 근로자 부담분과 근로소득세·지방소득세를 공제한 금액이 실수령액입니다." },
    { q: "계산 결과가 실제와 같나요?", a: "비과세 수당, 부양가족, 연말정산 등에 따라 실제와 차이가 날 수 있으므로 참고용으로 사용하세요." },
  ],
  en: [
    { q: "What are the four social insurances?", a: "National pension, health insurance, long-term care insurance, and employment insurance. Industrial-accident insurance is fully employer-paid and excluded from take-home pay." },
    { q: "How is take-home pay calculated?", a: "It is gross salary minus the employee share of the four insurances and income/local taxes." },
    { q: "Does the result match my real paycheck?", a: "It can differ due to non-taxable allowances, dependents, and year-end settlement, so use it as a reference." },
  ],
  ja: [
    { q: "4大保険とは何ですか？", a: "国民年金・健康保険・介護保険・雇用保険を指します。労災保険は全額事業主負担のため手取り計算からは除外されます。" },
    { q: "手取り額はどう計算しますか？", a: "税引前給与から4大保険の被用者負担分と所得税・地方所得税を控除した金額です。" },
    { q: "計算結果は実際と同じですか？", a: "非課税手当・扶養家族・年末調整などにより実際と差が出ることがあるため、参考としてご利用ください。" },
  ],
};

const { content: c, faqHeading, faqItems } = buildToolShell(content, faqs, locale);
---

<BaseLayout title={m.title} description={m.description}>
  <ToolShell
    title={m.title}
    description={m.description}
    siteUrl={siteConfig.url}
    locale={locale}
    slug="salary-calculator"
    content={c}
    applicationCategory="FinanceApplication"
  >
    <div class="mx-auto max-w-xl">
      <SalaryCalculatorComp client:visible locale={locale} />
      {locale === "ko" && <section class="mt-4 space-y-3" aria-label="급여명세 대조 순서"><h2 class="text-lg font-semibold">급여명세는 같은 달·같은 항목으로 대조해요</h2><ol class="grid gap-2 sm:grid-cols-3"><li class="rounded-lg border border-border p-3 text-sm">① 세전 지급총액과 비과세 항목을 나눠요</li><li class="rounded-lg border border-border p-3 text-sm">② 근로자 부담 보험료와 원천징수 세액을 구분해요</li><li class="rounded-lg border border-border p-3 text-sm">③ 지급총액 − 실제 공제총액을 통장 입금액과 대조해요</li></ol><p class="text-sm leading-relaxed">사업주 부담 보험료를 근로자 공제에 더하지 않아요. 이 계산기의 소득세는 연간 추정액을 나눈 값이라 명세서 원천징수와 다를 수 있어요. 상여·소급분·보험 정산·기타 공제가 있으면 해당 달의 명세서를 우선 확인해 주세요.</p></section>}
      <p class="mt-3 text-xs text-muted-foreground">
        {locale === "ko" ? "기준일 2026-10-17 · 출처: " : "As of 2026-10-17 · Sources: "}
        <a class="underline" href="https://www.nts.go.kr/nts/cm/cntnts/cntntsView.do?cntntsId=7873&mi=6437" rel="noopener" target="_blank">{locale === "ko" ? "국세청 근로소득 과세표준·세율" : "NTS earned income & tax brackets"}</a>
        {" · "}
        <a class="underline" href="https://www.nts.go.kr/nts/cm/cntnts/cntntsView.do?cntntsId=7875&mi=6596" rel="noopener" target="_blank">{locale === "ko" ? "국세청 근로소득세액공제" : "NTS earned income tax credit"}</a>
        {" · "}
        <a class="underline" href="https://www.nhis.or.kr/nhis/etc/20251204_banner_pop01.do" rel="noopener" target="_blank">{locale === "ko" ? "국민건강보험공단 2026 보험료율" : "NHIS 2026 contribution rates"}</a>
      </p>
    </div>
    <RelatedToolLinks
      locale={locale}
      current="salary-calculator"
      slugs={["china-salary-calculator", "japan-salary-calculator", "taiwan-salary-calculator", "france-salary-calculator", "spain-salary-calculator", "salary-negotiation-calculator", "money-planner"]}
    />
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
