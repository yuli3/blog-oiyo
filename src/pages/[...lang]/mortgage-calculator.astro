---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MortgageCalculatorComp from "../../components/calculators/MortgageCalculator";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "주택담보대출 계산기 — 월 상환금·총 이자 계산",
    description: "대출금액, 금리, 기간을 입력해 월 상환금과 총 이자를 계산하세요. 원리금균등상환 방식 기준.",
  },
  en: {
    title: "Mortgage Calculator — Monthly Payment & Total Interest",
    description: "Enter loan amount, interest rate, and term to calculate monthly payment and total interest. Annuity repayment method.",
  },
  ja: {
    title: "住宅ローン計算機 — 月返済額・総利息を計算",
    description: "ローン金額、金利、期間を入力して月返済額と総利息を計算します。",
  },
  fr: {
    title: "Calculateur de Prêt Immobilier — Mensualité & Intérêts Totaux",
    description: "Calculez vos mensualités et intérêts totaux en entrant le montant, le taux et la durée.",
  },
  es: {
    title: "Calculadora de Hipoteca — Cuota Mensual e Intereses Totales",
    description: "Calcula tus cuotas mensuales e intereses totales introduciendo el importe, el tipo y el plazo.",
  },
  zh: {
    title: "房貸計算機 — 月供及總利息計算",
    description: "輸入貸款金額、利率和期限，計算月供和總利息。",
  },
  cn: {
    title: "房贷计算器 — 月供及总利息计算",
    description: "输入贷款金额、利率和期限，计算月供和总利息。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <MortgageCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
  </main>
</BaseLayout>
