---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonaPathTestComp from "../../components/tests/PersonaPathTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "페르소나 패스 테스트: 나의 MBTI 성격 차원은?", description: "20개의 질문으로 MBTI 기반 나의 성격 차원을 탐구하세요. 외향형/내향형, 감각형/직관형, 사고형/감정형, 판단형/인식형 중 나의 우세한 성격 차원은?" },
  en: { title: "Persona Path Test: What's Your MBTI Personality Dimension?", description: "Explore your MBTI-based personality dimensions through 20 questions. Extrovert or Introvert, Sensing or Intuitive, Thinking or Feeling, Judging or Perceiving — which dominates?" },
  ja: { title: "ペルソナパステスト：あなたのMBTI性格次元は？", description: "20の質問でMBTIベースの性格次元を探りましょう。外向型/内向型、感覚型/直観型、思考型/感情型、判断型/認識型のうち、あなたの優勢な次元は？" },
  fr: { title: "Test Persona Path : Quelle est votre dimension de personnalité MBTI ?", description: "Explorez vos dimensions de personnalité MBTI à travers 20 questions. Extraverti ou Introverti, Sensitif ou Intuitif, Pensée ou Sentiment, Jugement ou Perception ?" },
  es: { title: "Test Persona Path: ¿Cuál es tu dimensión de personalidad MBTI?", description: "Explora tus dimensiones de personalidad MBTI a través de 20 preguntas. ¿Extrovertido o Introvertido, Sensitivo o Intuitivo, Pensamiento o Sentimiento, Juicio o Percepción?" },
  zh: { title: "人格路徑測試：你的MBTI性格維度是什麼？", description: "透過20個問題探索你的MBTI性格維度。外向/內向、感覺/直覺、思考/情感、判斷/感知，你的主導維度是哪個？" },
  cn: { title: "人格路径测试：你的MBTI性格维度是什么？", description: "通过20个问题探索你的MBTI性格维度。外向/内向、感觉/直觉、思考/情感、判断/感知，你的主导维度是哪个？" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <PersonaPathTestComp client:load locale={locale} />
  </main>
</BaseLayout>
