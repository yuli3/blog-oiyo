---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IsaTaxSavingsCalculator from "../../components/tools/IsaTaxSavingsCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";

const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "ISA 절세 계산기 2026 — 일반형 vs 서민형 비과세 혜택 및 손익통산 시뮬레이션";
const description = "ISA 일반형 200만 원·서민형 및 농어민형 400만 원 비과세 한도와 초과분 9.9% 세율을 알아봐요. 상품별 과세손익·가입 요건·손익통산 범위를 확인하고 단순 비교의 한계를 살펴보세요.";

const ko = {
  eyebrow: "절세 계좌 및 투자 세무",
  introTitle: "ISA 세제 혜택은 실제 투자손익이 아니라 세법상 과세손익을 기준으로 봐요",
  intro: "ISA는 가입·유지 요건을 충족하면 일반형 200만 원, 서민형·농어민형 등 해당 요건을 충족한 경우 400만 원까지 비과세가 적용돼요. 초과분은 지방소득세를 포함해 9.9%로 분리과세해요. 다만 모든 투자 이익과 손실을 그대로 합산하는 구조는 아니에요. 국내 상장 해외 ETF도 실제 매매손익과 과표손익이 다를 수 있고, 채권 매매손익은 통산 대상에서 제외돼요. 계좌 전체 평가손익이 아니라 금융회사가 확인한 과세대상 이익과 통산대상 손실을 기준으로 살펴보세요. 이 페이지는 가입 자격이나 실제 정산세액을 확정하지 않아요.",
  howToTitle: "사용 방법",
  steps: [
    "가입 유형과 소득 요건을 금융회사에서 먼저 확인해요. 서민형·농어민형은 총급여 조건 하나만으로 결정하지 않아요.",
    "현행 비과세 한도는 일반형 200만 원, 요건을 충족한 서민형·농어민형 400만 원이에요. 과거 확대안의 500만·1,000만 원을 현행 한도로 사용하지 마세요.",
    "금융회사가 확인한 과세대상 이익을 준비해요. 실제 매매차익이나 평가이익과 같다고 가정하지 않아요.",
    "공제가 가능한 통산대상 손실을 확인해요. 모든 투자손실·평가손실이 공제되는 것은 아니에요.",
    "일반계좌 15.4% 단순 비교는 해당 세율로 과세되는 소득만 가정해요. 실제 세금과 순수익은 상품별 계산·수수료·가입 유지 조건에 따라 달라져요.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "일반형 vs 서민형 실시간 비교", body: "일반형(200만 원)과 서민형·농어민형(400만 원)의 비과세 혜택 차이를 명확하게 비교합니다." },
    { title: "손익통산 대상은 상품별로 달라요", body: "법정 통산대상 손실과 차감 순서를 확인해야 해요. ETF·펀드의 과표손익과 실제 손익을 구별하고 금융회사의 정산 안내를 확인하세요." },
    { title: "분리과세와 자격 판정은 달라요", body: "ISA 특례 적용 소득은 종합소득 과세표준에 합산하지 않아요. 이것만으로 전체 금융소득이나 건강보험 자격·보험료를 판정할 수는 없어요." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/inheritance-gift-tax-calculator/", label: "상속세 및 증여세 계산기", desc: "공제 한도별 상속세와 증여세를 계산합니다." },
    { href: "/ko/retirement-tax-calculator/", label: "퇴직소득세 계산기", desc: "퇴직금 실수령액과 IRP 절세 효과를 계산합니다." },
    { href: "/ko/global-income-tax-calculator/", label: "종합소득세 계산기", desc: "금융소득 2천만 원 초과 시 종합소득세율을 계산합니다." },
  ],
  disclaimer: "이 도구는 가입·유지 요건을 충족한 경우의 단순 세금 비교예요. 3년 전 해지하거나 납입원금을 초과해 인출하면 적용받은 세제 혜택 상당액이 상품별로 추징될 수 있어요. 다만 사망·해외이주 등 법정 특별해지 사유는 예외가 있으니 증빙과 신청 조건을 금융회사에 확인하세요. 직전 3개 과세기간 중 금융소득종합과세 대상 이력이 있으면 가입이 제한돼요. 실제 정산세액은 금융회사 안내를 확인하세요.",
};

const faqs = [
  { q: "ISA 계좌는 1인 1계좌만 개설할 수 있나요?", a: "네, 전 금융기관을 통틀어 1인 1계좌예요. 계좌 이전의 처리 조건과 보유 상품 처분 여부는 해당 금융회사에 확인하세요. 중개형·신탁형·일임형마다 운용 방식과 취급 상품이 달라요." },
  { q: "ISA 연간 납입한도는 얼마이며 이월이 가능한가요?", a: "연간 한도는 2,000만 원, 총납입 한도는 1억 원이에요. 사용하지 않은 납입한도는 이월할 수 있어요. 예를 들어 첫해에 납입하지 않았다면 둘째 해에는 이월분을 합쳐 최대 4,000만 원까지 납입할 수 있어요. 실제 잔여 한도는 금융회사에서 확인하세요." },
  { q: "ISA의 절세액으로 연금계좌 전환 혜택도 알 수 있나요?", a: "아니요. 연금계좌 전환은 별도의 요건과 세액공제 계산이 필요해요. 세액공제 대상 납입액과 실제 공제되는 세금, 계좌에 납입할 수 있는 한도는 서로 다른 금액이에요. 이 계산 결과에는 연금계좌 전환 혜택을 포함하지 않아요." },
  { q: "ISA 결과만으로 건강보험료나 피부양자 자격을 판단해도 되나요?", a: "아니요. 이 도구는 국민건강보험공단의 소득 반영·정보 전달·자격 심사 과정을 계산하지 않아요. 세법상 비과세·분리과세와 개인의 전체 소득·재산·부양 요건은 구별해야 해요. 계좌 정산 내역과 다른 소득을 준비해 공단에 확인하세요. 투자상품의 원금손실 위험도 별도로 남아 있어요." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="isa-tax-savings-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <IsaTaxSavingsCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거 확인: 2026-10-18. <a href="https://www.law.go.kr/LSW/lsSideInfoP.do?docCls=jo&amp;joBrNo=18&amp;joNo=0091&amp;lsiSeq=284389&amp;urlMode=lsScJoRltInfoR" class="underline">조세특례제한법 제91조의18</a> · <a href="https://www.law.go.kr/LSW/lsSideInfoP.do?docCls=jo&amp;joBrNo=04&amp;joNo=0093&amp;lsiSeq=288915&amp;urlMode=lsScJoRltInfoR" class="underline">시행령 제93조의4</a> · <a href="https://file.shinhansec.com/filedoc/clause/y_183.pdf" class="underline">신한투자증권 중개형 ISA 핵심설명서(상품별 과세손익·통산 범위)</a></p>
    </div>
    <div class="mt-12">
      <h2 class="text-xl font-bold tracking-tight mb-4">{faqHeading}</h2>
      <FaqAccordion items={faqItems} />
    </div>
  </ToolShell>
</BaseLayout>
