---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoveProfileTest from "../../components/tools/LoveProfileTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale & Locale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "연애 프로필 테스트 — 애착 유형·사랑의 언어·갈등 스타일 분석",
    description: "28문항으로 나의 애착 유형(안정·불안·회피·혼란), 사랑의 언어(말·행위·선물·시간·스킨십), 갈등 스타일을 한 번에 분석합니다.",
  },
  en: {
    title: "Love Profile Test — Attachment Style, Love Language & Conflict Style",
    description: "28 questions reveal your attachment type (secure, anxious, avoidant, disorganized), love language, and conflict style — your complete relationship profile.",
  },
  ja: {
    title: "恋愛プロフィールテスト — 愛着タイプ・愛の言語・葛藤スタイル分析",
    description: "28問で愛着タイプ（安定・不安・回避・混乱）、愛の言語（言葉・行為・贈り物・時間・スキンシップ）、葛藤スタイルを一度に分析します。",
  },
  fr: {
    title: "Test de Profil Amoureux — Style d'Attachement, Langage de l'Amour & Gestion des Conflits",
    description: "28 questions révèlent votre type d'attachement (sécure, anxieux, évitant, désorganisé), votre langage de l'amour et votre style de gestion des conflits.",
  },
  es: {
    title: "Test de Perfil Amoroso — Estilo de Apego, Lenguaje del Amor y Estilo de Conflicto",
    description: "28 preguntas revelan tu tipo de apego (seguro, ansioso, evitativo, desorganizado), lenguaje del amor y estilo de manejo de conflictos.",
  },
  zh: {
    title: "恋爱档案测试 — 依附类型·爱的语言·冲突风格分析",
    description: "通过28题了解你的依附类型、爱的语言和冲突风格，用于轻松自我反思。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "연애 성향 테스트는 관계 대화를 시작하는 도구입니다",
    intro: "애착 유형, 사랑의 언어, 갈등 스타일은 관계에서 반복되는 반응을 이해하는 데 도움을 줄 수 있습니다. 이 테스트는 28문항으로 나의 경향을 가볍게 정리해 보도록 설계되었으며, 상대를 단정하거나 관계의 정답을 내리는 도구가 아니라 대화와 자기성찰의 출발점으로 쓰는 것이 좋습니다.",
    formulaTitle: "결과를 읽는 관점",
    formulas: [
      { title: "애착 경향", body: "가까워질 때 안정감, 불안, 거리두기 중 어떤 반응이 자주 나오는지 돌아봅니다." },
      { title: "사랑의 표현", body: "말, 행동, 시간, 선물, 스킨십 중 내가 주고받기 편한 표현을 확인합니다." },
      { title: "갈등 방식", body: "문제가 생겼을 때 회피, 설득, 조율, 감정 표현 중 어떤 패턴이 반복되는지 봅니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "최근 관계에서 실제로 자주 보이는 반응을 기준으로 답합니다.",
      "결과 유형을 읽고 공감되는 설명과 다른 설명을 구분합니다.",
      "필요하면 결과를 대화 주제로 삼되, 상대를 평가하는 라벨로 쓰지 않습니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "이 테스트가 나의 애착 유형을 확정하나요?", answer: "아니요. 자기보고식 엔터테인먼트 테스트이며 전문 심리평가가 아닙니다." },
      { question: "연인과 함께 해도 되나요?", answer: "가능합니다. 다만 서로를 단정하기보다 선호와 불편함을 설명하는 대화 도구로 사용하는 것이 좋습니다." },
      { question: "결과가 마음에 들지 않으면 어떻게 하나요?", answer: "결과는 고정된 성격표가 아닙니다. 상황, 경험, 관계 안전감에 따라 반응은 달라질 수 있습니다." },
    ],
    disclaimer: "이 테스트는 엔터테인먼트와 자기성찰용입니다. 관계 문제, 폭력, 심각한 갈등은 전문 상담이나 안전 지원을 우선하세요.",
  },
  en: {
    introTitle: "A love profile test can start better relationship conversations",
    intro: "Attachment patterns, love languages, and conflict styles can help you notice repeated relationship reactions. This 28-question test summarizes tendencies for reflection. It should not be used to label a partner or decide the value of a relationship.",
    formulaTitle: "How to read the profile",
    formulas: [
      { title: "Attachment tendency", body: "Notice whether closeness often brings security, anxiety, distance, or mixed reactions." },
      { title: "Expression style", body: "Words, acts, time, gifts, and touch describe how affection may feel most natural." },
      { title: "Conflict pattern", body: "Look for repeated habits such as avoidance, persuasion, compromise, or strong emotional expression." },
    ],
    howToTitle: "How to use",
    steps: [
      "Answer based on patterns you actually notice in recent relationships.",
      "Read the result and separate what feels accurate from what does not.",
      "Use the profile as a conversation prompt, not as a label for yourself or someone else.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Does this prove my attachment style?", answer: "No. It is a self-report entertainment test, not a professional psychological assessment." },
      { question: "Can couples take it together?", answer: "Yes, if both people treat it as a conversation tool rather than a way to judge or diagnose each other." },
      { question: "What if I dislike the result?", answer: "The result is not a fixed identity. Reactions change with context, experience, and relationship safety." },
    ],
    disclaimer: "This test is for entertainment and self-reflection. For abuse, severe conflict, or ongoing distress, prioritize professional or safety support.",
  },
  ja: {
    introTitle: "恋愛プロフィールは関係について話すきっかけになります",
    intro: "愛着傾向、愛情表現、葛藤スタイルは、関係の中で繰り返す反応を理解する助けになります。この28問テストは自分の傾向を軽く整理するもので、相手を決めつけたり関係の正解を出したりするものではありません。",
    formulaTitle: "結果の見方",
    formulas: [
      { title: "愛着傾向", body: "近づくときに安心、不安、距離、混乱のどの反応が出やすいかを見ます。" },
      { title: "愛情表現", body: "言葉、行動、時間、贈り物、スキンシップのうち自然に感じる表現を確認します。" },
      { title: "葛藤スタイル", body: "問題が起きた時の回避、説得、調整、感情表現のパターンを見ます。" },
    ],
    howToTitle: "使い方",
    steps: [
      "最近の関係で実際によく出る反応をもとに答えます。",
      "結果を読み、当てはまる部分と違う部分を分けて考えます。",
      "相手を評価するラベルではなく、会話のきっかけとして使います。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "愛着タイプを確定できますか？", answer: "いいえ。自己回答式の娯楽テストであり、専門的な心理評価ではありません。" },
      { question: "カップルで使えますか？", answer: "使えます。ただし相手を判断するのではなく、好みや困りごとを話す材料にしてください。" },
      { question: "結果が嫌だったら？", answer: "結果は固定された性格ではありません。状況、経験、安心感によって反応は変わります。" },
    ],
    disclaimer: "このテストは娯楽と自己理解のためのものです。暴力、深刻な葛藤、強い苦痛がある場合は専門相談や安全支援を優先してください。",
  },
  fr: {
    introTitle: "Un profil amoureux peut ouvrir une conversation",
    intro: "Attachement, langage de l'amour et style de conflit peuvent aider à repérer des réactions répétées dans les relations. Ce test de 28 questions résume des tendances pour réfléchir, sans étiqueter un partenaire ni décider de la valeur d'une relation.",
    formulaTitle: "Lire le profil",
    formulas: [
      { title: "Attachement", body: "Observez si la proximité déclenche plutôt sécurité, anxiété, distance ou réactions mixtes." },
      { title: "Expression", body: "Mots, gestes, temps, cadeaux et toucher décrivent des façons possibles de recevoir l'affection." },
      { title: "Conflit", body: "Repérez les habitudes comme éviter, convaincre, négocier ou exprimer fortement l'émotion." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Répondez selon vos réactions récentes les plus fréquentes.",
      "Lisez le résultat en distinguant ce qui vous parle et ce qui ne correspond pas.",
      "Utilisez-le comme support de discussion, pas comme étiquette définitive.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Le test prouve-t-il mon style d'attachement ?", answer: "Non. C'est un test de divertissement auto-déclaré, pas une évaluation psychologique." },
      { question: "Peut-on le faire en couple ?", answer: "Oui, si chacun l'utilise pour discuter, non pour juger ou diagnostiquer l'autre." },
      { question: "Et si le résultat me déplaît ?", answer: "Ce n'est pas une identité fixe. Les réactions changent selon contexte, expérience et sécurité relationnelle." },
    ],
    disclaimer: "Ce test sert au divertissement et à l'introspection. En cas de violence, conflit grave ou détresse, cherchez une aide professionnelle ou de sécurité.",
  },
  es: {
    introTitle: "Un perfil amoroso puede iniciar mejores conversaciones",
    intro: "El apego, el lenguaje del amor y el estilo de conflicto ayudan a notar reacciones repetidas en las relaciones. Este test de 28 preguntas resume tendencias para reflexionar, no para etiquetar a una pareja ni decidir el valor de una relación.",
    formulaTitle: "Cómo leer el perfil",
    formulas: [
      { title: "Apego", body: "Observa si la cercanía suele activar seguridad, ansiedad, distancia o reacciones mixtas." },
      { title: "Expresión", body: "Palabras, actos, tiempo, regalos y contacto describen formas posibles de recibir afecto." },
      { title: "Conflicto", body: "Busca hábitos repetidos como evitar, persuadir, negociar o expresar emoción intensa." },
    ],
    howToTitle: "Cómo usarlo",
    steps: [
      "Responde según patrones reales de relaciones recientes.",
      "Lee el resultado y separa lo que encaja de lo que no.",
      "Úsalo como tema de conversación, no como etiqueta fija.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Prueba mi estilo de apego?", answer: "No. Es un test de entretenimiento autoinformado, no una evaluación psicológica profesional." },
      { question: "¿Puede hacerse en pareja?", answer: "Sí, si se usa para conversar y no para juzgar o diagnosticar a la otra persona." },
      { question: "¿Y si no me gusta el resultado?", answer: "No es una identidad fija. Las reacciones cambian con contexto, experiencia y seguridad relacional." },
    ],
    disclaimer: "Este test es para entretenimiento y autorreflexión. Ante violencia, conflicto grave o malestar persistente, prioriza ayuda profesional o de seguridad.",
  },
  zh: {
    introTitle: "恋爱档案测试适合用来开启关系对话",
    intro: "依附倾向、爱的语言和冲突风格，可以帮助你观察关系中反复出现的反应。这个 28 题测试用于轻松整理个人倾向，不应用来给伴侣贴标签，也不决定一段关系的价值。",
    formulaTitle: "阅读结果的角度",
    formulas: [
      { title: "依附倾向", body: "观察亲密关系中更常出现安全、焦虑、保持距离还是混合反应。" },
      { title: "表达方式", body: "语言、行动、时间、礼物和身体接触，代表不同的表达和接收爱意方式。" },
      { title: "冲突模式", body: "留意问题出现时是否常见回避、说服、协商或强烈表达情绪。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "根据近期关系中的真实反应作答。",
      "阅读结果，区分哪些描述符合、哪些不符合。",
      "把结果作为对话提示，而不是给自己或他人贴标签。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "这个测试能确定我的依附类型吗？", answer: "不能。这是自我报告式娱乐测试，不是专业心理评估。" },
      { question: "情侣可以一起做吗？", answer: "可以，但应作为沟通工具，而不是评判或诊断对方的依据。" },
      { question: "不喜欢结果怎么办？", answer: "结果不是固定身份。反应会随着情境、经历和关系安全感改变。" },
    ],
    disclaimer: "本测试仅用于娱乐和自我反思。若存在暴力、严重冲突或持续痛苦，请优先寻求专业或安全支持。",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <LoveProfileTest client:load locale={locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
