---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "투자 성향",
  en: "investment personality",
  ja: "投資性向",
  fr: "personnalité investisseur",
  es: "personalidad inversora",
  zh: "投资性向",
  cn: "投資性向",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/investment-type/test" kind="test" />
