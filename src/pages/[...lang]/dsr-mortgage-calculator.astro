---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsrMortgageCalculator from "../../components/tools/DsrMortgageCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";

const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "스트레스 DSR 주택담보대출 한도 계산기 2026 — 3단계(수도권·규제지역 3.0%)·LTV·주담대 상한";
const description = "2026년 하반기 3단계 스트레스 DSR 기준으로 수도권·규제지역 주담대는 스트레스 금리 3.0%, 지방은 0.75%를 금리 유형별 비율만큼 더해 LTV·주담대 상한·DSR 40% 중 가장 낮은 한도와 월 상환액을 추정해요. 기준일 2026-10-17.";

const ko = {
  eyebrow: "부동산 금융 도구",
  introTitle: "지금 적용되는 건 3단계 스트레스 DSR이에요",
  intro: "2025년 7월 1일부터 3단계 스트레스 DSR이 시행돼 모든 업권의 가계대출에 스트레스 금리가 붙어요. 2025년 10월 16일부터 수도권·규제지역 주택담보대출은 스트레스 금리 하한이 3.0%로 올랐고, 수도권·규제지역 밖 지방 주담대만 2026년 12월 31일까지 2단계 수준(1.5% × 50% = 0.75%)이 유지돼요. 이 계산기는 연소득·기존 대출·금리 유형을 넣으면 LTV, 수도권·규제지역 주담대 최대 한도, 스트레스 DSR 40% 한도 가운데 가장 낮은 값을 보여 줘요.",
  howToTitle: "사용 방법",
  steps: [
    "매수할 주택의 매매가격과 본인의 연간 세전 소득을 입력해요.",
    "신용대출, 자동차 할부 등 보유 중인 기존 대출의 연간 원리금 상환액을 입력해요.",
    "대출 예상 금리, 만기, 금리 유형(변동·혼합·주기형)과 고정 기간을 고르세요.",
    "주택 소재지(수도권·지방)와 규제지역 여부를 선택해요.",
    "최종 한도와 그 한도를 정한 규제(LTV·주담대 상한·DSR), 실제 월 상환액을 확인해요.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "3단계 스트레스 금리", body: "수도권·규제지역 주담대 3.0%, 지방 주담대 0.75%(2026-12-31까지)를 변동형 100%, 혼합·주기형은 고정 기간 비중별 비율로 더해요." },
    { title: "LTV·주담대 상한·DSR 교차 확인", body: "규제지역 LTV 40%·비규제 70%, 수도권·규제지역 주택구입 주담대 상한(시가 15억 이하 6억, 25억 이하 4억, 초과 2억), 은행권 DSR 40% 중 가장 낮은 값을 써요." },
    { title: "기준일과 출처 공개", body: "2026-10-17에 금융위원회 행정지도(유효기간 2026-07-01~12-31)와 은행연합회 운영방안을 확인했어요. 2027년 이후 규칙은 다시 확인해야 해요." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/dsr-calculator/", label: "DSR 계산기", desc: "보유 대출 전체의 DSR 비율을 계산해요." },
    { href: "/ko/first-home-tax-calculator/", label: "생애최초 취득세 감면 계산기", desc: "취득세 최대 200만 원 감면을 계산해요." },
    { href: "/ko/jeonse-vs-monthly-calculator/", label: "전세 vs 월세 비교 계산기", desc: "주거비용 기회비용을 비교해요." },
  ],
  disclaimer: "이 계산기는 금융위원회 스트레스 DSR 행정지도와 10.15 대출수요 관리 방안을 바탕으로 한 추정 도구예요. 무주택자·처분조건부 1주택자 기준이며 생애최초 LTV 완화, 다주택자 LTV 0%, 정책모기지, 2금융권 DSR 50%, 경과규정(계약일 기준), 은행별 심사·방공제는 반영하지 않아요. 실제 한도는 대출 실행 은행에서 확인하세요.",
};

const faqs = [
  { q: "지금 스트레스 DSR은 몇 단계인가요?", a: "3단계예요. 2025년 7월 1일부터 시행됐고, 2026년 하반기(7월 1일~12월 31일) 행정지도도 3단계 기준이에요. 다만 수도권·규제지역 밖 지방 주담대는 2026년 말까지 2단계 비율이 유지돼요." },
  { q: "수도권 주담대 스트레스 금리는 얼마인가요?", a: "수도권·규제지역 주담대(오피스텔 포함)는 스트레스 금리 하한이 3.0%예요(2025-10-16 시행). 변동형이면 3.0%p가 그대로 붙고, 혼합형·주기형은 고정 기간 비중에 따라 일부만 붙어요." },
  { q: "스트레스 금리가 더해지면 실제 이자도 늘어나나요?", a: "아니에요. 스트레스 금리는 대출 한도를 정할 때만 쓰는 가상의 금리예요. 매달 내는 이자는 약정 금리로만 계산돼요." },
  { q: "고정금리로 받으면 스트레스 금리가 안 붙나요?", a: "고정 기간(또는 금리 변동 주기)이 만기의 70% 이상이면 붙지 않아요. 5년 미만이면 변동형과 같이 100% 붙고, 그 사이는 3단계 기준 혼합형 80·60·40%, 주기형 40·30·20%가 적용돼요." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="dsr-mortgage-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <DsrMortgageCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">
        기준일 2026-10-17 · 출처:
        <a class="underline" href="https://better.fsc.go.kr/fsc_new/status/adminMap/OpertnDetail.do?muNo=145&postNo=4215&stNo=11" rel="noopener" target="_blank">금융위원회 3단계 스트레스 DSR 행정지도(2026-07-01~12-31)</a>
        {" · "}
        <a class="underline" href="https://fsc.go.kr/no040101?cnId=2741" rel="noopener" target="_blank">금융위원회 3단계 시행 안내</a>
        {" · "}
        <a class="underline" href="https://www.fsc.go.kr/no010101/85432" rel="noopener" target="_blank">금융위원회 10.15 대출수요 관리 방안</a>
        {" · "}
        <a class="underline" href="https://m.kfb.or.kr/news/info_news_view.php?idx=1989" rel="noopener" target="_blank">은행연합회 26년 하반기 운영방안</a>
      </p>
    </div>
    <div slot="after-content" class="mt-12">
      <FaqAccordion heading={faqHeading} items={faqItems} />
    </div>
  </ToolShell>
</BaseLayout>
