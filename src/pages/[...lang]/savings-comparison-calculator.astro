    ],
    relatedTitle: "関連計算機",
    related: [
      { href: "/ja/stock-yield-calculator/", label: "株式利回り計算機", desc: "平均取得単価と未実現損益を計算します。" },
      { href: "/ja/dividend-tracker/", label: "配当トラッカー", desc: "予想配当と支払い周期を記録します。" },
      { href: "/ja/salary-calculator/", label: "給与手取り計算機", desc: "保険・税金控除後の手取りを推定します。" },
    ],
    disclaimer: "金融助言ではありません。実際の金利、税金、非課税枠、中途解約利率、優遇条件、預金保護は公式条件を確認してください。",
  },
  zh: {
    eyebrow: "储蓄计算工具",
    introTitle: "什么是储蓄商品比较计算机？",
    intro: "在相同月存金额和期限下，比较定存、定期储蓄、ISA 类账户和活期高息账户的税前利息、税额和税后总额。它帮助你看实际到手金额，而不只看标称利率。",
    howToTitle: "使用方法",
    steps: ["输入每月储蓄金额和期限。", "按当前产品条件修改各商品预期年利率。", "点击比较查看税前利息、税费和税后总额。", "开户前请确认免税额度、提前支取规则、存款保护和流动性。"],
    highlightsTitle: "比较标准",
    highlights: [
      { title: "税后总额", body: "应税产品按 15.4% 利息所得税估算。" },
      { title: "商品假设", body: "定存按一次性本金，其它商品按每月存入计算。" },
      { title: "可编辑利率", body: "可按银行或券商实际利率调整。" },
    ],
    relatedTitle: "相关计算器",
    related: [
      { href: "/zh/stock-yield-calculator/", label: "股票收益率计算机", desc: "估算平均成本和未实现盈亏。" },
      { href: "/zh/dividend-tracker/", label: "股息追踪器", desc: "记录预期股息和支付周期。" },
      { href: "/zh/salary-calculator/", label: "薪资税后计算器", desc: "估算保险和税后到手工资。" },
    ],
    disclaimer: "这不是金融建议。实际利率、税费、免税额度、提前支取利率、优惠条件和存款保护请以官方条款为准。",
  },
  fr: {
    eyebrow: "Calculateur d'épargne",
    introTitle: "Qu'est-ce que ce comparateur d'épargne ?",
