const faqs = {
  ko: [
    { q: "왜 세후 수령액으로 비교하나요?", a: "실제로 사용할 수 있는 금액은 세금과 조건을 반영한 뒤의 금액이기 때문입니다. 표시 금리가 높아도 세후 결과나 유동성이 다를 수 있습니다." },
    { q: "ISA는 항상 비과세로 계산되나요?", a: "이 도구는 단순 비교를 위해 비과세 한도 내라고 가정합니다. 실제 비과세 한도와 적용 여부는 계좌 유형과 법령에 따라 다릅니다." },
    { q: "정기예금과 적금 계산 방식이 왜 다른가요?", a: "정기예금은 원금을 한 번에 넣는 구조, 적금은 매월 납입하는 구조라 같은 금리라도 이자 계산 기준이 다릅니다." },
  ],
  en: [
    { q: "Why compare after-tax totals?", a: "The useful amount is what remains after tax and product constraints. A higher headline rate may not mean a better net outcome." },
    { q: "Is ISA always treated as tax-exempt?", a: "For simple comparison, this page assumes the amount is within the tax-exempt limit. Actual eligibility depends on account type and current rules." },
    { q: "Why are deposits and installment savings calculated differently?", a: "A fixed deposit assumes a lump-sum principal, while installment savings are paid monthly, so interest accrual differs even at the same annual rate." },
  ],
  ja: [
    { q: "なぜ税引き後で比較しますか？", a: "実際に残る金額は税金と商品条件を反映した後の金額だからです。表示金利だけでは比較できません。" },
    { q: "ISAは常に非課税ですか？", a: "単純比較のため非課税枠内と仮定しています。実際の適用可否は口座種別と制度により異なります。" },
    { q: "定期預金と積立の計算が違う理由は？", a: "定期預金は一括預入、積立は毎月入金のため、同じ年利でも利息の発生方法が異なります。" },
  ],
};

const m = meta[locale] ?? meta.en;
const { content: c, faqHeading, faqItems } = buildToolShell(content, faqs, locale);
const componentLocale = locale === "ko" ? "ko" : "en";
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <ToolShell
    title={m.title}
    description={m.description}
    siteUrl={siteConfig.url}
    locale={locale}
    slug="savings-comparison-calculator"
    content={c}
    applicationCategory="FinanceApplication"
  >
    <SavingsComparisonCalculatorComp client:visible locale={componentLocale} />
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>