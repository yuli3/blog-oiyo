    highlights: [
      { title: "세후 수령액", body: "일반 과세 상품은 이자소득세 15.4%를 반영해 비교합니다." },
      { title: "상품별 방식", body: "정기예금은 일시예치, 적금·ISA·파킹통장은 월 적립 방식으로 가정합니다." },
      { title: "금리 수정", body: "은행별 실제 금리를 직접 바꿔 더 현실적인 비교가 가능합니다." },
    ],
    relatedTitle: "관련 계산기",
    related: [
      { href: "/ko/stock-yield-calculator/", label: "주식 수익률 계산기", desc: "평균단가와 미실현 손익을 계산합니다." },
      { href: "/ko/dividend-tracker/", label: "배당 추적기", desc: "예상 배당금과 지급 주기를 기록합니다." },
      { href: "/ko/salary-calculator/", label: "월급 실수령액 계산기", desc: "4대 보험과 세금 공제 후 수령액을 추정합니다." },
