---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FirstHomeTaxCalculator from "../../components/tools/FirstHomeTaxCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";

const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "생애최초 주택 취득세 감면 계산기 2026 — 최대 200만원 절세액 모의계산";
const description = "매매가액 12억원 이하 생애최초 주택 취득 시 취득세 최대 200만원 감면 혜택, 실납부 취득세, 지방교육세, 농특세 및 3년 실거주 요건을 즉시 계산합니다.";

const ko = {
  eyebrow: "부동산 세무 도구",
  introTitle: "생애최초 주택 구입, 취득세를 최대 200만 원까지 감면받습니다",
  intro: "지방세특례제한법 제36조의3에 따라 본인과 배우자가 과거에 주택을 소유한 적이 없을 때 매매가액 12억 원 이하의 주택을 취득할 때 산출된 취득세에서 최대 200만 원을 감면받을 수 있습니다. 취득세액이 200만 원 이하이면 전액 면제되며, 초과 시 200만 원이 차감됩니다. 전용 60㎡ 이하 소형주택(수도권 6억·비수도권 3억 이하, 아파트 제외)은 한도가 300만 원이고, 2028년 12월 31일 취득분까지 적용됩니다. 이 계산기로 매수 예정 주택의 실납부 세액과 절세액을 미리 계산해 보세요.",
  howToTitle: "사용 방법",
  steps: [
    "매수할 주택의 실거래 매매가액을 만원 단위로 입력하거나 아래 빠른 선택 버튼을 누릅니다.",
    "본인·배우자 주택 소유 이력 기준으로 생애최초 대상 여부와 소형주택 여부를 선택합니다.",
    "전용면적 85㎡(국민주택규모) 이하 또는 초과 여부를 선택하여 농어촌특별세 적용을 확인합니다.",
    "산출된 본세, 감면액, 지방교육세, 최종 납부 예상액과 필수 유지 조건을 확인합니다.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "최신 개정세법 반영", body: "소득 기준 폐지 및 12억 원 이하 주택 최대 200만 원(소형주택 300만 원) 감면 규정을 충실히 계산합니다." },
    { title: "교육세·농특세 연동", body: "본세 감면에 따른 지방교육세 동반 감면 효과와 85㎡ 초과 시 농특세를 정밀 산출합니다." },
    { title: "실거주 의무 주의사항", body: "취득 후 3개월 내 전입, 3년 내 매각·증여·임대 금지 등 추징 방지 가이드를 함께 제공합니다." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/acquisition-tax-calculator/", label: "부동산 취득세 계산기", desc: "다주택 및 법인 취득세율을 계산합니다." },
    { href: "/ko/property-tax-calculator/", label: "부동산 재산세 계산기", desc: "보유 주택의 재산세와 종부세를 계산합니다." },
    { href: "https://tools.oiyo.net/ko/jeonse-vs-rent-calculator/", label: "전세 vs 월세 비교 계산기", desc: "주거비용 기회비용을 정밀 비교합니다." },
  ],
  disclaimer: "본 계산기는 지방세법 및 지방세특례제한법을 바탕으로 일반적인 세액을 산출하는 참고용 도구입니다. 오피스텔(주택 외 취득세율 4.6% 적용)이나 상속·증여 등 특수 취득은 감면 대상에서 제외될 수 있으므로, 실제 잔금 납부 전 관할 지자체 세무과 또는 세무 전문가의 확인을 권장합니다.",
};

const faqs = [
  { q: "과거에 분양권이나 입주권을 보유했던 적이 있어도 생애최초인가요?", a: "원칙적으로 본인 및 배우자가 주택(분양권·조합원입주권 포함)을 소유했던 사실이 없어야 합니다. 다만 상속으로 인한 소액 지분 소유 등 특수한 예외는 인정될 수 있습니다." },
  { q: "소득 제한이 있나요?", a: "2023년 세법 개정 이후 부부합산 소득 제한이 완전히 폐지되었습니다. 취득가액 12억 원 이하 요건만 충족하면 소득과 무관하게 감면받을 수 있습니다." },
  { q: "감면받은 후 전세를 놓을 수 있나요?", a: "취득일로부터 3개월 이내에 전입하여 상시 거주해야 하며, 3년 이내에 매도·증여하거나 전월세 임대(하숙·전대 포함)를 놓을 경우 감면받은 취득세와 이자상당 가산액이 추징됩니다." },
  { q: "주거용 오피스텔도 감면 대상인가요?", a: "오피스텔은 건축법상 업무시설에 해당하여 주택 취득세 감면 특례가 적용되지 않으며, 일반 매매 세율 4.6%가 부과됩니다." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="first-home-tax-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <FirstHomeTaxCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 지방세특례제한법 제36조의3(생애최초 주택 구입에 대한 취득세 감면). 기준일 2026년 10월.</p>
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
