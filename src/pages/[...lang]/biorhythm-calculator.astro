---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "바이오리듬",
  "en": "Biorhythm",
  "ja": "バイオリズム",
  "fr": "biorythme",
  "es": "biorritmo",
  "zh": "生物节律",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/biorhythm/calculator" kind="calculator" />
