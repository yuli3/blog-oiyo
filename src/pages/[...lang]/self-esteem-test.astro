---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "자존감",
  "en": "Self-esteem",
  "ja": "自尊感情",
  "fr": "estime de soi",
  "es": "autoestima",
  "zh": "自尊感",
  "cn": "自尊感"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/self-esteem/test" kind="test" />
