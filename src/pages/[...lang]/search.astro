---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";

export async function getStaticPaths() {
  return siteConfig.locales.map((lang) => ({ params: { lang } }));
}

const { lang: locale } = Astro.params;

// Build a serializable search index at build time
const allPosts = await getCollection("blog", (post) => {
  const postLocale = post.slug.split("/")[0];
  return !post.data.draft && postLocale === locale;
});

const searchIndex = allPosts.map((post) => {
  const parts = post.slug.split("/");
  const slug = parts.slice(1).join("/");
  return {
    slug: `/${locale}/${slug}/`,
    title: post.data.title,
    description: post.data.description,
    category: post.data.category ?? "",
    tags: post.data.tags ?? [],
    pubDate: post.data.pubDate.toISOString().split("T")[0],
  };
});

const labels: Record<string, Record<string, string>> = {
  en: { title: "Search", placeholder: "Search articles…", results: "results for", no_results: "No results for" },
  ko: { title: "검색", placeholder: "글 검색…", results: "개 결과:", no_results: "검색 결과 없음:" },
  ja: { title: "検索", placeholder: "記事を検索…", results: "件の結果:", no_results: "結果なし:" },
  fr: { title: "Recherche", placeholder: "Rechercher des articles…", results: "résultats pour", no_results: "Aucun résultat pour" },
  es: { title: "Búsqueda", placeholder: "Buscar artículos…", results: "resultados para", no_results: "Sin resultados para" },
};
const t = labels[locale ?? "en"] ?? labels.en;
---

<BaseLayout title={t.title}>
  <div class="container mx-auto px-4 py-24 max-w-2xl">
    <h1 class="text-4xl font-extrabold tracking-tight mb-10">{t.title}</h1>

    <div id="search-root" data-index={JSON.stringify(searchIndex)} data-labels={JSON.stringify(t)}>
      <input
        id="search-input"
        type="search"
        placeholder={t.placeholder}
        class="w-full rounded-xl border border-border bg-card px-4 py-3 text-base shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/50 mb-6"
        autofocus
        aria-label={t.placeholder}
      />
      <div id="search-meta" class="text-sm text-muted-foreground mb-4 min-h-[1.25rem]"></div>
      <ul id="search-results" class="space-y-4" role="list" aria-live="polite" aria-atomic="true"></ul>
    </div>

    <script is:inline>
      (function () {
        const root = document.getElementById("search-root");
        if (!root) return;
        const index = JSON.parse(root.dataset.index || "[]");
        const labels = JSON.parse(root.dataset.labels || "{}");
        const input = document.getElementById("search-input");
        const resultsList = document.getElementById("search-results");
        const metaEl = document.getElementById("search-meta");

        let fuse = null;

        async function initFuse() {
          if (fuse) return;
          const Fuse = (await import("https://cdn.jsdelivr.net/npm/fuse.js@7/dist/fuse.esm.min.mjs")).default;
          fuse = new Fuse(index, {
            keys: [
              { name: "title", weight: 3 },
              { name: "description", weight: 2 },
              { name: "tags", weight: 1.5 },
              { name: "category", weight: 1 },
            ],
            threshold: 0.35,
            includeScore: true,
            minMatchCharLength: 2,
          });
          // Run initial search if URL has query
          const q = new URLSearchParams(window.location.search).get("q");
          if (q) { input.value = q; runSearch(q); }
        }

        function renderResults(results, query) {
          resultsList.innerHTML = "";
          if (results.length === 0) {
            metaEl.textContent = `${labels.no_results} "${query}"`;
            return;
          }
          metaEl.textContent = `${results.length} ${labels.results} "${query}"`;
          for (const { item } of results) {
            const li = document.createElement("li");
            li.innerHTML = `
              <a href="${item.slug}" class="group block rounded-xl border border-border/60 bg-card p-4 hover:border-primary/50 hover:bg-primary/5 transition-colors">
                ${item.category ? `<span class="text-[10px] font-bold uppercase tracking-wider text-primary/70 mb-1 block">${item.category}</span>` : ""}
                <p class="font-semibold text-sm leading-snug group-hover:text-primary transition-colors mb-1">${item.title}</p>
                <p class="text-xs text-muted-foreground line-clamp-2">${item.description}</p>
                <time class="text-[11px] text-muted-foreground/60 mt-2 block">${item.pubDate}</time>
              </a>`;
            resultsList.appendChild(li);
          }
        }

        function runSearch(query) {
          if (!fuse || !query.trim()) {
            resultsList.innerHTML = "";
            metaEl.textContent = "";
            return;
          }
          const results = fuse.search(query);
          renderResults(results, query);
          // Update URL without reload
          const url = new URL(window.location.href);
          url.searchParams.set("q", query);
          history.replaceState(null, "", url.toString());
        }

        let debounceTimer;
        input.addEventListener("input", (e) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => runSearch(e.target.value), 200);
        });

        initFuse();
      })();
    </script>
  </div>
</BaseLayout>
