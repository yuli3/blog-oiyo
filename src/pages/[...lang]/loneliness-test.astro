---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LonelinessTestComp from "../../components/tests/LonelinessTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "외로움 자가 점검 — 나는 얼마나 고립되어 있는가?",
    description: "UCLA 외로움 척도를 참고한 10가지 질문으로 나의 사회적 연결 상태를 점검해보세요. 연결감을 높이는 실용적인 조언과 따뜻한 메시지를 함께 제공합니다.",
  },
  en: {
    title: "Loneliness Self-Assessment — How Connected Are You?",
    description: "Check your social connection status through 10 questions based on the UCLA Loneliness Scale. Includes practical advice for building connection and a compassionate message.",
  },
  ja: {
    title: "孤独感セルフチェック — 私はどれくらい孤立しているか？",
    description: "UCLA孤独感尺度を参考にした10問で社会的つながりの状態を確認しましょう。つながりを高める実践的なアドバイスと温かいメッセージも提供します。",
  },
  fr: {
    title: "Auto-évaluation de la Solitude — Êtes-vous connecté?",
    description: "Vérifiez votre connexion sociale avec 10 questions basées sur l'échelle de solitude UCLA. Inclut des conseils pratiques et un message bienveillant.",
  },
  es: {
    title: "Autoevaluación de Soledad — ¿Qué tan Conectado Estás?",
    description: "Verifica tu conexión social con 10 preguntas basadas en la escala de soledad UCLA. Incluye consejos prácticos y un mensaje compasivo.",
  },
  zh: {
    title: "孤獨感自我評估 — 您有多大程度上與人聯繫？",
    description: "通過基於UCLA孤獨感量表的10個問題檢查您的社交聯繫狀態。包括建立聯繫的實用建議和充滿關懷的訊息。",
  },
  cn: {
    title: "孤独感自我评估 — 您有多大程度上与人联系？",
    description: "通过基于UCLA孤独感量表的10个问题检查您的社交联系状态。包括建立联系的实用建议和充满关怀的信息。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <LonelinessTestComp client:load locale={locale} />
  </main>
</BaseLayout>
