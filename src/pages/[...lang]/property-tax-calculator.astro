---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import PropertyTaxCalculatorComp from "../../components/tools/PropertyTaxCalculator";
import PropertyTaxCountryCalculator from "../../components/tools/PropertyTaxCountryCalculator";
import type { PropertyCountry } from "../../lib/property-tax-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, PropertyCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "재산세 계산기 — 부동산 보유세 미리 계산하기",
    description: "공시가격을 기준으로 재산세와 종합부동산세를 계산합니다. 주택 보유 비용을 미리 파악하세요.",
  },
  en: {
    title: "Property Tax Calculator (South Korea)",
    description: "Calculate property tax and comprehensive real estate tax based on assessed value in Korea.",
  },
  ja: {
    title: "固定資産税・都市計画税 計算機（日本）",
    description: "土地と家屋の評価額から固定資産税（1.4%）と都市計画税（最大0.3%）を計算します。住宅用地の特例（1/6・1/3）と新築住宅の減額に対応。"
  },
  fr: {
    title: "Calculateur de taxe foncière",
    description: "Estimez votre taxe foncière : valeur locative cadastrale × 50 % × taux voté par la commune et l'intercommunalité, à reprendre sur votre avis."
  },
  es: {
    title: "Calculadora del IBI (impuesto sobre bienes inmuebles)",
    description: "Calcula el IBI anual de tu vivienda: valor catastral (base liquidable) × tipo municipal, entre el 0,4 % y el 1,10 % en suelo urbano."
  },
  zh: {
    title: "个人住房房产税计算器（上海试点）",
    description: "中国目前没有普遍征收的个人住房房产税。本页说明现行制度，并按上海试点规则（人均60㎡免税、交易价70%计税、0.6%或0.4%）计算。"
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "재산세 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 재산세를 설명과 함께 계산해요. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전해요.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "공시가격에 공정시장가액비율을 곱해 과세표준을 만듭니다."
    }, {
      title: "기준 2",
      body: "0.1%, 0.15%, 0.25%, 0.4% 재산세 구간을 적용합니다."
    }, {
      title: "기준 3",
      body: "도시지역분 0.14%와 재산세의 20% 지방교육세를 더합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "1주택 특례, 세부담 상한, 종합부동산세, 지역별 감면은 반영 범위가 제한됩니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용이에요. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Property tax is country-specific",
    intro: "This page estimates property tax under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Official assessed value is multiplied by the fair market value ratio."
    }, {
      title: "Rule 2",
      body: "Uses 0.1%, 0.15%, 0.25%, and 0.4% property tax bands."
    }, {
      title: "Rule 3",
      body: "Adds 0.14% urban area tax and 20% local education tax."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "One-home relief, tax burden caps, comprehensive real estate tax, and local reductions are limited or not reflected."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "固定資産税と都市計画税は、1月1日時点の所有者にかかります",
    intro: "固定資産税は市町村（東京23区は都）の税で、土地・家屋の評価額をもとに毎年課税されます。住宅が建っている土地は課税標準が大きく下がる特例があり、新築住宅は一定期間、家屋の税額が半分になります。都市計画税は市街化区域内の土地・家屋にだけかかります。",
    formulaTitle: "計算基準",
    formulas: [
      {
        title: "固定資産税",
        body: "課税標準 × 1.4%（標準税率）。住宅用地は200㎡/戸まで評価額×1/6、超える部分×1/3"
      },
      {
        title: "都市計画税",
        body: "課税標準 × 最大0.3%。住宅用地は200㎡/戸まで×1/3、超える部分×2/3"
      },
      {
        title: "新築住宅の減額",
        body: "居住部分120㎡までの固定資産税を1/2。一般住宅3年度、長期優良住宅5年度、3階建以上の耐火住宅は5〜7年度"
      }
    ],
    howToTitle: "使い方",
    steps: [
      "課税明細書の土地・家屋の評価額と面積を入力します。",
      "住宅用地かどうか、新築減額の期間中かを選び、税率を確認します。",
      "固定資産税・都市計画税と合計を確認します。"
    ],
    faqTitle: "よくある質問",
    faqs: [
      {
        question: "通知書の金額と違うのはなぜですか？",
        answer: "土地には負担調整措置があり、実際の課税標準が本則の額より低いことがあります。課税明細書の「課税標準額」を評価額欄に入れ、住宅用地を「住宅用地以外」にすると、固定資産税は近い値になります。"
      },
      {
        question: "空き家にも特例がありますか？",
        answer: "管理不全空家や特定空家として勧告を受けると、住宅用地の特例が外れます。"
      },
      {
        question: "免税点とは？",
        answer: "同じ市町村内の課税標準の合計が土地30万円、家屋20万円に満たない場合は課税されません。"
      }
    ],
    disclaimer: "このツールは一般的な計算用です。正確な税額はお住まいの市区町村の資産税課でご確認ください。"
  },
  zh: {
    introTitle: "中国个人住房一般不征收持有环节的房产税",
    intro: "《房产税暂行条例》第5条规定个人所有非营业用的房产免纳房产税，因此大多数城市的自住房没有每年缴纳的持有税。2011年起上海、重庆开展了对部分个人住房征收房产税的试点，至今仍在执行。本页按上海试点规则计算，其他城市的个人住房目前一般不需要缴纳。",
    formulaTitle: "上海试点规则",
    formulas: [
      {
        title: "征收对象",
        body: "本市居民家庭新购的第二套及以上住房，以及非本市居民家庭新购的住房"
      },
      {
        title: "免税面积",
        body: "家庭全部住房面积人均不超过60㎡的，新购住房免税；超过的部分计税"
      },
      {
        title: "计税依据和税率",
        body: "成交价 × 70% 按应税面积折算；税率0.6%，单价不超过上年新建商品住房均价2倍的按0.4%"
      }
    ],
    howToTitle: "使用方法",
    steps: [
      "输入新购住房的成交价和面积。",
      "输入家庭已有住房面积和家庭人数，选择户籍和单价档次。",
      "查看应税面积、计税依据和每年房产税。"
    ],
    faqTitle: "常见问题",
    faqs: [
      {
        question: "全国会开征房地产税吗？",
        answer: "2021年全国人大常委会授权国务院在部分地区开展房地产税改革试点，但目前没有公布新的试点城市。现行仍只有上海、重庆的房产税试点。"
      },
      {
        question: "重庆试点怎么算？",
        answer: "重庆试点主要针对主城区的独栋商品住宅、高档住房以及特定人群购买的第二套以上普通住房，税率0.5%至1.2%，规则与上海不同，本工具未计算。"
      },
      {
        question: "出租或经营用房要交吗？",
        answer: "要。个人出租住房等营业用房产按房产税暂行条例和相关优惠政策缴纳，不属于本页的自住房范围。"
      }
    ],
    disclaimer: "本工具用于一般估算。具体是否征税和金额请以上海市税务局的认定为准。"
  },
  fr: {
    introTitle: "La taxe foncière dépend de la valeur locative cadastrale et des taux locaux",
    intro: "Tout propriétaire d'un logement au 1er janvier paie la taxe foncière sur les propriétés bâties. Sa base est la moitié de la valeur locative cadastrale, revalorisée chaque année par la loi de finances. Le taux est voté par la commune et l'intercommunalité : il varie beaucoup d'une ville à l'autre, d'où la saisie du taux indiqué sur votre avis.",
    formulaTitle: "Règles de calcul",
    formulas: [
      {
        title: "Base",
        body: "Valeur locative cadastrale × 50 % (abattement légal pour frais)"
      },
      {
        title: "Taux",
        body: "Taux communal + intercommunal (+ taxes spéciales et GEMAPI le cas échéant), voté chaque année"
      },
      {
        title: "Montant",
        body: "Base × taux ; la taxe d'enlèvement des ordures ménagères s'ajoute sur le même avis"
      }
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Reprenez la valeur locative de votre avis ou de l'espace particulier sur impots.gouv.fr.",
      "Saisissez le total des taux de la commune et de l'intercommunalité.",
      "Lisez la base et la taxe foncière estimée."
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      {
        question: "Pourquoi 37,18 % par défaut ?",
        answer: "C'est le taux moyen communal de taxe foncière bâtie voté en 2025 selon la DGCL. Votre taux réel, intercommunalité comprise, peut être nettement plus haut ou plus bas."
      },
      {
        question: "Un logement neuf est-il exonéré ?",
        answer: "Une construction nouvelle peut bénéficier d'une exonération temporaire de deux ans, dont la commune fixe l'étendue ; il faut déclarer l'achèvement des travaux dans les 90 jours."
      },
      {
        question: "Existe-t-il des dégrèvements ?",
        answer: "Oui, notamment pour les personnes de plus de 75 ans ou bénéficiaires de certaines allocations sous conditions de revenus. Vérifiez sur impots.gouv.fr."
      }
    ],
    disclaimer: "Cet outil sert au calcul général. Le montant exact figure sur votre avis de taxe foncière."
  },
  es: {
    introTitle: "El IBI se calcula con el valor catastral y el tipo que fija tu ayuntamiento",
    intro: "El Impuesto sobre Bienes Inmuebles es un impuesto municipal que paga cada año quien es propietario a 1 de enero. La base es el valor catastral, a veces reducido tras una revisión catastral (base liquidable), y el ayuntamiento fija el tipo dentro de los límites de la Ley de Haciendas Locales: entre el 0,4 % y el 1,10 % para inmuebles urbanos.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      {
        title: "Base",
        body: "Valor catastral, menos la reducción por revisión catastral si la hay (base liquidable)"
      },
      {
        title: "Tipo",
        body: "Urbano: 0,4 %–1,10 % según el ayuntamiento (art. 72 TRLRHL); puede ser mayor en algunos casos"
      },
      {
        title: "Cuota",
        body: "Base liquidable × tipo, menos bonificaciones municipales"
      }
    ],
    howToTitle: "Cómo usarla",
    steps: [
      "Copia la base liquidable o el valor catastral de tu recibo o de la Sede del Catastro.",
      "Introduce el tipo de gravamen de tu ayuntamiento.",
      "Revisa el IBI anual estimado."
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      {
        question: "¿Dónde veo el valor catastral?",
        answer: "En el recibo del IBI o en la Sede Electrónica del Catastro con certificado digital o Cl@ve."
      },
      {
        question: "¿Quién paga el IBI si vendo a mitad de año?",
        answer: "El sujeto pasivo es el propietario a 1 de enero, aunque en la compraventa es habitual prorratearlo entre comprador y vendedor."
      },
      {
        question: "¿Hay bonificaciones?",
        answer: "Muchos ayuntamientos bonifican a familias numerosas, viviendas de protección oficial o instalaciones solares, y pueden aplicar un recargo a viviendas vacías."
      }
    ],
    disclaimer: "Esta herramienta es para cálculo general. El importe exacto figura en el recibo de tu ayuntamiento."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {country ? <PropertyTaxCountryCalculator client:load country={country} /> : <PropertyTaxCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="property-tax-calculator" slugs={["comprehensive-income-tax-calculator", "global-income-tax-calculator", "gift-tax-calculator", "inheritance-tax-calculator", "property-tax-calculator", "year-end-settlement-calculator", "severance-calculator", "freelancer-tax-calculator"]} />
  </div>
</BaseLayout>
