---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EtfRecommenderComp from "../../components/tools/EtfRecommender";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale & Locale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "ETF 추천기 — 투자 성향에 맞는 ETF 찾기",
    description: "간단한 설문으로 나의 투자 성향을 분석하고, 최적화된 글로벌 ETF 포트폴리오를 추천받으세요.",
  },
  en: {
    title: "ETF Recommender",
    description: "Analyze your investment propensity with a quick quiz and get a recommended global ETF portfolio tailored to your style.",
  },
  ja: {
    title: "ETFレコメンダー — 投資傾向に合ったETFを探す",
    description: "簡単なアンケートで投資傾向を分析し、最適なグローバルETFポートフォリオをご提案します。",
  },
  fr: {
    title: "Recommandeur ETF",
    description: "Analysez votre profil d'investisseur avec un quiz rapide et obtenez un portefeuille ETF mondial adapté à votre style.",
  },
  es: {
    title: "Recomendador de ETF",
    description: "Analiza tu perfil inversor con un cuestionario rápido y obtén un portafolio de ETF global adaptado a tu estilo.",
  },
  zh: {
    title: "ETF推荐器 — 找到符合投资倾向的ETF",
    description: "通过简单问卷了解您的投资倾向，查看用于学习的全球ETF组合示例。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "ETF 선택은 수익률보다 투자 목적을 먼저 정해야 합니다",
    intro: "ETF는 여러 자산에 분산 투자할 수 있는 유용한 도구지만, 모든 사람에게 같은 상품이 맞지는 않습니다. 이 추천기는 투자 기간, 위험 감수도, 선호 자산을 정리해 학습용 포트폴리오 예시를 보여줍니다. 실제 매수 전에는 비용, 세금, 환율, 추적오차, 개인 재무상황을 별도로 확인해야 합니다.",
    formulaTitle: "ETF를 비교할 때 보는 기준",
    formulas: [
      { title: "위험 성향", body: "주식 비중이 높을수록 변동성이 커질 수 있고, 채권·현금성 자산은 방어적 역할을 할 수 있습니다." },
      { title: "비용과 추적", body: "총보수, 거래비용, 추적오차는 장기 수익률에 누적 영향을 줍니다." },
      { title: "투자 기간", body: "단기 자금과 장기 자금은 감당할 수 있는 변동성과 상품 선택 기준이 다릅니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "투자 목적, 기간, 위험 감수도에 관한 질문에 답합니다.",
      "제시된 ETF 조합을 자산군 비중과 비용 관점에서 읽습니다.",
      "실제 투자 전 공식 상품 설명서와 본인의 재무 상황을 다시 확인합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "이 결과대로 ETF를 사도 되나요?", answer: "아니요. 결과는 교육용 예시이며 개인 맞춤 투자 자문이 아닙니다. 실제 매수는 본인 판단과 전문 상담을 바탕으로 해야 합니다." },
      { question: "추천 결과가 수익을 보장하나요?", answer: "아니요. ETF도 원금 손실 가능성이 있으며 시장, 환율, 금리, 세금 변화에 영향을 받습니다." },
      { question: "ETF를 고를 때 가장 먼저 볼 것은 무엇인가요?", answer: "투자 목적과 기간, 위험 감수도를 먼저 정한 뒤 자산군, 비용, 유동성, 과거 추적 정도를 비교하는 것이 좋습니다." },
    ],
    disclaimer: "이 페이지는 교육용 정보이며 투자 권유나 자문이 아닙니다. 투자 결정과 손익 책임은 투자자 본인에게 있습니다.",
  },
  en: {
    introTitle: "ETF selection starts with purpose, not a ticker",
    intro: "ETFs can be useful building blocks for diversified portfolios, but the same fund is not right for every investor. This recommender organizes your time horizon, risk tolerance, and asset preferences into an educational portfolio example. Before investing, review fees, taxes, currency exposure, tracking difference, and your own financial situation.",
    formulaTitle: "ETF comparison concepts",
    formulas: [
      { title: "Risk profile", body: "Higher equity exposure can mean higher volatility; bonds or cash-like assets may play a defensive role." },
      { title: "Cost and tracking", body: "Expense ratios, trading costs, and tracking difference compound over long holding periods." },
      { title: "Time horizon", body: "Short-term and long-term money can tolerate very different levels of market movement." },
    ],
    howToTitle: "How to use",
    steps: [
      "Answer the questions about purpose, time horizon, and risk tolerance.",
      "Read the suggested ETF mix by asset class, risk level, and cost considerations.",
      "Before investing, check official fund documents and your personal financial context.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Should I buy exactly what this suggests?", answer: "No. The result is an educational example, not personalized investment advice or a recommendation to buy." },
      { question: "Does the result guarantee returns?", answer: "No. ETFs can lose value and are affected by market prices, currency, interest rates, taxes, and fees." },
      { question: "What should I compare first?", answer: "Start with goal, time horizon, and risk tolerance, then compare asset class, cost, liquidity, and tracking history." },
    ],
    disclaimer: "This page is educational information, not investment advice, solicitation, or fiduciary guidance. You are responsible for your own investment decisions.",
  },
  ja: {
    introTitle: "ETF選びは銘柄名より投資目的から始めます",
    intro: "ETFは分散投資に使いやすい商品ですが、誰にでも同じETFが合うわけではありません。この推薦ツールは投資期間、リスク許容度、好みの資産を整理し、学習用のポートフォリオ例を示します。実際の投資前には手数料、税金、為替、トラッキング差、個人の資金状況を確認してください。",
    formulaTitle: "ETF比較の観点",
    formulas: [
      { title: "リスク特性", body: "株式比率が高いほど変動が大きくなり、債券や現金性資産は防御的な役割を持つことがあります。" },
      { title: "費用と連動性", body: "信託報酬、売買コスト、トラッキング差は長期で積み重なります。" },
      { title: "投資期間", body: "短期資金と長期資金では、許容できる値動きが大きく異なります。" },
    ],
    howToTitle: "使い方",
    steps: [
      "投資目的、期間、リスク許容度に関する質問に答えます。",
      "提示されたETF構成を資産配分、リスク、費用の面から読みます。",
      "投資前に公式資料と自分の資金状況を確認します。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "結果どおりに買えばよいですか？", answer: "いいえ。結果は学習用の例であり、個別の投資助言や購入推奨ではありません。" },
      { question: "収益は保証されますか？", answer: "いいえ。ETFには元本割れの可能性があり、市場、為替、金利、税金、費用の影響を受けます。" },
      { question: "最初に何を比較すべきですか？", answer: "目的、期間、リスク許容度を決めたうえで、資産クラス、費用、流動性、連動状況を比較します。" },
    ],
    disclaimer: "このページは教育目的の情報であり、投資助言や勧誘ではありません。投資判断と損益の責任は投資者本人にあります。",
  },
  fr: {
    introTitle: "Choisir un ETF commence par l'objectif, pas par le symbole",
    intro: "Les ETF sont des briques utiles de diversification, mais le même fonds ne convient pas à tout le monde. Ce questionnaire organise horizon, tolérance au risque et préférences d'actifs pour afficher un exemple pédagogique de portefeuille. Avant d'investir, vérifiez frais, fiscalité, devise, suivi de l'indice et situation personnelle.",
    formulaTitle: "Critères de comparaison",
    formulas: [
      { title: "Profil de risque", body: "Plus d'actions peut signifier plus de volatilité ; obligations et liquidités peuvent jouer un rôle défensif." },
      { title: "Frais et suivi", body: "Frais courants, coûts de transaction et écart de suivi s'accumulent sur la durée." },
      { title: "Horizon", body: "L'argent à court terme et à long terme ne supporte pas le même niveau de fluctuation." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Répondez aux questions sur objectif, horizon et tolérance au risque.",
      "Lisez la répartition proposée par classe d'actifs, risque et coûts.",
      "Avant d'investir, consultez les documents officiels et votre contexte financier.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Dois-je acheter exactement ce résultat ?", answer: "Non. Le résultat est un exemple pédagogique, pas un conseil personnalisé ni une recommandation d'achat." },
      { question: "Les rendements sont-ils garantis ?", answer: "Non. Un ETF peut perdre de la valeur et dépend des marchés, devises, taux, frais et impôts." },
      { question: "Que comparer en premier ?", answer: "Commencez par objectif, horizon et risque, puis comparez classe d'actifs, frais, liquidité et historique de suivi." },
    ],
    disclaimer: "Cette page est informative et pédagogique. Elle ne constitue pas un conseil en investissement, une sollicitation ou une recommandation personnalisée.",
  },
  es: {
    introTitle: "Elegir un ETF empieza por el objetivo, no por el ticker",
    intro: "Los ETF pueden ser piezas útiles para diversificar, pero el mismo fondo no sirve para todas las personas. Este cuestionario organiza horizonte, tolerancia al riesgo y preferencias de activos en un ejemplo educativo de cartera. Antes de invertir, revisa costes, impuestos, divisa, seguimiento del índice y tu situación financiera.",
    formulaTitle: "Conceptos para comparar ETF",
    formulas: [
      { title: "Perfil de riesgo", body: "Más exposición a acciones puede implicar más volatilidad; bonos o efectivo pueden tener un papel defensivo." },
      { title: "Costes y seguimiento", body: "Comisiones, costes de operación y diferencia de seguimiento se acumulan con el tiempo." },
      { title: "Horizonte temporal", body: "El dinero de corto y largo plazo tolera niveles distintos de movimiento del mercado." },
    ],
    howToTitle: "Cómo usarlo",
    steps: [
      "Responde preguntas sobre objetivo, horizonte y tolerancia al riesgo.",
      "Lee la mezcla sugerida por clase de activo, riesgo y costes.",
      "Antes de invertir, consulta documentos oficiales y tu contexto financiero personal.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Debo comprar exactamente lo sugerido?", answer: "No. El resultado es un ejemplo educativo, no asesoramiento personalizado ni recomendación de compra." },
      { question: "¿Garantiza rentabilidad?", answer: "No. Los ETF pueden perder valor y dependen de mercado, divisa, tipos, impuestos y comisiones." },
      { question: "¿Qué comparo primero?", answer: "Empieza por objetivo, horizonte y riesgo; luego compara clase de activo, coste, liquidez e historial de seguimiento." },
    ],
    disclaimer: "Esta página es información educativa, no asesoramiento de inversión, solicitud ni recomendación personalizada. Las decisiones son responsabilidad del inversor.",
  },
  zh: {
    introTitle: "选择 ETF 应先看投资目的，而不是先看代码",
    intro: "ETF 可以作为分散投资的工具，但同一个产品并不适合所有人。本推荐器会根据投资期限、风险承受能力和资产偏好，展示用于学习的组合示例。实际投资前，请另行查看费用、税务、汇率、跟踪误差和个人财务状况。",
    formulaTitle: "比较 ETF 的核心概念",
    formulas: [
      { title: "风险偏好", body: "股票比例越高，波动可能越大；债券或现金类资产可能起到防守作用。" },
      { title: "费用与跟踪", body: "管理费、交易成本和跟踪误差会在长期持有中持续影响结果。" },
      { title: "投资期限", body: "短期资金和长期资金能承受的市场波动并不相同。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "回答关于投资目的、期限和风险承受能力的问题。",
      "从资产类别、风险水平和费用角度阅读示例组合。",
      "实际投资前，查看官方基金文件并结合个人财务情况判断。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "可以直接按照结果买入吗？", answer: "不可以。结果只是教育示例，不是个性化投资建议，也不是买入推荐。" },
      { question: "结果能保证收益吗？", answer: "不能。ETF 也可能亏损，并受市场、汇率、利率、税费等因素影响。" },
      { question: "选择 ETF 先比较什么？", answer: "先明确目标、期限和风险承受能力，再比较资产类别、费用、流动性和跟踪情况。" },
    ],
    disclaimer: "本页面仅提供教育信息，不构成投资建议、招揽或个性化推荐。投资决策及盈亏责任由投资者自行承担。",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-3xl px-4 py-8">
    <EtfRecommenderComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
