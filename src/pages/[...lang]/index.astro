---
import { getCollection } from "astro:content";
import BlogList from "../../components/BlogList.astro";
import { getTranslations, locales } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

const posts = await getCollection("blog", ({ data }) => {
  return data.draft !== true && data.locale === locale;
});

posts.sort((a, b) => {
  const aMatch = a.slug.match(/-ch(\d+)$/);
  const bMatch = b.slug.match(/-ch(\d+)$/);
  if (aMatch && bMatch && a.data.category === b.data.category) {
    return parseInt(aMatch[1], 10) - parseInt(bMatch[1], 10);
  }
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const postsPerPage = 10;
const totalPages = Math.ceil(posts.length / postsPerPage);

const page = {
  data: posts.slice(0, postsPerPage),
  currentPage: 1,
  lastPage: totalPages,
};
---

<BlogList
  page={page}
  locale={locale}
  baseUrl={`/${locale}`}
  title={t.nav.home}
  subtitle={locale === "ko"
    ? "우리는 스스로 나아지려는 노력을 할 때 늙지 않습니다."
    : "We do not grow old as long as we strive to improve ourselves."}
/>
