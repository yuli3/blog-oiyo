---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AieoReadinessAudit from "../../components/tools/AieoReadinessAudit";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "웹사이트 AI 검색 노출(GEO/AIEO) 준비도 진단기 — Schema.org & 크롤러 감사 도구",
    description: "ChatGPT Search, Perplexity, Claude, Google AI Overviews에서 내 웹사이트가 왜 인용되지 않는지 1초 만에 무료 진단하고 개선책을 제시합니다.",
  },
  en: {
    title: "AIEO & GEO Readiness Audit Tool — AI Search Engine Optimization Checker",
    description: "Audit your website for Google AI Overviews, ChatGPT Search, and Perplexity citation readiness in under 1 second.",
  },
  ja: {
    title: "AI検索最適化（GEO/AIEO）診断ツール — AI検索エンジン露出チェッカー",
    description: "ChatGPT Search、Perplexity、Google AI Overviewsからの引用準備状況をリアルタイムで無料診断します。",
  },
  fr: {
    title: "Outil d'Audit AIEO & GEO — Vérificateur d'Optimisation pour Moteurs de Recherche IA",
    description: "Auditez la préparation de votre site web pour les citations ChatGPT Search, Perplexity et Google AI en 1 seconde.",
  },
  es: {
    title: "Herramienta de Auditoría AIEO y GEO — Optimizador de Búsqueda para IA",
    description: "Audita la preparación de tu sitio web para citaciones en ChatGPT Search, Perplexity y Google AI Overviews.",
  },
  zh: {
    title: "AI 搜索曝光度 (GEO/AIEO) 评估工具 — 大模型检索与引用就绪度审计",
    description: "一秒检测网站对 ChatGPT Search、Perplexity 和 Google AI Overviews 爬虫与结构化数据的支持状态。",
  },
};

const currentMeta = meta[locale] ?? meta.ko;
---

<BaseLayout
  title={currentMeta.title}
  description={currentMeta.description}
  availableLocales={[...locales]}
>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto mb-8 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        {currentMeta.title}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {currentMeta.description}
      </p>
    </div>

    <AieoReadinessAudit client:load />

    <section class="max-w-4xl mx-auto mt-12 space-y-6 text-sm text-muted-foreground border-t border-border pt-8">
      <h2 class="text-lg font-semibold text-foreground">
        {locale === "ko" ? "AI 검색 엔진 최적화(GEO/AIEO)가 필수인 이유" : "Why GEO/AIEO is Essential"}
      </h2>
      <div class="space-y-3 leading-relaxed">
        <p>
          {locale === "ko"
            ? "전통적인 키워드 중심의 SEO를 넘어, 대규모 언어 모델(LLM)이 웹페이지의 사실적 주장과 엔티티를 파악할 수 있도록 Schema.org JSON-LD와 명확한 H1/H2 계층 구조를 갖추는 것이 2026년 AI 검색 인용의 핵심입니다."
            : "Beyond traditional keywords, modern generative engines require valid Schema.org JSON-LD and clean semantic hierarchies to reliably synthesize and cite your content."}
        </p>
        <p>
          {locale === "ko"
            ? "robots.txt에서 OAI-SearchBot, ClaudeBot, PerplexityBot을 차단하면 AI 답변에서 출처 링크로 인용될 기회를 잃게 됩니다. AI 학습용 크롤러와 실시간 검색용 크롤러를 분리하여 현명하게 통제해야 합니다."
            : "Blocking search citation bots prevents your domain from being linked in AI-generated answers. Configure robots.txt to permit search indexers while managing training crawlers."}
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
