---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import PensionCalculatorComp from "../../components/tools/PensionCalculator";
import PensionCountryCalculator from "../../components/tools/PensionCountryCalculator";
import type { PensionCountry } from "../../lib/pension-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's private-pension scheme; ko and en use South Korea's 연금저축·IRP.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, PensionCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "연금저축·IRP 세액공제 계산기 — 연말정산 환급액 추정",
    description: "총급여와 연금저축·IRP 납입액을 입력해 세액공제율 13.2% 또는 16.5% 기준의 예상 환급액을 계산합니다.",
  },
  en: {
    title: "Pension Savings & IRP Tax Credit Calculator (South Korea)",
    description: "Estimate the Korean year-end tax credit from pension savings and IRP contributions using the 13.2% or 16.5% credit rate.",
  },
  ja: {
    title: "iDeCo節税シミュレーター — 掛金の拠出限度額と所得税・住民税の軽減額",
    description: "加入区分と年収から、iDeCoの拠出限度額（2026年12月分からの新限度額にも対応）と、掛金の所得控除で下がる所得税・住民税を計算します。受取時の税金、新NISAとの配分も試算できます。",
  },
  fr: {
    title: "Simulateur PER 2026 — plafond de déduction et économie d'impôt",
    description: "Calculez votre plafond épargne retraite 2026 (salarié ou indépendant), le montant déductible de vos versements PER et l'économie d'impôt selon votre tranche marginale. Fiscalité de sortie et projection incluses.",
  },
  es: {
    title: "Calculadora del plan de pensiones 2026 — cuánto ahorras en el IRPF",
    description: "Calcula cuánto reduce tu aportación al plan de pensiones la base imponible del IRPF (1.500 € individuales, hasta 8.500 € más por la empresa o 4.250 € como autónomo) y el ahorro según tu tipo marginal.",
  },
  zh: {
    title: "个人养老金节税计算器 — 12,000元扣除能少缴多少个税",
    description: "按综合所得年度税率表计算个人养老金缴费（每年最多12,000元）能少缴的个人所得税、你的边际税率，以及领取时按3%缴税后的净收益。",
  },
};

const m = meta[locale] ?? meta.en;

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "이 계산기는 국민연금 수령액이 아니라 연금계좌 세액공제를 추정합니다",
    intro: "연금저축과 IRP는 노후 준비 수단이면서 연말정산 세액공제 효과가 있는 계좌예요. 총급여와 연간 납입액을 입력하면 2024년 기준 통합 한도 900만 원 안에서 13.2% 또는 16.5% 공제율이 적용될 때 돌려받을 수 있는 세액공제액을 확인할 수 있어요.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "공제 대상 납입액", body: "입력한 연간 납입액과 통합 한도 900만 원 중 작은 금액을 기준으로 합니다." },
      { title: "공제율", body: "총급여 5,500만 원 이하는 16.5%, 초과는 13.2%를 적용합니다." },
      { title: "예상 환급액", body: "공제 대상 납입액에 세액공제율을 곱해 연말정산 환급 효과를 추정합니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "연간 총급여를 원 단위로 입력합니다.",
      "연금저축과 IRP에 납입할 연간 금액을 입력합니다.",
      "적용 공제율과 한도, 예상 세액공제액을 확인합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "국민연금 예상 수령액도 계산하나요?", answer: "아니요. 이 페이지의 컴포넌트는 연금저축·IRP 세액공제 계산기입니다. 국민연금 노령연금 수령액은 가입 기간, 기준소득월액, 제도 산식이 별도로 필요합니다." },
      { question: "900만 원 한도는 항상 적용되나요?", answer: "이 도구는 연금저축과 IRP를 합산한 세액공제 한도 900만 원을 단순 적용합니다. 계좌 종류별 세부 한도와 세법은 해마다 바뀔 수 있습니다." },
      { question: "계산된 금액이 그대로 환급되나요?", answer: "세액공제는 산출세액이 충분할 때 효과가 납니다. 이미 낼 세금이 적거나 다른 공제가 많으면 실제 환급액은 줄어들 수 있습니다." },
    ],
    disclaimer: "이 도구는 일반적인 추정용이에요. 실제 세액공제와 연말정산 결과는 국세청 또는 세무 전문가에게 확인하세요.",
  },
  en: {
    introTitle: "This estimates pension account tax credits, not public pension benefits",
    intro: "Korean pension savings and IRP accounts can support retirement planning while creating a year-end tax credit. Enter annual salary and annual contributions to estimate the credit under the 2024-style combined KRW 9 million limit and the 13.2% or 16.5% credit rate.",
    formulaTitle: "Calculation basis",
    formulas: [
      { title: "Eligible contribution", body: "Uses the smaller of your annual contribution and the combined KRW 9 million limit." },
      { title: "Credit rate", body: "Uses 16.5% for salary up to KRW 55 million and 13.2% above that threshold." },
      { title: "Estimated refund effect", body: "Eligible contribution multiplied by the credit rate gives the estimated tax credit." },
    ],
    howToTitle: "How to use",
    steps: [
      "Enter annual gross salary in KRW.",
      "Enter the annual amount you plan to contribute to pension savings and IRP.",
      "Review the applied credit rate, contribution cap, and estimated tax credit.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Does this calculate Korean National Pension benefits?", answer: "No. The mounted tool calculates pension savings and IRP tax credits. Public pension benefit estimates require contribution history, insured income, and the NPS benefit formula." },
      { question: "Is the KRW 9 million limit always correct?", answer: "This tool applies a simplified combined tax-credit cap. Account-specific limits and Korean tax rules can change by year." },
      { question: "Will I receive the full amount as a refund?", answer: "Only if you have enough tax liability. If your calculated tax is low or other credits already reduce it, the actual refund can be smaller." },
    ],
    disclaimer: "This tool is a general estimate. Confirm actual tax credits and year-end settlement results with the relevant institution or tax professional.",
  },
  ja: {
    introTitle: "iDeCoの掛金は全額が所得控除。節税額は所得税と住民税の税率で決まります",
    intro: "iDeCo（個人型確定拠出年金）の掛金は全額が小規模企業共済等掛金控除になり、その年の所得税（復興特別所得税を含む）と翌年度の住民税（10%）が下がります。会社員で所得税率10%なら、掛金の約20%が戻る計算です。拠出限度額は加入区分で決まり、2026年12月分の掛金から会社員は月2.3万円（企業年金ありは2万円）→6.2万円、自営業は6.8万円→7.5万円に引き上げられます。12月分は翌年1月に引き落とされるので、新しい限度額が控除に効くのは2027年分からです。",
    formulaTitle: "計算基準",
    formulas: [
      { title: "拠出限度額（月額）", body: "会社員（企業年金なし）2.3万→6.2万円、企業年金あり・公務員 2万円（合算5.5万円）→6.2万円−他制度掛金相当額、自営業 6.8万→7.5万円（国民年金基金と合算）、第3号 2.3万円" },
      { title: "所得税の軽減", body: "課税所得が掛金分だけ下がり、所得税率（5%〜45%）×102.1%の分だけ税が減ります" },
      { title: "住民税の軽減", body: "翌年度の住民税（所得割10%）が掛金×10%程度下がります" },
    ],
    howToTitle: "使い方",
    steps: ["加入区分と、計算する年分（2026年分か2027年分以降か）を選びます。", "毎月の掛金と、給与収入・社会保険料・扶養などを入れます。", "所得税・住民税の軽減額と実質負担を確認します。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "2026年12月の改正で、いくらまで掛けられるようになりますか？", answer: "2026年12月分の掛金から、企業年金のない会社員と公務員以外の第2号被保険者は月6.2万円、企業年金のある会社員・公務員は6.2万円から企業年金等の掛金相当額を引いた額、自営業などの第1号被保険者は国民年金基金・付加保険料と合わせて月7.5万円になります。専業主婦・主夫（第3号）は月2.3万円のままです。" },
      { question: "収入がなくても節税になりますか？", answer: "なりません。所得控除は所得税・住民税を減らす仕組みなので、税金がかからない人には節税効果はありません。運用益が非課税になる点は同じです。" },
      { question: "年末調整と確定申告のどちらで控除を受けますか？", answer: "会社員は年末調整で「小規模企業共済等掛金控除」として申告します。勤務先の給与天引きなら自動で反映されます。自営業の人は確定申告で控除します。" },
    ],
    disclaimer: "このツールは一般的な見積もり用です。拠出限度額はiDeCo公式サイト・厚生労働省、税額は国税庁の資料や税理士にご確認ください。",
  },
  zh: {
    introTitle: "个人养老金：每年12,000元以内的缴费在个税前扣除，领取时按3%纳税",
    intro: "个人养老金自2024年起在全国实施。向个人养老金资金账户缴费，每年最多12,000元可在综合所得或经营所得中据实扣除；账户里的投资收益暂不征税；退休领取时不并入综合所得，单独按3%缴税。所以节税多少取决于你的边际税率：边际税率10%的人每年少缴1,200元，领取时每1万元交300元；边际税率3%或不用交个税的人，单看税收没有好处。",
    formulaTitle: "计算规则",
    formulas: [
      { title: "可扣除金额", body: "当年个人养老金缴费与12,000元取小" },
      { title: "少缴个税", body: "按年度税率表（3%–45%）分别计算扣除前后的应纳税额，差额即节税额" },
      { title: "领取时纳税", body: "领取金额 × 3%，不并入综合所得" },
    ],
    howToTitle: "使用方法",
    steps: ["填写全年工资薪金等收入、社保公积金和专项附加扣除。", "输入当年个人养老金缴费金额。", "查看少缴的个税、边际税率；切换到「领取纳税」「长期测算」看领取时的税和净收益。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "个人养老金一年最多能扣除多少？", answer: "每年12,000元。可以在预扣预缴时向单位提供缴费凭证扣除，也可以在次年年度汇算时扣除。超过12,000元的部分不能扣除。" },
      { question: "什么人缴个人养老金划算？", answer: "边际税率越高越划算。边际税率10%及以上的人，缴费时省的税比领取时的3%多；收入在起征点附近、不用交个税或只适用3%税率的人，单看税收没有净收益，还要考虑资金要到退休才能领取。" },
      { question: "领取时的3%包括收益吗？", answer: "包括。领取的全部金额（本金和投资收益）都按3%计税，由开户银行代扣代缴。" },
    ],
    disclaimer: "本工具仅供一般估算。具体以国家税务总局、人力资源社会保障部的规定和个人所得税App的计算为准。",
  },
  fr: {
    introTitle: "PER : chaque euro versé dans le plafond réduit votre revenu imposable",
    intro: "Les versements volontaires sur un plan d'épargne retraite (PER individuel) se déduisent du revenu net imposable du foyer. L'économie d'impôt est donc égale au versement multiplié par votre tranche marginale d'imposition (11 %, 30 %, 41 % ou 45 %). Pour un salarié, le plafond 2026 vaut 10 % des revenus professionnels nets de 2025, au minimum 4 710 € et au maximum 37 680 €, moins les cotisations de l'employeur au PERCOL ou au PER obligatoire. Les indépendants ont un plafond plus élevé (jusqu'à 88 911 €). La loi de finances 2026 allonge le report des plafonds non utilisés à 5 ans et supprime la déduction des versements faits après 70 ans.",
    formulaTitle: "Règles de calcul",
    formulas: [
      { title: "Plafond salarié 2026", body: "10 % des revenus nets 2025, min 4 710 € (10 % du PASS 2025), max 37 680 € (10 % de 8 PASS), − cotisations employeur, + plafonds non utilisés" },
      { title: "Plafond TNS 2026", body: "10 % du bénéfice (≤ 8 PASS) + 15 % de la part entre 1 et 8 PASS, min 4 806 €, max 88 911 €" },
      { title: "Économie d'impôt", body: "Impôt au barème 2026 avant versement − impôt après déduction du versement (≈ versement × TMI)" },
    ],
    howToTitle: "Mode d'emploi",
    steps: ["Choisissez votre statut et saisissez les revenus qui fixent le plafond.", "Indiquez le revenu imposable du foyer, la situation familiale et le versement prévu.", "Lisez le plafond, le montant déductible et l'économie d'impôt."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Où trouver mon plafond épargne retraite ?", answer: "Il figure sur votre avis d'impôt, rubrique « plafond épargne retraite », avec les plafonds non utilisés des années précédentes. Le simulateur le recalcule à partir de vos revenus si vous ne l'avez pas sous la main." },
      { question: "Le PER est-il intéressant si je ne suis pas imposable ?", answer: "Pas pour la déduction : sans impôt, il n'y a rien à économiser. Vous pouvez alors renoncer à la déduction ; les versements non déduits ne seront pas imposés à la sortie, seuls les gains le seront." },
      { question: "Que change la loi de finances 2026 ?", answer: "Les plafonds non utilisés à partir de 2026 se reportent sur 5 ans au lieu de 3, et les versements effectués après 70 ans ne sont plus déductibles. Les prélèvements sociaux sur les gains passent de 17,2 % à 18,6 %." },
    ],
    disclaimer: "Cet outil sert au calcul général. Vérifiez votre plafond sur votre avis d'impôt (impots.gouv.fr) et les règles du PER sur service-public.fr.",
  },
  es: {
    introTitle: "Plan de pensiones: lo que aportas reduce tu base del IRPF y ahorras tu tipo marginal",
    intro: "Las aportaciones a planes de pensiones se restan de la base imponible general del IRPF. Por eso el ahorro es aproximadamente la aportación multiplicada por tu tipo marginal (del 19 % al 47 %). El límite general es de 1.500 € al año en planes individuales; se puede ampliar hasta 8.500 € más con contribuciones de la empresa a un plan de empleo (y tus aportaciones a ese plan dentro de unos coeficientes) o con 4.250 € de aportaciones como autónomo a planes de empleo simplificados. En ningún caso la reducción puede superar el 30 % de tus rendimientos netos del trabajo y actividades. Al rescatar, todo lo cobrado tributa como rendimiento del trabajo.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      { title: "Límite general", body: "1.500 € en planes individuales (incluye lo que aportes al plan de empleo por encima del coeficiente)" },
      { title: "Incrementos", body: "Hasta 8.500 € por contribuciones empresariales y tus aportaciones al plan de empleo (×2,5 hasta 500 €, 1.250 + 25 % hasta 1.500 €, ×1 por encima, máx. 4.250 €) o 4.250 € como autónomo" },
      { title: "Ahorro", body: "Cuota con la base sin reducción − cuota con la base reducida; nunca más del 30 % de los rendimientos netos" },
    ],
    howToTitle: "Cómo se usa",
    steps: ["Introduce tu salario bruto, cotizaciones y, si eres autónomo, el rendimiento de la actividad.", "Indica tus aportaciones individuales y, si las hay, las del plan de empleo o como autónomo.", "Consulta la reducción en la base y el ahorro en el IRPF."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Cuánto puedo aportar al plan de pensiones en 2026?", answer: "Puedes aportar lo que quieras, pero solo reducen la base 1.500 € en planes individuales, más hasta 8.500 € de planes de empleo con contribución empresarial o 4.250 € como autónomo en planes de empleo simplificados, con un máximo del 30 % de tus rendimientos netos del trabajo y actividades." },
      { question: "¿Qué pasa si aporto por encima del límite?", answer: "El exceso no se reduce ese año, pero puedes pedir en la declaración que se aplique en los cinco ejercicios siguientes." },
      { question: "¿Es lo mismo reducir la base que deducir de la cuota?", answer: "No. La reducción baja la base imponible, así que ahorras tu tipo marginal: con un tipo del 30 %, 1.500 € aportados ahorran unos 450 €. Al rescatar, el dinero vuelve a tributar en la base general." },
    ],
    disclaimer: "Esta herramienta es para cálculo general. Consulta los límites en el Manual práctico de Renta de la Agencia Tributaria y tu caso concreto en Renta WEB.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {country ? <PensionCountryCalculator client:load country={country} initialTab="contribution" /> : <PensionCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
