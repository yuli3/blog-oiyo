---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PerfectScopeTestComp from "../../components/tests/PerfectScopeTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "퍼펙트스코프 테스트: 나의 완벽주의 유형은?", description: "15개의 질문으로 나만의 완벽주의 패턴을 발견하세요. 자기 지향형·타인 지향형·사회적 처방형·적응적 성취형 중 나의 완벽주의 유형은 무엇인가요?" },
  en: { title: "PerfectScope Test: What's Your Perfectionism Type?", description: "Discover your unique perfectionism pattern through 15 questions. Self-Oriented, Other-Oriented, Socially Prescribed, or Adaptive Striver — which perfectionism type are you?" },
  ja: { title: "パーフェクトスコープテスト：あなたの完璧主義タイプは？", description: "15の質問で完璧主義パターンを発見しましょう。自己指向型・他者指向型・社会的処方型・適応的達成型のどれがあなたの完璧主義タイプですか？" },
  fr: { title: "Test PerfectScope : Quel est votre type de perfectionnisme ?", description: "Découvrez votre schéma perfectionniste unique à travers 15 questions. Orienté vers soi, vers les autres, socialement prescrit ou battant adaptatif ?" },
  es: { title: "Test PerfectScope: ¿Cuál es tu tipo de perfeccionismo?", description: "Descubre tu patrón perfeccionista único a través de 15 preguntas. ¿Orientado a uno mismo, orientado a otros, socialmente prescrito o buscador adaptativo?" },
  zh: { title: "完美鏡頭測試：你的完美主義類型是什麼？", description: "透過15個問題發現你獨特的完美主義模式。自我導向型、他人導向型、社會規定型還是適應性奮鬥者，你是哪種完美主義類型？" },
  cn: { title: "完美镜头测试：你的完美主义类型是什么？", description: "通过15个问题发现你独特的完美主义模式。自我导向型、他人导向型、社会规定型还是适应性奋斗者，你是哪种完美主义类型？" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <PerfectScopeTestComp client:load locale={locale} />
  </main>
</BaseLayout>
