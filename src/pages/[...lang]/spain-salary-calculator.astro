---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import SpainSalaryCalculatorComp from "../../components/tools/SpainSalaryCalculator";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  es: {
    title: "Calculadora de salario neto España 2024 — IRPF y Seguridad Social",
    description: "Calcula tu salario neto mensual en España 2024: cotizaciones a la Seguridad Social (6,47%) e IRPF según el baremo progresivo. Introduce tu bruto anual y situación familiar.",
  },
  en: {
    title: "Spain Net Salary Calculator 2024 — IRPF & Social Security",
    description: "Calculate your monthly net salary in Spain 2024: Social Security contributions (6.47%) and IRPF income tax by progressive scale. Enter your annual gross and family situation.",
  },
  ko: {
    title: "스페인 세후 급여 계산기 2024",
    description: "스페인 사회보장세(6.47%)와 IRPF 소득세를 자동 계산합니다.",
  },
  ja: {
    title: "スペイン給与手取り計算機 2024",
    description: "スペインの社会保障料とIRPF所得税を計算します。",
  },
  fr: {
    title: "Calculateur de salaire net Espagne 2024",
    description: "Calculez votre salaire net en Espagne avec les cotisations SS et l'IRPF 2024.",
  },
  zh: {
    title: "西班牙薪资净值计算机 2024",
    description: "计算西班牙社会保障费和个人所得税（IRPF）后的实际薪资。",
  },
};

const m = meta[locale] ?? meta.en;
const calcLocale = locale === 'es' ? 'es' : 'en';

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "스페인 세후 급여 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 스페인 기준의 스페인 세후 급여를 설명과 함께 계산합니다. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전합니다.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "공통 contingencias 4.70%, 실업 1.55%, 직업훈련 0.10%, MEI 0.12%를 합산합니다."
    }, {
      title: "기준 2",
      body: "연간 56,646유로를 사회보장 산정 상한으로 사용합니다."
    }, {
      title: "기준 3",
      body: "개인 최저한도 5,550유로와 자녀 기준 후 19%~47% 구간을 적용합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "스페인 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "자치주별 세율, 추가 공제, 계약 형태, 보너스 지급 방식에 따라 실제 원천징수액은 달라질 수 있습니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용입니다. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Spain net salary is country-specific",
    intro: "This page estimates Spain net salary under Spain rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Combines common contingencies 4.70%, unemployment 1.55%, training 0.10%, and MEI 0.12%."
    }, {
      title: "Rule 2",
      body: "Uses EUR 56,646 per year as the Social Security base cap."
    }, {
      title: "Rule 3",
      body: "Applies 19%-47% brackets after a EUR 5,550 personal minimum and child allowances."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Spain rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Regional rates, extra deductions, contract type, and bonus timing can change actual withholding."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "スペイン給与手取りは国ごとの制度確認が必要です",
    intro: "このページはスペイン基準のスペイン給与手取りを説明付きで試算します。税率や控除は国ごとに異なり毎年変わるため、申告前の参考値として扱ってください。",
    formulaTitle: "主な計算基準",
    formulas: [{
      title: "基準 1",
      body: "共通4.70%、失業1.55%、訓練0.10%、MEI 0.12%。"
    }, {
      title: "基準 2",
      body: "年56,646ユーロを上限にします。"
    }, {
      title: "基準 3",
      body: "5,550ユーロと子の基準後に19%~47%。"
    }],
    howToTitle: "使い方",
    steps: ["必要な金額と条件を入力します。", "税金・控除・社会保険の内訳を確認します。", "申告・納付・判断前に最新の公式基準と照合します。"],
    faqTitle: "よくある質問",
    faqs: [{
      question: "どの国の制度を基準にしていますか？",
      answer: "スペインの制度です。他国の税率、控除、社会保険にはそのまま使えません。"
    }, {
      question: "実際の金額と異なる理由は？",
      answer: "自治州税率、追加控除、契約、賞与で変わります。"
    }, {
      question: "制度は毎年変わりますか？",
      answer: "はい。税率、控除限度、社会保険料率は毎年変わる可能性があります。申告や納付前に最新年度の基準を確認してください。"
    }],
    disclaimer: "この計算は一般的な概算です。実際の税額は税務当局または税理士に確認してください。"
  },
  zh: {
    introTitle: "西班牙到手薪资必须先确认适用国家的制度",
    intro: "本页依西班牙规则估算西班牙到手薪资。税率、扣除与社会保险具有国别差异且可能逐年变动，结果应作为申报前的初步参考。",
    formulaTitle: "主要计算基准",
    formulas: [{
      title: "规则 1",
      body: "合并一般意外4.70%、失业1.55%、职训0.10%、MEI 0.12%。"
    }, {
      title: "规则 2",
      body: "以每年56,646欧元为上限。"
    }, {
      title: "规则 3",
      body: "5,550欧元最低额与子女基准后套用19%~47%。"
    }],
    howToTitle: "使用方法",
    steps: ["输入所需金额与条件。", "分别查看税金、扣除与社会保险明细。", "申报、缴纳或决策前请核对最新官方规定。"],
    faqTitle: "常见问题",
    faqs: [{
      question: "这个计算机采用哪个国家的规则？",
      answer: "采用西班牙规则，不能直接套用其他国家的税率、扣除或社会保险制度。"
    }, {
      question: "为什么可能和实际金额不同？",
      answer: "自治区税率、额外扣除、合约与奖金会改变扣缴。"
    }, {
      question: "规则每年都会变吗？",
      answer: "会。税率、扣除上限与社会保险费率都可能按年度调整。申报或缴纳前请确认当年度官方规定。"
    }],
    disclaimer: "本工具仅为一般估算。实际税额请向税务机关或税务专业人士确认。"
  },
  fr: {
    introTitle: "Salaire net espagnol dépend du pays concerné",
    intro: "Cette page estime le salaire net espagnol selon les règles de l'Espagne. Les tranches, déductions et cotisations sont propres au pays et peuvent changer chaque année; utilisez le résultat comme point de départ.",
    formulaTitle: "Bases de calcul",
    formulas: [{
      title: "Règle 1",
      body: "Contingences 4,70%, chômage 1,55%, formation 0,10%, MEI 0,12%."
    }, {
      title: "Règle 2",
      body: "56 646 € par an comme plafond."
    }, {
      title: "Règle 3",
      body: "Minimum 5 550 € et enfants avant 19%-47%."
    }],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez les montants et conditions nécessaires.", "Vérifiez séparément impôts, déductions et cotisations.", "Comparez avec les règles officielles avant déclaration, paiement ou décision."],
    faqTitle: "Questions fréquentes",
    faqs: [{
      question: "Quel pays sert de référence ?",
      answer: "Il utilise les règles de l'Espagne. Ne l’appliquez pas directement à un autre système fiscal ou social."
    }, {
      question: "Pourquoi le montant réel peut-il différer ?",
      answer: "Taux régionaux, déductions, contrat et primes peuvent changer la retenue."
    }, {
      question: "Les règles changent-elles chaque année ?",
      answer: "Oui. Les taux, plafonds de déduction et cotisations peuvent changer chaque année. Vérifiez l'année en vigueur avant de déclarer ou payer."
    }],
    disclaimer: "Ce calcul est une estimation générale. Confirmez le montant auprès de l'administration fiscale ou d'un fiscaliste."
  },
  es: {
    introTitle: "Salario neto en España depende del país aplicado",
    intro: "Esta página estima el salario neto en España con reglas de España. Los tramos, deducciones y cotizaciones son propios de cada país y pueden cambiar cada año; úsalo como estimación inicial.",
    formulaTitle: "Bases de cálculo",
    formulas: [{
      title: "Regla 1",
      body: "Contingencias comunes 4,70%, desempleo 1,55%, formación 0,10%, MEI 0,12%."
    }, {
      title: "Regla 2",
      body: "56.646 € anuales como tope."
    }, {
      title: "Regla 3",
      body: "Mínimo 5.550 € e hijos antes de 19%-47%."
    }],
    howToTitle: "Cómo usarla",
    steps: ["Introduce los importes y condiciones necesarios.", "Revisa por separado impuestos, deducciones y cotizaciones.", "Compáralo con reglas oficiales antes de declarar, pagar o tomar una decisión."],
    faqTitle: "Preguntas frecuentes",
    faqs: [{
      question: "¿Qué país usa esta calculadora?",
      answer: "Usa reglas de España. No lo apliques directamente a otro sistema fiscal o social."
    }, {
      question: "¿Por qué puede cambiar el importe final?",
      answer: "Tipos autonómicos, deducciones, contrato y pagas extra pueden cambiar la retención."
    }, {
      question: "¿Las reglas cambian cada año?",
      answer: "Sí. Los tipos, límites de deducción y cotizaciones pueden cambiar cada año. Comprueba la norma vigente antes de declarar o pagar."
    }],
    disclaimer: "Este cálculo es una estimación general. Confirma el importe con la autoridad fiscal o un profesional tributario."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-8">
    <SpainSalaryCalculatorComp client:load locale={calcLocale} />
  

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="spain-salary-calculator" slugs={["salary-calculator", "china-salary-calculator", "japan-salary-calculator", "taiwan-salary-calculator", "france-salary-calculator", "spain-salary-calculator", "salary-negotiation-calculator", "hours-calculator"]} />
  </div>
</BaseLayout>
