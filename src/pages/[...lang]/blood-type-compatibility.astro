---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "혈액형 궁합",
  en: "Blood type compatibility",
  ja: "血液型相性",
  fr: "compatibilité par groupe sanguin",
  es: "compatibilidad por tipo de sangre",
  zh: "血型配对",
  cn: "血型配對",
};
---

<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/blood-type/compatibility" kind="test" />
