---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PasswordGeneratorComp from "../../components/tools/PasswordGenerator";
import { locales } from "../../lib/i18n";
import { siteConfig } from "../../config/site.config";
import { toolStructuredData } from "../../lib/seo/structured-data";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: { title: "안전한 비밀번호 생성기 — 강력한 비밀번호 즉시 만들기", description: "길이, 대소문자, 숫자, 특수문자 옵션을 설정해 즉시 강력한 비밀번호를 생성하세요. 엔트로피 기반 강도 측정 제공." },
  en: { title: "Secure Password Generator — Create Strong Passwords Instantly", description: "Generate strong passwords instantly with custom length, uppercase, lowercase, numbers, and symbols. Includes entropy-based strength meter." },
  ja: { title: "安全なパスワード生成器 — 強力なパスワードを即時作成", description: "長さ、大文字、小文字、数字、特殊文字のオプションを設定して強力なパスワードを即座に生成。エントロピーベースの強度計測も提供。" },
  fr: { title: "Générateur de Mots de Passe Sécurisés", description: "Générez des mots de passe forts instantanément avec longueur, majuscules, minuscules, chiffres et symboles personnalisés." },
  es: { title: "Generador de Contraseñas Seguras", description: "Genera contraseñas fuertes al instante con longitud, mayúsculas, minúsculas, números y símbolos personalizados." },
  zh: { title: "安全密码生成器 — 即时创建强密码", description: "设置长度、大小写、数字、特殊字符选项即时生成强密码。提供基于熵值的强度计量。" },
};

const m = meta[locale] ?? meta.en;
type SeoContent = { introTitle: string; intro: string; formulaTitle: string; formulas: { title: string; body: string }[]; howToTitle: string; steps: string[]; faqTitle: string; faqs: { question: string; answer: string }[]; disclaimer: string; };

const content: Record<ActiveLocale, SeoContent> = {
  ko: { introTitle: "강한 비밀번호는 길이와 예측 불가능성이 핵심입니다", intro: "안전한 비밀번호는 사람이 떠올리기 쉬운 단어보다 무작위 문자 조합에 가깝고, 서비스마다 달라야 합니다. 이 도구는 길이, 문자 종류, 헷갈리는 문자 제외 여부를 조정해 브라우저에서 난수 기반 비밀번호를 만들고 엔트로피로 강도를 보여줍니다.", formulaTitle: "핵심 개념", formulas: [{ title: "엔트로피", body: "가능한 조합 수가 클수록 추측 공격에 더 오래 버팁니다." }, { title: "문자 풀", body: "대문자, 소문자, 숫자, 기호를 조합하면 후보 공간이 커집니다." }, { title: "고유 사용", body: "같은 비밀번호를 여러 서비스에 재사용하면 한 곳의 유출이 연쇄 위험이 됩니다." }], howToTitle: "사용 방법", steps: ["길이를 정하고 사용할 문자 종류를 선택합니다.", "읽기 편해야 하면 헷갈리는 문자를 제외합니다.", "생성한 비밀번호를 복사해 비밀번호 관리자에 저장합니다."], faqTitle: "자주 묻는 질문", faqs: [{ question: "몇 글자가 적당한가요?", answer: "가능하면 16자 이상을 권장합니다. 더 긴 비밀번호가 보통 더 안전합니다." }, { question: "특수문자는 꼭 필요하나요?", answer: "서비스 정책에 따라 다르지만, 문자 풀을 넓히면 엔트로피가 올라갑니다." }, { question: "생성한 비밀번호를 외워야 하나요?", answer: "고유하고 긴 비밀번호는 비밀번호 관리자에 저장하는 방식이 현실적입니다." }], disclaimer: "비밀번호는 안전한 관리자에 저장하고, 가능하면 2단계 인증을 함께 사용하세요." },
  en: { introTitle: "Strong passwords depend on length and unpredictability", intro: "A secure password should be closer to random characters than to a memorable word, and it should be unique per service. This browser-side generator lets you adjust length, character classes, ambiguous characters, and entropy-based strength.", formulaTitle: "Key concepts", formulas: [{ title: "Entropy", body: "More possible combinations mean more resistance against guessing attacks." }, { title: "Character pool", body: "Uppercase, lowercase, numbers, and symbols increase the search space." }, { title: "Unique use", body: "Reusing one password turns a single breach into a multi-account risk." }], howToTitle: "How to use", steps: ["Set the length and choose the character types.", "Exclude ambiguous characters if readability matters.", "Copy the result into a password manager."], faqTitle: "Frequently asked questions", faqs: [{ question: "How long should it be?", answer: "Use at least 16 characters when possible. Longer is usually better." }, { question: "Do I need symbols?", answer: "It depends on the service, but symbols increase the character pool and entropy." }, { question: "Should I memorize generated passwords?", answer: "For long unique passwords, a password manager is the practical option." }], disclaimer: "Store passwords in a trusted manager and enable multi-factor authentication where possible." },
  ja: { introTitle: "強いパスワードは長さと予測しにくさが重要です", intro: "安全なパスワードは覚えやすい単語ではなく、ランダムな文字列に近く、サービスごとに別であるべきです。このツールは長さ、文字種類、紛らわしい文字の除外を調整し、エントロピーで強度を示します。", formulaTitle: "基本概念", formulas: [{ title: "エントロピー", body: "組み合わせ数が多いほど推測攻撃に強くなります。" }, { title: "文字プール", body: "大文字、小文字、数字、記号を入れると候補数が増えます。" }, { title: "使い回し禁止", body: "同じパスワードの再利用は、1件の漏えいを複数アカウントの危険にします。" }], howToTitle: "使い方", steps: ["長さと文字種類を選びます。", "読みやすさが必要なら紛らわしい文字を除外します。", "生成結果をコピーし、パスワードマネージャーに保存します。"], faqTitle: "よくある質問", faqs: [{ question: "何文字がよいですか？", answer: "可能なら16文字以上を推奨します。一般に長いほど安全です。" }, { question: "記号は必要ですか？", answer: "サービス要件によりますが、記号は文字プールを広げます。" }, { question: "覚えるべきですか？", answer: "長く固有のパスワードはマネージャーで管理するのが現実的です。" }], disclaimer: "信頼できるパスワードマネージャーに保存し、可能なら多要素認証を使ってください。" },
  fr: { introTitle: "Un mot de passe fort dépend de la longueur et de l'imprévisibilité", intro: "Un bon mot de passe ressemble plus à une chaîne aléatoire qu'à un mot mémorisable, et il doit être unique par service. L'outil ajuste longueur, types de caractères, caractères ambigus et force par entropie.", formulaTitle: "Concepts clés", formulas: [{ title: "Entropie", body: "Plus il existe de combinaisons, plus l'attaque par devinette est difficile." }, { title: "Jeu de caractères", body: "Majuscules, minuscules, chiffres et symboles élargissent l'espace de recherche." }, { title: "Usage unique", body: "La réutilisation transforme une fuite en risque pour plusieurs comptes." }], howToTitle: "Comment l'utiliser", steps: ["Réglez la longueur et les types de caractères.", "Excluez les caractères ambigus si la lisibilité compte.", "Copiez le résultat dans un gestionnaire de mots de passe."], faqTitle: "Questions fréquentes", faqs: [{ question: "Quelle longueur choisir ?", answer: "Au moins 16 caractères si possible. Plus long est généralement mieux." }, { question: "Les symboles sont-ils nécessaires ?", answer: "Selon le service, mais ils augmentent le jeu de caractères et l'entropie." }, { question: "Faut-il les mémoriser ?", answer: "Pour des mots de passe longs et uniques, un gestionnaire est la solution pratique." }], disclaimer: "Stockez les mots de passe dans un gestionnaire fiable et activez l'authentification multifacteur si possible." },
  es: { introTitle: "Una contraseña fuerte depende de longitud e imprevisibilidad", intro: "Una contraseña segura se parece más a una cadena aleatoria que a una palabra fácil, y debe ser única por servicio. La herramienta ajusta longitud, tipos de caracteres, caracteres ambiguos y fuerza por entropía.", formulaTitle: "Conceptos clave", formulas: [{ title: "Entropía", body: "Cuantas más combinaciones posibles, más difícil es adivinarla." }, { title: "Conjunto de caracteres", body: "Mayúsculas, minúsculas, números y símbolos aumentan el espacio de búsqueda." }, { title: "Uso único", body: "Reutilizar contraseñas convierte una filtración en riesgo para varias cuentas." }], howToTitle: "Cómo usarlo", steps: ["Define longitud y tipos de caracteres.", "Excluye caracteres ambiguos si necesitas legibilidad.", "Copia el resultado en un gestor de contraseñas."], faqTitle: "Preguntas frecuentes", faqs: [{ question: "¿Qué longitud conviene?", answer: "Al menos 16 caracteres cuando sea posible. Más largo suele ser mejor." }, { question: "¿Necesito símbolos?", answer: "Depende del servicio, pero los símbolos aumentan el conjunto y la entropía." }, { question: "¿Debo memorizarlas?", answer: "Para contraseñas largas y únicas, un gestor es la opción práctica." }], disclaimer: "Guarda las contraseñas en un gestor confiable y activa autenticación multifactor cuando sea posible." },
  zh: { introTitle: "强密码的关键是长度和不可预测性", intro: "安全密码应更接近随机字符串，而不是容易想到的词，并且每个服务都应不同。本工具可设置长度、字符类型、是否排除易混字符，并用熵值显示强度。", formulaTitle: "核心概念", formulas: [{ title: "熵值", body: "可能组合越多，抵抗猜测攻击的能力越强。" }, { title: "字符池", body: "大写、小写、数字和符号会扩大搜索空间。" }, { title: "唯一使用", body: "重复使用密码会让一次泄露变成多个账户风险。" }], howToTitle: "使用方法", steps: ["设置长度并选择字符类型。", "如果需要易读，可排除易混字符。", "生成后复制到密码管理器保存。"], faqTitle: "常见问题", faqs: [{ question: "多少位比较合适？", answer: "条件允许时建议至少 16 位。通常越长越安全。" }, { question: "必须包含符号吗？", answer: "取决于服务规则，但符号能扩大字符池并提高熵值。" }, { question: "需要记住生成的密码吗？", answer: "长且唯一的密码更适合由密码管理器保存。" }], disclaimer: "请把密码保存在可信的密码管理器中，并尽量启用多因素认证。" },
};

const c = content[locale] ?? content.en;
const pageUrl = `${siteConfig.url}/${locale}/password-generator/`;

const structuredData = toolStructuredData({
  name: m.title,
  description: m.description,
  steps: c.steps,
  faqs: c.faqs,
  url: pageUrl,
  webApplication: true,
  breadcrumbs: [
    { name: "Tools", url: `${siteConfig.url}/${locale}/tools/` },
    { name: m.title, url: pageUrl },
  ],
});
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <PasswordGeneratorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <section class="mt-10 border-t border-slate-200 pt-8"><h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2><p class="mt-4 leading-8 text-slate-700">{c.intro}</p></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2><div class="mt-4 grid gap-4 md:grid-cols-3">{c.formulas.map((item) => (<article class="rounded-xl border border-slate-200 bg-white p-4"><h3 class="font-semibold text-slate-900">{item.title}</h3><p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p></article>))}</div></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2><ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">{c.steps.map((s) => (<li class="leading-7">{s}</li>))}</ol></section>
    <section class="mt-10"><h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2><div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">{c.faqs.map((faq) => (<details class="group p-4"><summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary><p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p></details>))}</div></section>
    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
