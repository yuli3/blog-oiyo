---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PasswordGeneratorComp from "../../components/tools/PasswordGenerator";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "안전한 비밀번호 생성기 — 강력한 비밀번호 즉시 만들기",
    description: "길이, 대소문자, 숫자, 특수문자 옵션을 설정해 즉시 강력한 비밀번호를 생성하세요. 엔트로피 기반 강도 측정 제공.",
  },
  en: {
    title: "Secure Password Generator — Create Strong Passwords Instantly",
    description: "Generate strong passwords instantly with custom length, uppercase, lowercase, numbers, and symbols. Includes entropy-based strength meter.",
  },
  ja: {
    title: "安全なパスワード生成器 — 強力なパスワードを即時作成",
    description: "長さ、大文字、小文字、数字、特殊文字のオプションを設定して強力なパスワードを即座に生成。エントロピーベースの強度計測も提供。",
  },
  fr: {
    title: "Générateur de Mots de Passe Sécurisés",
    description: "Générez des mots de passe forts instantanément avec longueur, majuscules, minuscules, chiffres et symboles personnalisés.",
  },
  es: {
    title: "Generador de Contraseñas Seguras",
    description: "Genera contraseñas fuertes al instante con longitud, mayúsculas, minúsculas, números y símbolos personalizados.",
  },
  zh: {
    title: "安全密碼生成器 — 即時創建強密碼",
    description: "設置長度、大小寫、數字、特殊字符選項即時生成強密碼。提供基於熵值的強度計量。",
  },
  cn: {
    title: "安全密码生成器 — 即时创建强密码",
    description: "设置长度、大小写、数字、特殊字符选项即时生成强密码。提供基于熵值的强度计量。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <PasswordGeneratorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
  </main>
</BaseLayout>
