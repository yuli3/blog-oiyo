---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "띠 궁합",
  en: "Chinese zodiac compatibility",
  ja: "干支相性",
  fr: "compatibilité du zodiaque chinois",
  es: "compatibilidad del zodiaco chino",
  zh: "生肖配对",
  cn: "生肖配對",
};
---

<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/chinese-zodiac/compatibility" kind="test" />
