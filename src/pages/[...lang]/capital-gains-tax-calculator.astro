---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import CapitalGainsTaxCalculatorComp from "../../components/tools/CapitalGainsTaxCalculator";
import CapitalGainsTaxCountryCalculator from "../../components/tools/CapitalGainsTaxCountryCalculator";
import type { CapitalGainsCountry } from "../../lib/capital-gains-tax-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, CapitalGainsCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "양도소득세 계산기 — 부동산·주식 양도세 미리 계산하기",
    description: "부동산·국내주식·해외주식 매도 시 예상 양도소득세를 계산합니다. 보유 기간, 주택 수, 조정대상지역 여부를 반영한 정확한 세금 예측.",
  },
  en: {
    title: "Capital Gains Tax Calculator (South Korea) — Real Estate & Stocks",
    description: "Calculate estimated capital gains tax on real estate, domestic stocks, and foreign stocks in Korea. Factors in holding period and property count.",
  },
  ja: {
    title: "不動産の譲渡所得税 計算機（日本）",
    description: "家や土地を売ったときの譲渡所得税と住民税を計算します。長期20.315%・短期39.63%、居住用の3,000万円特別控除、10年超所有の軽減税率14.21%に対応。",
  },
  fr: {
    title: "Calculateur d'impôt sur la plus-value immobilière",
    description: "Calculez l'impôt sur la plus-value d'une vente immobilière en France : 19 % d'impôt sur le revenu et 17,2 % de prélèvements sociaux après abattements pour durée de détention, et surtaxe au-delà de 50 000 €.",
  },
  es: {
    title: "Calculadora del IRPF por la venta de una vivienda",
    description: "Calcula el IRPF de la ganancia patrimonial al vender una vivienda en España con la escala del ahorro 2026 (19 % a 30 %) y la exención por reinversión en vivienda habitual o por ser mayor de 65 años.",
  },
  zh: {
    title: "个人转让住房个人所得税计算器",
    description: "按财产转让所得20%或核定征收1%–3%计算个人卖房的个人所得税，并判断“满五唯一”免征。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "양도소득세 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 양도소득세를 설명과 함께 계산해요. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전해요.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "양도가액에서 취득가액을 뺀 양도차익을 출발점으로 삼습니다."
    }, {
      title: "기준 2",
      body: "부동산과 해외주식은 250만원 기본공제를 반영합니다."
    }, {
      title: "기준 3",
      body: "국내 상장주식 소액주주는 비과세, 해외주식은 국세 20%와 지방세 10%를 구분합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "비과세 여부, 장기보유공제, 필요경비, 대주주 여부가 빠지면 실제 세액이 달라집니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용이에요. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Capital gains tax is country-specific",
    intro: "This page estimates capital gains tax under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Starts from transfer price minus acquisition price."
    }, {
      title: "Rule 2",
      body: "Reflects a KRW 2.5M basic deduction for real estate and foreign stocks."
    }, {
      title: "Rule 3",
      body: "Domestic listed minority holdings are treated as exempt; foreign stocks separate 20% national tax and 10% local tax."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Exemptions, long-term deductions, necessary expenses, or major-shareholder rules can change the result."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "日本で家を売ったときの税金は、譲渡所得にかかる所得税と住民税です",
    intro: "不動産の譲渡所得は給与などと分けて計算する分離課税で、売った翌年の2月16日から3月15日までに確定申告します。税率は売った年の1月1日時点の所有期間で決まり、5年を超えると長期（20.315%）、5年以下は短期（39.63%）です。自分が住んでいた家なら3,000万円の特別控除があり、10年を超えて所有していれば6,000万円以下の部分に軽減税率14.21%が使えます。",
    formulaTitle: "計算基準",
    formulas: [
      {
        title: "譲渡所得",
        body: "譲渡価額 −（取得費＋譲渡費用）− 特別控除。取得費は購入代金と購入時の費用で、建物は減価償却後の額。分からなければ譲渡価額の5%"
      },
      {
        title: "税率",
        body: "長期：所得税15.315%＋住民税5%。短期：所得税30.63%＋住民税9%。10年超の居住用：6,000万円以下は所得税10.21%＋住民税4%"
      },
      {
        title: "居住用の特例",
        body: "住まなくなってから3年目の年末までに売ること、親子・夫婦間の売買でないこと、前年・前々年に同じ特例を使っていないことなどが条件"
      }
    ],
    howToTitle: "使い方",
    steps: [
      "売却価格、取得費、譲渡費用を入力します。",
      "取得した年と売った年を入力し、長期・短期を判定します。",
      "居住用財産の特例を使うかを選び、所得税・住民税の合計を確認します。"
    ],
    faqTitle: "よくある質問",
    faqs: [
      {
        question: "所有期間はどう数えますか？",
        answer: "取得した日から、売った年の1月1日までで数えます。たとえば2020年に買った家を2026年に売ると、2026年1月1日時点で5年を超えるので長期です。2021年に買った家は5年以下なので短期になります。"
      },
      {
        question: "3,000万円控除を使うと税金はゼロですか？",
        answer: "譲渡所得が3,000万円以下ならゼロになりますが、確定申告は必要です。買い換えた新居で住宅ローン控除を受ける場合は、入居した年の前後（前2年・後3年）に3,000万円控除を使っていると住宅ローン控除が受けられないので、どちらが有利か比べて選びます。"
      },
      {
        question: "損が出たときは？",
        answer: "居住用財産を買い換えたり、住宅ローンが残ったまま売ったりした場合は、一定の要件で譲渡損失を給与所得などと損益通算し、翌年以降3年間繰り越せる特例があります。この計算機は損失の計算を行いません。"
      }
    ],
    disclaimer: "このツールは一般的な計算用です。取得費・特例の要件は国税庁のタックスアンサーや税務署、税理士にご確認ください。"
  },
  zh: {
    introTitle: "个人卖房的个人所得税按财产转让所得20%计算",
    intro: "个人转让住房取得的所得属于财产转让所得，以转让收入减除房屋原值和合理费用后的余额为应纳税所得额，适用20%的比例税率。纳税人不能提供房屋原值凭证的，税务机关按转让收入的1%–3%核定征收，具体比例由各省确定。个人转让自用5年以上、并且是家庭唯一生活用房取得的所得，免征个人所得税。",
    formulaTitle: "计算规则",
    formulas: [
      {
        title: "据实征收",
        body: "（转让收入 − 房屋原值 − 合理费用）× 20%。原值含购房价款和购房时缴纳的契税等；合理费用含装修费（有限额）、住房贷款利息、手续费、公证费"
      },
      {
        title: "核定征收",
        body: "原值无法核实时，按转让收入 × 1%–3% 计算，由各省规定具体比例（国税发〔2006〕108号）"
      },
      {
        title: "满五唯一",
        body: "自用满5年且是家庭唯一生活用房，免征个人所得税（财税字〔1999〕278号）"
      }
    ],
    howToTitle: "使用方法",
    steps: [
      "输入转让收入、房屋原值和合理费用。",
      "选择据实征收或核定征收，核定征收时填写本地比例。",
      "确认是否满五唯一，查看应缴个人所得税。"
    ],
    faqTitle: "常见问题",
    faqs: [
      {
        question: "“满五”从什么时候算？",
        answer: "一般以房产证（不动产权证）登记日期或契税完税凭证日期中较早的一个起算，到出售时满5年。“唯一”指家庭（本人、配偶、未成年子女）在该地只有这一套生活用房。"
      },
      {
        question: "卖房还要交哪些税？",
        answer: "个人出售住房满2年免征增值税，不满2年按规定缴纳增值税及附加。个人转让住房暂免土地增值税，印花税也暂免。买方另需缴纳契税。本计算器只计算个人所得税。"
      },
      {
        question: "装修费可以全额扣除吗？",
        answer: "不能。装修费用需有合法凭证，并有限额：已购公有住房、经济适用房最高为原值的15%，商品房及其他住房最高为原值的10%。"
      }
    ],
    disclaimer: "本工具仅供一般估算。核定征收率和扣除凭证要求请向当地税务机关或不动产登记交易中心确认。"
  },
  fr: {
    introTitle: "En France, la plus-value immobilière est taxée à 36,2 % avant abattements",
    intro: "La plus-value réalisée lors de la vente d'un bien immobilier est soumise à l'impôt sur le revenu au taux de 19 % et aux prélèvements sociaux de 17,2 %. Des abattements pour durée de détention réduisent la base à partir de la 6e année : exonération d'impôt sur le revenu après 22 ans et de prélèvements sociaux après 30 ans. La vente de la résidence principale est exonérée. Le notaire calcule et paie l'impôt au moment de la vente.",
    formulaTitle: "Règles de calcul",
    formulas: [
      {
        title: "Plus-value brute",
        body: "Prix de cession − (prix d'acquisition + frais d'acquisition réels ou forfait 7,5 % + travaux réels ou forfait 15 % après 5 ans)"
      },
      {
        title: "Abattements",
        body: "Impôt sur le revenu : 6 % par an de la 6e à la 21e année, 4 % la 22e. Prélèvements sociaux : 1,65 % par an de la 6e à la 21e, 1,60 % la 22e, 9 % par an de la 23e à la 30e"
      },
      {
        title: "Surtaxe",
        body: "Plus-value nette imposable à l'IR supérieure à 50 000 € : 2 % à 6 % selon le montant, avec un lissage entre les tranches (hors terrains à bâtir)"
      }
    ],
    howToTitle: "Mode d'emploi",
    steps: [
      "Saisissez le prix de vente, le prix d'achat et la durée de détention.",
      "Choisissez les forfaits ou les montants réels pour les frais et les travaux.",
      "Indiquez s'il s'agit de votre résidence principale et lisez l'impôt total."
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      {
        question: "Comment compter les années de détention ?",
        answer: "On compte les années pleines entre la date d'acquisition (acte notarié) et la date de cession. Un bien acheté le 1er mars 2014 et vendu le 15 février 2026 est détenu depuis 11 années pleines."
      },
      {
        question: "Quand la résidence principale est-elle exonérée ?",
        answer: "Le bien doit être votre résidence principale au jour de la vente. Si vous l'avez quitté, la vente doit intervenir dans un délai normal (en général un an) et le logement ne doit pas avoir été loué ou occupé entre-temps."
      },
      {
        question: "Le forfait travaux de 15 % est-il automatique ?",
        answer: "Il s'applique sans justificatif si vous détenez le bien depuis plus de 5 ans. Sinon, seuls les travaux réels justifiés par des factures d'entreprises (construction, agrandissement, amélioration) sont retenus."
      }
    ],
    disclaimer: "Cet outil sert au calcul général. Le calcul définitif est établi par le notaire sur la déclaration 2048-IMM ; vérifiez les règles sur impots.gouv.fr ou auprès de votre notaire."
  },
  es: {
    introTitle: "En España, la ganancia por vender una vivienda tributa en la base del ahorro del IRPF",
    intro: "La diferencia entre el valor de transmisión y el valor de adquisición es una ganancia patrimonial que se declara en la renta del año siguiente y tributa con la escala del ahorro: 19 % hasta 6.000 €, 21 % hasta 50.000 €, 23 % hasta 200.000 €, 27 % hasta 300.000 € y 30 % por encima. Si vendes tu vivienda habitual y reinviertes el importe en otra en dos años, la ganancia queda exenta en proporción a lo reinvertido; los mayores de 65 años están exentos. La plusvalía municipal es un impuesto local distinto.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      {
        title: "Ganancia patrimonial",
        body: "(Precio de venta − gastos de venta) − (precio de compra + gastos y tributos de compra + mejoras). La plusvalía municipal pagada cuenta como gasto de venta"
      },
      {
        title: "Escala del ahorro 2026",
        body: "19 % hasta 6.000 €, 21 % hasta 50.000 €, 23 % hasta 200.000 €, 27 % hasta 300.000 € y 30 % desde 300.000 €"
      },
      {
        title: "Exenciones",
        body: "Reinversión en vivienda habitual en dos años (proporcional al importe reinvertido) y venta de la vivienda habitual por mayores de 65 años"
      }
    ],
    howToTitle: "Cómo se usa",
    steps: [
      "Introduce el precio y los gastos de venta y de compra.",
      "Indica si es tu vivienda habitual, tu edad y el importe reinvertido.",
      "Consulta la ganancia exenta y el IRPF a pagar en la base del ahorro."
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      {
        question: "¿Qué es la plusvalía municipal?",
        answer: "Es el Impuesto sobre el Incremento de Valor de los Terrenos de Naturaleza Urbana (IIVTNU), que cobra el ayuntamiento al vendedor. Se calcula por el método objetivo o el real, a elegir el más bajo, y no existe si no hubo ganancia. No está incluido en este cálculo."
      },
      {
        question: "¿Cuándo es vivienda habitual?",
        answer: "Cuando has vivido en ella de forma continuada al menos tres años, o se vende antes por circunstancias como separación, traslado laboral o un primer empleo. Debe serlo al venderla o haberlo sido hasta cualquier día de los dos años anteriores."
      },
      {
        question: "¿Se aplican coeficientes por antigüedad?",
        answer: "Los coeficientes de actualización desaparecieron en 2015. Solo quedan los coeficientes de abatimiento para inmuebles comprados antes de 1995, con un límite de 400.000 € de valor de transmisión, que este cálculo no aplica."
      }
    ],
    disclaimer: "Esta herramienta es para cálculo general. Confirma el resultado con el programa Renta WEB de la Agencia Tributaria o con tu asesor fiscal."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {country ? <CapitalGainsTaxCountryCalculator client:load country={country} /> : <CapitalGainsTaxCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="capital-gains-tax-calculator" slugs={["salary-calculator", "annual-leave-calculator", "auto-tax-calculator", "acquisition-tax-calculator", "capital-gains-tax-calculator"]} />
  </div>
</BaseLayout>
