---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InterviewQuestionGenerator from "../../components/tools/InterviewQuestionGenerator";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "면접 질문 생성기 — 직무별 예상 질문 무료 연습",
    description: "IT·마케팅·영업·인사·재무 등 10개 직무별 면접 예상 질문을 난이도별로 생성하세요. 취업 면접 준비 무료 도구.",
  },
  en: {
    title: "Interview Question Generator — Free Practice by Job Role",
    description: "Generate mock interview questions by job role (IT, Marketing, Sales, HR, Finance, etc.) and difficulty. Free job interview prep tool.",
  },
  ja: {
    title: "面接質問ジェネレーター — 職種別予想質問を無料練習",
    description: "IT・マーケティング・営業・人事・財務など10職種の面接予想質問を難易度別に生成。就職面接対策無料ツール。",
  },
  fr: {
    title: "Générateur de Questions d'Entretien — Pratique Gratuite par Poste",
    description: "Générez des questions d'entretien simulées par poste (IT, Marketing, Ventes, RH, Finance, etc.) et par niveau de difficulté. Outil gratuit de préparation aux entretiens.",
  },
  es: {
    title: "Generador de Preguntas de Entrevista — Práctica Gratuita por Rol",
    description: "Genera preguntas de entrevista simuladas por rol (TI, Marketing, Ventas, RRHH, Finanzas, etc.) y dificultad. Herramienta gratuita de preparación para entrevistas.",
  },
  zh: {
    title: "面试问题生成器 — 按职位免费练习",
    description: "按职位（IT、市场营销、销售、人力资源、财务等）和难度生成模拟面试问题。免费面试备考工具。",
  },
};

const m = meta[locale] ?? meta.en;

type PageContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

const content: Record<ActiveLocale, PageContent> = {
  ko: {
    introTitle: "면접 연습은 질문을 많이 보는 것보다 답변 구조를 반복하는 일이 중요합니다",
    intro: "실제 면접에서는 직무 지식, 경험 설명, 우선순위 판단, 협업 태도를 짧은 시간 안에 말해야 합니다. 이 생성기는 개발, 디자인, 마케팅, 영업, 재무, 인사 등 직무와 난이도를 기준으로 예상 질문과 답변 힌트를 제공해 답변 연습의 출발점을 만들어줍니다.",
    formulaTitle: "면접 준비 개념",
    formulas: [
      { title: "직무 맥락", body: "같은 질문도 직무에 따라 평가 포인트가 달라집니다. 먼저 지원 역할의 핵심 역량을 떠올려야 합니다." },
      { title: "난이도", body: "쉬운 질문은 기본 태도, 중간 질문은 경험 설명, 어려운 질문은 판단력과 깊이를 확인하는 데 가깝습니다." },
      { title: "답변 힌트", body: "힌트는 완성 답안이 아니라 구조를 잡는 단서입니다. 본인의 실제 사례로 바꿔 말해야 합니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "지원 직무와 연습할 난이도를 선택합니다.",
      "생성된 질문을 보고 1-2분 안에 말할 답변 구조를 먼저 잡습니다.",
      "힌트를 참고해 실제 경험, 수치, 배운 점을 넣어 답변을 다시 다듬습니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "실제 면접 질문과 같나요?", answer: "보장할 수 없습니다. 직무별로 자주 나오는 유형을 연습하도록 돕는 모의 질문입니다." },
      { question: "답변을 그대로 외워도 되나요?", answer: "권하지 않습니다. 힌트를 구조로 활용하되, 본인의 프로젝트, 성과, 실패 경험을 바탕으로 말해야 자연스럽습니다." },
      { question: "어떤 방식으로 답하면 좋나요?", answer: "상황, 행동, 결과, 배운 점을 짧게 묶는 방식이 좋습니다. 가능하면 수치와 역할 범위를 명확히 하세요." },
    ],
    disclaimer: "이 도구는 면접 연습 보조용이며 채용 결과, 평가 기준, 회사별 질문을 보장하지 않습니다.",
  },
  en: {
    introTitle: "Interview practice is about rehearsing answer structure, not memorizing prompts",
    intro: "Real interviews ask you to explain role knowledge, experience, judgment, and collaboration under time pressure. This generator offers mock questions and preparation tips by role and difficulty, giving you a starting point for structured practice.",
    formulaTitle: "Interview prep concepts",
    formulas: [
      { title: "Role context", body: "The same question can evaluate different skills depending on the job family." },
      { title: "Difficulty", body: "Easy prompts check basics, medium prompts test experience, and hard prompts probe judgment or depth." },
      { title: "Answer tip", body: "A tip is not a script. Use it to shape your response around your own evidence and examples." },
    ],
    howToTitle: "How to use",
    steps: [
      "Select the job role and difficulty level you want to practice.",
      "Read the generated question and outline a 1-2 minute answer before checking the tip.",
      "Revise the answer with concrete experience, metrics, tradeoffs, and lessons learned.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Are these actual interview questions?", answer: "They are mock practice questions based on common job-role patterns, not guaranteed company-specific questions." },
      { question: "Should I memorize the suggested angle?", answer: "No. Use the tip as structure, then answer with your own projects, outcomes, failures, and learning." },
      { question: "What answer format works well?", answer: "A concise situation, action, result, and lesson structure is usually effective, especially when supported by numbers and scope." },
    ],
    disclaimer: "This tool supports interview practice and does not guarantee hiring outcomes, evaluation criteria, or company-specific questions.",
  },
  ja: {
    introTitle: "面接練習では質問暗記より答え方の構造化が重要です",
    intro: "実際の面接では、職種知識、経験、判断、協働姿勢を短時間で説明する必要があります。このジェネレーターは職種と難易度に応じた模擬質問とヒントを出し、構造的に答える練習の出発点を作ります。",
    formulaTitle: "面接準備の考え方",
    formulas: [
      { title: "職種文脈", body: "同じ質問でも、職種によって評価されるスキルや視点が変わります。" },
      { title: "難易度", body: "易しい質問は基本、中程度は経験説明、難しい質問は判断力や深さを見ます。" },
      { title: "回答ヒント", body: "ヒントは台本ではありません。自分の実例を入れて答えを作るための手がかりです。" },
    ],
    howToTitle: "使い方",
    steps: [
      "練習したい職種と難易度を選びます。",
      "質問を読み、ヒントを見る前に1〜2分の回答構成を考えます。",
      "実際の経験、数値、判断理由、学びを入れて答えを整えます。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "実際の面接質問と同じですか？", answer: "保証はできません。職種別によくある型を練習するための模擬質問です。" },
      { question: "ヒントをそのまま暗記すべきですか？", answer: "おすすめしません。構造の参考にし、自分のプロジェクト、成果、失敗、学びで話してください。" },
      { question: "どんな答え方がよいですか？", answer: "状況、行動、結果、学びを短くまとめ、可能なら数値や担当範囲を明確にすると伝わりやすくなります。" },
    ],
    disclaimer: "このツールは面接練習の補助であり、採用結果、評価基準、企業別質問を保証するものではありません。",
  },
  zh: {
    introTitle: "面试练习重点在回答结构，而不是背题",
    intro: "真实面试要求你在有限时间内说明岗位知识、经历、判断和协作方式。这个生成器按职位和难度提供模拟问题与准备提示，帮助你开始结构化练习。",
    formulaTitle: "面试准备概念",
    formulas: [
      { title: "岗位语境", body: "同一个问题在不同岗位中可能考察不同能力点。" },
      { title: "难度", body: "简单题检查基础，中等题考察经验表达，困难题更偏向判断深度。" },
      { title: "回答提示", body: "提示不是标准答案，而是帮助你用真实经历组织回答的线索。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "选择要练习的职位和难度。",
      "阅读生成的问题，先构思 1-2 分钟的回答结构。",
      "参考提示加入具体经历、数据、取舍和复盘收获。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "这些是真实面试题吗？", answer: "不是保证命中的公司题库，而是基于岗位常见类型的模拟练习问题。" },
      { question: "可以直接背提示吗？", answer: "不建议。提示适合当结构参考，回答应来自你的项目、成果、失败经历和学习。" },
      { question: "怎样回答更有效？", answer: "用简短的情境、行动、结果、经验结构，并尽量说明数字和职责范围。" },
    ],
    disclaimer: "本工具用于面试练习辅助，不保证录用结果、评估标准或公司特定题目。",
  },
  fr: {
    introTitle: "S'entraîner à l'entretien consiste à structurer ses réponses, pas à mémoriser des questions",
    intro: "Un entretien demande d'expliquer rapidement connaissances métier, expériences, jugement et collaboration. Ce générateur propose des questions simulées et conseils par poste et difficulté pour créer un point de départ d'entraînement.",
    formulaTitle: "Notions de préparation",
    formulas: [
      { title: "Contexte du poste", body: "La même question peut évaluer des compétences différentes selon la famille de métiers." },
      { title: "Difficulté", body: "Les questions faciles vérifient les bases, les moyennes l'expérience, les difficiles le jugement ou la profondeur." },
      { title: "Conseil de réponse", body: "Le conseil n'est pas un script : utilisez-le pour organiser vos propres preuves et exemples." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Sélectionnez le poste et le niveau de difficulté à travailler.",
      "Lisez la question et préparez une réponse de 1 à 2 minutes avant le conseil.",
      "Révisez avec expériences concrètes, chiffres, arbitrages et apprentissages.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "S'agit-il de vraies questions d'entretien ?", answer: "Ce sont des questions de simulation basées sur des schémas fréquents, pas des questions garanties d'une entreprise." },
      { question: "Dois-je mémoriser le conseil ?", answer: "Non. Utilisez-le comme structure, puis répondez avec vos projets, résultats, échecs et apprentissages." },
      { question: "Quel format de réponse fonctionne bien ?", answer: "Situation, action, résultat et leçon, en version concise, fonctionnent souvent mieux avec chiffres et périmètre clair." },
    ],
    disclaimer: "Cet outil aide à s'entraîner et ne garantit ni embauche, ni critères d'évaluation, ni questions propres à une entreprise.",
  },
  es: {
    introTitle: "Practicar entrevistas consiste en estructurar respuestas, no memorizar preguntas",
    intro: "En una entrevista real debes explicar conocimiento del rol, experiencia, criterio y colaboración bajo presión de tiempo. Este generador ofrece preguntas simuladas y consejos por rol y dificultad para iniciar una práctica estructurada.",
    formulaTitle: "Conceptos de preparación",
    formulas: [
      { title: "Contexto del rol", body: "La misma pregunta puede evaluar habilidades distintas según la familia profesional." },
      { title: "Dificultad", body: "Las preguntas fáciles revisan bases, las medias experiencia y las difíciles juicio o profundidad." },
      { title: "Consejo de respuesta", body: "El consejo no es un guion; úsalo para ordenar tus propias evidencias y ejemplos." },
    ],
    howToTitle: "Cómo usarlo",
    steps: [
      "Selecciona el rol y nivel de dificultad que quieres practicar.",
      "Lee la pregunta y bosqueja una respuesta de 1 a 2 minutos antes de mirar el consejo.",
      "Ajusta la respuesta con experiencia concreta, métricas, decisiones y aprendizajes.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Son preguntas reales de entrevista?", answer: "Son preguntas simuladas basadas en patrones comunes por rol, no preguntas garantizadas de una empresa concreta." },
      { question: "¿Debo memorizar el consejo?", answer: "No. Úsalo como estructura y responde con tus proyectos, resultados, errores y aprendizajes." },
      { question: "¿Qué formato de respuesta funciona bien?", answer: "Una estructura breve de situación, acción, resultado y aprendizaje suele funcionar, sobre todo con números y alcance claro." },
    ],
    disclaimer: "Esta herramienta apoya la práctica de entrevistas y no garantiza contratación, criterios de evaluación ni preguntas específicas de empresas.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <InterviewQuestionGenerator client:load locale={locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </main>
</BaseLayout>
