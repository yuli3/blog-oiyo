---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InterviewQuestionGenerator from "../../components/tools/InterviewQuestionGenerator";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "면접 질문 생성기 — 직무별 예상 질문 무료 연습",
    description: "IT·마케팅·영업·인사·재무 등 10개 직무별 면접 예상 질문을 난이도별로 생성하세요. 취업 면접 준비 무료 도구.",
  },
  en: {
    title: "Interview Question Generator — Free Practice by Job Role",
    description: "Generate mock interview questions by job role (IT, Marketing, Sales, HR, Finance, etc.) and difficulty. Free job interview prep tool.",
  },
  ja: {
    title: "面接質問ジェネレーター — 職種別予想質問を無料練習",
    description: "IT・マーケティング・営業・人事・財務など10職種の面接予想質問を難易度別に生成。就職面接対策無料ツール。",
  },
  fr: {
    title: "Générateur de Questions d'Entretien — Pratique Gratuite par Poste",
    description: "Générez des questions d'entretien simulées par poste (IT, Marketing, Ventes, RH, Finance, etc.) et par niveau de difficulté. Outil gratuit de préparation aux entretiens.",
  },
  es: {
    title: "Generador de Preguntas de Entrevista — Práctica Gratuita por Rol",
    description: "Genera preguntas de entrevista simuladas por rol (TI, Marketing, Ventas, RRHH, Finanzas, etc.) y dificultad. Herramienta gratuita de preparación para entrevistas.",
  },
  zh: {
    title: "面试问题生成器 — 按职位免费练习",
    description: "按职位（IT、市场营销、销售、人力资源、财务等）和难度生成模拟面试问题。免费面试备考工具。",
  },
  cn: {
    title: "面試問題生成器 — 按職位免費練習",
    description: "按職位（IT、市場營銷、銷售、人力資源、財務等）和難度生成模擬面試問題。免費面試備考工具。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <InterviewQuestionGenerator client:load locale={locale} />
  </main>
</BaseLayout>
