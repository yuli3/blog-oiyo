  },
  "en": {
    "title": "Life Planning Calculator — Wedding, Education and Jeonse",
    "description": "Calculate wedding net start, future education funding needs, and jeonse deposit exposure ratio in one planning tool."
  },
  "ja": {
    "title": "ライフプランニング計算機 — 結婚・教育・チョンセ",
