---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MeetingStyleTestComp from "../../components/tests/MeetingStyleTest";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "회의 스타일 테스트: 나는 어떤 회의 유형?", description: "10개의 질문으로 아이디어 속도, 발언 타이밍, 피드백 스타일을 분석해 나의 회의 생존 스타일을 알아보세요. 6가지 유형 진단." },
  en: { title: "Meeting Style Test: What's Your Meeting Personality?", description: "Analyze your idea speed, speaking timing, and feedback style with 10 questions. Discover which of 6 meeting personality types you are." },
  ja: { title: "会議スタイルテスト：あなたの会議タイプは？", description: "10の質問でアイデア速度、発言タイミング、フィードバックスタイルを分析して会議生存スタイルを診断。6タイプ。" },
  fr: { title: "Test Style de Réunion : Quel est votre style de réunion?", description: "Analysez votre vitesse d'idée, votre timing de parole et votre style de feedback avec 10 questions. 6 types de personnalité de réunion." },
  es: { title: "Test de Estilo de Reunión: ¿Cuál es tu estilo en las reuniones?", description: "Analiza tu velocidad de ideas, tiempo de habla y estilo de retroalimentación con 10 preguntas. 6 tipos de personalidad de reunión." },
  zh: { title: "会议风格测试：你是哪种会议类型？", description: "通过10个问题分析你的想法速度、发言时机和反馈风格，找出你的会议生存风格。6种类型诊断。" },
  cn: { title: "会议风格测试：你是哪种会议类型？", description: "通过10个问题分析你的想法速度、发言时机和反馈风格，找出你的会议生存风格。6种类型诊断。" },
};

const m = meta[locale] ?? meta.en;
---
<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <MeetingStyleTestComp client:load locale={locale} />
  </main>
</BaseLayout>
