---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TaxSavingsRoadmap from "../../components/tools/TaxSavingsRoadmap";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "절세 로드맵 — 나에게 맞는 세금 절약 전략",
    description: "직업·소득·가족·주택 정보를 입력하면 IRP, ISA, 연금저축, 의료비 공제 등 나에게 맞는 절세 전략을 우선순위별로 안내합니다.",
  },
  en: {
    title: "Tax Savings Roadmap — Personalized Tax Strategies",
    description: "Enter your income, employment, family, and housing details to get a prioritized roadmap of Korean tax-saving strategies including IRP, ISA, pension savings, and deductions.",
  },
  ja: {
    title: "節税ロードマップ — 自分に合った節税戦略",
    description: "職業・所得・家族・住宅情報を入力して、IRP・ISA・年金貯蓄・医療費控除などの優先順位付き節税戦略をご案内します。",
  },
  fr: {
    title: "Feuille de Route Fiscale — Stratégies Fiscales Personnalisées",
    description: "Entrez vos revenus, type d'emploi, situation familiale et immobilière pour obtenir une feuille de route priorisée des stratégies fiscales coréennes : IRP, ISA, retraite, déductions.",
  },
  es: {
    title: "Hoja de Ruta Fiscal — Estrategias Fiscales Personalizadas",
    description: "Introduce ingresos, empleo, familia y vivienda para obtener una hoja de ruta priorizada de estrategias de ahorro fiscal coreanas: IRP, ISA, pensión y deducciones.",
  },
  zh: {
    title: "节税路线图 — 个性化节税策略",
    description: "输入您的收入、职业、家庭和住宅资讯，获得IRP、ISA、年金储蓄、医疗费用扣除等按优先顺序排列的节税策略路线图。",
  },
};

const m = meta[locale] ?? meta.en;

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "절세는 상품 추천보다 적용 가능한 공제를 우선순위화하는 일입니다",
    intro: "IRP, ISA, 연금저축, 월세 세액공제, 의료비와 카드 공제는 모두 조건이 다릅니다. 이 로드맵은 소득, 직업, 가족, 주거 상태와 보유 계좌를 입력해 적용 가능성이 높은 전략을 우선순위와 예상 절세 범위로 정리합니다.",
    formulaTitle: "판단 기준",
    formulas: [
      { title: "적용 조건", body: "직장인, 프리랜서, 사업자 여부와 소득, 주택 보유, 부양가족을 기준으로 전략을 걸러냅니다." },
      { title: "우선순위", body: "세액공제 효과가 크고 실행 가능성이 높은 항목을 필수, 권장, 추가로 나눕니다." },
      { title: "예상 절세액", body: "전략별 절세 범위를 합산해 대략적인 연간 효과를 보여 줍니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "연간 소득, 직업 유형, 혼인 여부, 부양가족 수를 입력합니다.",
      "주택 상태와 ISA, 연금저축, IRP 보유 여부를 선택합니다.",
      "표시된 전략을 연말정산, 종합소득세, 금융상품 한도와 대조해 실행 순서를 정합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "이 로드맵이 세무 상담을 대체하나요?", answer: "아닙니다. 적용 가능성이 높은 공제와 계좌를 정리하는 참고 도구입니다. 실제 세액은 소득 구성, 원천징수, 기존 공제, 가족 요건에 따라 달라집니다." },
      { question: "IRP와 연금저축은 무조건 가입해야 하나요?", answer: "세액공제 효과가 커도 중도 인출 제한, 투자 위험, 장기 자금계획을 함께 봐야 합니다. 단기 생활비가 부족하면 무리한 납입은 피해야 합니다." },
      { question: "세법 기준은 매년 바뀌나요?", answer: "예. 공제 한도, 소득 기준, 적용률은 개정될 수 있습니다. 연말정산 시즌에는 국세청 안내와 최신 세법을 확인해야 합니다." },
    ],
    disclaimer: "이 도구는 일반적인 추정용입니다. 실제 절세액, 신고 요건, 금융상품 선택은 관련 기관이나 전문가에게 확인하세요.",
  },
  en: {
    introTitle: "Tax saving starts by prioritizing eligible deductions, not by chasing products",
    intro: "IRP, ISA, pension savings, rent credits, medical expenses, card deductions, and business expenses all have different eligibility rules. This roadmap uses income, employment type, family, housing status, and existing accounts to surface likely Korean tax-saving strategies by priority and estimated savings range.",
    formulaTitle: "Decision basis",
    formulas: [
      { title: "Eligibility filters", body: "Employment type, income, home status, dependents, and existing accounts decide which strategies appear." },
      { title: "Priority", body: "High-impact and broadly actionable items are separated into essential, recommended, and optional groups." },
      { title: "Savings range", body: "Each strategy carries a rough annual savings range, aggregated for a high-level estimate." },
    ],
    howToTitle: "How to use",
    steps: [
      "Enter annual income, employment type, marital status, and dependents.",
      "Select housing status and whether you already have ISA, pension savings, or IRP accounts.",
      "Compare the roadmap with year-end settlement, comprehensive income tax, and product limits before acting.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Does this replace tax advice?", answer: "No. It is a triage tool for likely deductions and accounts. Actual tax depends on income mix, withholding, existing credits, family eligibility, and documentation." },
      { question: "Should everyone open IRP or pension savings?", answer: "Not necessarily. Tax credits can be attractive, but withdrawal restrictions, investment risk, and long-term cash planning matter." },
      { question: "Do Korean tax rules change every year?", answer: "They can. Limits, income thresholds, and credit rates may be revised, so check NTS guidance and current law during filing season." },
    ],
    disclaimer: "This tool is a general estimate. Confirm actual tax savings, filing requirements, and financial product choices with the relevant institution or professional.",
  },
  ja: {
    introTitle: "節税は商品選びより、適用できる控除の優先順位づけです",
    intro: "IRP、ISA、年金貯蓄、家賃税額控除、医療費、カード控除はそれぞれ条件が異なります。このロードマップは所得、職業、家族、住居、保有口座をもとに、適用可能性の高い韓国の節税策を優先順位と概算効果で整理します。",
    formulaTitle: "判断の基準",
    formulas: [
      { title: "適用条件", body: "雇用形態、所得、住宅保有、扶養家族、既存口座で候補を絞ります。" },
      { title: "優先順位", body: "効果が大きく実行しやすい項目を必須、推奨、追加に分けます。" },
      { title: "節税予想", body: "各戦略の概算節税範囲を合計して年間効果を示します。" },
    ],
    howToTitle: "使い方",
    steps: [
      "年間所得、職業タイプ、婚姻状況、扶養家族数を入力します。",
      "住宅状況とISA、年金貯蓄、IRPの保有有無を選びます。",
      "表示された戦略を年末調整、総合所得税、商品限度と照合します。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "税務相談の代わりになりますか？", answer: "いいえ。適用可能性のある控除と口座を整理する参考ツールです。実際の税額は所得構成、源泉徴収、既存控除、家族要件で変わります。" },
      { question: "IRPや年金貯蓄は必ず加入すべきですか？", answer: "必ずではありません。税額控除は魅力的でも、中途引き出し制限、投資リスク、長期資金計画を確認する必要があります。" },
      { question: "税制は毎年変わりますか？", answer: "変わる可能性があります。限度、所得基準、控除率は改正されるため、申告時期に最新情報を確認してください。" },
    ],
    disclaimer: "このツールは一般的な概算です。実際の節税額、申告要件、金融商品選択は関係機関または専門家に確認してください。",
  },
  zh: {
    introTitle: "节税的重点是排序可适用扣除，而不是盲目选择产品",
    intro: "IRP、ISA、年金储蓄、月租税额抵免、医疗费和卡片扣除都有不同条件。本路线图根据收入、职业、家庭、住房状态和已持有账户，整理可能适用的韩国节税策略、优先级和预估节税范围。",
    formulaTitle: "判断依据",
    formulas: [
      { title: "适用条件", body: "按职业类型、收入、住房、扶养家属和已有账户筛选策略。" },
      { title: "优先级", body: "把效果较大且较容易执行的项目分为必做、建议和可选。" },
      { title: "预计节税", body: "汇总各策略的年度节税范围，给出粗略效果。" },
    ],
    howToTitle: "使用方法",
    steps: [
      "输入年收入、职业类型、婚姻状况和扶养人数。",
      "选择住房状态，以及是否已有ISA、年金储蓄或IRP账户。",
      "将显示的策略与年终结算、综合所得税和金融商品限额核对后执行。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "这个路线图能替代税务咨询吗？", answer: "不能。它只是整理可能适用的扣除和账户。实际税额取决于收入结构、预扣税、已有抵免、家庭条件和证明文件。" },
      { question: "IRP和年金储蓄一定要开吗？", answer: "不一定。税额抵免有吸引力，但也要考虑中途提取限制、投资风险和长期现金规划。" },
      { question: "韩国税法每年都会变吗？", answer: "可能会。扣除限额、收入标准和适用率都可能调整，申报季应查看国税厅和最新法规。" },
    ],
    disclaimer: "本工具仅作一般估算。实际节税额、申报要求和金融商品选择请向相关机构或专业人士确认。",
  },
  fr: {
    introTitle: "L'économie d'impôt commence par prioriser les déductions éligibles",
    intro: "IRP, ISA, épargne retraite, crédit de loyer, frais médicaux, cartes et dépenses professionnelles ont chacun leurs conditions. Cette feuille de route utilise revenu, emploi, famille, logement et comptes existants pour classer les stratégies fiscales coréennes probables.",
    formulaTitle: "Bases de décision",
    formulas: [
      { title: "Filtres d'éligibilité", body: "Emploi, revenu, logement, personnes à charge et comptes existants déterminent les stratégies affichées." },
      { title: "Priorité", body: "Les actions à fort impact et faciles à exécuter sont classées en essentiel, recommandé ou optionnel." },
      { title: "Fourchette d'économie", body: "Chaque stratégie porte une estimation annuelle, agrégée pour une vue d'ensemble." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Saisissez revenu annuel, emploi, situation familiale et personnes à charge.",
      "Sélectionnez logement et comptes ISA, pension ou IRP déjà détenus.",
      "Comparez la feuille de route aux règles de déclaration, plafonds et produits avant d'agir.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Cela remplace-t-il un conseil fiscal ?", answer: "Non. C'est un outil de tri. L'impôt réel dépend revenus, retenues, crédits existants, famille et justificatifs." },
      { question: "Faut-il toujours ouvrir IRP ou pension ?", answer: "Pas forcément. Les crédits sont utiles, mais restrictions de retrait, risque d'investissement et trésorerie long terme comptent." },
      { question: "Les règles changent-elles chaque année ?", answer: "Oui, elles peuvent changer. Plafonds, seuils et taux doivent être vérifiés avec les guides officiels au moment de déclarer." },
    ],
    disclaimer: "Cet outil fournit une estimation générale. Confirmez économies, obligations déclaratives et produits financiers avec l'institution compétente ou un professionnel.",
  },
  es: {
    introTitle: "Ahorrar impuestos empieza por priorizar deducciones aplicables",
    intro: "IRP, ISA, ahorro pensión, crédito por alquiler, gastos médicos, tarjetas y gastos de negocio tienen reglas distintas. Esta hoja de ruta usa ingresos, empleo, familia, vivienda y cuentas existentes para ordenar estrategias fiscales coreanas probables.",
    formulaTitle: "Bases de decisión",
    formulas: [
      { title: "Filtros de elegibilidad", body: "Empleo, ingresos, vivienda, dependientes y cuentas existentes determinan qué estrategias aparecen." },
      { title: "Prioridad", body: "Las acciones de alto impacto y fáciles de ejecutar se clasifican como esenciales, recomendadas u opcionales." },
      { title: "Rango de ahorro", body: "Cada estrategia tiene una estimación anual, agregada para una vista general." },
    ],
    howToTitle: "Cómo usarla",
    steps: [
      "Introduce ingresos anuales, empleo, estado civil y dependientes.",
      "Selecciona vivienda y si tienes ISA, pensión o IRP.",
      "Compara la hoja de ruta con reglas de declaración, límites y productos antes de actuar.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Sustituye el asesoramiento fiscal?", answer: "No. Es una herramienta de orientación. El impuesto real depende de ingresos, retenciones, créditos existentes, familia y documentación." },
      { question: "¿Siempre conviene abrir IRP o pensión?", answer: "No necesariamente. Los créditos pueden ayudar, pero importan restricciones de retiro, riesgo de inversión y liquidez a largo plazo." },
      { question: "¿Cambian las reglas cada año?", answer: "Pueden cambiar. Límites, umbrales y tasas deben verificarse con guías oficiales al declarar." },
    ],
    disclaimer: "Esta herramienta ofrece una estimación general. Confirma ahorro fiscal, obligaciones y productos financieros con la institución correspondiente o un profesional.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-8">
    <TaxSavingsRoadmap client:load locale={locale} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
  </div>
</BaseLayout>
