---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import ToolsCompanionBanner from "../../components/ToolsCompanionBanner.astro";
import SeveranceCalculatorComp from "../../components/tools/SeveranceCalculator";
import SeveranceCountryCalculator from "../../components/tools/SeveranceCountryCalculator";
import type { SeveranceCountry } from "../../lib/severance-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, SeveranceCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "퇴직금 계산기 — 예상 퇴직금 미리 계산하기",
    description: "입사일, 퇴직일, 평균 임금을 입력해 예상 퇴직금을 계산합니다. 근로기준법 기준의 정확한 퇴직금 산출.",
  },
  en: {
    title: "South Korea Severance Pay Calculator",
    description: "Estimate statutory severance pay in South Korea: 30 days of average wage per year of service, for one year or more of continuous work.",
  },
  ja: {
    title: "退職金・解雇予告手当 計算機（日本）",
    description: "日本の退職金は会社の規程しだい。退職所得控除と税金を引いた手取り、労基法20条の解雇予告手当を計算します。",
  },
  fr: {
    title: "Calculateur d'indemnité légale de licenciement",
    description: "Calculez l'indemnité légale de licenciement en France : 1/4 de mois par année jusqu'à 10 ans, 1/3 au-delà, dès 8 mois d'ancienneté.",
  },
  es: {
    title: "Calculadora de indemnización por despido",
    description: "Calcula la indemnización en España: despido improcedente 33 días por año (tope 24 mensualidades), objetivo 20 días (tope 12) y fin de contrato temporal.",
  },
  zh: {
    title: "经济补偿金计算器（N、N+1、2N）",
    description: "按《劳动合同法》第47条计算离职经济补偿：每满一年一个月工资，含3倍社平工资封顶、代通知金和违法解除赔偿金。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "퇴직금은 평균임금과 계속근로기간을 기준으로 추정합니다",
    intro: "이 계산기는 입사일, 퇴직일, 월 평균 급여, 연간 상여금을 입력해 예상 퇴직금을 계산해요. 한국 퇴직금 산식의 기본 구조를 이해하는 데 도움을 주지만, 실제 평균임금 산정에는 수당, 상여, 미사용 연차, 퇴직소득세 등 세부 항목이 반영될 수 있어요.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "평균임금(1일)", body: "평균임금 = (최근 3개월 임금 + 연상여×3/12) ÷ 3개월 총일수" },
      { title: "계속근로일수", body: "근로일수 = 퇴직일 - 입사일" },
      { title: "퇴직금", body: "퇴직금 = 평균임금 × 30 × 근로일수 / 365 (1년 이상)" },
    ],
    howToTitle: "사용 방법",
    steps: ["입사일과 퇴직 예정일을 입력합니다.", "월 평균 급여와 연간 상여금을 입력합니다.", "예상 퇴직금, 평균일임금, 재직일수를 확인합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "한국 퇴직금 기준인가요?", answer: "네. 이 페이지는 한국 근로기준법상 퇴직금 구조를 단순화해 설명합니다. 다른 국가의 severance 제도와 다릅니다." },
      { question: "1년 미만 근무도 계산되나요?", answer: "아니요. 계속근로기간이 1년 이상이고 4주 평균 주 15시간 이상 일해야 법정 퇴직금이 생겨요. 1년 미만이면 계산기는 0원으로 보여줘요." },
      { question: "세후 실수령액인가요?", answer: "아닙니다. 퇴직소득세와 실제 평균임금 산입 항목에 따라 수령액은 달라질 수 있습니다." },
    ],
    disclaimer: "이 도구는 일반적인 계산용이에요. 공식 퇴직금과 세액은 고용노동부·국세청 또는 노무전문가 기준을 확인하세요.",
  },
  en: {
    introTitle: "South Korean severance pay is estimated from average wage and tenure",
    intro: "This calculator estimates severance pay from employment dates, average monthly pay, and annual bonus. It explains the basic Korean severance-pay structure, but actual payroll treatment may include allowances, unused leave, bonus rules, and retirement income tax.",
    formulaTitle: "Calculation rules",
    formulas: [
      { title: "Average daily wage", body: "Daily wage = (last 3 months of pay + annual bonus × 3/12) ÷ calendar days in those 3 months" },
      { title: "Tenure days", body: "Tenure days = exit date - start date" },
      { title: "Severance pay", body: "Severance = daily wage × 30 × tenure days / 365 (1 year or more)" },
    ],
    howToTitle: "How to use",
    steps: ["Enter the start date and expected exit date.", "Enter average monthly pay and annual bonus.", "Review estimated severance, daily wage, and tenure days."],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Is this based on Korean rules?", answer: "Yes. It simplifies the Korean Labor Standards Act structure and is not the same as severance systems in other countries." },
      { question: "Does it apply below one year of service?", answer: "No. Statutory severance in South Korea needs at least one year of continuous service at 15 or more hours a week on a 4-week average. Below one year the calculator shows 0." },
      { question: "Is this after tax?", answer: "No. Retirement income tax and detailed wage-inclusion rules can change the actual payout." },
    ],
    disclaimer: "This tool is for general calculation. Confirm official severance pay and tax figures with the relevant labor or tax authority.",
  },
  ja: {
    introTitle: "日本の退職金は法律ではなく会社の規程で決まります",
    intro: "労働基準法には退職金の支払い義務がありません。退職金が出るのは、就業規則や退職金規程に定めがある会社だけで、額も会社ごとに違います。この計算機では、規程で決まった退職金の手取り（退職所得控除と税金を差し引いた額）と、法律で決まっている解雇予告手当を計算します。",
    formulaTitle: "計算基準",
    formulas: [
      { title: "退職所得控除", body: "20年以下：40万円×勤続年数（最低80万円）／20年超：800万円＋70万円×（年数−20）" },
      { title: "課税退職所得", body: "（退職金 − 控除）× 1/2。勤続5年以下は300万円超の部分を1/2にしない" },
      { title: "解雇予告手当", body: "平均賃金 ×（30日 − 予告日数）。平均賃金＝直前3か月の賃金総額 ÷ 暦日数" },
    ],
    howToTitle: "使い方",
    steps: ["勤続年数と、会社の規程で決まった退職金の額面を入力します。", "退職所得控除、課税退職所得、手取りを確認します。", "解雇の場合は直前3か月の賃金と予告日数を入れて解雇予告手当を確認します。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "退職金がない会社は違法ですか？", answer: "いいえ。退職金は法律上の義務ではありません。ただし就業規則や退職金規程に定めがあれば、会社は規程どおりに支払う義務があります。" },
      { question: "税金はいつ引かれますか？", answer: "「退職所得の受給に関する申告書」を会社に出せば、支払い時に所得税・復興特別所得税・住民税が源泉徴収され、原則として確定申告は不要です。出さないと20.42%が源泉徴収されます。" },
      { question: "解雇予告手当は必ずもらえますか？", answer: "会社が30日前までに予告せずに解雇するときは、足りない日数分の平均賃金を払う必要があります（労基法20条）。天災や本人の重大な責任で労基署の認定を受けた場合などは例外です。" },
    ],
    disclaimer: "このツールは一般的な計算用です。退職金の額は会社の規程、税額は国税庁・お住まいの市区町村、解雇の扱いは労働基準監督署でご確認ください。",
  },
  zh: {
    introTitle: "离职经济补偿按工作年限和月工资计算",
    intro: "中国没有统一的“退职金”，用人单位依法解除或终止劳动合同时，要按《劳动合同法》第47条支付经济补偿。协商解除、裁员、劳动合同到期不续签（单位不续或降低条件）、单位过错被迫辞职等情形都适用。本计算器按工作年限、离职前12个月平均工资和当地社平工资计算 N、N+1 和 2N。",
    formulaTitle: "计算规则",
    formulas: [
      { title: "年限 N", body: "每满1年支付1个月工资；6个月以上不满1年按1年；不满6个月支付半个月" },
      { title: "封顶", body: "月工资高于当地上年度职工月平均工资3倍的，按3倍计算，年限最多12年" },
      { title: "N+1 与 2N", body: "未提前30天书面通知：另付1个月工资（代通知金）；违法解除：按经济补偿标准的2倍支付赔偿金" },
    ],
    howToTitle: "使用方法",
    steps: ["输入在本单位的工作月数。", "输入离职前12个月的平均工资和当地上年度职工月平均工资。", "选择解除情形，查看计算年限、基数和金额。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "主动辞职有经济补偿吗？", answer: "一般没有。但如果是因为单位未及时足额支付工资、未缴社保等原因（劳动合同法第38条）而辞职，可以要求经济补偿。" },
      { question: "月工资包括哪些？", answer: "按劳动者离职前12个月的应得工资计算，包括计时或计件工资以及奖金、津贴和补贴等货币性收入。" },
      { question: "当地月平均工资在哪里查？", answer: "以劳动合同履行地或用人单位所在地人社部门、统计部门公布的上年度职工月平均工资为准，各地数字不同。" },
    ],
    disclaimer: "本工具用于一般计算。具体金额请以当地劳动保障部门、劳动仲裁机构或专业律师的意见为准。",
  },
  fr: {
    introTitle: "L'indemnité légale de licenciement dépend de l'ancienneté et du salaire de référence",
    intro: "En France, un salarié en CDI licencié (hors faute grave ou lourde) a droit à l'indemnité légale de licenciement dès 8 mois d'ancienneté ininterrompue. Le même minimum s'applique à la rupture conventionnelle. Ce calculateur applique le barème du Code du travail ; votre convention collective peut prévoir plus.",
    formulaTitle: "Règles de calcul",
    formulas: [
      { title: "Condition", body: "8 mois d'ancienneté ininterrompue chez le même employeur (L1234-9)" },
      { title: "Barème", body: "1/4 de mois de salaire par année jusqu'à 10 ans, puis 1/3 de mois par année (R1234-2)" },
      { title: "Salaire de référence", body: "Le plus favorable : moyenne des 12 derniers mois ou des 3 derniers mois (primes proratisées)" },
    ],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez votre ancienneté en mois, préavis inclus.", "Indiquez votre salaire de référence brut mensuel.", "Lisez l'indemnité légale, puis comparez avec votre convention collective."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "L'indemnité est-elle imposable ?", answer: "L'indemnité légale ou conventionnelle de licenciement est exonérée d'impôt sur le revenu. Au-delà, des plafonds s'appliquent ; vérifiez sur impots.gouv.fr." },
      { question: "Et en cas de faute grave ?", answer: "La faute grave ou lourde prive de l'indemnité de licenciement et du préavis, mais pas des congés payés acquis." },
      { question: "Les années incomplètes comptent-elles ?", answer: "Oui, au prorata du nombre de mois complets. L'ancienneté s'apprécie à la fin du préavis, même si celui-ci n'est pas effectué." },
    ],
    disclaimer: "Cet outil sert au calcul général. Vérifiez votre convention collective et, en cas de doute, renseignez-vous auprès de l'inspection du travail ou d'un avocat.",
  },
  es: {
    introTitle: "La indemnización por despido depende del tipo de extinción y de la antigüedad",
    intro: "En España la indemnización se calcula con el salario diario (salario bruto anual ÷ 365) y los días por año de servicio que fija el Estatuto de los Trabajadores. Un despido declarado improcedente paga 33 días por año, uno objetivo 20 días y el fin de un contrato temporal 12 días.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      { title: "Improcedente", body: "33 días de salario por año, tope 24 mensualidades (art. 56 ET)" },
      { title: "Objetivo", body: "20 días de salario por año, tope 12 mensualidades (art. 53 ET)" },
      { title: "Fin de contrato temporal", body: "12 días de salario por año (art. 49.1.c ET)" },
    ],
    howToTitle: "Cómo usarlo",
    steps: ["Introduce tu antigüedad en meses.", "Indica el salario bruto anual con pagas extra prorrateadas.", "Elige el tipo de extinción y revisa los días y el importe."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Tributa la indemnización?", answer: "La indemnización obligatoria por despido está exenta de IRPF hasta 180.000 €. Lo pactado por encima del mínimo legal tributa." },
      { question: "¿Y si entré antes de 2012?", answer: "Para el tiempo trabajado antes del 12 de febrero de 2012 el despido improcedente se calcula a 45 días por año. Esta calculadora aplica solo la regla de 33 días." },
      { question: "¿El finiquito es lo mismo?", answer: "No. El finiquito incluye salario pendiente, vacaciones no disfrutadas y partes proporcionales de pagas extra; la indemnización se suma aparte." },
    ],
    disclaimer: "Esta herramienta es para cálculo general. Confirma tu caso con el SEPE, la inspección de trabajo, un graduado social o un abogado laboralista.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  { "@context": "https://schema.org", "@type": "HowTo", name: m.title, description: m.description, step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-6 sm:py-10">
    {country ? <SeveranceCountryCalculator client:load country={country} /> : <SeveranceCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}
    {locale === "ko" && <ToolsCompanionBanner tool="severance-pay" />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 font-mono text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="severance-calculator" slugs={["comprehensive-income-tax-calculator", "global-income-tax-calculator", "gift-tax-calculator", "inheritance-tax-calculator", "property-tax-calculator", "year-end-settlement-calculator", "severance-calculator", "freelancer-tax-calculator"]} />
  </div>
</BaseLayout>
