---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "오늘의 타로",
  "en": "Daily Tarot",
  "ja": "今日のタロット",
  "fr": "tarot du jour",
  "es": "tarot del día",
  "zh": "今日塔罗",
  "cn": "今日塔羅"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/tarot/daily" kind="tool" />
