---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import AnnualLeaveCalculator from "../../components/tools/AnnualLeaveCalculator";
import AnnualLeaveCountryCalculator from "../../components/tools/AnnualLeaveCountryCalculator";
import type { LeaveCountry } from "../../lib/annual-leave-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// Law-dependent tool: each locale page follows its own country's law (세운 2026-10-19).
// ko and en (expats in Korea) use the Korean Labor Standards Act.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, LeaveCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "연차 계산기 — 발생·잔여 연차 자동 계산 (근로기준법)",
    description: "입사일을 입력하면 근로기준법에 따른 연차 발생일수(최대 25일), 사용 연차, 잔여 연차를 자동으로 계산합니다. 1년 미만 월 단위 산정도 지원.",
  },
  en: {
    title: "South Korea Annual Leave Calculator — Statutory Days & Unused Leave Pay",
    description: "For employees in South Korea: statutory annual leave under the Labor Standards Act (15 days, up to 25 with seniority) and the payout for unused days based on ordinary wages.",
  },
  ja: {
    title: "年次有給休暇計算機 — 勤続年数ごとの付与日数（労働基準法39条）",
    description: "日本の労働基準法39条にもとづき、継続勤務期間から年次有給休暇の付与日数（6か月10日〜6年6か月以上20日）を計算し、残日数の賃金換算額も確認できます。",
  },
  fr: {
    title: "Calculateur de congés payés — jours acquis et indemnité compensatrice",
    description: "Calculez vos congés payés selon le Code du travail français (2,5 jours ouvrables par mois, 30 jours maximum) et l'indemnité compensatrice : règle du dixième ou maintien de salaire.",
  },
  es: {
    title: "Calculadora de vacaciones — días generados y compensación en el finiquito",
    description: "Calcula tus vacaciones según el Estatuto de los Trabajadores (30 días naturales al año, en proporción a los meses trabajados) y la compensación por días pendientes en el finiquito.",
  },
  zh: {
    title: "年休假计算器 — 法定天数与未休年假工资",
    description: "按《职工带薪年休假条例》计算累计工作年限对应的年休假天数（5/10/15天），以及单位未安排休假时按日工资300%支付的未休年假工资。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "연차는 입사일, 근속 기간, 사용 일수에 따라 달라집니다",
    intro: "연차 계산은 단순히 달력 연도만 보는 것이 아니라 입사일과 계속 근로 기간, 이미 사용한 휴가를 함께 봐야 해요. 이 계산기는 한국 근로기준법의 일반적인 발생 구조를 바탕으로 예상 발생일수와 잔여일수를 빠르게 확인하도록 구성했어요.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "1년 미만", body: "개근한 1개월마다 1일씩 발생하는 구조를 참고합니다." },
      { title: "1년 이상", body: "기본 15일에서 근속 기간에 따라 가산일을 더합니다." },
      { title: "잔여 연차", body: "발생 연차에서 이미 사용한 일수를 뺀 값입니다." },
    ],
    howToTitle: "사용 방법",
    steps: [
      "입사일과 기준일을 입력해 근속 기간을 정합니다.",
      "이미 사용한 연차 일수가 있다면 함께 입력합니다.",
      "예상 발생일수와 남은 일수를 확인하고 회사 규정과 대조합니다.",
    ],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "회사 회계연도 기준과 다를 수 있나요?", answer: "네. 회사가 회계연도 기준으로 연차를 관리하면 입사일 기준 계산과 정산 방식이 달라질 수 있습니다." },
      { question: "최대 연차는 몇 일인가요?", answer: "일반적으로 근속 가산을 포함해 연 25일을 상한으로 봅니다. 단, 적용 조건은 근로 형태와 회사 규정에 따라 확인해야 합니다." },
      { question: "반차나 시간 단위 휴가는 어떻게 넣나요?", answer: "반차는 0.5일처럼 일 단위로 환산해 입력하면 잔여일수 추정에 활용할 수 있습니다." },
    ],
    disclaimer: "이 계산기는 일반 정보 제공용이에요. 실제 연차 산정, 수당, 분쟁 사안은 회사 취업규칙, 근로계약, 고용노동부 또는 노무 전문가의 확인이 필요해요.",
  },
  en: {
    introTitle: "Annual leave depends on start date, service length, and days already used",
    intro: "PTO balances are not just a calendar-year number. For Korean annual leave, the hire date, continuous service period, accrual rules, and used days all matter. This calculator gives a practical estimate of accrued and remaining leave.",
    formulaTitle: "Calculation concepts",
    formulas: [
      { title: "Under one year", body: "Uses the common one-day-per-full-month accrual concept." },
      { title: "One year or more", body: "Starts from 15 days and adds service-based extra days where applicable." },
      { title: "Remaining balance", body: "Estimated accrued leave minus days already used." },
    ],
    howToTitle: "How to use",
    steps: [
      "Enter your start date and the reference date for the calculation.",
      "Add any leave days you have already used.",
      "Compare the estimated accrued and remaining days with your employer's records.",
    ],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "Can this differ from my company's fiscal-year system?", answer: "Yes. Employers may manage annual leave by fiscal year, which can require separate settlement from hire-date accrual." },
      { question: "What is the usual maximum annual leave?", answer: "Under the common Korean rule, annual leave is capped at 25 days after service-based additions, but eligibility should be checked for your employment situation." },
      { question: "How should I enter half-day leave?", answer: "Convert it to a day value, such as 0.5, so the remaining balance estimate reflects partial usage." },
    ],
    disclaimer: "This calculator provides general information. For official leave, allowance, or dispute questions, check your contract, company rules, the Korean labor authority, or a labor professional.",
  },
  ja: {
    introTitle: "有給休暇は「6か月・出勤率8割」から始まります",
    intro: "日本の労働基準法39条では、雇い入れから6か月継続して勤務し、全労働日の8割以上出勤した人に10日の年次有給休暇が付与されます。その後は1年ごとに増え、6年6か月以上で年20日になります。パートタイムでも週の所定労働日数に応じて比例付与されます。使わなかった分は2年で時効消滅し、在職中の買取りは原則としてできません。年10日以上付与される人には、会社が年5日を取得させる義務があります。",
    formulaTitle: "付与日数のルール",
    formulas: [
      { title: "初回", body: "6か月継続勤務・出勤率8割以上で10日" },
      { title: "その後", body: "1年6か月11日、2年6か月12日、3年6か月14日、4年6か月16日、5年6か月18日、6年6か月以上20日" },
      { title: "時効と取得義務", body: "付与から2年で消滅。10日以上付与される人は年5日の取得が義務" },
    ],
    howToTitle: "使い方",
    steps: [
      "入社日から今日までの継続勤務期間を月数で入力します。",
      "1日分の賃金（通常の賃金）と残っている日数を入力します。",
      "今年の付与日数と、残日数を賃金に換算した目安を確認します。",
    ],
    faqTitle: "よくある質問",
    faqs: [
      { question: "パート・アルバイトにも有給休暇はありますか？", answer: "あります。週30時間未満かつ週4日以下などの場合は、週の所定労働日数に応じて比例付与されます。この計算機は通常の労働者の日数を示します。" },
      { question: "使わなかった有給休暇は買い取ってもらえますか？", answer: "在職中の買取りは原則として認められません。時効で消える分や退職時に残った分を会社が買い取ることは違法ではありませんが、義務ではありません。" },
      { question: "有給休暇中の賃金はいくらですか？", answer: "就業規則にもとづき、通常の賃金、平均賃金、または労使協定による標準報酬日額のいずれかで支払われます。" },
    ],
    disclaimer: "日本の労働基準法39条にもとづく一般的な計算です（2026年10月時点）。比例付与、計画的付与、労使協定の内容は反映していません。正確な日数は就業規則や労働基準監督署にご確認ください。",
  },
  fr: {
    introTitle: "2,5 jours ouvrables par mois travaillé",
    intro: "En France, le Code du travail (articles L3141-3 et suivants) accorde 2,5 jours ouvrables de congés payés par mois de travail effectif, soit 30 jours ouvrables (5 semaines) pour une année complète. Le résultat est arrondi au nombre entier supérieur. À la fin du contrat, les jours non pris donnent droit à une indemnité compensatrice, calculée selon la méthode la plus favorable au salarié : 10 % de la rémunération brute de la période de référence, ou le maintien du salaire.",
    formulaTitle: "Repères de calcul",
    formulas: [
      { title: "Acquisition", body: "2,5 jours ouvrables par mois, arrondi au supérieur, 30 jours maximum" },
      { title: "Règle du dixième", body: "10 % du brut de la période de référence, au prorata des jours restants" },
      { title: "Maintien de salaire", body: "Salaire qu'aurait perçu le salarié pendant les jours de congé (brut ÷ 26 jours ouvrables par jour)" },
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Indiquez le nombre de mois travaillés pendant la période de référence (souvent du 1er juin au 31 mai).",
      "Saisissez votre salaire brut mensuel et les jours de congés qu'il vous reste.",
      "Comparez les deux méthodes : l'indemnité due est la plus élevée.",
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Les congés sont-ils comptés en jours ouvrables ou ouvrés ?", answer: "La loi compte en jours ouvrables (du lundi au samedi), soit 30 jours par an. Beaucoup d'entreprises comptent en jours ouvrés (25 jours) ; le résultat doit être au moins équivalent." },
      { question: "L'ancienneté donne-t-elle des jours en plus ?", answer: "Pas selon la loi. Des jours supplémentaires peuvent venir de la convention collective ou d'un accord d'entreprise." },
      { question: "Les arrêts maladie ouvrent-ils des congés ?", answer: "Depuis la loi du 22 avril 2024, les arrêts pour maladie non professionnelle ouvrent aussi des congés (2 jours ouvrables par mois, 24 maximum). Ce calculateur ne les prend pas en compte." },
    ],
    disclaimer: "Calcul indicatif selon le Code du travail français (octobre 2026). Les conventions collectives, le fractionnement et les congés acquis pendant un arrêt maladie ne sont pas inclus. Vérifiez votre bulletin de paie ou interrogez votre employeur.",
  },
  es: {
    introTitle: "30 días naturales al año, en proporción al tiempo trabajado",
    intro: "En España, el artículo 38 del Estatuto de los Trabajadores fija un mínimo de 30 días naturales de vacaciones retribuidas al año, que no pueden sustituirse por dinero mientras dura la relación laboral. Si el contrato termina antes de disfrutarlas, los días pendientes se pagan en el finiquito. Los convenios colectivos pueden mejorar este mínimo, por ejemplo con días por antigüedad.",
    formulaTitle: "Conceptos de cálculo",
    formulas: [
      { title: "Días generados", body: "30 días naturales × meses trabajados ÷ 12" },
      { title: "Días pendientes", body: "Días generados menos los ya disfrutados" },
      { title: "Compensación", body: "Días pendientes × salario bruto anual ÷ 365" },
    ],
    howToTitle: "Cómo usarlo",
    steps: [
      "Indica los meses trabajados en el año natural.",
      "Introduce tu salario bruto anual y los días de vacaciones que ya has disfrutado.",
      "Revisa los días pendientes y la compensación que debería aparecer en el finiquito.",
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Son 30 días naturales o 22 laborables?", answer: "La ley habla de 30 días naturales. Muchas empresas lo traducen a 22 días laborables, que en la práctica equivalen a cinco semanas." },
      { question: "¿Me pueden pagar las vacaciones en lugar de disfrutarlas?", answer: "No mientras sigas en la empresa. Solo se compensan en dinero las vacaciones no disfrutadas cuando termina el contrato." },
      { question: "¿Qué pasa si enfermo durante las vacaciones?", answer: "Si la incapacidad temporal impide disfrutarlas en el año, puedes hacerlo después, dentro de los 18 meses siguientes al final del año en que se generaron." },
    ],
    disclaimer: "Cálculo orientativo según el artículo 38 del Estatuto de los Trabajadores (octubre de 2026). El convenio colectivo puede fijar más días o otra base de cálculo. Comprueba tu nómina o consulta a la empresa o a un graduado social.",
  },
  zh: {
    introTitle: "年休假看累计工作年限，不只看本单位",
    intro: "根据《职工带薪年休假条例》，职工连续工作满12个月后享受带薪年休假：累计工作满1年不满10年5天，满10年不满20年10天，满20年及以上15天。年限按在所有单位的累计工作时间计算。单位因工作需要不安排休假的，按日工资收入的300%支付未休年休假工资报酬，其中包含正常工作期间的工资，所以实际另付200%。日工资按月工资除以21.75天计算。",
    formulaTitle: "计算规则",
    formulas: [
      { title: "法定天数", body: "累计满1年5天，满10年10天，满20年15天" },
      { title: "日工资", body: "月工资 ÷ 21.75天（剔除加班工资）" },
      { title: "未休补偿", body: "日工资 × 未休天数 × 300%（含正常工资，另付200%）" },
    ],
    howToTitle: "使用方法",
    steps: [
      "输入在所有单位的累计工作年限。",
      "输入月工资和单位未安排休假的未休天数。",
      "查看法定年休假天数和应另付的未休年假工资。",
    ],
    faqTitle: "常见问题",
    faqs: [
      { question: "新入职的单位也按累计年限算吗？", answer: "是。年休假天数按累计工作年限确定。新入职当年按剩余日历天数折算，不足1整天的部分不享受。" },
      { question: "自己不休年假也能拿300%吗？", answer: "如果单位已安排休假而职工本人书面提出不休，单位可以只支付正常工资，不另付200%。" },
      { question: "离职时没休的年假怎么办？", answer: "单位应按当年已工作时间折算应休天数，未休的部分按日工资300%支付（已折算部分不足1天的不支付）。" },
    ],
    disclaimer: "本工具依据《职工带薪年休假条例》和《企业职工带薪年休假实施办法》做一般估算（2026年10月）。地方规定、寒暑假与年休假的抵扣、离职折算的细节未纳入，请以单位规章和当地劳动保障部门意见为准。",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {locale === "ko" && <section class="mb-4 space-y-3 rounded-lg border border-border p-3" aria-label="연차와 퇴직금의 날짜 경계"><h2 class="font-semibold">퇴사 전후에는 서로 다른 기준을 확인해요</h2><ol class="grid gap-2 sm:grid-cols-3"><li class="rounded-lg border border-border p-3 text-sm">① 연차: 개근한 월·연간 출근율·권리 발생일</li><li class="rounded-lg border border-border p-3 text-sm">② 퇴직금: 계속근로·주 평균시간·마지막 근무일 다음 날</li><li class="rounded-lg border border-border p-3 text-sm">③ 사용한 휴가·지급한 수당·사용촉진 별도 확인</li></ol><p class="text-sm leading-relaxed">같은 입사일을 넣어도 연차 발생과 퇴직금 대상은 같은 판정이 아니에요. 상시 근로자 수와 출근율, 계약 종료 시점에 따라 달라져요. 1년 계약을 마쳤다는 이유만으로 추가 연차 15일을 자동 합산하지 않아요. 조회일 기준 화면을 퇴사 정산 확정액으로 쓰지 마세요.</p><a class="inline-flex min-h-11 items-center text-sm text-primary underline" href="https://www.moel.go.kr/retirementpayCal.do">퇴직금 공식 예시와 퇴직일 입력 기준</a></section>}
    {country ? <AnnualLeaveCountryCalculator client:load country={country} /> : <AnnualLeaveCalculator client:load locale={locale} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 font-mono text-sm leading-6 text-green-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="annual-leave-calculator" slugs={["salary-calculator", "annual-leave-calculator", "auto-tax-calculator", "acquisition-tax-calculator", "capital-gains-tax-calculator"]} />
  </div>
</BaseLayout>
