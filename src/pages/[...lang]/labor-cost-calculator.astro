---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import LaborCostCalculatorComp from "../../components/calculators/LaborCostCalculator";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "인건비 계산기 — 4대 보험 + 퇴직금 실부담금",
    description: "직원 월급여 입력 시 국민연금, 건강보험, 고용보험, 산재보험 사부담금과 퇴직금 적립액을 포함한 실제 고용비용을 계산합니다.",
  },
  en: {
    title: "Labor Cost Calculator — 4 Insurances + Severance",
    description: "Enter monthly salary to calculate total employer cost including national pension, health insurance, employment insurance, and severance accrual.",
  },
  ja: {
    title: "人件費計算機 — 4大保険+退職金",
    description: "月給を入力して、国民年金・健康保険・雇用保険・産業災害補償保険と退職金積立を含む実際の雇用コストを計算します。",
  },
  fr: {
    title: "Calculateur de Coût Salarial — Charges Patronales",
    description: "Entrez le salaire mensuel pour calculer le coût total de l'employeur incluant les cotisations sociales et l'indemnité de licenciement.",
  },
  es: {
    title: "Calculadora de Coste Laboral — Seguridad Social + Indemnización",
    description: "Ingrese el salario mensual para calcular el coste total del empleador incluyendo las cotizaciones sociales y la indemnización.",
  },
  zh: {
    title: "人力成本计算机 — 四大保险+退休金",
    description: "输入月薪，计算包含国民年金、健康保险、就业保险、工伤保险及退休金在内的实际雇用成本。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <LaborCostCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedToolLinks locale={locale} current="labor-cost-calculator" slugs={["legal-interest-calculator", "litigation-cost-calculator", "loss-of-income-calculator", "statute-limitations-calculator", "separate-vs-comprehensive-tax-calculator", "real-estate-capital-gains-tax-calculator", "gift-vs-inheritance-calculator", "incorporation-calculator", "insurance-premium-calculator", "labor-cost-calculator", "subscription-points-calculator"]} />
  </main>
</BaseLayout>
