---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedToolLinks from "../../components/RelatedToolLinks.astro";
import AcquisitionTaxCalculatorComp from "../../components/tools/AcquisitionTaxCalculator";
import AcquisitionTaxCountryCalculator from "../../components/tools/AcquisitionTaxCountryCalculator";
import type { AcquisitionCountry } from "../../lib/acquisition-tax-countries";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

// ja/zh/fr/es use their own country's law; ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, AcquisitionCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "부동산 취득세 계산기 — 주택 매수 전 세금 미리 계산하기",
    description: "주택 가격과 취득 유형에 따른 취득세를 미리 계산하세요. 1주택·2주택·법인 등 상황별 세율을 반영합니다.",
  },
  en: {
    title: "Real Estate Acquisition Tax Calculator (South Korea)",
    description: "Calculate acquisition tax before buying property in Korea. Supports first home, second home, and corporate purchase rates.",
  },
  ja: {
    title: "不動産取得税・登録免許税 計算機（日本）",
    description: "家を買うときの不動産取得税（土地・住宅3%、宅地1/2、新築1,200万円控除）と登録免許税（土地1.5%、住宅0.3%）を固定資産税評価額から計算します。"
  },
  fr: {
    title: "Calculateur de droits de mutation (frais de notaire)",
    description: "Calculez les droits de mutation d'un achat immobilier en France : ancien jusqu'à 6,32 % (taux départemental 5 %, 4,5 % pour les primo-accédants), neuf 0,715 %."
  },
  es: {
    title: "Calculadora de ITP e impuestos de compra de vivienda",
    description: "Calcula el ITP de una vivienda usada según tu comunidad (Madrid 6 %, Cataluña 10 %, Andalucía 7 %, C. Valenciana 9 %) o el IVA del 10 % + AJD de una obra nueva."
  },
  zh: {
    title: "契税计算器（首套、二套住房）",
    description: "按《契税法》和2024年第16号公告计算购房契税：家庭唯一住房140㎡以下1%、以上1.5%，第二套1%或2%，第三套按本省3%–5%税率。"
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "부동산 취득세 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 한국 기준의 부동산 취득세를 설명과 함께 계산해요. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전해요.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "6억원 이하 1%, 6억~9억원 약 1~3%, 9억원 초과 3%를 기본 구조로 봅니다."
    }, {
      title: "기준 2",
      body: "취득세의 10%를 지방교육세로 더합니다."
    }, {
      title: "기준 3",
      body: "85㎡ 초과 주택은 매수가액의 0.2%를 농어촌특별세로 추정합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "한국 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "다주택자, 법인, 증여, 생애최초 감면, 조정대상지역 규정은 별도 검토가 필요합니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용이에요. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "Real estate acquisition tax is country-specific",
    intro: "This page estimates real estate acquisition tax under Korea rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Uses 1% up to KRW 600M, roughly 1-3% to KRW 900M, and 3% above KRW 900M."
    }, {
      title: "Rule 2",
      body: "Adds local education tax at 10% of acquisition tax."
    }, {
      title: "Rule 3",
      body: "Homes over 85㎡ add an estimated 0.2% rural special tax."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses Korea rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Multi-home, corporate, gift, first-home relief, and regulated-area rules need separate review."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "日本で家を買うときにかかる税金は、不動産取得税と登録免許税です",
    intro: "不動産取得税は都道府県の税で、取得から数か月後に納税通知書が届きます。登録免許税は国の税で、所有権の登記のときに司法書士を通じて納めます。どちらも売買価格ではなく固定資産税評価額を基準に計算し、住宅には令和9年3月31日までの軽減特例があります。",
    formulaTitle: "計算基準",
    formulas: [
      {
        title: "不動産取得税",
        body: "土地：評価額×1/2（宅地）×3% − 住宅用土地の減額（45,000円か、1㎡当たり価格×床面積の2倍（200㎡まで）×3%の多い方）。家屋：（評価額 − 1,200万円）×3%"
      },
      {
        title: "登録免許税",
        body: "土地の売買：評価額×1.5%（本則2%）。住宅用家屋の移転0.3%（本則2%）、新築の保存0.15%（本則0.4%）"
      },
      {
        title: "住宅の要件",
        body: "自己居住、床面積50㎡以上（不動産取得税の新築控除は40〜240㎡）、1982年以降の建築または新耐震基準適合"
      }
    ],
    howToTitle: "使い方",
    steps: [
      "固定資産税評価額（土地・家屋）と面積を入力します。",
      "新築か中古か、宅地かどうか、住宅の軽減要件を満たすかを選びます。",
      "不動産取得税・登録免許税と合計を確認します。"
    ],
    faqTitle: "よくある質問",
    faqs: [
      {
        question: "評価額はどこでわかりますか？",
        answer: "売主が持っている固定資産税の納税通知書（課税明細書）か、市区町村で取る評価証明書に載っています。新築の家屋は評価額がまだないため、法務局の認定価格や都道府県の基準で計算されます。"
      },
      {
        question: "中古住宅の控除額は？",
        answer: "その住宅が新築された時期の控除額が使われます。1997年4月1日以降に新築された住宅は1,200万円で、それより前は時期に応じて少なくなります。耐震基準に適合していることが条件です。"
      },
      {
        question: "期限が過ぎたらどうなりますか？",
        answer: "特例が延長されなければ、不動産取得税は4%、宅地の1/2特例なし、登録免許税は本則税率に戻ります。毎年の税制改正で延長されることが多いので、取得時点の規定を確認してください。"
      }
    ],
    disclaimer: "このツールは一般的な計算用です。税額は都道府県税事務所（不動産取得税）と法務局・司法書士（登録免許税）でご確認ください。"
  },
  zh: {
    introTitle: "个人购房契税按家庭住房套数和面积确定税率",
    intro: "《契税法》规定契税税率为3%至5%，由各省、自治区、直辖市确定。自2024年12月1日起，个人购买家庭唯一住房或第二套住房可享受减按1%至2%征收的优惠（财政部 税务总局 住房城乡建设部公告2024年第16号）。家庭成员包括购房人、配偶和未成年子女。",
    formulaTitle: "计算规则",
    formulas: [
      {
        title: "家庭唯一住房",
        body: "140㎡及以下：1%；140㎡以上：1.5%"
      },
      {
        title: "家庭第二套住房",
        body: "140㎡及以下：1%；140㎡以上：2%（北京、上海、广州、深圳也适用）"
      },
      {
        title: "第三套及以上",
        body: "按本省规定的契税税率（3%–5%）× 成交价（不含增值税）"
      }
    ],
    howToTitle: "使用方法",
    steps: [
      "输入不含增值税的成交价和住房面积。",
      "选择家庭住房套数，必要时修改本省税率。",
      "查看适用税率和契税金额。"
    ],
    faqTitle: "常见问题",
    faqs: [
      {
        question: "这个优惠有期限吗？",
        answer: "2024年第16号公告自2024年12月1日起执行，公告本身没有规定截止日期。如有新政策，以税务机关公布为准。"
      },
      {
        question: "套数怎么认定？",
        answer: "以家庭（购房人、配偶、未成年子女）名下住房为准，一般由住房城乡建设部门出具家庭住房情况查询结果。"
      },
      {
        question: "非住宅（商铺、车位）怎么算？",
        answer: "不适用住房优惠，按本省规定的契税税率计算，请选择“第三套及以上”并填写当地税率。"
      }
    ],
    disclaimer: "本工具用于一般估算。具体税率和套数认定请以当地税务机关和不动产登记中心为准。"
  },
  fr: {
    introTitle: "Les droits de mutation sont l'essentiel des « frais de notaire »",
    intro: "Lors d'un achat immobilier en France, le notaire collecte les droits de mutation à titre onéreux pour le département, la commune et l'État. Dans l'ancien, la loi de finances 2025 permet aux départements de porter leur taux de 4,5 % à 5 % jusqu'en 2028 ; 84 départements l'ont fait. Les primo-accédants qui achètent leur résidence principale ne paient pas cette hausse. Dans le neuf, on paie surtout la TVA, incluse dans le prix, et une taxe de publicité foncière réduite.",
    formulaTitle: "Règles de calcul",
    formulas: [
      {
        title: "Ancien",
        body: "Prix × (taux départemental + 1,2 %) + 2,37 % de la taxe départementale, soit 6,32 % à 5 % ou 5,81 % à 4,5 %"
      },
      {
        title: "Primo-accédant",
        body: "Pas de hausse de 0,5 point : le taux départemental reste à 4,5 % pour la résidence principale"
      },
      {
        title: "Neuf",
        body: "Taxe de publicité foncière : 0,715 % du prix (bien de moins de 5 ans vendu avec TVA)"
      }
    ],
    howToTitle: "Comment l'utiliser",
    steps: [
      "Saisissez le prix de vente, hors mobilier.",
      "Choisissez ancien ou neuf, le taux de votre département et si vous êtes primo-accédant.",
      "Lisez le détail des droits et leur pourcentage du prix."
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
      {
        question: "Mon département applique-t-il 5 % ?",
        answer: "84 départements sur 101 l'appliquent depuis avril à juin 2025. Restent à 4,5 % notamment l'Ain, les Hautes-Alpes, les Alpes-Maritimes, l'Ardèche, la Charente, la Drôme, l'Eure, la Lozère, l'Oise, les Hautes-Pyrénées, la Saône-et-Loire, le Tarn-et-Garonne et plusieurs départements d'outre-mer ; l'Indre et Mayotte appliquent 3,8 %."
      },
      {
        question: "Qui est primo-accédant ?",
        answer: "Une personne qui n'a pas été propriétaire de sa résidence principale au cours des deux années précédant l'achat, et qui achète pour en faire sa résidence principale."
      },
      {
        question: "Pourquoi le notaire demande-t-il plus ?",
        answer: "Les frais de notaire comprennent aussi ses émoluments réglementés, la contribution de sécurité immobilière et des débours. Ce calculateur ne compte que les droits de mutation."
      }
    ],
    disclaimer: "Cet outil sert au calcul général. Votre notaire vous donnera le montant exact ; le simulateur de service-public.fr peut aussi vous aider."
  },
  es: {
    introTitle: "Comprar vivienda en España: ITP si es usada, IVA y AJD si es nueva",
    intro: "La compra de una vivienda usada paga el Impuesto sobre Transmisiones Patrimoniales (ITP), cuyo tipo fija cada comunidad autónoma. La compra de una vivienda nueva al promotor paga IVA del 10 % y, por la escritura, Actos Jurídicos Documentados (AJD) al tipo de la comunidad. La base es el precio o el valor de referencia del Catastro si es mayor.",
    formulaTitle: "Reglas de cálculo",
    formulas: [
      {
        title: "ITP (usada)",
        body: "Madrid 6 %; Andalucía 7 %; Cataluña 10 % hasta 600.000 € y 11–13 % por encima; C. Valenciana 9 % hasta 1.000.000 € y 11 % por encima"
      },
      {
        title: "Obra nueva",
        body: "IVA 10 % + AJD: Madrid 0,75 %, Cataluña 1,5 %, Andalucía 1,2 %, C. Valenciana 1,4 %"
      },
      {
        title: "Otra comunidad",
        body: "Introduce el tipo general de ITP y de AJD de tu comunidad"
      }
    ],
    howToTitle: "Cómo usarla",
    steps: [
      "Introduce el precio o el valor de referencia si es mayor.",
      "Elige vivienda usada u obra nueva y tu comunidad autónoma.",
      "Revisa ITP, o IVA y AJD, y el total."
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      {
        question: "¿Hay tipos reducidos?",
        answer: "Sí. Muchas comunidades aplican tipos reducidos a jóvenes, familias numerosas, personas con discapacidad o VPO, con límites de precio y renta. Esta calculadora usa el tipo general."
      },
      {
        question: "¿Cambió el ITP en la Comunidad Valenciana?",
        answer: "Desde el 1 de junio de 2026 el tipo general baja del 10 % al 9 % hasta 1.000.000 € (11 % por encima), y el AJD general del 1,5 % al 1,4 % (Ley 5/2025)."
      },
      {
        question: "¿Y el País Vasco o Navarra?",
        answer: "Tienen régimen foral propio (por ejemplo, el 4 % general en el País Vasco). Elige «Otra» e introduce el tipo de tu territorio."
      }
    ],
    disclaimer: "Esta herramienta es para cálculo general. Confirma los tipos y bonificaciones en la agencia tributaria de tu comunidad autónoma o con tu notario o gestor."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]} heading={m.title} intro={m.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-2xl px-4 py-5 sm:py-8">
    {country ? <AcquisitionTaxCountryCalculator client:load country={country} /> : <AcquisitionTaxCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />}

    <section class="mt-6 sm:mt-10 border-t border-border pt-5 sm:pt-8">
      <h2 class="text-2xl font-bold text-foreground">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-border bg-card p-4">
            <h3 class="font-semibold text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-6 sm:mt-10">
      <h2 class="text-xl font-bold text-foreground">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-border bg-card">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-foreground">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-5 sm:mt-8 rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm leading-6 text-foreground">{c.disclaimer}</p>
    <RelatedToolLinks locale={locale} current="acquisition-tax-calculator" slugs={["salary-calculator", "annual-leave-calculator", "auto-tax-calculator", "acquisition-tax-calculator", "capital-gains-tax-calculator"]} />
  </div>
</BaseLayout>
