---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTranslations, locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import { getTrackFromData, slugifyCategory } from "../../lib/taxonomy";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = await getTranslations(locale);
const categoryNames = (t.category.names ?? {}) as Record<string, string>;

const allPosts = await getCollection("blog", ({ data }) => {
  return data.draft !== true && data.locale === locale && getTrackFromData(data) === "interactive";
});

allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts[0];
const recent = allPosts.slice(1, 7);
const byCategoryMap = new Map<string, typeof allPosts>();
for (const post of allPosts) {
  const cat = post.data.category ?? "Interactive";
  const existing = byCategoryMap.get(cat) ?? [];
  existing.push(post);
  byCategoryMap.set(cat, existing);
}
const categoryGroups = Array.from(byCategoryMap.entries()).sort(([a], [b]) => a.localeCompare(b));

const interactiveT = (t as Record<string, unknown>).interactive as Record<string, string> | undefined;
const pageTitle = interactiveT?.title ?? "Interactive";
const pageSubtitle = interactiveT?.subtitle ?? "Reading-first pages that embed selected tools, games, and simulators.";
const featuredLabel = interactiveT?.featured ?? "Interactive Pick";
const launchLabel = interactiveT?.launch ?? "Explore";
const latestLabel = interactiveT?.latest ?? "Latest Interactive";

// Tools & calculators now live under the Interactive umbrella (IA consolidation).
const toolsSection: Record<string, { heading: string; sub: string; cta: string; groups: { label: string; href: string }[] }> = {
  ko: {
    heading: "도구 · 계산기 · 게임",
    sub: "변환기·계산기·심리테스트·게임을 한곳에서.",
    cta: "전체 도구 보기",
    groups: [
      { label: "🧮 계산기·변환기", href: `/${locale}/tools` },
      { label: "🧠 심리 테스트", href: `/${locale}/tools` },
      { label: "🎮 게임", href: `/${locale}/tools` },
      { label: "🛠️ 유틸리티", href: `/${locale}/tools` },
    ],
  },
  en: {
    heading: "Tools · Calculators · Games",
    sub: "Converters, calculators, psychology tests, and games in one place.",
    cta: "Browse all tools",
    groups: [
      { label: "🧮 Calculators & Converters", href: `/${locale}/tools` },
      { label: "🧠 Psychology Tests", href: `/${locale}/tools` },
      { label: "🎮 Games", href: `/${locale}/tools` },
      { label: "🛠️ Utilities", href: `/${locale}/tools` },
    ],
  },
};
const ts = toolsSection[locale] ?? toolsSection.en;

// Flagship tools surfaced directly on /interactive so tools are visible, not just linked.
const flagshipTools: { slug: string; emoji: string; label: Record<string, string> }[] = [
  { slug: "height-converter", emoji: "📐", label: { ko: "키 변환기", en: "Height Converter", ja: "身長変換" } },
  { slug: "currency-converter", emoji: "💱", label: { ko: "환율 변환기", en: "Currency Converter", ja: "為替換算" } },
  { slug: "bmi-calculator", emoji: "⚖️", label: { ko: "BMI 계산기", en: "BMI Calculator", ja: "BMI計算" } },
  { slug: "discount-calculator", emoji: "🏷️", label: { ko: "할인가 계산기", en: "Discount Calculator", ja: "割引計算" } },
  { slug: "percentage-calculator", emoji: "％", label: { ko: "퍼센트 계산기", en: "Percentage Calculator", ja: "パーセント計算" } },
  { slug: "calorie-calculator", emoji: "🔥", label: { ko: "칼로리 계산기", en: "Calorie Calculator", ja: "カロリー計算" } },
  { slug: "temperature-converter", emoji: "🌡️", label: { ko: "온도 변환기", en: "Temperature Converter", ja: "温度変換" } },
  { slug: "dday-counter", emoji: "📅", label: { ko: "디데이 계산기", en: "D-Day Counter", ja: "Dデイ計算" } },
  { slug: "world-clock", emoji: "🕐", label: { ko: "세계 시계", en: "World Clock", ja: "世界時計" } },
  { slug: "sudoku", emoji: "🔢", label: { ko: "스도쿠", en: "Sudoku", ja: "数独" } },
];
const tlabel = (l: Record<string, string>) => l[locale] ?? l.en;
---

<BaseLayout title={pageTitle} description={pageSubtitle}>
  <section class="py-16 md:py-24">
    <div class="container px-4">

      {/* Tools & calculators (consolidated under Interactive) */}
      <div class="mb-14 rounded-2xl border border-primary/20 bg-primary/5 p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h2 class="text-2xl font-extrabold tracking-tight text-foreground">{ts.heading}</h2>
            <p class="mt-1 text-sm text-muted-foreground">{ts.sub}</p>
          </div>
          <a href={`/${locale}/tools`} class="shrink-0 inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:opacity-90 transition-opacity">
            {ts.cta} →
          </a>
        </div>
        <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3">
          {ts.groups.map((g) => (
            <a href={g.href} class="rounded-xl border border-border bg-card px-4 py-3 text-sm font-semibold text-foreground hover:border-primary/40 transition-colors">
              {g.label}
            </a>
          ))}
        </div>
        <div class="mt-3 grid grid-cols-2 sm:grid-cols-5 gap-2">
          {flagshipTools.map((tool) => (
            <a href={`/${locale}/${tool.slug}`} class="flex items-center gap-2 rounded-lg border border-border/60 bg-background px-3 py-2 text-xs font-medium text-muted-foreground hover:border-primary/40 hover:text-foreground transition-colors">
              <span aria-hidden="true">{tool.emoji}</span>
              <span class="truncate">{tlabel(tool.label)}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="mb-16 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/10 border border-secondary/20 text-secondary text-[10px] font-black uppercase tracking-[0.2em] mb-6">
          Interactive
        </div>
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-6">{pageTitle}</h1>
        <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl">{pageSubtitle}</p>
        <p class="mt-2 text-sm text-muted-foreground/50">{allPosts.length} interactive stories</p>
      </div>

      {featured && (() => {
        const href = `/${locale}/${featured.slug.split("/").slice(1).join("/")}/`;
        return (
          <a href={href} class="group block mb-20">
            <div class="grid lg:grid-cols-2 gap-8 items-center p-8 md:p-12 rounded-3xl border border-secondary/20 bg-secondary/5 hover:border-secondary/40 transition-all">
              <div class="space-y-6">
                <div class="flex items-center gap-3">
                  <span class="text-[10px] font-black uppercase tracking-[0.2em] bg-secondary text-secondary-foreground px-2.5 py-1 rounded-md">
                    {featuredLabel}
                  </span>
                  <span class="text-xs text-muted-foreground/60">
                    {categoryNames[featured.data.category ?? ""] ?? featured.data.category ?? "Interactive"}
                  </span>
                </div>
                <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight group-hover:text-secondary transition-colors">
                  {featured.data.title}
                </h2>
                <p class="text-muted-foreground leading-relaxed">
                  {featured.data.description}
                </p>
                <div class="flex items-center gap-4">
                  <span class="text-sm font-bold text-secondary">{launchLabel} →</span>
                  <span class="text-xs text-muted-foreground/50">
                    {featured.data.pubDate.toLocaleDateString(locale === "ko" ? "ko-KR" : "en-US", {
                      month: "long",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </span>
                </div>
              </div>
              <div class="order-first lg:order-last aspect-[4/3] rounded-2xl bg-gradient-to-br from-secondary/20 via-secondary/10 to-transparent border border-secondary/20 flex items-center justify-center">
                <div class="text-center space-y-2">
                  <p class="text-xs font-black uppercase tracking-[0.25em] text-secondary/80">Embedded</p>
                  <p class="text-sm text-muted-foreground">
                    {featured.data.embeddedTools?.length ? featured.data.embeddedTools.join(", ") : "Interactive module"}
                  </p>
                </div>
              </div>
            </div>
          </a>
        );
      })()}

      {recent.length > 0 && (
        <div class="mb-20">
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-sm font-black uppercase tracking-[0.2em] text-muted-foreground">{latestLabel}</h2>
            <div class="h-px flex-1 bg-border/40" />
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {recent.map((post) => {
              const href = `/${locale}/${post.slug.split("/").slice(1).join("/")}/`;
              return (
                <a href={href} class="group flex flex-col gap-4 p-6 rounded-2xl border border-secondary/20 hover:border-secondary/40 hover:bg-secondary/5 transition-all">
                  <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-widest">
                    <span class="bg-secondary text-secondary-foreground px-2 py-0.5 rounded-md">Interactive</span>
                    <span class="text-muted-foreground/40">/</span>
                    <span class="text-muted-foreground">{categoryNames[post.data.category ?? ""] ?? post.data.category}</span>
                  </div>
                  <h3 class="font-bold text-lg leading-snug group-hover:text-secondary transition-colors">{post.data.title}</h3>
                  <p class="text-sm text-muted-foreground line-clamp-3 leading-relaxed">{post.data.description}</p>
                  <div class="mt-auto pt-2 text-xs text-muted-foreground/50">
                    {post.data.embeddedTools?.length ? `Tools: ${post.data.embeddedTools.join(", ")}` : "Embedded experience"}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      {categoryGroups.length > 0 && (
        <div>
          {categoryGroups.map(([category, posts]) => (
            <div class="mb-12">
              <div class="flex items-center gap-4 mb-6">
                <h2 class="text-sm font-black uppercase tracking-[0.2em] text-muted-foreground">
                  {categoryNames[category] ?? category}
                </h2>
                <div class="h-px flex-1 bg-border/40" />
                <a
                  href={`/${locale}/category/${slugifyCategory(category)}`}
                  class="text-xs text-muted-foreground/50 hover:text-secondary transition-colors"
                >
                  All →
                </a>
              </div>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {posts.slice(0, 4).map((post) => {
                  const href = `/${locale}/${post.slug.split("/").slice(1).join("/")}/`;
                  return (
                    <a href={href} class="group flex flex-col gap-2 p-4 rounded-xl border border-secondary/20 hover:border-secondary/40 hover:bg-secondary/5 transition-all">
                      <h3 class="font-semibold text-sm leading-snug group-hover:text-secondary transition-colors line-clamp-3">{post.data.title}</h3>
                      <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">{post.data.description}</p>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      )}

      {allPosts.length === 0 && (
        <div class="text-center py-32 text-muted-foreground">
          <p>No interactive stories available yet.</p>
        </div>
      )}

      {/* ── Tools hub link ── */}
      <div class="mt-20 pt-12 border-t border-border/40 flex items-center justify-between gap-4">
        <p class="text-sm text-muted-foreground/60">
          {locale === "ko" ? "더 많은 독립형 도구를 찾고 계신가요?" :
           locale === "ja" ? "スタンドアロンツールをお探しですか？" :
           locale === "fr" ? "Vous cherchez plus d'outils autonomes ?" :
           locale === "es" ? "¿Buscas más herramientas independientes?" :
           locale === "zh" ? "正在尋找更多獨立工具？" :
           locale === "cn" ? "正在寻找更多独立工具？" :
           "Looking for standalone tools?"}
        </p>
        <a
          href={`/${locale}/tools/`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-secondary/30 bg-secondary/5 text-secondary text-sm font-bold hover:border-secondary/50 hover:bg-secondary/10 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
          aria-label={locale === "ko" ? "도구 모음 보기" : "View tools hub"}
        >
          {locale === "ko" ? "도구 모음 보기" :
           locale === "ja" ? "ツール一覧を見る" :
           locale === "fr" ? "Voir tous les outils" :
           locale === "es" ? "Ver todos los tools" :
           locale === "zh" ? "查看工具一覽" :
           locale === "cn" ? "查看工具一览" :
           "Browse Tools Hub"} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
