---
import SameSiteRedirect from "../../components/SameSiteRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
---
<SameSiteRedirect locale={locale} targetPath="/password-generator" />
