  },
  en: {
    title: "France VAT Calculator 2024 — 20%, 10%, 5.5%, 2.1% Rates",
    description: "Instantly calculate prices excl. and incl. VAT for all four French VAT rates: 20% standard, 10% reduced, 5.5% food, 2.1% reimbursed medicines.",
