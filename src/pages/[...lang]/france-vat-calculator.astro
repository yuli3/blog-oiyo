      { value: "0.021", label: "2,1% — Tasa especial (medicamentos)" },
    ],
  },
  zh: {
    heading: "法国TVA计算机",
    desc: "2024年法国4种TVA税率：20%标准、10%中间、5.5%食品、2.1%药品。",
    priceLabel: "输入价格（€）",
    modeLabel: "输入价格类型",
    modeHT: "未含税价格（HT）",
    modeTTC: "含税价格（TTC）",
    rateLabel: "TVA税率",
    resultHT: "未含税价格",
    resultTVA: "TVA金额",
    resultTTC: "含税价格",
    rates: [
      { value: "0.20", label: "20% — 标准税率" },
      { value: "0.10", label: "10% — 中间税率（餐饮、装修）" },
      { value: "0.055", label: "5.5% — 轻减税率（食品、书籍）" },
      { value: "0.021", label: "2.1% — 特别税率（报销药品）" },
    ],
  },
};

const ui = uiLabels[locale] ?? uiLabels.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-xl px-4 py-8">
    <div class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-sm flex flex-col gap-6">
      <div>
        <h1 class="text-2xl font-bold text-foreground mb-2">{ui.heading}</h1>
        <p class="text-sm text-muted-foreground">{ui.desc}</p>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label for="tva-price" class="text-sm font-bold text-foreground">{ui.priceLabel}</label>
          <input
            id="tva-price"
            type="number"
            min="0"
            step="0.01"
            value="100"
            class="w-full rounded-xl border border-border bg-background px-4 py-3 text-base font-bold text-foreground focus:outline-none focus:ring-2 focus:ring-success/30"
            aria-label={ui.priceLabel}
          />
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-sm font-bold text-foreground">{ui.modeLabel}</span>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
              <input type="radio" name="tva-mode" value="ht" checked class="accent-success" />
              {ui.modeHT}
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
              <input type="radio" name="tva-mode" value="ttc" class="accent-success" />
              {ui.modeTTC}
            </label>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-sm font-bold text-foreground">{ui.rateLabel}</span>
          <div class="flex flex-col gap-2">
            {ui.rates.map((rate, i) => (
              <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                <input
                  type="radio"
                  name="tva-rate"
                  value={rate.value}
                  checked={i === 0}
                  class="accent-success"
                />
                {rate.label}
              </label>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-2xl bg-success/10 border border-success/30 p-4 flex flex-col gap-1">
          <span class="text-xs font-bold text-success uppercase tracking-wide">{ui.resultHT}</span>
          <span class="text-2xl font-bold text-success" id="tva-ht">100,00 €</span>
        </div>
        <div class="rounded-2xl bg-warning/10 border border-warning/30 p-4 flex flex-col gap-1">
          <span class="text-xs font-bold text-warning uppercase tracking-wide">{ui.resultTVA}</span>
          <span class="text-2xl font-bold text-warning" id="tva-amount">20,00 €</span>
        </div>
        <div class="rounded-2xl bg-success p-4 flex flex-col gap-1">
          <span class="text-xs font-bold text-success uppercase tracking-wide">{ui.resultTTC}</span>
          <span class="text-2xl font-bold text-white" id="tva-ttc">120,00 €</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  function recalcTVA() {
    const priceInput = document.getElementById('tva-price') as HTMLInputElement | null;
    const modeInputs = document.querySelectorAll<HTMLInputElement>('input[name="tva-mode"]');
    const rateInputs = document.querySelectorAll<HTMLInputElement>('input[name="tva-rate"]');

    if (!priceInput) return;

    const price = Math.max(0, Number(priceInput.value) || 0);
    const mode = Array.from(modeInputs).find((r) => r.checked)?.value ?? 'ht';
    const rate = Number(Array.from(rateInputs).find((r) => r.checked)?.value ?? '0.20');

    let ht: number, tva: number, ttc: number;
    if (mode === 'ht') {
      ht = price;
      tva = Math.round(price * rate * 100) / 100;
      ttc = Math.round((ht + tva) * 100) / 100;
    } else {
      ttc = price;
      ht = Math.round((price / (1 + rate)) * 100) / 100;
      tva = Math.round((ttc - ht) * 100) / 100;
    }

    const fmt = (n: number) =>
      n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

    const htEl = document.getElementById('tva-ht');
    const tvaEl = document.getElementById('tva-amount');
    const ttcEl = document.getElementById('tva-ttc');
    if (htEl) htEl.textContent = fmt(ht);
    if (tvaEl) tvaEl.textContent = fmt(tva);
    if (ttcEl) ttcEl.textContent = fmt(ttc);
  }

  document.getElementById('tva-price')?.addEventListener('input', recalcTVA);
  document.querySelectorAll('input[name="tva-mode"]').forEach((r) => r.addEventListener('change', recalcTVA));
  document.querySelectorAll('input[name="tva-rate"]').forEach((r) => r.addEventListener('change', recalcTVA));
  recalcTVA();
</script>
