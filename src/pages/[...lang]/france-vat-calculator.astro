  resultTVA: string;
  resultTTC: string;
  rates: { value: string; label: string }[];
}> = {
  fr: {
    heading: "Calculateur de TVA",
    desc: "Quatre taux de TVA français 2024 : 20% normal, 10% réduit, 5,5% alimentaire, 2,1% médicaments.",
    priceLabel: "Saisir le prix (€)",
    modeLabel: "Type de prix saisi",
    modeHT: "Prix HT",
    modeTTC: "Prix TTC",
    rateLabel: "Taux de TVA",
    resultHT: "Prix HT",
    resultTVA: "Montant TVA",
    resultTTC: "Prix TTC",
    rates: [
      { value: "0.20", label: "20% — Taux normal (général)" },
      { value: "0.10", label: "10% — Taux intermédiaire (restauration, travaux)" },
      { value: "0.055", label: "5,5% — Taux réduit (alimentation, livres, abonnements)" },
      { value: "0.021", label: "2,1% — Taux particulier (médicaments remboursés, presse)" },
    ],
  },
  en: {
    heading: "France VAT Calculator",
    desc: "Four French VAT rates 2024: 20% standard, 10% intermediate, 5.5% food, 2.1% reimbursed medicines.",
    priceLabel: "Enter price (€)",
    modeLabel: "Input price type",
    modeHT: "Price excl. VAT",
    modeTTC: "Price incl. VAT",
    rateLabel: "VAT rate",
    resultHT: "Price excl. VAT",
    resultTVA: "VAT amount",
    resultTTC: "Price incl. VAT",
    rates: [
      { value: "0.20", label: "20% — Standard rate (general)" },
      { value: "0.10", label: "10% — Intermediate (restaurants, renovation works)" },
      { value: "0.055", label: "5.5% — Reduced (food, books, energy)" },
      { value: "0.021", label: "2.1% — Super-reduced (reimbursed medicines, press)" },
    ],
  },
  ko: {
    heading: "프랑스 TVA 계산기",
    desc: "2024년 프랑스 4가지 TVA 세율: 20% 일반, 10% 중간, 5.5% 식료품, 2.1% 의약품.",
    priceLabel: "가격 입력 (€)",
    modeLabel: "입력 가격 종류",
    modeHT: "세전 가격",
    modeTTC: "세후 가격",
    rateLabel: "TVA 세율",
    resultHT: "세전 가격",
    resultTVA: "TVA 금액",
    resultTTC: "세후 가격",
    rates: [
      { value: "0.20", label: "20% — 일반세율" },
      { value: "0.10", label: "10% — 중간세율 (음식점, 공사)" },
      { value: "0.055", label: "5.5% — 경감세율 (식료품, 도서)" },
      { value: "0.021", label: "2.1% — 특별세율 (환급 의약품)" },
    ],
  },
  ja: {
    heading: "フランスTVA計算機",
    desc: "2024年フランス4税率: 20%標準、10%中間、5.5%食料品、2.1%医薬品。",
    priceLabel: "価格を入力 (€)",
    modeLabel: "入力価格の種類",
    modeHT: "税抜き価格（HT）",
    modeTTC: "税込み価格（TTC）",
