    resultTVA: "TVA金額",
    resultTTC: "税込み価格（TTC）",
    rates: [
      { value: "0.20", label: "20% — 標準税率" },
      { value: "0.10", label: "10% — 中間税率（飲食店、工事）" },
      { value: "0.055", label: "5.5% — 軽減税率（食料品、書籍）" },
      { value: "0.021", label: "2.1% — 特別税率（医薬品）" },
    ],
  },
  es: {
    heading: "Calculadora de TVA Francia",
    desc: "4 tipos de IVA francés 2024: 20% normal, 10% intermedio, 5,5% alimentación, 2,1% medicamentos.",
    priceLabel: "Ingresa el precio (€)",
