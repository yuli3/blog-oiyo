---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "퍼스널 컬러",
  "en": "Personal color",
  "ja": "パーソナルカラー",
  "fr": "couleur personnelle",
  "es": "color personal",
  "zh": "个人色彩",
  "cn": "個人色彩"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/personal-color/test" kind="test" />
