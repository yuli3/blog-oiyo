---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalorieCalculatorComp from "../../components/tools/CalorieCalculator";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "하루 칼로리 계산기 — BMR·TDEE 및 목표 칼로리 계산",
    description: "Mifflin-St Jeor 공식으로 기초대사량(BMR)과 총 에너지 소비량(TDEE)을 계산합니다. 체중 감량·유지·증량 목표 칼로리와 3대 영양소 비율도 확인하세요.",
  },
  en: {
    title: "Daily Calorie Calculator — BMR, TDEE & Target Calories",
    description: "Calculate your Basal Metabolic Rate (BMR) and Total Daily Energy Expenditure (TDEE) using the Mifflin-St Jeor formula. Includes calorie targets for weight loss, maintenance, and gain.",
  },
  ja: {
    title: "1日カロリー計算機 — BMR・TDEE・目標カロリー計算",
    description: "Mifflin-St Jeor公式で基礎代謝量(BMR)と総エネルギー消費量(TDEE)を計算します。",
  },
  fr: {
    title: "Calculateur de Calories Journalières — BMR, TDEE et Objectifs",
    description: "Calculez votre métabolisme de base (BMR) et dépense énergétique totale (TDEE) avec la formule Mifflin-St Jeor.",
  },
  es: {
    title: "Calculadora de Calorías Diarias — BMR, TDEE y Objetivos",
    description: "Calcula tu tasa metabólica basal (BMR) y gasto energético total (TDEE) con la fórmula Mifflin-St Jeor.",
  },
  zh: {
    title: "每日热量计算机 — BMR、TDEE及目标热量计算",
    description: "使用Mifflin-St Jeor公式计算基础代谢率(BMR)和每日总能量消耗(TDEE)，包含减重、维持和增重目标热量。",
  },
};

const m = meta[locale] ?? meta.en;

const content: Record<ActiveLocale, {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
}> = {
  ko: {
    introTitle: "하루 칼로리는 BMR에서 시작해 활동량과 목표에 따라 달라집니다",
    intro: "이 계산기는 Mifflin-St Jeor 공식으로 기초대사량(BMR)을 구하고, 활동계수를 곱해 총 에너지 소비량(TDEE)을 추정합니다. 이후 감량, 유지, 증량 목표에 맞춘 하루 칼로리와 단백질·탄수화물·지방의 기본 배분을 보여줍니다.",
    formulaTitle: "계산 기준",
    formulas: [
      { title: "BMR", body: "남성: 10W+6.25H-5A+5, 여성: 10W+6.25H-5A-161" },
      { title: "TDEE", body: "TDEE = BMR × 활동계수(1.2-1.9)" },
      { title: "목표 칼로리", body: "감량은 TDEE-500kcal, 증량은 TDEE+500kcal 기준으로 표시합니다." },
    ],
    howToTitle: "사용 방법",
    steps: ["성별, 나이, 키, 몸무게를 입력합니다.", "현재 생활에 가장 가까운 활동 수준을 선택합니다.", "BMR, TDEE, 목표별 칼로리와 매크로를 식단 계획의 출발점으로 사용합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [
      { question: "BMR과 TDEE는 무엇이 다른가요?", answer: "BMR은 생명 유지에 필요한 최소 에너지이고, TDEE는 활동량까지 포함한 하루 전체 소비량입니다." },
      { question: "500kcal 감량 기준은 항상 맞나요?", answer: "일반적인 출발점일 뿐입니다. 체중 변화, 배고픔, 운동량, 건강 상태에 따라 조정해야 합니다." },
      { question: "매크로 비율은 꼭 지켜야 하나요?", answer: "아닙니다. 단백질 목표와 총열량을 우선 맞추고, 탄수화물과 지방은 선호도와 운동량에 맞게 조절할 수 있습니다." },
    ],
    disclaimer: "결과는 일반적인 추정치이며 전문적인 의학적 또는 영양 상담을 대신하지 않습니다.",
  },
  en: {
    introTitle: "Daily calories start with BMR, then change with activity and goal",
    intro: "This calculator estimates basal metabolic rate (BMR) with the Mifflin-St Jeor equation, then multiplies it by an activity factor to estimate total daily energy expenditure (TDEE). It then shows calorie targets for weight loss, maintenance, and gain, plus a basic protein, carbohydrate, and fat split.",
    formulaTitle: "Calculation basics",
    formulas: [
      { title: "BMR", body: "Men: 10W+6.25H-5A+5; women: 10W+6.25H-5A-161" },
      { title: "TDEE", body: "TDEE = BMR × activity factor (1.2-1.9)" },
      { title: "Goal calories", body: "Weight loss uses TDEE-500 kcal; weight gain uses TDEE+500 kcal." },
    ],
    howToTitle: "How to use",
    steps: ["Enter sex, age, height, and weight.", "Choose the activity level closest to your real routine.", "Use BMR, TDEE, goal calories, and macros as a planning baseline."],
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "What is the difference between BMR and TDEE?", answer: "BMR is the energy needed at rest. TDEE adds daily movement, exercise, and work activity." },
      { question: "Is a 500 kcal deficit always right?", answer: "No. It is a common starting point, but weight trend, hunger, training, and health status should guide adjustments." },
      { question: "Do I have to follow the macro split exactly?", answer: "No. Total calories and adequate protein usually matter most; carbs and fat can be adjusted to preference and training." },
    ],
    disclaimer: "Results are general estimates and are not a substitute for professional medical or nutrition advice.",
  },
  ja: {
    introTitle: "1日のカロリーはBMRを起点に、活動量と目的で変わります",
    intro: "この計算機はMifflin-St Jeor式で基礎代謝量(BMR)を推定し、活動係数を掛けて総消費エネルギー(TDEE)を求めます。さらに減量・維持・増量の目標カロリーと、たんぱく質・炭水化物・脂質の目安を表示します。",
    formulaTitle: "計算の基準",
    formulas: [
      { title: "BMR", body: "男性: 10W+6.25H-5A+5、女性: 10W+6.25H-5A-161" },
      { title: "TDEE", body: "TDEE = BMR × 活動係数(1.2-1.9)" },
      { title: "目標カロリー", body: "減量はTDEE-500kcal、増量はTDEE+500kcalを目安にします。" },
    ],
    howToTitle: "使い方",
    steps: ["性別、年齢、身長、体重を入力します。", "実際の生活に近い活動レベルを選びます。", "BMR、TDEE、目標カロリー、マクロを食事計画の出発点にします。"],
    faqTitle: "よくある質問",
    faqs: [
      { question: "BMRとTDEEの違いは？", answer: "BMRは安静時に必要なエネルギーで、TDEEは日常活動や運動を含めた消費量です。" },
      { question: "500kcal減は必ず適切ですか？", answer: "一般的な出発点ですが、体重推移、空腹感、運動量、健康状態で調整が必要です。" },
      { question: "マクロ比率は厳守ですか？", answer: "いいえ。総カロリーと十分なたんぱく質を優先し、炭水化物と脂質は生活に合わせて調整できます。" },
    ],
    disclaimer: "結果は一般的な推定値であり、医療または栄養の専門的助言の代わりにはなりません。",
  },
  zh: {
    introTitle: "每日热量从 BMR 开始，再依活动量与目标调整",
    intro: "这个计算器使用 Mifflin-St Jeor 公式估算基础代谢率(BMR)，再乘以活动系数得到每日总能量消耗(TDEE)。接著提供减重、维持与增重目标热量，以及蛋白质、碳水化合物与脂肪的基本分配。",
    formulaTitle: "计算基准",
    formulas: [
      { title: "BMR", body: "男性: 10W+6.25H-5A+5；女性: 10W+6.25H-5A-161" },
      { title: "TDEE", body: "TDEE = BMR × 活动系数(1.2-1.9)" },
      { title: "目标热量", body: "减重以 TDEE-500 kcal，增重以 TDEE+500 kcal 作为起点。" },
    ],
    howToTitle: "使用方法",
    steps: ["输入性别、年龄、身高与体重。", "选择最接近日常生活的活动程度。", "把 BMR、TDEE、目标热量与营养素分配作为规划起点。"],
    faqTitle: "常见问题",
    faqs: [
      { question: "BMR 和 TDEE 有什么不同？", answer: "BMR 是静息状态所需能量，TDEE 则包含日常活动、运动与工作消耗。" },
      { question: "每天少 500 kcal 一定适合吗？", answer: "不一定。这只是常见起点，应依体重变化、饥饿感、训练量与健康状况调整。" },
      { question: "营养素比例要完全照做吗？", answer: "不必。通常先看总热量与足够蛋白质，再依偏好与运动量调整碳水和脂肪。" },
    ],
    disclaimer: "结果仅为一般估算，不能替代专业医疗或营养建议。",
  },
  fr: {
    introTitle: "Les calories quotidiennes partent du BMR, puis varient avec l'activité et l'objectif",
    intro: "Ce calculateur estime le métabolisme de base avec la formule de Mifflin-St Jeor, puis applique un facteur d'activité pour obtenir la dépense énergétique totale. Il affiche ensuite des objectifs pour perdre, maintenir ou prendre du poids, avec une répartition simple des macronutriments.",
    formulaTitle: "Bases de calcul",
    formulas: [
      { title: "BMR", body: "Homme : 10P+6,25T-5A+5 ; femme : 10P+6,25T-5A-161" },
      { title: "TDEE", body: "TDEE = BMR × facteur d'activité (1,2-1,9)" },
      { title: "Objectif", body: "Perte : TDEE-500 kcal ; prise : TDEE+500 kcal." },
    ],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez sexe, âge, taille et poids.", "Choisissez le niveau d'activité le plus proche de votre routine.", "Utilisez BMR, TDEE, calories cible et macros comme base de planification."],
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Quelle différence entre BMR et TDEE ?", answer: "Le BMR correspond à l'énergie au repos ; le TDEE ajoute les mouvements, le sport et le travail quotidien." },
      { question: "Un déficit de 500 kcal est-il toujours adapté ?", answer: "Non. C'est un point de départ courant, à ajuster selon poids, faim, entraînement et santé." },
      { question: "Faut-il suivre les macros exactement ?", answer: "Non. Les calories totales et les protéines suffisantes priment souvent ; glucides et lipides peuvent varier." },
    ],
    disclaimer: "Les résultats sont des estimations générales et ne remplacent pas un avis médical ou nutritionnel professionnel.",
  },
  es: {
    introTitle: "Las calorías diarias empiezan con el BMR y cambian con actividad y objetivo",
    intro: "Esta calculadora estima la tasa metabólica basal con la fórmula Mifflin-St Jeor y la multiplica por un factor de actividad para obtener el gasto energético total. Después muestra objetivos para perder, mantener o ganar peso y una división básica de macronutrientes.",
    formulaTitle: "Bases del cálculo",
    formulas: [
      { title: "BMR", body: "Hombre: 10P+6.25A-5E+5; mujer: 10P+6.25A-5E-161" },
      { title: "TDEE", body: "TDEE = BMR × factor de actividad (1.2-1.9)" },
      { title: "Objetivo", body: "Pérdida: TDEE-500 kcal; ganancia: TDEE+500 kcal." },
    ],
    howToTitle: "Cómo usarla",
    steps: ["Introduce sexo, edad, estatura y peso.", "Elige el nivel de actividad más parecido a tu rutina.", "Usa BMR, TDEE, calorías objetivo y macros como punto de partida."],
    faqTitle: "Preguntas frecuentes",
    faqs: [
      { question: "¿Qué diferencia hay entre BMR y TDEE?", answer: "BMR es la energía en reposo; TDEE suma movimiento diario, ejercicio y actividad laboral." },
      { question: "¿Un déficit de 500 kcal siempre es correcto?", answer: "No. Es un inicio común, pero debe ajustarse según peso, hambre, entrenamiento y salud." },
      { question: "¿Debo seguir los macros exactamente?", answer: "No. Suelen importar primero calorías totales y proteína suficiente; carbohidratos y grasas se ajustan." },
    ],
    disclaimer: "Los resultados son estimaciones generales y no sustituyen el consejo médico o nutricional profesional.",
  },
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <CalorieCalculatorComp client:load locale={locale === 'ko' ? 'ko' : 'en'} />

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 font-mono text-sm leading-6 text-indigo-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
  </main>
</BaseLayout>
