---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "EQ 감성지능",
  "en": "EQ emotional intelligence",
  "ja": "EQ感情知能",
  "fr": "intelligence émotionnelle EQ",
  "es": "inteligencia emocional EQ",
  "zh": "EQ 情绪智力",
  "cn": "EQ 情緒智力"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/eq/test" kind="test" />
