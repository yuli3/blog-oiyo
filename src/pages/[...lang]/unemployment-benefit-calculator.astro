---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnemploymentBenefitCalculator from "../../components/tools/UnemploymentBenefitCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { dailyFloor, unemploymentBenefit, UNEMPLOYMENT, UNEMPLOYMENT_AS_OF } from "../../lib/kr-unemployment-2026";

// Korean only (2026-10-19): Korea's Employment Insurance Act. Law-specific tools get one page per
// country rather than translated copies (세운 2026-10-19). Topic T3 of the mrkimfighting-based plan,
// timed for year-end resignations.
const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "실업급여 계산기 2026 — 하루 얼마, 며칠, 총 얼마 받는지";
const description = "퇴사 전 3개월 월급과 고용보험 가입 기간을 넣으면 2026년 기준 하루 구직급여(상한 68,100원·하한 66,048원), 받는 날수(120~270일), 총 수령액을 계산합니다.";

const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const low = unemploymentBenefit({ threeMonthWages: 9_000_000, threeMonthDays: 92, insuredYears: 4, over50OrDisabled: false, dailyHours: 8 });
const high = unemploymentBenefit({ threeMonthWages: 15_000_000, threeMonthDays: 92, insuredYears: 4, over50OrDisabled: false, dailyHours: 8 });

const ko = {
  eyebrow: "노동·급여 도구",
  introTitle: "실업급여, 월급이 달라도 받는 돈은 거의 같습니다",
  intro: `실업급여(구직급여)는 퇴사 전 3개월 평균임금의 60%를 하루 단위로 줍니다. 다만 2026년에 퇴사한 사람은 하루 ${won(UNEMPLOYMENT.dailyCap)}을 넘지 못하고, 8시간 일한 사람은 ${won(dailyFloor(8))}보다 적게 받지도 않습니다. 상한과 하한의 차이가 ${won(UNEMPLOYMENT.dailyCap - dailyFloor(8))}뿐이라, 월급 300만 원이던 사람도 500만 원이던 사람도 하루 금액은 거의 같습니다. 가입 4년, 50세 미만이면 180일을 받아 월급 300만 원은 총 ${won(low.total)}, 500만 원은 ${won(high.total)}입니다. 금액보다 차이를 크게 만드는 것은 받는 날수입니다. 나이와 고용보험 가입 기간에 따라 120일에서 270일까지 달라집니다.`,
  howToTitle: "사용 방법",
  steps: [
    "퇴사 전 3개월 동안 받은 세전 월급의 평균을 만 원 단위로 넣습니다. 상여금과 연차수당도 넣습니다.",
    "고용보험에 가입한 기간을 넣습니다. 여러 회사를 다녔다면 합산한 기간입니다.",
    "퇴사일 기준 나이를 고르면 하루 금액, 받는 날수, 총액이 나옵니다.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "상한·하한 자동 적용", body: "평균임금의 60%가 상한을 넘거나 하한보다 적으면 어느 쪽에 걸렸는지 알려 줍니다." },
    { title: "받는 날수 표", body: "가입 기간과 나이에 따른 소정급여일수를 표로 함께 보여 줍니다." },
    { title: "단시간 근로자 하한", body: "하루 4시간·6시간 근무자는 하한이 시간에 비례해 낮아지는 점을 반영합니다." },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/severance-calculator/", label: "퇴직금 계산기", desc: "퇴사할 때 받는 퇴직금을 계산합니다." },
    { href: "/ko/retirement-tax-calculator/", label: "퇴직소득세 계산기", desc: "퇴직금에서 떼는 세금을 봅니다." },
    { href: "/ko/annual-leave-calculator/", label: "연차 계산기", desc: "남은 연차수당을 확인합니다." },
  ],
  disclaimer: `고용보험법의 구직급여 계산식을 단순화한 참고 계산입니다. 실제 평균임금은 퇴사 전 3개월의 임금명세와 날수로 고용센터가 정하고, 수급 자격(이직 전 18개월 중 피보험 단위기간 180일 이상, 비자발적 이직 등)은 고용센터 심사로 결정됩니다. 65세 이후 새로 고용된 경우, 자영업자 고용보험, 예술인·노무제공자는 기준이 다릅니다. 기준일 ${UNEMPLOYMENT_AS_OF}.`,
};

const faqs = [
  { q: "2026년 실업급여 상한액과 하한액은 얼마인가요?", a: "2026년 1월 1일 이후 퇴사한 사람은 하루 상한액이 68,100원입니다(2025년까지 66,000원). 하한액은 최저임금의 80%라서 하루 8시간 근로자는 10,320원 × 8시간 × 80% = 66,048원입니다." },
  { q: "실업급여는 며칠 동안 받나요?", a: "퇴사일 기준 나이와 고용보험 가입 기간으로 정해집니다. 50세 미만은 가입 1년 미만 120일, 1~3년 150일, 3~5년 180일, 5~10년 210일, 10년 이상 240일입니다. 50세 이상이거나 장애인은 1년 이상 구간마다 30일씩 더 깁니다(최대 270일)." },
  { q: "자진 퇴사해도 받을 수 있나요?", a: "원칙적으로는 받을 수 없습니다. 다만 임금 체불, 통근 곤란, 직장 내 괴롭힘, 권고사직처럼 법이 정한 정당한 사유가 있으면 자발적 퇴사여도 받을 수 있습니다." },
  { q: "언제까지 신청해야 하나요?", a: "받을 수 있는 기간은 퇴사 다음 날부터 12개월입니다. 늦게 신청하면 12개월이 지나는 날 남은 일수와 관계없이 끝나므로, 퇴사 후 바로 고용24에서 구직 등록과 수급 자격 신청을 하는 것이 좋습니다." },
  { q: "반복해서 받으면 깎이나요?", a: "5년 안에 여러 번 받으면 금액을 줄이는 고용보험법 개정안이 추진되고 있지만, 2026년 10월 현재 시행 중인 감액은 확인되지 않아 이 계산기에는 넣지 않았습니다." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="unemployment-benefit-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <UnemploymentBenefitCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 고용보험법 제45조(급여 기초 임금일액), 제46조(구직급여일액), 제50조·별표 1(소정급여일수). 2026년 1월 1일 이후 이직자 기준. 기준일 {UNEMPLOYMENT_AS_OF}.</p>
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
