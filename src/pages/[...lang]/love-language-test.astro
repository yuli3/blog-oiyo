---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "사랑의 언어",
  "en": "Love language",
  "ja": "愛の言語",
  "fr": "langage de l'amour",
  "es": "lenguaje del amor",
  "zh": "爱的语言",
  "cn": "愛的語言"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/love-language/test" kind="test" />
