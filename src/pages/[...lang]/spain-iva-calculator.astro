const ui = uiLabels[locale] ?? uiLabels.en;
---

<BaseLayout title={m.title} description={m.description}>
  <main class="mx-auto max-w-xl px-4 py-8">
    <div class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-sm flex flex-col gap-6">
      <div>
        <h1 class="text-2xl font-bold text-foreground mb-2">{ui.heading}</h1>
        <p class="text-sm text-muted-foreground">{ui.desc}</p>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <label for="iva-price" class="text-sm font-bold text-foreground">{ui.priceLabel}</label>
          <input
            id="iva-price"
            type="number"
            min="0"
            step="0.01"
            value="100"
            class="w-full rounded-xl border border-border bg-background px-4 py-3 text-base font-bold text-foreground focus:outline-none focus:ring-2 focus:ring-red-500"
            aria-label={ui.priceLabel}
          />
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-sm font-bold text-foreground">{ui.modeLabel}</span>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
              <input type="radio" name="iva-mode" value="ex" checked class="accent-red-600" />
              {ui.modeEx}
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
              <input type="radio" name="iva-mode" value="inc" class="accent-red-600" />
              {ui.modeInc}
            </label>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-sm font-bold text-foreground">{ui.rateLabel}</span>
          <div class="flex flex-col gap-2">
            {ui.rates.map((rate, i) => (
              <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                <input
                  type="radio"
                  name="iva-rate"
                  value={rate.value}
                  checked={i === 0}
                  class="accent-red-600"
                />
                {rate.label}
              </label>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-2xl bg-red-50 border border-red-200 p-4 flex flex-col gap-1">
          <span class="text-xs font-bold text-red-700 uppercase tracking-wide">{ui.resultEx}</span>
          <span class="text-2xl font-bold text-red-900" id="iva-ex">100,00 €</span>
        </div>
        <div class="rounded-2xl bg-amber-50 border border-amber-200 p-4 flex flex-col gap-1">
          <span class="text-xs font-bold text-amber-700 uppercase tracking-wide">{ui.resultIVA}</span>
          <span class="text-2xl font-bold text-amber-900" id="iva-amount">21,00 €</span>
        </div>
        <div class="rounded-2xl bg-red-600 p-4 flex flex-col gap-1">
          <span class="text-xs font-bold text-red-100 uppercase tracking-wide">{ui.resultInc}</span>
          <span class="text-2xl font-bold text-white" id="iva-inc">121,00 €</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  function recalcIVA() {
    const priceInput = document.getElementById('iva-price') as HTMLInputElement | null;
    const modeInputs = document.querySelectorAll<HTMLInputElement>('input[name="iva-mode"]');
    const rateInputs = document.querySelectorAll<HTMLInputElement>('input[name="iva-rate"]');

    if (!priceInput) return;

    const price = Math.max(0, Number(priceInput.value) || 0);
    const mode = Array.from(modeInputs).find((r) => r.checked)?.value ?? 'ex';
    const rate = Number(Array.from(rateInputs).find((r) => r.checked)?.value ?? '0.21');

    let ex: number, iva: number, inc: number;
    if (mode === 'ex') {
      ex  = price;
      iva = Math.round(price * rate * 100) / 100;
      inc = Math.round((ex + iva) * 100) / 100;
    } else {
      inc = price;
      ex  = Math.round((price / (1 + rate)) * 100) / 100;
      iva = Math.round((inc - ex) * 100) / 100;
    }

    const fmt = (n: number) =>
      n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

    const exEl  = document.getElementById('iva-ex');
    const ivaEl = document.getElementById('iva-amount');
    const incEl = document.getElementById('iva-inc');
    if (exEl)  exEl.textContent  = fmt(ex);
    if (ivaEl) ivaEl.textContent = fmt(iva);
    if (incEl) incEl.textContent = fmt(inc);
  }

  document.getElementById('iva-price')?.addEventListener('input', recalcIVA);
  document.querySelectorAll('input[name="iva-mode"]').forEach((r) => r.addEventListener('change', recalcIVA));
  document.querySelectorAll('input[name="iva-rate"]').forEach((r) => r.addEventListener('change', recalcIVA));
  recalcIVA();
</script>
