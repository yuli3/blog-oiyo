---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PensionTaxCalculatorComp from "../../components/calculators/PensionTaxCalculator";
import PensionCountryCalculator from "../../components/tools/PensionCountryCalculator";
import type { PensionCountry } from "../../lib/pension-countries";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

// ja/zh/fr/es use their own country's private-pension scheme (opening on the withdrawal tax); ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<Locale, PensionCountry>> = { ja: "jp", zh: "cn", fr: "fr", es: "es" };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "연금저축 세액공제 계산기 — 환급액 계산",
    description: "연금저축과 IRP 납입액으로 받을 수 있는 연말정산 세액공제 환급액을 계산합니다. 총급여 기준 세액공제율 자동 적용.",
  },
  en: {
    title: "Pension Savings Tax Credit Calculator (South Korea) — Year-End Refund",
    description: "Based on South Korean rules. Calculate your year-end tax credit refund from pension savings and IRP contributions. Applies 16.5% or 13.2% rate based on income.",
  },
  ja: {
    title: "iDeCo受取時の税金計算機 — 一時金の退職所得控除と所得税・住民税",
    description: "iDeCoを一時金で受け取るときの退職所得控除（拠出年数で決定）、課税退職所得、所得税・住民税と手取りを計算します。掛金の節税額や新NISAとの配分も同じ画面で試算できます。",
  },
  fr: {
    title: "Fiscalité de sortie du PER 2026 — impôt sur le capital retiré",
    description: "Calculez l'impôt sur une sortie en capital du PER : versements déduits au barème, plus-values au PFU de 12,8 % et prélèvements sociaux de 18,6 % depuis 2026, avec ou sans fractionnement du retrait.",
  },
  es: {
    title: "Calculadora del rescate del plan de pensiones — IRPF al cobrarlo",
    description: "Calcula el IRPF del rescate de un plan de pensiones, que tributa como rendimiento del trabajo: en capital en un año, repartido en varios años y con la reducción del 40 % de las aportaciones anteriores a 2007.",
  },
  zh: {
    title: "个人养老金领取个税计算器 — 3%单独计税",
    description: "计算领取个人养老金时按3%单独缴纳的个人所得税和实际到手金额，并可测算缴费时少缴的个税与长期净收益。",
  },
};

const m = meta[locale] ?? meta.en;

const content = {
  ko: {
    eyebrow: "세금 계산 도구",
    introTitle: "연금저축 세액공제 계산기란?",
    intro: "연금저축·IRP 납입액에 대한 세액공제 환급액을 계산하는 도구예요. 총급여에 따른 공제율(13.2% 또는 16.5%)과 한도를 반영해요.",
    howToTitle: "사용 방법",
    steps: ["연간 총급여(또는 종합소득)를 입력합니다.", "연금저축·IRP 납입액을 입력합니다.", "공제 한도와 적용 공제율이 자동 반영됩니다.", "예상 세액공제 환급액을 확인합니다."],
    highlightsTitle: "주요 특징",
    highlights: [
      { title: "공제율 자동 적용", body: "총급여 5,500만원(종합소득 4,500만원) 기준 16.5%/13.2%를 자동 적용합니다." },
      { title: "한도 반영", body: "연금저축·IRP 합산 납입 한도를 반영해 계산합니다." },
      { title: "환급액 추정", body: "연말정산에서 돌려받을 예상 금액을 가늠합니다." },
    ],
    relatedTitle: "관련 계산기",
    related: [
      { href: "/ko/pension-optimizer-calculator/", label: "연금 최적화 계산기", desc: "연금저축·IRP 납입 배분을 최적화합니다." },
      { href: "/ko/fire-retirement-calculator/", label: "조기은퇴 계산기", desc: "은퇴 목표 자금을 계산합니다." },
      { href: "/ko/savings-comparison-calculator/", label: "예적금 비교", desc: "예금·적금 수익을 비교합니다." },
    ],
    disclaimer: "본 계산기는 참고용이며, 실제 공제·환급액은 소득 구성·다른 공제 항목·세법 개정에 따라 달라질 수 있어요. 정확한 산정은 전문가 상담을 권장해요.",
  },
  en: {
    eyebrow: "Tax Tool",
    introTitle: "What is the pension savings tax-credit calculator?",
    intro: "It estimates the tax-credit refund for pension savings and IRP contributions, applying the credit rate (13.2% or 16.5%) and limit based on your gross salary.",
    howToTitle: "How to use",
    steps: ["Enter your annual gross salary (or total income).", "Enter your pension savings / IRP contributions.", "The credit limit and applicable rate are applied automatically.", "Review your estimated tax-credit refund."],
    highlightsTitle: "Highlights",
    highlights: [
      { title: "Automatic credit rate", body: "Applies 16.5% / 13.2% based on the 55M KRW salary (45M income) threshold." },
      { title: "Limit applied", body: "Reflects the combined pension-savings/IRP contribution limit." },
      { title: "Refund estimate", body: "Gauges the amount you may get back at year-end settlement." },
    ],
    relatedTitle: "Related calculators",
    related: [
      { href: "/en/pension-optimizer-calculator/", label: "Pension Optimizer", desc: "Optimize pension/IRP contribution split." },
      { href: "/en/fire-retirement-calculator/", label: "FIRE Calculator", desc: "Compute your retirement target." },
      { href: "/en/savings-comparison-calculator/", label: "Savings Comparison", desc: "Compare deposit and installment savings." },
    ],
    disclaimer: "This calculator is for reference only. Actual credit/refund varies with income composition, other deductions, and tax-law changes. Consult a professional for accuracy.",
  },
