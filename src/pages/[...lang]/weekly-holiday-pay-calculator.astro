---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WeeklyHolidayPayCalculator from "../../components/tools/WeeklyHolidayPayCalculator";
import ToolShell from "../../components/shared/_oiyo-shared/ToolShell.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { buildToolShell } from "../../lib/tool-shell";
import { siteConfig } from "../../config/site.config";
import { RATES, RATES_AS_OF, weeklyHolidayPay } from "../../lib/kr-payroll-2026";

// Korean only (2026-10-12): Korean labor law tool from the tax-practice toolkit plan
// (company-brain projects/oiyo-ecosystem/tax-practice-toolkit-plan-2026-10-12.md, item 1).
const PAGE_LOCALES = ["ko"] as const;

export async function getStaticPaths() {
  return [{ params: { lang: "ko" }, props: { locale: "ko" } }];
}
const locale = "ko";

const title = "주휴수당 계산기 2026 — 알바 주휴수당·주급·월급 환산";
const description = "시급과 주 근무일·하루 근무시간을 넣으면 주휴수당 대상 여부, 주휴수당, 주급과 월 환산액을 계산합니다. 2026년 최저임금 10,320원 기준.";

const sample = weeklyHolidayPay({ hourlyWage: RATES.minimumWage, daysPerWeek: 5, hoursPerDay: 4 });
const fullTime = weeklyHolidayPay({ hourlyWage: RATES.minimumWage, daysPerWeek: 5, hoursPerDay: 8 });
const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;

const ko = {
  eyebrow: "인건비 도구",
  introTitle: "주휴수당은 언제, 얼마나 주나요?",
  intro: `1주 소정근로시간이 15시간 이상이고 그 주에 정해진 날을 모두 일했다면, 일하지 않는 주휴일에도 하루치 임금을 줘야 합니다. 이것이 주휴수당입니다. 하루치는 주 40시간을 일하면 8시간이고, 그보다 적게 일하면 근로시간에 비례해 줄어듭니다. 예를 들어 2026년 최저임금 ${won(RATES.minimumWage)}으로 주 5일 하루 4시간을 일하면 주휴시간은 4시간, 주휴수당은 ${won(sample.holidayPay)}입니다. 주 40시간을 일하면 주휴수당은 ${won(fullTime.holidayPay)}이고, 흔히 말하는 최저 월급 209시간도 여기서 나옵니다. 근무 조건을 한 줄로 적거나 칸에 직접 넣으면 계산 과정과 함께 결과를 보여 줍니다.`,
  howToTitle: "사용 방법",
  steps: [
    "맨 위 칸에 \"주 5일 하루 4시간 시급 10320원\"처럼 한 줄로 적거나 예시를 누릅니다.",
    "채워진 시급·주 근무일·하루 근무시간을 확인하고 필요하면 고칩니다.",
    "주휴수당, 주급, 월 환산액과 \"어떻게 계산했나요?\"를 확인합니다.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "한 줄 입력", body: "문장으로 적으면 브라우저 안에서 읽어 칸을 채웁니다. 입력은 저장하거나 보내지 않습니다." },
    { title: "계산 과정 공개", body: "15시간 기준, 40시간 상한, 월 4.345주 환산을 단계별로 보여 줍니다." },
    { title: "최저임금 경고", body: `시급이 2026년 최저임금 ${won(RATES.minimumWage)}보다 낮으면 알려 줍니다.` },
  ],
  relatedTitle: "관련 도구",
  related: [
    { href: "/ko/daily-worker-insurance-checker/", label: "일용직·알바 4대보험 판정기", desc: "한 달 근무일·시간으로 가입 대상인지 봅니다." },
    { href: "/ko/salary-calculator/", label: "연봉 실수령액 계산기", desc: "4대보험과 소득세를 뺀 월급을 계산합니다." },
    { href: "/ko/severance-calculator/", label: "퇴직금 계산기", desc: "주 15시간 이상, 1년 이상 근무 시 퇴직금." },
  ],
  disclaimer: `일반적인 계산을 돕는 참고 도구입니다. 결근이 있는 주, 4주 평균 계산, 5인 미만 사업장 등 개별 사정은 고용노동부(1350) 안내를 확인하세요. 기준일 ${RATES_AS_OF}.`,
};

const faqs = [
  { q: "주 15시간 미만이면 주휴수당이 없나요?", a: "네. 근로기준법은 4주 평균 1주 소정근로시간이 15시간 미만인 근로자에게 주휴일 규정을 적용하지 않습니다(근로기준법 제18조 제3항)." },
  { q: "결근한 주에도 주휴수당을 주나요?", a: "그 주에 정해진 근로일을 모두 나오지 않았다면 그 주의 주휴수당은 발생하지 않습니다. 지각·조퇴는 결근이 아니라서 주휴수당에 영향을 주지 않습니다." },
  { q: "주 40시간 넘게 일하면 주휴수당도 늘어나나요?", a: "아니요. 주휴수당은 하루 8시간분이 상한입니다. 40시간을 넘는 시간은 연장근로로 따로 계산합니다(5인 이상 사업장은 50% 가산)." },
  { q: "월급 환산은 왜 4.345주로 하나요?", a: "1년 365일을 7일과 12개월로 나누면 한 달은 평균 4.345주입니다. 주 40시간 근무자의 주휴 포함 48시간에 이 값을 곱한 208.6시간을 올려 209시간으로 씁니다." },
  { q: "5인 미만 사업장도 주휴수당을 줘야 하나요?", a: "네. 주휴일(근로기준법 제55조)은 5인 미만 사업장에도 적용됩니다. 연장·야간·휴일 가산수당은 5인 미만 사업장에 적용되지 않습니다." },
];

const { content: c, faqHeading, faqItems } = buildToolShell({ en: ko, ko }, { en: faqs, ko: faqs }, locale);
---

<BaseLayout title={title} description={description} availableLocales={[...PAGE_LOCALES]}>
  <ToolShell title={title} description={description} siteUrl={siteConfig.url} locale={locale} slug="weekly-holiday-pay-calculator" content={c} applicationCategory="FinanceApplication">
    <div class="mx-auto max-w-2xl">
      <WeeklyHolidayPayCalculator client:load />
      <p class="mt-4 text-xs text-muted-foreground">근거: 근로기준법 제55조(휴일), 같은 법 시행령 제30조, 제18조 제3항(단시간 근로자). 2026년 최저임금 시간급 10,320원(2027년 10,700원). 기준일 {RATES_AS_OF}.</p>
    </div>
    <FaqAccordion slot="faq" heading={faqHeading} items={faqItems} />
  </ToolShell>
</BaseLayout>
