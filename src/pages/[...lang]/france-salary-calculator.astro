---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FranceSalaryCalculatorComp from "../../components/tools/FranceSalaryCalculator";
import { locales } from "../../lib/i18n";

type ActiveLocale = (typeof locales)[number];

type SeoContent = {
  introTitle: string;
  intro: string;
  formulaTitle: string;
  formulas: { title: string; body: string }[];
  howToTitle: string;
  steps: string[];
  faqTitle: string;
  faqs: { question: string; answer: string }[];
  disclaimer: string;
};

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  fr: {
    title: "Calculateur de salaire net France 2024 — Cotisations sociales et impôt sur le revenu",
    description: "Calculez votre salaire net en France : CSG/CRDS, retraite CNAV, AGIRC-ARRCO, impôt sur le revenu selon le barème 2024 et votre quotient familial.",
  },
  en: {
    title: "France Net Salary Calculator 2024 — Social Contributions & Income Tax",
    description: "Calculate your net salary in France: CSG/CRDS, CNAV pension, AGIRC-ARRCO, and income tax under the 2024 progressive scale with family quotient.",
  },
  ko: {
    title: "프랑스 급여 실수령액 계산기 2024",
    description: "프랑스 사회보험료 및 소득세를 자동 계산합니다.",
  },
  ja: {
    title: "フランス給与手取り計算機 2024",
    description: "フランスの社会保険料と所得税を自動計算します。",
  },
  es: {
    title: "Calculadora de salario neto Francia 2024",
    description: "Calcula tu salario neto en Francia con cotizaciones sociales e IRPF 2024.",
  },
  zh: {
    title: "法国薪资计算机 2024",
    description: "计算法国社会保险费及所得税后的净薪资。",
  },
};

const m = meta[locale] ?? meta.en;
const calcLocale = locale === 'fr' ? 'fr' : 'en';

const content: Record<ActiveLocale, SeoContent> = {
  ko: {
    introTitle: "프랑스 급여 실수령액 계산은 적용 국가의 제도를 먼저 확인해야 합니다",
    intro: "이 페이지는 프랑스 기준의 프랑스 급여 실수령액을 설명과 함께 계산합니다. 세율과 공제는 국가별로 다르고 매년 바뀔 수 있으므로, 결과는 신고 전 검토를 위한 출발점으로 보는 것이 안전합니다.",
    formulaTitle: "핵심 계산 기준",
    formulas: [{
      title: "기준 1",
      body: "CSG/CRDS 9.7%×98.25%, CNAV 6.9%, AGIRC-ARRCO T1 3.15%, T2 8.64%를 반영합니다."
    }, {
      title: "기준 2",
      body: "2024년 PASS 46,368유로를 연금 산정 상한으로 사용합니다."
    }, {
      title: "기준 3",
      body: "가족지수 parts로 나누어 0%, 11%, 30%, 41%, 45% 구간을 적용합니다."
    }],
    howToTitle: "사용 방법",
    steps: ["계산에 필요한 금액과 조건을 입력합니다.", "결과 카드의 세금·공제·부담액 항목을 나누어 확인합니다.", "신고·납부 또는 의사결정 전에 최신 공식 기준과 비교합니다."],
    faqTitle: "자주 묻는 질문",
    faqs: [{
      question: "이 계산기는 어느 나라 기준인가요?",
      answer: "프랑스 기준입니다. 다른 나라의 세율, 공제, 사회보험 구조에는 그대로 적용할 수 없습니다."
    }, {
      question: "실제 금액과 왜 다를 수 있나요?",
      answer: "직종, 단체협약, 공제, 세액공제, 원천징수율에 따라 달라질 수 있습니다."
    }, {
      question: "규칙은 매년 바뀌나요?",
      answer: "예. 세율, 공제 한도, 사회보험 요율은 매년 바뀔 수 있습니다. 신고나 납부 전에는 해당 연도의 공식 기준을 확인하세요."
    }],
    disclaimer: "이 계산기는 일반 추정용입니다. 실제 세액은 과세관청 안내 또는 세무 전문가를 통해 확인하세요."
  },
  en: {
    introTitle: "France net salary is country-specific",
    intro: "This page estimates France net salary under France rules. Because brackets, deductions, and social contributions are country-specific and can change yearly, use the result as a planning estimate before filing.",
    formulaTitle: "Core calculation rules",
    formulas: [{
      title: "Rule 1",
      body: "Reflects CSG/CRDS 9.7%×98.25%, CNAV 6.9%, AGIRC-ARRCO T1 3.15%, T2 8.64%."
    }, {
      title: "Rule 2",
      body: "Uses the 2024 PASS of EUR 46,368 for capped pension bases."
    }, {
      title: "Rule 3",
      body: "Divides income by family quotient parts and applies 0%, 11%, 30%, 41%, 45%."
    }],
    howToTitle: "How to use",
    steps: ["Enter the required amounts and conditions.", "Review the tax, deduction, and contribution lines separately.", "Compare with current official rules before filing, paying, or making a decision."],
    faqTitle: "Frequently asked questions",
    faqs: [{
      question: "Which country does this calculator use?",
      answer: "It uses France rules. Do not apply it directly to another country’s tax, deduction, or social insurance system."
    }, {
      question: "Why can the final amount differ?",
      answer: "Sector, collective agreement, deductions, credits, and withholding rate can change the amount."
    }, {
      question: "Do the rules change every year?",
      answer: "Yes. Tax rates, deduction limits, and social contribution rates can change each year. Confirm the current-year rules before filing or paying."
    }],
    disclaimer: "This is a general estimate. Confirm the final amount with the tax authority or a tax professional."
  },
  ja: {
    introTitle: "フランス給与手取りは国ごとの制度確認が必要です",
    intro: "このページはフランス基準のフランス給与手取りを説明付きで試算します。税率や控除は国ごとに異なり毎年変わるため、申告前の参考値として扱ってください。",
    formulaTitle: "主な計算基準",
    formulas: [{
      title: "基準 1",
      body: "CSG/CRDS 9.7%×98.25%、CNAV 6.9%、T1 3.15%、T2 8.64%。"
    }, {
      title: "基準 2",
      body: "2024年PASS 46,368ユーロを使います。"
    }, {
      title: "基準 3",
      body: "partsで割り0%、11%、30%、41%、45%を適用します。"
    }],
    howToTitle: "使い方",
    steps: ["必要な金額と条件を入力します。", "税金・控除・社会保険の内訳を確認します。", "申告・納付・判断前に最新の公式基準と照合します。"],
    faqTitle: "よくある質問",
    faqs: [{
      question: "どの国の制度を基準にしていますか？",
      answer: "フランスの制度です。他国の税率、控除、社会保険にはそのまま使えません。"
    }, {
      question: "実際の金額と異なる理由は？",
      answer: "職種、労働協約、控除、税額控除、源泉税率で変わります。"
    }, {
      question: "制度は毎年変わりますか？",
      answer: "はい。税率、控除限度、社会保険料率は毎年変わる可能性があります。申告や納付前に最新年度の基準を確認してください。"
    }],
    disclaimer: "この計算は一般的な概算です。実際の税額は税務当局または税理士に確認してください。"
  },
  zh: {
    introTitle: "法国到手薪资必须先确认适用国家的制度",
    intro: "本页依法国规则估算法国到手薪资。税率、扣除与社会保险具有国别差异且可能逐年变动，结果应作为申报前的初步参考。",
    formulaTitle: "主要计算基准",
    formulas: [{
      title: "规则 1",
      body: "CSG/CRDS 9.7%×98.25%、CNAV 6.9%、T1 3.15%、T2 8.64%。"
    }, {
      title: "规则 2",
      body: "使用2024年PASS 46,368欧元。"
    }, {
      title: "规则 3",
      body: "按parts拆分后套用0%、11%、30%、41%、45%。"
    }],
    howToTitle: "使用方法",
    steps: ["输入所需金额与条件。", "分别查看税金、扣除与社会保险明细。", "申报、缴纳或决策前请核对最新官方规定。"],
    faqTitle: "常见问题",
    faqs: [{
      question: "这个计算机采用哪个国家的规则？",
      answer: "采用法国规则，不能直接套用其他国家的税率、扣除或社会保险制度。"
    }, {
      question: "为什么可能和实际金额不同？",
      answer: "行业、集体协议、扣除、抵免与扣缴率会改变结果。"
    }, {
      question: "规则每年都会变吗？",
      answer: "会。税率、扣除上限与社会保险费率都可能按年度调整。申报或缴纳前请确认当年度官方规定。"
    }],
    disclaimer: "本工具仅为一般估算。实际税额请向税务机关或税务专业人士确认。"
  },
  fr: {
    introTitle: "Salaire net français dépend du pays concerné",
    intro: "Cette page estime le salaire net français selon les règles de la France. Les tranches, déductions et cotisations sont propres au pays et peuvent changer chaque année; utilisez le résultat comme point de départ.",
    formulaTitle: "Bases de calcul",
    formulas: [{
      title: "Règle 1",
      body: "CSG/CRDS 9,7%×98,25%, CNAV 6,9%, T1 3,15%, T2 8,64%."
    }, {
      title: "Règle 2",
      body: "PASS 2024 de 46 368 € pour certaines bases."
    }, {
      title: "Règle 3",
      body: "Revenu divisé par parts, puis 0%, 11%, 30%, 41%, 45%."
    }],
    howToTitle: "Comment l'utiliser",
    steps: ["Saisissez les montants et conditions nécessaires.", "Vérifiez séparément impôts, déductions et cotisations.", "Comparez avec les règles officielles avant déclaration, paiement ou décision."],
    faqTitle: "Questions fréquentes",
    faqs: [{
      question: "Quel pays sert de référence ?",
      answer: "Il utilise les règles de la France. Ne l’appliquez pas directement à un autre système fiscal ou social."
    }, {
      question: "Pourquoi le montant réel peut-il différer ?",
      answer: "Secteur, convention, déductions, crédits et taux de prélèvement peuvent changer."
    }, {
      question: "Les règles changent-elles chaque année ?",
      answer: "Oui. Les taux, plafonds de déduction et cotisations peuvent changer chaque année. Vérifiez l'année en vigueur avant de déclarer ou payer."
    }],
    disclaimer: "Ce calcul est une estimation générale. Confirmez le montant auprès de l'administration fiscale ou d'un fiscaliste."
  },
  es: {
    introTitle: "Salario neto francés depende del país aplicado",
    intro: "Esta página estima el salario neto francés con reglas de Francia. Los tramos, deducciones y cotizaciones son propios de cada país y pueden cambiar cada año; úsalo como estimación inicial.",
    formulaTitle: "Bases de cálculo",
    formulas: [{
      title: "Regla 1",
      body: "CSG/CRDS 9,7%×98,25%, CNAV 6,9%, T1 3,15%, T2 8,64%."
    }, {
      title: "Regla 2",
      body: "PASS 2024 de 46.368 € para bases topadas."
    }, {
      title: "Regla 3",
      body: "Renta dividida por parts, luego 0%, 11%, 30%, 41%, 45%."
    }],
    howToTitle: "Cómo usarla",
    steps: ["Introduce los importes y condiciones necesarios.", "Revisa por separado impuestos, deducciones y cotizaciones.", "Compáralo con reglas oficiales antes de declarar, pagar o tomar una decisión."],
    faqTitle: "Preguntas frecuentes",
    faqs: [{
      question: "¿Qué país usa esta calculadora?",
      answer: "Usa reglas de Francia. No lo apliques directamente a otro sistema fiscal o social."
    }, {
      question: "¿Por qué puede cambiar el importe final?",
      answer: "Sector, convenio, deducciones, créditos y retención pueden cambiar."
    }, {
      question: "¿Las reglas cambian cada año?",
      answer: "Sí. Los tipos, límites de deducción y cotizaciones pueden cambiar cada año. Comprueba la norma vigente antes de declarar o pagar."
    }],
    disclaimer: "Este cálculo es una estimación general. Confirma el importe con la autoridad fiscal o un profesional tributario."
  }
};

const c = content[locale] ?? content.en;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: m.title,
    description: m.description,
    step: c.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={m.title} description={m.description} availableLocales={[...locales]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <main class="mx-auto max-w-2xl px-4 py-8">
    <FranceSalaryCalculatorComp client:load locale={calcLocale} />
  

    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-bold text-slate-900">{c.introTitle}</h2>
      <p class="mt-4 leading-8 text-slate-700">{c.intro}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.formulaTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {c.formulas.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
        {c.steps.map((s) => (<li class="leading-7">{s}</li>))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">{c.faqTitle}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
        {c.faqs.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-8 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900">{c.disclaimer}</p>
  </main>
</BaseLayout>
