---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };
// lab/academy articles exist in ko/en only (#27)
const labLocale = locale === 'ko' ? 'ko' : 'en';

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "회계·재무 학습 허브 — 재무제표·비율분석·원가관리 도구 모음",
    description: "재무제표 분석기, CVP 손익분기점, CAPM·WACC 계산기, 분산분석 등 회계·재무 인터랙티브 도구를 한곳에서 만나보세요.",
  },
  en: {
    title: "Accounting & Finance Learning Hub",
    description: "Explore interactive tools for financial statements, CVP analysis, CAPM, WACC, and variance analysis.",
  },
  ja: {
    title: "会計・財務学習ハブ",
    description: "財務諸表分析、CVP分析、CAPM・WACC計算など会計・財務のインタラクティブツールを一覧できます。",
  },
  fr: {
    title: "Hub d'apprentissage Comptabilité et Finance",
    description: "Explorez les outils interactifs pour les états financiers, l'analyse CVP, le CAPM et le WACC.",
  },
  es: {
    title: "Hub de Aprendizaje Contabilidad y Finanzas",
    description: "Explora herramientas interactivas para estados financieros, análisis CVP, CAPM y WACC.",
  },
  zh: {
    title: "会计与财务学习中心",
    description: "探索财务报表分析、CVP分析、CAPM与WACC计算等互动工具。",
  },
};

interface ToolCard {
  title: string;
  description: string;
  href: string;
  badge: string;
}

const tools: ToolCard[] = [
  {
    title: "재무제표 분석기",
    description: "재무상태표·손익계산서·현금흐름표를 입력하면 유동비율·ROE·부채비율 등 8가지 핵심 비율을 자동 계산합니다.",
    href: `/${locale}/financial-statement-analyzer`,
    badge: "신규",
  },
  {
    title: "원가관리 인터랙티브 라보 (CVP)",
    description: "가격·변동원가·고정원가를 조정하며 손익분기점 구조를 시각적으로 학습합니다.",
    href: `/${labLocale}/magazine-education-accounting-lab`,
    badge: "인기",
  },
  {
    title: "분산분석 시뮬레이터",
    description: "표준원가 대비 실제원가의 차이를 가격·수량·효율 차이로 분해하는 분산분석 도구입니다.",
    href: `/${labLocale}/magazine-education-variance-lab`,
    badge: "",
  },
  {
    title: "CAPM & WACC 계산기",
    description: "자기자본비용(CAPM)과 가중평균자본비용(WACC)을 계산하는 고급 재무 도구입니다.",
    href: `/${labLocale}/magazine-education-finance-lab`,
    badge: "",
  },
  {
    title: "채권·포트폴리오 도구",
    description: "채권 가격·YTM·듀레이션 계산과 포트폴리오 리스크-수익 분석을 제공합니다.",
    href: `/${labLocale}/magazine-education-portfolio-lab`,
    badge: "",
  },
  {
    title: "투자 분석 도구 (DCF·IRR·NPV)",
    description: "현금흐름 할인, 내부수익률, 순현재가치 계산 — 투자 의사결정 지원 도구입니다.",
    href: `/${labLocale}/magazine-education-investment-lab`,
    badge: "",
  },
];

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 text-xs font-bold px-3 py-1 rounded-full mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
        </svg>
        회계·재무 학습 허브
      </div>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">재무제표·비율분석·원가관리 도구 모음</h1>
      <p class="text-sm text-slate-500 leading-relaxed">
        회계·재무 개념을 직접 조작하며 배우는 인터랙티브 도구들입니다. 이론 공부와 함께 활용하면 개념이 훨씬 빠르게 정착됩니다.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group flex flex-col gap-2 p-5 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500"
          aria-label={tool.title}
        >
          <div class="flex items-start justify-between gap-2">
            <h2 class="text-sm font-bold text-slate-800 group-hover:text-green-700 transition-colors leading-snug">{tool.title}</h2>
            {tool.badge && (
              <span class="shrink-0 text-[10px] font-bold bg-green-100 text-green-700 px-2 py-0.5 rounded-full">{tool.badge}</span>
            )}
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">{tool.description}</p>
          <div class="mt-auto pt-1 flex items-center gap-1 text-xs font-bold text-green-600">
            <span>열기</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  @media (prefers-reduced-motion: reduce) {
    a { transition: none !important; }
    a:hover { transform: none !important; }
  }
</style>
