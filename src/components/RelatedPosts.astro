---
import { getCollection } from "astro:content";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import {
  NEXT_READ_LABELS,
  RELATED_POST_LABELS,
  resolveCuratedPosts,
  scoreRelatedPosts,
} from "../lib/related-next";

interface Props {
  currentSlug?: string;
  tags?: string[];
  category?: string;
  locale?: string;
  maxItems?: number;
  /** Locale-free post slugs for curated landing CTAs. */
  slugs?: string[];
  /** Override section heading. */
  heading?: string;
  /** "next" uses "Next read" wording for pages/session CTAs. */
  variant?: "related" | "next";
}

const {
  currentSlug,
  tags = [],
  category,
  locale = "en",
  maxItems = 3,
  slugs,
  heading,
  variant = "related",
} = Astro.props;

const allPosts = await getCollection("blog", (post) => !post.data.draft);

const scored =
  slugs && slugs.length > 0
    ? resolveCuratedPosts(allPosts, locale, slugs, maxItems)
    : scoreRelatedPosts(allPosts, { locale, currentSlug, tags, category, maxItems });

const hasResults = scored.length > 0;

const t = await getTranslations(locale as Locale);
const categoryNames = (t.category.names ?? {}) as Record<string, string>;

const labelMap = variant === "next" ? NEXT_READ_LABELS : RELATED_POST_LABELS;
const label = heading ?? labelMap[locale] ?? labelMap.en;
---

{hasResults && (
<section class="mt-12 pt-10 border-t border-border/40 not-prose" data-cta="related-posts" data-variant={variant}>
  <h3 class="text-sm font-bold uppercase tracking-widest text-muted-foreground mb-5">{label}</h3>
  <div class="grid gap-4 sm:grid-cols-3">
    {scored.map((post) => {
      const parts = post.slug.split("/");
      const slug = parts.slice(1).join("/");
      const postLocale = parts[0];
      return (
        <a
          href={`/${postLocale}/${slug}/`}
          class="group block rounded-xl border border-border/60 bg-card p-4 hover:border-primary/50 hover:bg-primary/5 transition-colors"
        >
          {post.data.category && (
            <span class="text-[10px] font-bold uppercase tracking-wider text-primary/70 mb-1 block">
              {categoryNames[post.data.category] ?? post.data.category}
            </span>
          )}
          <p class="font-semibold text-sm leading-snug group-hover:text-primary transition-colors line-clamp-3">
            {post.data.title}
          </p>
          {post.data.pubDate && (
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-[11px] text-muted-foreground mt-2 block"
            >
              {post.data.pubDate.toLocaleDateString(postLocale, { year: "numeric", month: "short", day: "numeric" })}
            </time>
          )}
        </a>
      );
    })}
  </div>
</section>
)}
