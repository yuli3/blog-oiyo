---
/**
 * ToolShell — canonical shared tool/calculator page scaffold (SSOT: /coding/shared/components).
 * Synced into each repo by shared/sync.sh. Do NOT edit synced copies.
 *
 * Renders the standard SEO-rich shell for a tool page: hero, interactive <slot/>,
 * intro, HowTo steps, highlights, related links, disclaimer + WebApplication/HowTo/
 * BreadcrumbList JSON-LD. Pair with FaqAccordion for the FAQ section (it emits the
 * FAQPage JSON-LD), keeping each concern in one component.
 *
 * Portable: depends only on shared design tokens (olive-green system): background,
 * card, border, foreground, muted-foreground, primary, accent. No hardcoded colors,
 * no shadows (the system disables them). siteUrl is passed in so it works in any repo.
 */
interface ToolCard { title: string; body: string }
interface ToolLink { href: string; label: string; desc: string }
export interface ToolShellContent {
  eyebrow: string;
  introTitle: string;
  intro: string;
  howToTitle: string;
  steps: string[];
  highlightsTitle: string;
  highlights: ToolCard[];
  relatedTitle: string;
  related: ToolLink[];
  disclaimer: string;
}
interface Props {
  title: string;
  description: string;
  siteUrl: string;          // e.g. https://blog.oiyo.net (no trailing slash)
  locale: string;
  slug: string;             // path after /{locale}/ (no leading/trailing slash)
  content: ToolShellContent;
  applicationCategory?: string;
  toolsLabel?: string;      // breadcrumb root label
  toolsPath?: string;       // breadcrumb root path segment (default "tools")
}
const {
  title, description, siteUrl, locale, slug, content,
  applicationCategory = "UtilityApplication",
  toolsLabel = "Tools",
  toolsPath = "tools",
} = Astro.props as Props;

const base = siteUrl.replace(/\/$/, "");
const pageUrl = `${base}/${locale}/${slug}/`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      name: title,
      url: pageUrl,
      applicationCategory,
      operatingSystem: "Web",
      description,
      isAccessibleForFree: true,
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      name: content.howToTitle,
      step: content.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, text: step })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: toolsLabel, item: `${base}/${locale}/${toolsPath}/` },
        { "@type": "ListItem", position: 2, name: title, item: pageUrl },
      ],
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

<div class="mx-auto max-w-3xl px-4 py-8">
  <section class="mb-8 rounded-lg border border-border bg-card p-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">{content.eyebrow}</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-foreground">{title}</h1>
    <p class="mt-4 leading-8 text-muted-foreground">{description}</p>
  </section>

  <slot />

  <section class="mt-10 border-t border-border pt-8">
    <h2 class="text-2xl font-bold text-foreground">{content.introTitle}</h2>
    <p class="mt-4 leading-8 text-muted-foreground">{content.intro}</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-foreground">{content.howToTitle}</h2>
    <ol class="mt-4 grid gap-3">
      {content.steps.map((step, i) => (
        <li class="flex gap-3 rounded-lg border border-border bg-card p-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
            {i + 1}
          </span>
          <span class="leading-7 text-muted-foreground">{step}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-foreground">{content.highlightsTitle}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {content.highlights.map((item) => (
        <article class="rounded-lg bg-accent p-4">
          <h3 class="font-semibold text-foreground">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <slot name="faq" />

  <section class="mt-10">
    <h2 class="text-xl font-bold text-foreground">{content.relatedTitle}</h2>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {content.related.map((item) => (
        <a class="rounded-lg border border-border bg-card p-4 transition-colors hover:border-primary" href={item.href}>
          <span class="font-semibold text-foreground">{item.label}</span>
          <span class="mt-2 block text-sm leading-6 text-muted-foreground">{item.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <p class="mt-10 rounded-lg bg-muted p-4 text-sm leading-6 text-muted-foreground">
    {content.disclaimer}
  </p>
</div>
