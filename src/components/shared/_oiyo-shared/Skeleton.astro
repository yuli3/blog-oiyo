---
/**
 * Skeleton — canonical shared component (SSOT: /coding/shared/components).
 * Synced into each repo by shared/sync.sh. Do NOT edit synced copies.
 *
 * Preset-shape loading placeholder (text line, card, avatar, button).
 * Composes Shimmer.astro for the animated sweep effect.
 */
import Shimmer from "./Shimmer.astro";

interface Props {
  variant?: "avatar" | "button" | "card" | "text";
  class?: string;
}
const { variant = "text", class: className = "" } = Astro.props as Props;

const variants: Record<string, string> = {
  avatar: "h-12 w-12 rounded-full",
  button: "h-10 w-24 rounded-md",
  card: "h-48 w-full rounded-xl",
  text: "h-4 w-full rounded-md",
};
---

<Shimmer class:list={[variants[variant], className]} />
