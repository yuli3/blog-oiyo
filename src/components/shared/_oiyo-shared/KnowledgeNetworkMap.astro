---
/**
 * KnowledgeNetworkMap — canonical shared component (SSOT: /coding/shared/components).
 * Synced into each repo by shared/sync.sh. Do NOT edit synced copies.
 *
 * Compact map for the Oiyo canonical-route knowledge network. It keeps the first
 * read simple, then exposes detail through native no-JS <details> blocks.
 */
interface Layer {
  role: string;
  title: string;
  href: string;
  summary: string;
  details?: string;
  catalogs?: { label: string; href: string }[];
  current?: boolean;
}
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  layers: Layer[];
}

const { eyebrow, heading, intro, layers = [] } = Astro.props as Props;
---

{layers.length > 0 && (
  <section class="my-12" aria-labelledby="knowledge-network-map-title">
    {eyebrow && <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">{eyebrow}</p>}
    <div class="mb-6 max-w-2xl">
      <h2 id="knowledge-network-map-title" class="text-2xl font-bold tracking-tight">{heading}</h2>
      {intro && <p class="mt-2 text-sm leading-6 text-muted-foreground">{intro}</p>}
    </div>

    <ol class="grid gap-3 md:grid-cols-3" aria-label="Oiyo knowledge network layers">
      {layers.map((layer, index) => (
        <li class:list={[
          "relative border border-border rounded-lg bg-card p-5",
          layer.current ? "ring-1 ring-primary/50" : "",
        ]}>
          {index < layers.length - 1 && (
            <span class="pointer-events-none absolute -right-3 top-8 z-10 hidden h-6 w-6 items-center justify-center rounded-full border border-border bg-background text-xs font-bold text-primary md:flex" aria-hidden="true">
              -&gt;
            </span>
          )}
          <p class="text-[10px] font-bold uppercase tracking-widest text-primary">{layer.role}</p>
          <a href={layer.href} class="mt-2 inline-flex font-bold text-foreground underline-offset-4 hover:text-primary hover:underline">
            {layer.title}
          </a>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">{layer.summary}</p>

          {(layer.details || (layer.catalogs?.length ?? 0) > 0) && (
            <details class="group mt-4 border-t border-border pt-3">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-xs font-bold uppercase tracking-widest text-muted-foreground">
                <span>Read more</span>
                <span class="text-primary transition-transform duration-150 group-open:rotate-45">+</span>
              </summary>
              {/*
                긴 설명은 **자기 계층에서만** 낸다. 세 사이트의 /knowledge 가 모든 계층의
                details 를 똑같이 렌더하는 바람에 blog·wiki 본문이 65% 겹쳤다(2026-08-11 실측).
                각자 다른 데이터 카탈로그를 노출하는 페이지라 canonical 통합은 틀린 처방이고,
                중복의 원인은 이 공유 산문이었다. 링크·요약·카탈로그는 그대로 두어 지도로서의
                가치와 내부 링크는 유지한다.
              */}
              {layer.current && layer.details && (
                <p class="mt-3 text-sm leading-6 text-muted-foreground">{layer.details}</p>
              )}
              {(layer.catalogs?.length ?? 0) > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {layer.catalogs?.map((catalog) => (
                    <a href={catalog.href} class="rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground hover:border-primary hover:text-primary">
                      {catalog.label}
                    </a>
                  ))}
                </div>
              )}
            </details>
          )}
        </li>
      ))}
    </ol>
  </section>
)}
