---
/**
 * Spinner — canonical shared component (SSOT: /coding/shared/components).
 * Synced into each repo by shared/sync.sh. Do NOT edit synced copies.
 *
 * CSS-only rotating loading indicator (Tailwind's animate-spin). No icon
 * library dependency — portable across every repo regardless of installed
 * icon set. Use inline in buttons or centered for page/section loading.
 */
interface Props {
  size?: "lg" | "md" | "sm";
  class?: string;
  label?: string;
}
const { size = "md", class: className = "", label = "Loading" } = Astro.props as Props;

const sizes: Record<string, string> = {
  lg: "h-10 w-10 border-[3px]",
  md: "h-6 w-6 border-2",
  sm: "h-4 w-4 border-2",
};
---

<span
  class:list={[
    "inline-block animate-spin rounded-full border-current border-t-transparent text-primary",
    sizes[size],
    className,
  ]}
  role="status"
  aria-label={label}
/>
