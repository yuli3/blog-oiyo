---
/**
 * Shimmer — canonical shared component (SSOT: /coding/shared/components).
 * Synced into each repo by shared/sync.sh. Do NOT edit synced copies.
 *
 * Base loading-placeholder effect: an animated gradient sweep over a muted
 * block. Skeleton.astro composes this with preset shapes; use Shimmer
 * directly for one-off placeholder shapes Skeleton doesn't cover.
 * Depends on the `.oiyo-shimmer` utility class + `bg-muted` token, both
 * defined once in each repo's global.css (shared with the React Skeleton.tsx
 * / Spinner.tsx counterparts so the animation stays identical everywhere).
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props as Props;
---

<div class:list={["oiyo-shimmer bg-muted", className]} />
