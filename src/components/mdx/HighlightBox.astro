---
// 색은 Tailwind 팔레트가 아니라 시맨틱 토큰에서 가져온다. 이전 판의
// `bg-green-500/10` · `text-green-900` 은 테마를 바꿔도 따라오지 않고, 무엇보다
// **본문 글자색을 진한 초록으로 고정**해 상자 안 글이 바깥과 다른 색으로 읽혔다.
// 지면 색만 톤을 주고 글자는 `text-foreground` 로 둔다.

interface Props {
  type?: "abstract" | "insight" | "info" | string;
  title?: string;
}

const { type = "info", title } = Astro.props;

const typeStyles = {
  abstract: "bg-primary/5 border-primary/20",
  insight: "bg-warning/10 border-warning/25",
  info: "bg-muted/30 border-border/40",
};

const currentStyle =
  typeStyles[type as keyof typeof typeStyles] || typeStyles.info;
---

<div
  class:list={[
    "my-5 p-4 sm:my-8 sm:p-6 rounded-2xl border backdrop-blur-sm animate-fade-up text-foreground",
    currentStyle,
  ]}
>
  {
    title && (
      <div class="font-bold text-sm tracking-widest uppercase mb-4 opacity-70">
        {title}
      </div>
    )
  }
  <div class="prose-sm max-w-none [&>p]:last:mb-0">
    <slot />
  </div>
</div>
