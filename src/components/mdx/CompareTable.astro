---
/**
 * CompareTable — 두 개념의 비교/대조 표
 * 또는 headers + 행 배열을 넘긴 일반 표.
 *
 * Props (비교):
 *   leftTitle, rightTitle, rows: [{ label, left, right }]
 * Props (격자):
 *   headers: string[]
 *   rows: string[][]
 */
import { inlineMd } from "../../lib/utils";
import { isGridCompareTable, type CompareObjectRow } from "./compare-table-mode";

interface Props {
  title?: string;
  leftTitle?: string;
  rightTitle?: string;
  headers?: string[];
  rows: CompareObjectRow[] | string[][];
  leftColor?: string;
  rightColor?: string;
}

const {
  title,
  leftTitle,
  rightTitle,
  headers,
  rows,
  leftColor = "#3b82f6",
  rightColor = "#f59e0b",
} = Astro.props;

const grid = isGridCompareTable(headers, rows);
const compareRows = grid ? [] : (rows as CompareObjectRow[]);
---

{grid ? (
  <div class="edu-compare-table">
    {title && <div class="edu-compare-table__title" set:html={inlineMd(title)} />}
    <div class="edu-compare-table__scroll">
    <table>
      <thead>
        <tr>
          {headers!.map((h) => (
            <th set:html={inlineMd(h)} />
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => (
          <tr class={i % 2 === 0 ? "even" : "odd"}>
            {row.map((cell, j) => (
              <td class={j === 0 ? "edu-compare-table__label" : undefined} set:html={inlineMd(cell)} />
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
) : (
  <div class="edu-compare-table">
    {title && <div class="edu-compare-table__title" set:html={inlineMd(title)} />}
    <div class="edu-compare-table__scroll">
    <table>
      <thead>
        <tr>
          <th class="edu-compare-table__label-header">구분</th>
          <th style={`border-top: 3px solid ${leftColor}; color: ${leftColor};`}
            set:html={inlineMd(leftTitle ?? "")}
          ></th>
          <th style={`border-top: 3px solid ${rightColor}; color: ${rightColor};`}
            set:html={inlineMd(rightTitle ?? "")}
          ></th>
        </tr>
      </thead>
      <tbody>
        {
          compareRows.map((row, i) => (
            <tr class={i % 2 === 0 ? "even" : "odd"}>
              <td class="edu-compare-table__label" set:html={inlineMd(row.label)} />
              <td class="edu-compare-table__left" set:html={inlineMd(row.left)} />
              <td class="edu-compare-table__right" set:html={inlineMd(row.right)} />
            </tr>
          ))
        }
      </tbody>
    </table>
    </div>
  </div>
)}

<style>
  .edu-compare-table {
    margin: 1.5rem 0;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
    font-size: 0.95rem;
  }
  .edu-compare-table__title {
    padding: 1rem 1.5rem;
    font-weight: 700;
    font-size: 1.05rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #0f172a;
  }
  /* 래퍼는 라운드 유지를 위해 overflow:hidden 이라, 표는 안쪽에서 스크롤한다.
     이전에는 넘치는 열이 잘려서 아예 읽을 수 없었다(2026-09-10 375px 실측). */
  .edu-compare-table__scroll {
    overflow-x: auto;
    background:
      linear-gradient(to right, #fff 30%, transparent),
      linear-gradient(to right, transparent, #fff 70%) 100% 0,
      radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, 0.12), transparent),
      radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, 0.12), transparent) 100% 0;
    background-repeat: no-repeat;
    background-size: 40px 100%, 40px 100%, 14px 100%, 14px 100%;
    background-attachment: local, local, scroll, scroll;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    padding: 0.9rem 1.25rem;
    background: #f1f5f9;
    font-weight: 700;
    text-align: center;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  .edu-compare-table__label-header {
    background: #e2e8f0;
    color: #475569;
    width: 22%;
  }
  td {
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid #f1f5f9;
    line-height: 1.6;
    color: #334155;
    vertical-align: top;
  }
  .edu-compare-table__label {
    font-weight: 700;
    color: #0f172a;
    background: #f8fafc;
    font-size: 0.85rem;
  }
  .even td {
    background: #fff;
  }
  .odd td {
    background: #fafcff;
  }
  .edu-compare-table__left {
    border-left: 2px solid #dbeafe;
  }
  .edu-compare-table__right {
    border-left: 1px solid #fde68a;
  }
  tr:hover td {
    background: #f0f9ff;
    transition: background 0.2s;
  }

  /* 모바일: 셀 좌우 패딩 1.25rem 은 375px 에서 3열 기준 가용폭의 40% 를
     패딩으로 쓴다. 먼저 패딩을 줄이고, 그래도 넘치면 위의 스크롤로 넘긴다. */
  @media (max-width: 480px) {
    .edu-compare-table {
      font-size: 0.9rem;
    }
    .edu-compare-table__title {
      padding: 0.75rem 0.875rem;
      font-size: 1rem;
    }
    th {
      padding: 0.65rem 0.6rem;
      font-size: 0.8rem;
    }
    td {
      padding: 0.65rem 0.6rem;
    }
    .edu-compare-table__label {
      font-size: 0.8rem;
    }
  }
</style>
