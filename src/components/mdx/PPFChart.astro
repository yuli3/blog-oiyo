---
/**
 * PPFChart — 생산가능곡선 (Production Possibility Frontier, SVG)
 * Props:
 *   title       - 차트 제목
 *   goodX       - X축 재화명 (default: "재화 X")
 *   goodY       - Y축 재화명 (default: "재화 Y")
 *   showShift   - 경제 성장(외향 이동) 표시 (default: false)
 *   showPoints  - 효율점/비효율점/불가능점 표시 (default: true)
 *   caption     - 하단 설명
 */
interface Props {
  title?: string;
  goodX?: string;
  goodY?: string;
  showShift?: boolean;
  showPoints?: boolean;
  caption?: string;
}

const {
  title = "생산가능곡선 (PPF)",
  goodX = "재화 X",
  goodY = "재화 Y",
  showShift = false,
  showPoints = true,
  caption,
} = Astro.props;

const W = 400;
const H = 360;
const PAD = { top: 30, right: 40, bottom: 60, left: 60 };
const cW = W - PAD.left - PAD.right;
const cH = H - PAD.top - PAD.bottom;

const px = (x: number) => PAD.left + (x / 100) * cW;
const py = (y: number) => PAD.top + cH - (y / 100) * cH;

// Concave PPF curve points (increasing opportunity cost)
const ppfPts = [
  { x: 0, y: 100 },
  { x: 15, y: 98 },
  { x: 30, y: 93 },
  { x: 45, y: 84 },
  { x: 60, y: 70 },
  { x: 73, y: 52 },
  { x: 83, y: 32 },
  { x: 90, y: 16 },
  { x: 95, y: 5 },
  { x: 100, y: 0 },
];

// Outward shifted PPF (economic growth)
const ppfShiftedPts = ppfPts.map(p => ({
  x: Math.min(100, p.x * 1.18),
  y: Math.min(100, p.y * 1.18),
}));

function curvePath(pts: { x: number; y: number }[]): string {
  if (pts.length < 2) return "";
  let d = `M ${px(pts[0].x)} ${py(pts[0].y)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const x1 = px(pts[i].x);     const y1 = py(pts[i].y);
    const x2 = px(pts[i + 1].x); const y2 = py(pts[i + 1].y);
    const cpx = (x1 + x2) / 2;
    d += ` C ${cpx} ${y1}, ${cpx} ${y2}, ${x2} ${y2}`;
  }
  return d;
}

// Key points
const pointEfficient = { x: 60, y: 70, label: "A (효율)", color: "#22c55e" };
const pointInefficient = { x: 35, y: 45, label: "B (비효율)", color: "#f59e0b" };
const pointUnattainable = { x: 78, y: 85, label: "C (불가능)", color: "#ef4444" };

const ticks = [0, 20, 40, 60, 80, 100];
---

<div class="edu-chart-wrap">
  {title && <div class="edu-chart-title">{title}</div>}
  <div class="edu-chart-body">
    <svg viewBox={`0 0 ${W} ${H}`} style={`max-width:${W}px; width:100%;`} aria-label={title}>

      <!-- Grid -->
      {ticks.map(v => (
        <>
          <line x1={PAD.left} y1={py(v)} x2={PAD.left + cW} y2={py(v)} stroke="#f1f5f9" stroke-width="1"/>
          <line x1={px(v)} y1={PAD.top} x2={px(v)} y2={PAD.top + cH} stroke="#f1f5f9" stroke-width="1"/>
        </>
      ))}

      <!-- Unattainable region shading -->
      {showPoints && (
        <circle cx={px(pointUnattainable.x)} cy={py(pointUnattainable.y)} r="18" fill="#ef4444" fill-opacity="0.07"/>
      )}

      <!-- Attainable region shading (inside PPF) -->
      <path d={`${curvePath(ppfPts)} L ${px(0)} ${py(0)} L ${px(0)} ${py(100)}`} fill="#3b82f6" fill-opacity="0.06"/>

      <!-- Shifted PPF -->
      {showShift && (
        <>
          <path d={curvePath(ppfShiftedPts)} fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="7,4" stroke-linecap="round"/>
          <text x={px(87)} y={py(19)} font-size="11" font-weight="700" fill="#64748b">PPF'</text>
          <!-- Growth arrow -->
          <defs>
            <marker id="ppfArrow" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
              <polygon points="0 0, 8 3, 0 6" fill="#94a3b8"/>
            </marker>
          </defs>
          <line x1={px(70)} y1={py(60)} x2={px(80)} y2={py(68)} stroke="#94a3b8" stroke-width="1.5" marker-end="url(#ppfArrow)"/>
        </>
      )}

      <!-- Main PPF curve -->
      <path d={curvePath(ppfPts)} fill="none" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>
      <text x={px(96)} y={py(4) - 8} text-anchor="middle" font-size="12" font-weight="700" fill="#2563eb">PPF</text>

      <!-- Key points -->
      {showPoints && (
        <>
          <!-- A: on PPF (efficient) -->
          <circle cx={px(pointEfficient.x)} cy={py(pointEfficient.y)} r="5" fill={pointEfficient.color} stroke="#fff" stroke-width="2"/>
          <text x={px(pointEfficient.x) + 8} y={py(pointEfficient.y) - 6} font-size="10" font-weight="700" fill={pointEfficient.color}>{pointEfficient.label}</text>

          <!-- B: inside PPF (inefficient) -->
          <circle cx={px(pointInefficient.x)} cy={py(pointInefficient.y)} r="5" fill={pointInefficient.color} stroke="#fff" stroke-width="2"/>
          <text x={px(pointInefficient.x) + 8} y={py(pointInefficient.y) - 6} font-size="10" font-weight="700" fill={pointInefficient.color}>{pointInefficient.label}</text>

          <!-- C: outside PPF (unattainable) -->
          <circle cx={px(pointUnattainable.x)} cy={py(pointUnattainable.y)} r="5" fill={pointUnattainable.color} stroke="#fff" stroke-width="2"/>
          <text x={px(pointUnattainable.x) + 8} y={py(pointUnattainable.y) - 6} font-size="10" font-weight="700" fill={pointUnattainable.color}>{pointUnattainable.label}</text>
        </>
      )}

      <!-- Axes -->
      <line x1={PAD.left} y1={PAD.top} x2={PAD.left} y2={PAD.top + cH + 10} stroke="#334155" stroke-width="2" stroke-linecap="round"/>
      <line x1={PAD.left - 10} y1={PAD.top + cH} x2={PAD.left + cW} y2={PAD.top + cH} stroke="#334155" stroke-width="2" stroke-linecap="round"/>

      <!-- Axis labels -->
      <text x={PAD.left + cW / 2} y={H - 10} text-anchor="middle" font-size="12" fill="#64748b" font-weight="600">{goodX}</text>
      <text x={14} y={PAD.top + cH / 2} text-anchor="middle" font-size="12" fill="#64748b" font-weight="600" transform={`rotate(-90, 14, ${PAD.top + cH / 2})`}>{goodY}</text>

    </svg>

    {showPoints && (
      <div class="edu-chart-legend">
        <div class="edu-chart-legend-item"><span class="edu-chart-legend-dot" style="background:#22c55e"></span><span>A — 효율적 생산점 (PPF 위)</span></div>
        <div class="edu-chart-legend-item"><span class="edu-chart-legend-dot" style="background:#f59e0b"></span><span>B — 비효율적 생산점 (PPF 내부)</span></div>
        <div class="edu-chart-legend-item"><span class="edu-chart-legend-dot" style="background:#ef4444"></span><span>C — 달성 불가능점 (PPF 외부)</span></div>
      </div>
    )}
  </div>
  {caption && <p class="edu-chart-caption">{caption}</p>}
</div>

<style>
  .edu-chart-wrap { margin:2.5rem 0; background:#fff; border:1px solid #e2e8f0; border-radius:1rem; padding:1.5rem; box-shadow:0 4px 16px rgba(0,0,0,.06); }
  .edu-chart-title { font-weight:700; font-size:1rem; color:#1e293b; margin-bottom:1.25rem; text-align:center; }
  .edu-chart-body { display:flex; flex-direction:column; align-items:center; gap:1rem; }
  .edu-chart-legend { display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; justify-content:center; }
  .edu-chart-legend-item { display:flex; align-items:center; gap:.5rem; font-size:.78rem; color:#475569; font-weight:600; }
  .edu-chart-legend-dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
  .edu-chart-caption { font-size:.78rem; color:#64748b; text-align:center; margin-top:.75rem; font-style:italic; }
</style>
