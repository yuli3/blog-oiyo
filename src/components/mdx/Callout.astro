---
// 본문 강조 상자.
//
// 이 컴포넌트는 오랫동안 **props 를 하나도 받지 않았다.** 그런데 본문에서는
// 1,444번 쓰이면서 그중 1,384번이 종류를 넘기고 있었다 — tip 572 · warning 263 ·
// note 209 · info 199 · important 135 · success 6. 전부 조용히 버려지고 파란 테두리
// 하나로 똑같이 그려졌다. 글쓴이가 경고로 쓴 것이 경고로 보이지 않았다.
//
// 색은 하드코딩하지 않고 시맨틱 토큰을 쓴다(`--warning`·`--success`·`--info`·
// `--destructive`). 이전 판의 `#f8fafc`·`#3b82f6`·`#1e293b` 는 토큰 감사의
// "토큰 밖 사용" 예산을 갉아먹고 있었고, 테마를 바꿔도 따라오지 않았다.
//
interface Props {
  type?: string;
  title?: string;
}

const { type, title } = Astro.props;

// 이름은 여섯이지만 세기는 다섯이다. 이름마다 색을 하나씩 주면 본문이
// 색 카탈로그가 된다.
//   note       → 조용함. 곁들이는 설명
//   info       → 중립. 알아 둘 것
//   tip        → 강조. 도움이 되는 요령
//   warning    → 주의
//   important  → 강한 주의. 틀리면 손해가 나는 것
//   success    → 확인·완료
const TONES = {
  note: "border-l-border bg-muted/40",
  info: "border-l-info bg-info/5",
  tip: "border-l-primary bg-primary/5",
  warning: "border-l-warning bg-warning/10",
  important: "border-l-destructive bg-destructive/5",
  success: "border-l-success bg-success/5",
} as const;

const key = (type ?? "note").toLowerCase();
const tone = TONES[key as keyof typeof TONES] ?? TONES.note;
---

<aside
  class:list={[
    "my-6 rounded-r-lg border-l-4 border-y border-r border-border/40 bg-card",
    "px-5 py-4 text-[1.02em] leading-relaxed text-foreground",
    tone,
  ]}
>
  {
    title && (
      <p class="mb-2 text-sm font-semibold tracking-wide text-foreground/80">
        {title}
      </p>
    )
  }
  <div class="[&>:first-child]:mt-0 [&>:last-child]:mb-0">
    <slot />
  </div>
</aside>
