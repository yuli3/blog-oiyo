---
/**
 * FormulaBox — 수식/공식 강조 블록
 *
 * LaTeX 명령(\frac, \delta …)이나 첨자(^, _)가 있으면 KaTeX 로 조판한다.
 * 2026-09-24 전까지는 문자열을 그대로 찍어 `s f(k^*)=(\delta+n)k^*` 가 날것으로
 * 보였다. "순자산 − 자본금" 같은 말로 된 공식은 지금처럼 글자로 둔다.
 * 수식 안의 한글은 \text{} 로 감싼다. 조판 실패는 빨간 글씨로 남아
 * `npm run audit:katex` 가 잡는다(throwOnError: false).
 *
 * Props:
 *   formula     - 수식 텍스트 (메인 표시)
 *   label       - 공식 이름 (optional)
 *   description - 설명 (optional)
 *   color       - 강조 색 (optional)
 */
interface Props {
  formula: string;
  label?: string;
  description?: string;
  color?: string;
}

import katex from "katex";

const { formula, label, description, color = "#3b82f6" } = Astro.props;
const isTex = /\\[a-zA-Z]|[\^_]/.test(formula);
const texHtml = isTex
  ? katex.renderToString(
      formula.replace(/[가-힣]+(?:[\s·][가-힣]+)*/g, (run) => `\\text{${run}}`),
      { displayMode: true, throwOnError: false, strict: "ignore" },
    )
  : null;
---

<div class="edu-formula-box" style={`border-left-color: ${color};`}>
  {
    label && (
      <div class="edu-formula-box__label" style={`color: ${color};`}>
        {label}
      </div>
    )
  }
  {texHtml
    ? <div class="edu-formula-box__formula edu-formula-box__formula--tex" set:html={texHtml} />
    : <div class="edu-formula-box__formula">{formula}</div>}
  {description && <div class="edu-formula-box__description">{description}</div>}
</div>

<style>
  .edu-formula-box {
    margin: 2rem 0;
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
    border-left: 5px solid #3b82f6;
    border-radius: 0 0.75rem 0.75rem 0;
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.08);
  }
  .edu-formula-box__label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .edu-formula-box__formula {
    font-family: "Georgia", "Times New Roman", serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #1e293b;
    letter-spacing: 0.03em;
    margin: 0.25rem 0;
    line-height: 1.8;
  }
  /* KaTeX 조판본: 폭이 좁은 화면에서 페이지가 아니라 이 칸만 가로로 밀린다. */
  .edu-formula-box__formula--tex {
    font-family: inherit;
    font-weight: 400;
    letter-spacing: normal;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .edu-formula-box__formula--tex :global(.katex-display) {
    margin: 0.25rem 0;
    /* 전역 .katex-display 의 스크롤 그림자 가리개는 페이지 배경색이라, 푸른 상자
       안에서는 회색 블록으로 보인다. 상자 안에서는 끈다(가로 스크롤은 그대로). */
    background: none;
  }
  .edu-formula-box__description {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.6;
    border-top: 1px solid #e2e8f0;
    padding-top: 0.75rem;
  }
</style>
