---
/**
 * PolicyCycle — 정책 과정 순환 다이어그램 (행정학, SVG)
 * Props:
 *   title    - 차트 제목
 *   steps    - 단계 배열 [{ label, description?, color?, icon? }]
 *              default: 5단계 정책과정 (의제설정 → 결정 → 집행 → 평가 → 환류)
 *   caption  - 하단 설명
 */
interface PolicyStep {
  label: string;
  description?: string;
  color?: string;
  icon?: string;
}

interface Props {
  title?: string;
  steps?: PolicyStep[];
  caption?: string;
}

const {
  title = "정책 과정 (Policy Cycle)",
  steps,
  caption,
} = Astro.props;

const defaultSteps: PolicyStep[] = [
  { label: "의제설정", description: "Agenda Setting",  color: "#8b5cf6", icon: "📋" },
  { label: "정책결정", description: "Policy Making",   color: "#3b82f6", icon: "⚖️" },
  { label: "정책집행", description: "Implementation",  color: "#22c55e", icon: "🏛️" },
  { label: "정책평가", description: "Evaluation",      color: "#f59e0b", icon: "📊" },
  { label: "환류·수정", description: "Feedback",       color: "#ef4444", icon: "🔄" },
];

const stepsData = steps ?? defaultSteps;
const n = stepsData.length;

const W = 420;
const H = 420;
const cx = W / 2;
const cy = H / 2;
const R = 130;          // radius of circle centers
const nodeW = 90;
const nodeH = 56;

// Position each node evenly around the circle, starting from top
function nodePos(i: number) {
  const angle = (2 * Math.PI * i) / n - Math.PI / 2;
  return {
    x: cx + R * Math.cos(angle),
    y: cy + R * Math.sin(angle),
    angle,
  };
}

// Arrow arc between consecutive nodes
function arcArrow(fromIdx: number, toIdx: number): string {
  const from = nodePos(fromIdx);
  const to = nodePos(toIdx);
  // Midpoint for arc control — slightly outward
  const midAngle = (from.angle + to.angle) / 2;
  const cr = R * 0.85;
  return `M ${from.x} ${from.y} Q ${cx + cr * Math.cos(midAngle)} ${cy + cr * Math.sin(midAngle)} ${to.x} ${to.y}`;
}

const positions = stepsData.map((_, i) => nodePos(i));
---

<div class="pc-wrap not-prose">
  {title && <div class="pc-title">{title}</div>}

  <div class="pc-svg-wrap">
    <svg viewBox={`0 0 ${W} ${H}`} style={`max-width:${W}px; width:100%;`} aria-label={title}>
      <defs>
        <marker id="pcArr" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#cbd5e1"/>
        </marker>
      </defs>

      <!-- Center circle -->
      <circle cx={cx} cy={cy} r="44" fill="#f8fafc" stroke="#e2e8f0" stroke-width="2"/>
      <text x={cx} y={cy - 6} text-anchor="middle" font-size="12" font-weight="700" fill="#475569">정책</text>
      <text x={cx} y={cy + 10} text-anchor="middle" font-size="12" font-weight="700" fill="#475569">과정</text>
      <text x={cx} y={cy + 26} text-anchor="middle" font-size="9" fill="#94a3b8">Policy Cycle</text>

      <!-- Connection arrows (curved) -->
      {stepsData.map((_, i) => {
        const from = positions[i];
        const to = positions[(i + 1) % n];
        // Angle bisector for control point
        const midAngle = ((from.angle + to.angle) / 2);
        const qx = cx + R * 0.72 * Math.cos(midAngle);
        const qy = cy + R * 0.72 * Math.sin(midAngle);
        return (
          <path
            d={`M ${from.x} ${from.y} Q ${qx} ${qy} ${to.x} ${to.y}`}
            fill="none"
            stroke="#cbd5e1"
            stroke-width="2"
            marker-end="url(#pcArr)"
          />
        );
      })}

      <!-- Step nodes -->
      {stepsData.map((step, i) => {
        const pos = positions[i];
        return (
          <>
            <rect
              x={pos.x - nodeW / 2}
              y={pos.y - nodeH / 2}
              width={nodeW}
              height={nodeH}
              rx="10"
              fill={step.color ?? "#3b82f6"}
              fill-opacity="0.12"
              stroke={step.color ?? "#3b82f6"}
              stroke-width="2"
            />
            {step.icon && (
              <text x={pos.x} y={pos.y - 6} text-anchor="middle" font-size="16">{step.icon}</text>
            )}
            <text x={pos.x} y={step.icon ? pos.y + 12 : pos.y + 5} text-anchor="middle" font-size="11" font-weight="700" fill={step.color ?? "#3b82f6"}>{step.label}</text>
            {step.description && (
              <text x={pos.x} y={step.icon ? pos.y + 25 : pos.y + 20} text-anchor="middle" font-size="9" fill="#64748b">{step.description}</text>
            )}
          </>
        );
      })}

    </svg>
  </div>

  {caption && <p class="pc-caption">{caption}</p>}
</div>

<style>
  .pc-wrap {
    margin: 2.5rem 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(0,0,0,.06);
  }
  .pc-title {
    font-weight: 700;
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 1.25rem;
    text-align: center;
  }
  .pc-svg-wrap {
    display: flex;
    justify-content: center;
  }
  .pc-caption {
    font-size: 0.78rem;
    color: #64748b;
    text-align: center;
    margin-top: 0.75rem;
    font-style: italic;
  }
</style>
