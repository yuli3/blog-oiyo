---
/**
 * RadarChart — 방사형 레이더 차트 (SVG 기반)
 * 다차원 역량/지표 비교에 적합 (e.g., SWOT, 5대 역량)
 *
 * Props:
 *   title    - 제목 (optional)
 *   axes     - 축 이름 배열 (최소 3개)
 *   datasets - [{ label, color, values: number[] }] (values는 axes와 동일한 길이, 0-100)
 *   size     - SVG 크기 (default 300)
 */
interface Dataset {
  label: string;
  color: string;
  values: number[];
}
interface Props {
  title?: string;
  axes: string[];
  datasets: Dataset[];
  size?: number;
}

const { title, axes, datasets, size = 300 } = Astro.props;
const n = axes.length;
const cx = size / 2,
  cy = size / 2;
const r = size * 0.36;
const PAD_TOP = 20;

function angle(i: number) {
  return (Math.PI * 2 * i) / n - Math.PI / 2;
}
function pt(i: number, dist: number) {
  return {
    x: cx + dist * Math.cos(angle(i)),
    y: cy + PAD_TOP + dist * Math.sin(angle(i)),
  };
}

const levels = [20, 40, 60, 80, 100];
const gridPolygons = levels.map((l) =>
  axes
    .map((_, i) => pt(i, (l / 100) * r))
    .map((p) => `${p.x},${p.y}`)
    .join(" "),
);

const axisPoints = axes.map((_, i) => pt(i, r));
const labelPoints = axes.map((_, i) => pt(i, r + 20));

function dataPolygon(values: number[]) {
  return values
    .map((v, i) => {
      const p = pt(i, (Math.min(100, v) / 100) * r);
      return `${p.x},${p.y}`;
    })
    .join(" ");
}
---

<div class="edu-radar">
  {title && <div class="edu-radar__title">{title}</div>}
  <div class="edu-radar__wrap">
    <svg
      viewBox={`0 0 ${size} ${size + PAD_TOP}`}
      style={`width: 100%; max-width: ${size}px;`}
      aria-label={title}
    >
      <!-- Grid polygons -->
      {
        gridPolygons.map((pts, gi) => (
          <polygon
            points={pts}
            fill="none"
            stroke="#e2e8f0"
            stroke-width={gi === gridPolygons.length - 1 ? "1.5" : "1"}
          />
        ))
      }

      <!-- Axis lines -->
      {
        axisPoints.map((p) => (
          <line
            x1={cx}
            y1={cy + PAD_TOP}
            x2={p.x}
            y2={p.y}
            stroke="#cbd5e1"
            stroke-width="1"
          />
        ))
      }

      <!-- Data polygons -->
      {
        datasets.map((ds) => (
          <>
            <polygon
              points={dataPolygon(ds.values)}
              fill={ds.color}
              fill-opacity="0.15"
              stroke={ds.color}
              stroke-width="2.5"
              stroke-linejoin="round"
            />
            {ds.values.map((v, i) => {
              const p = pt(i, (Math.min(100, v) / 100) * r);
              return (
                <circle
                  cx={p.x}
                  cy={p.y}
                  r="4"
                  fill={ds.color}
                  stroke="#fff"
                  stroke-width="2"
                />
              );
            })}
          </>
        ))
      }

      <!-- Axis labels -->
      {
        labelPoints.map((p, i) => (
          <text
            x={p.x}
            y={p.y}
            text-anchor="middle"
            dominant-baseline="middle"
            font-size="11"
            font-weight="700"
            fill="#334155"
          >
            {axes[i]}
          </text>
        ))
      }

      <!-- Level labels -->
      {
        levels.map((l) => {
          const p = pt(0, (l / 100) * r);
          return (
            <text x={p.x + 4} y={p.y} font-size="9" fill="#94a3b8">
              {l}
            </text>
          );
        })
      }
    </svg>

    <!-- Legend -->
    {
      datasets.length > 1 && (
        <div class="edu-radar__legend">
          {datasets.map((ds) => (
            <div class="edu-radar__legend-item">
              <span
                class="edu-radar__legend-dot"
                style={`background: ${ds.color};`}
              />
              <span>{ds.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .edu-radar {
    margin: 2.5rem 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
  .edu-radar__title {
    font-weight: 700;
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 1.25rem;
    text-align: center;
  }
  .edu-radar__wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .edu-radar__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: center;
  }
  .edu-radar__legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #475569;
    font-weight: 600;
  }
  .edu-radar__legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
</style>
