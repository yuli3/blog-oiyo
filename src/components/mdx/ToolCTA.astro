// family-first targets: link the OIYO family page when one exists (#strategy)
const HREF_OVERRIDES: Record<string, (l: string) => string> = {
  "empathy-test": (l) => `https://oiyo.net/${l}/empathy/test?utm_source=blog_oiyo&utm_medium=referral&utm_campaign=tool_cta`,
  investment: (l) => `https://oiyo.net/${l}/investment-type/test?utm_source=blog_oiyo&utm_medium=referral&utm_campaign=tool_cta`,
  chess: (l) => `/${l}/chess/`,
  gomoku: (l) => `/${l}/gomoku/`,
  "learning-style": (l) => `/${l}/learning-style-test/`,
  "legal-interest": (l) => `/${l}/legal-interest-calculator/`,
};

const { tool, locale = "ko" } = Astro.props;

const meta = TOOL_META[tool];

const isKo = locale === "ko";
const name = meta ? (isKo ? meta.name_ko : meta.name_en) : "";
const description = meta ? (isKo ? meta.description_ko : meta.description_en) : "";
const ctaLabel = isKo ? "계산해보기 →" : "Try it →";
import { AHOXY_URL } from '@/config/site.config';
const href = HREF_OVERRIDES[tool]
  ? HREF_OVERRIDES[tool](locale)
  : `${AHOXY_URL}/${locale}/${tool}?utm_source=blog_oiyo&utm_medium=referral&utm_campaign=tool_cta`;
---

{meta && (
<aside class="not-prose my-8 rounded-2xl border border-sky-200 bg-sky-50/80 shadow-sm">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-between gap-4 px-6 py-5 group"
  >
    <div class="flex items-center gap-4 min-w-0">
      <span class="text-3xl shrink-0" aria-hidden="true">{meta.icon}</span>
      <div class="min-w-0">
        <div class="font-bold text-base text-sky-900 leading-snug">
          {name}
        </div>
        <div class="text-sm text-sky-700/80 mt-0.5 leading-relaxed">
          {description}
        </div>
      </div>
    </div>
    <span
      class="shrink-0 inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm group-hover:bg-sky-700 transition-colors whitespace-nowrap"
    >
      {ctaLabel}
    </span>
  </a>
</aside>
)}
