---
/**
 * EconDiagram — 경제학 도식(비용곡선·IS-LM·솔로우 등)을 좌표로 그리는 범용 SVG.
 * 라벨은 모두 props 로 받는다(로케일 중립). 좌표 범위는 xMax·yMax(기본 100).
 *
 * Props:
 *   title, caption, xLabel, yLabel
 *   curves  - [{ label, points: [[x,y],...], tone?, dashed?, labelAt? }]
 *             labelAt: 라벨을 붙일 점 인덱스(기본 마지막 점)
 *   areas   - [{ points: [[x,y],...], tone?, label? }]   음영 다각형
 *   marks   - [{ x, y, label?, guide?, xTick?, yTick? }]  점. guide 면 두 축까지 점선
 *   arrows  - [{ from: [x,y], to: [x,y] }]               곡선 이동 방향
 *   xMin, xMax, yMin, yMax  축 범위(기본 0~100). 최솟값이 0이 아니면 축 끝에 물결 없이 그 값에서 시작한다
 *   범위가 0을 가로지르면 축은 원점을 지난다
 *   curves[].anchor  "end" 면 라벨을 점 왼쪽 위에 붙인다(오른쪽 끝 곡선용)
 */
type Pt = [number, number];
type Tone = "blue" | "green" | "red" | "amber" | "violet" | "gray";
interface Curve { label?: string; points: Pt[]; tone?: Tone; dashed?: boolean; labelAt?: number; anchor?: "start" | "end" }
interface Area { points: Pt[]; tone?: Tone; label?: string }
interface Mark { x: number; y: number; label?: string; guide?: boolean; xTick?: string; yTick?: string }
interface Arrow { from: Pt; to: Pt }
interface Props {
  title?: string;
  caption?: string;
  xLabel?: string;
  yLabel?: string;
  curves?: Curve[];
  areas?: Area[];
  marks?: Mark[];
  arrows?: Arrow[];
  xMin?: number;
  xMax?: number;
  yMin?: number;
  yMax?: number;
}

const {
  title,
  caption,
  xLabel = "",
  yLabel = "",
  curves = [],
  areas = [],
  marks = [],
  arrows = [],
  xMin = 0,
  xMax = 100,
  yMin = 0,
  yMax = 100,
} = Astro.props;

const TONES: Record<Tone, string> = {
  blue: "#2563eb",
  green: "#16a34a",
  red: "#dc2626",
  amber: "#d97706",
  violet: "#7c3aed",
  gray: "#64748b",
};
const W = 480;
const H = 320;
const PAD = { top: 24, right: 64, bottom: 48, left: 56 };
const cW = W - PAD.left - PAD.right;
const cH = H - PAD.top - PAD.bottom;
const px = (x: number) => PAD.left + ((x - xMin) / (xMax - xMin)) * cW;
const py = (y: number) => PAD.top + cH - ((y - yMin) / (yMax - yMin)) * cH;
const path = (pts: Pt[]) => pts.map(([x, y]) => `${px(x).toFixed(1)},${py(y).toFixed(1)}`).join(" ");
// 범위가 0을 가로지르면 축을 원점에 그린다(가치함수처럼 음수 영역이 있는 도식).
const axisX = xMin < 0 && xMax > 0 ? px(0) : PAD.left;
const axisY = yMin < 0 && yMax > 0 ? py(0) : PAD.top + cH;
const toneOf = (t?: Tone) => TONES[t ?? "blue"];
const uid = `ed-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="econ-diagram">
  {title && <figcaption class="econ-diagram__title">{title}</figcaption>}
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title ?? caption ?? ""}>
    <defs>
      <marker id={`${uid}-arrow`} markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#64748b" />
      </marker>
    </defs>

    {areas.map((a) => (
      <polygon points={path(a.points)} fill={toneOf(a.tone)} fill-opacity="0.14" />
    ))}
    {areas.filter((a) => a.label).map((a) => {
      const cx = a.points.reduce((s, p) => s + p[0], 0) / a.points.length;
      const cy = a.points.reduce((s, p) => s + p[1], 0) / a.points.length;
      return (
        <text x={px(cx)} y={py(cy) + 4} text-anchor="middle" font-size="11" font-weight="600" fill={toneOf(a.tone)}>{a.label}</text>
      );
    })}

    <line x1={axisX} y1={PAD.top - 6} x2={axisX} y2={PAD.top + cH} stroke="#334155" stroke-width="1.8" />
    <line x1={PAD.left} y1={axisY} x2={PAD.left + cW + 12} y2={axisY} stroke="#334155" stroke-width="1.8" />
    <text x={PAD.left + cW + 14} y={axisY + 4} font-size="12" font-weight="600" fill="#475569">{xLabel}</text>
    <text x={axisX} y={PAD.top - 10} text-anchor="middle" font-size="12" font-weight="600" fill="#475569">{yLabel}</text>

    {marks.filter((m) => m.guide).map((m) => (
      <>
        <line x1={px(m.x)} y1={py(m.y)} x2={px(m.x)} y2={axisY} stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="4 4" />
        <line x1={axisX} y1={py(m.y)} x2={px(m.x)} y2={py(m.y)} stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="4 4" />
      </>
    ))}
    {marks.filter((m) => m.xTick).map((m) => (
      <text x={px(m.x)} y={axisY + 16} text-anchor="middle" font-size="11" fill="#64748b">{m.xTick}</text>
    ))}
    {marks.filter((m) => m.yTick).map((m) => (
      <text x={axisX - 6} y={py(m.y) + 4} text-anchor="end" font-size="11" fill="#64748b">{m.yTick}</text>
    ))}

    {curves.map((c) => {
      const at = c.points[Math.min(c.labelAt ?? c.points.length - 1, c.points.length - 1)];
      return (
        <>
          <polyline
            points={path(c.points)}
            fill="none"
            stroke={toneOf(c.tone)}
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-dasharray={c.dashed ? "7,5" : undefined}
          />
          {c.label && (
            <text x={c.anchor === "end" ? px(at[0]) - 2 : px(at[0]) + 6} y={c.anchor === "end" ? py(at[1]) - 8 : py(at[1]) + 4} text-anchor={c.anchor === "end" ? "end" : "start"} font-size="12.5" font-weight="700" fill={toneOf(c.tone)}>{c.label}</text>
          )}
        </>
      );
    })}

    {arrows.map((a) => (
      <line
        x1={px(a.from[0])} y1={py(a.from[1])} x2={px(a.to[0])} y2={py(a.to[1])}
        stroke="#64748b" stroke-width="1.8" marker-end={`url(#${uid}-arrow)`}
      />
    ))}

    {marks.map((m) => (
      <>
        <circle cx={px(m.x)} cy={py(m.y)} r="4.5" fill="#1e293b" stroke="#fff" stroke-width="2" />
        {m.label && <text x={px(m.x) + 8} y={py(m.y) - 7} font-size="12" font-weight="700" fill="#1e293b">{m.label}</text>}
      </>
    ))}
  </svg>
  {caption && <p class="econ-diagram__caption">{caption}</p>}
</figure>

<style>
  .econ-diagram {
    margin: 2rem 0;
    padding: 1.25rem 1rem 1rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.875rem;
  }
  .econ-diagram svg {
    display: block;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    overflow: visible;
  }
  .econ-diagram__title {
    margin-bottom: 0.75rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: #1e293b;
  }
  .econ-diagram__caption {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #475569;
  }
</style>
