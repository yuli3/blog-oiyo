---
/**
 * ValueChain — Porter의 가치사슬 다이어그램
 *
 * Props:
 *   title    - 차트 제목
 *   primary  - 주요 활동 (5개 권장: Inbound Logistics → Operations → Outbound Logistics → Marketing & Sales → Service)
 *   support  - 지원 활동 (4개 권장: Firm Infrastructure, HRM, Technology, Procurement)
 *   margin   - 우측 마진 텍스트 (기본: "Margin")
 *
 * 사용 예시:
 * <ValueChain
 *   title="Porter의 가치사슬 분석"
 *   support={[
 *     { label: "기업 인프라", description: "재무, 법무, 계획" },
 *     { label: "인적자원 관리", description: "채용, 훈련, 보상" },
 *     { label: "기술 개발", description: "R&D, IT 시스템" },
 *     { label: "조달 활동", description: "원자재, 장비 구매" },
 *   ]}
 *   primary={[
 *     { label: "구매 물류", description: "원자재 입고·저장" },
 *     { label: "운영", description: "제조·생산 과정" },
 *     { label: "출하 물류", description: "완제품 보관·배송" },
 *     { label: "마케팅·판매", description: "광고·촉진·가격책정" },
 *     { label: "서비스", description: "A/S·유지보수" },
 *   ]}
 * />
 */

interface Activity {
  label: string;
  description?: string;
}

interface Props {
  title?: string;
  primary: Activity[];
  support?: Activity[];
  margin?: string;
  caption?: string;
}

const { title, primary, support = [], margin = "Margin", caption } = Astro.props;

const primaryColors = ["bg-blue-100", "bg-blue-200", "bg-indigo-100", "bg-indigo-200", "bg-violet-100"];
const supportColors = ["bg-slate-100", "bg-slate-50"];
---

<figure class="not-prose my-8 overflow-x-auto">
  {title && (
    <p class="font-black text-sm uppercase tracking-widest text-muted-foreground mb-4">{title}</p>
  )}

  <div class="min-w-[600px] rounded-2xl border border-border/60 overflow-hidden shadow-sm bg-card">
    <!-- Support Activities -->
    {support.length > 0 && (
      <div class="border-b border-border/60">
        <div class="flex">
          <div class="w-24 flex-shrink-0 flex items-center justify-center bg-slate-200 px-2 py-3 text-[10px] font-black uppercase tracking-wider text-slate-600 text-center border-r border-border/60">
            지원<br/>활동
          </div>
          <div class="flex-1 flex flex-col divide-y divide-border/40">
            {support.map((act, i) => (
              <div class={`flex items-center gap-3 px-4 py-2.5 ${supportColors[i % supportColors.length]}`}>
                <div>
                  <span class="text-xs font-bold text-foreground">{act.label}</span>
                  {act.description && (
                    <span class="text-[10px] text-muted-foreground ml-2">{act.description}</span>
                  )}
                </div>
              </div>
            ))}
          </div>
          <!-- Margin label on right -->
          <div class="w-16 flex-shrink-0 flex items-center justify-center bg-primary text-primary-foreground text-[10px] font-black uppercase tracking-widest text-center [writing-mode:vertical-rl] rotate-180 py-3">
            {margin}
          </div>
        </div>
      </div>
    )}

    <!-- Primary Activities -->
    <div class="flex">
      <div class="w-24 flex-shrink-0 flex items-center justify-center bg-primary/80 px-2 py-4 text-[10px] font-black uppercase tracking-wider text-primary-foreground text-center border-r border-border/60">
        핵심<br/>활동
      </div>
      <div class="flex-1 flex divide-x divide-border/40">
        {primary.map((act, i) => (
          <div class={`flex-1 flex flex-col justify-center items-center text-center px-3 py-5 gap-2 ${primaryColors[i % primaryColors.length]} relative`}>
            <!-- Arrow between items -->
            {i < primary.length - 1 && (
              <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 z-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground bg-card rounded-full p-0.5">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </div>
            )}
            <span class="text-xs font-bold text-foreground leading-snug">{act.label}</span>
            {act.description && (
              <span class="text-[10px] text-muted-foreground leading-snug">{act.description}</span>
            )}
          </div>
        ))}
      </div>
      {support.length === 0 && (
        <div class="w-16 flex-shrink-0 flex items-center justify-center bg-primary text-primary-foreground text-[10px] font-black uppercase tracking-widest text-center [writing-mode:vertical-rl] rotate-180 py-3">
          {margin}
        </div>
      )}
    </div>
  </div>

  {caption && (
    <p class="text-xs text-muted-foreground mt-3 italic">{caption}</p>
  )}
</figure>
