---
/**
 * ProgressBar — 진행도 / 비율 막대 차트 (수평)
 * 비율, 점수, 점유율 표현에 사용
 *
 * Props:
 *   items   - [{ label, value, max?, color?, note? }]
 *   title   - 제목 (optional)
 *   max     - 전체 기준치 (default 100)
 *   unit    - 단위 표시 (default "%")
 */
interface Item {
  label: string;
  value: number;
  max?: number;
  color?: string;
  note?: string;
}
interface Props {
  title?: string;
  items: Item[];
  max?: number;
  unit?: string;
}

import { inlineMd } from "../../lib/utils";
const { title, items, max = 100, unit = "%" } = Astro.props;
const colors = [
  "#3b82f6",
  "#10b981",
  "#f59e0b",
  "#ef4444",
  "#8b5cf6",
  "#06b6d4",
  "#ec4899",
];
---

<div class="edu-progress">
  {title && <div class="edu-progress__title">{title}</div>}
  <div class="edu-progress__list">
    {
      items.map((item, i) => {
        const pmax = item.max ?? max;
        const pct = Math.min(100, (item.value / pmax) * 100);
        const color = item.color ?? colors[i % colors.length];
        return (
          <div class="edu-progress__item">
            <div class="edu-progress__meta">
              <span class="edu-progress__label" set:html={inlineMd(item.label)} />
              <span class="edu-progress__value" style={`color: ${color};`}>
                {item.value}
                {unit}
                {item.note && (
                  <span class="edu-progress__note">&nbsp;— {item.note}</span>
                )}
              </span>
            </div>
            <div class="edu-progress__track">
              <div
                class="edu-progress__fill"
                style={`width: ${pct}%; background: ${color};`}
              />
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .edu-progress {
    margin: 2.5rem 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem 2rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
  .edu-progress__title {
    font-weight: 700;
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .edu-progress__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .edu-progress__item {
  }
  .edu-progress__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.4rem;
  }
  .edu-progress__label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1e293b;
  }
  .edu-progress__value {
    font-size: 0.85rem;
    font-weight: 700;
  }
  .edu-progress__note {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 400;
  }
  .edu-progress__track {
    height: 10px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
  }
  .edu-progress__fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.85;
  }
</style>
