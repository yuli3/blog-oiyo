---
/**
 * OrgChart — 조직도 (Organization Chart)
 * Props:
 *   title    - 차트 제목
 *   root     - 최상위 노드 { label, sublabel?, color? }
 *   levels   - 계층별 노드 배열 (각 레벨은 노드 배열)
 *              [level1[], level2[], ...]
 *              node: { label, sublabel?, color?, parentIndex? }
 *   caption  - 하단 설명
 */
interface OrgNode {
  label: string;
  sublabel?: string;
  color?: string;
  parentIndex?: number; // 부모 레벨의 인덱스 (0-based), 없으면 root 연결
}

interface Props {
  title?: string;
  root: { label: string; sublabel?: string; color?: string };
  levels: OrgNode[][];
  caption?: string;
}

const { title, root, levels, caption } = Astro.props;

const colorMap: Record<string, { bg: string; border: string; text: string }> = {
  blue:   { bg: "#eff6ff", border: "#3b82f6", text: "#1d4ed8" },
  green:  { bg: "#f0fdf4", border: "#22c55e", text: "#15803d" },
  purple: { bg: "#faf5ff", border: "#a855f7", text: "#7e22ce" },
  amber:  { bg: "#fffbeb", border: "#f59e0b", text: "#b45309" },
  red:    { bg: "#fef2f2", border: "#ef4444", text: "#b91c1c" },
  gray:   { bg: "#f8fafc", border: "#94a3b8", text: "#475569" },
  teal:   { bg: "#f0fdfa", border: "#14b8a6", text: "#0f766e" },
};

function getColor(color?: string) {
  return colorMap[color ?? "blue"] ?? colorMap.blue;
}

const rootColor = getColor(root.color ?? "blue");
---

<div class="org-wrap not-prose">
  {title && <div class="org-title">{title}</div>}

  <div class="org-tree">
    <!-- Root node -->
    <div class="org-level">
      <div
        class="org-node org-node--root"
        style={`background:${rootColor.bg}; border-color:${rootColor.border}; color:${rootColor.text}`}
      >
        <div class="org-node__label">{root.label}</div>
        {root.sublabel && <div class="org-node__sub">{root.sublabel}</div>}
      </div>
    </div>

    <!-- Each level -->
    {levels.map((level) => (
      <div class="org-level-wrap">
        <div class="org-connector-row">
          <div class="org-connector-down" />
          {level.length > 1 && <div class="org-connector-horiz" />}
        </div>
        <div class="org-level">
          {level.map((node) => {
            const c = getColor(node.color);
            return (
              <div class="org-node-col">
                {level.length > 1 && <div class="org-connector-branch" />}
                <div
                  class="org-node"
                  style={`background:${c.bg}; border-color:${c.border}; color:${c.text}`}
                >
                  <div class="org-node__label">{node.label}</div>
                  {node.sublabel && <div class="org-node__sub">{node.sublabel}</div>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  {caption && <p class="org-caption">{caption}</p>}
</div>

<style>
  .org-wrap {
    margin: 2.5rem 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(0,0,0,.06);
    overflow-x: auto;
  }
  .org-title {
    font-weight: 700;
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .org-tree {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    min-width: 300px;
  }
  .org-level {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .org-level-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .org-connector-row {
    position: relative;
    height: 24px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
  }
  .org-connector-down {
    width: 2px;
    height: 24px;
    background: #cbd5e1;
  }
  .org-connector-horiz {
    position: absolute;
    bottom: 0;
    left: 20%;
    right: 20%;
    height: 2px;
    background: #cbd5e1;
  }
  .org-node-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .org-connector-branch {
    width: 2px;
    height: 12px;
    background: #cbd5e1;
  }
  .org-node {
    border: 2px solid;
    border-radius: 10px;
    padding: 10px 16px;
    min-width: 120px;
    max-width: 180px;
    text-align: center;
    transition: transform 0.15s;
  }
  .org-node:hover {
    transform: translateY(-2px);
  }
  .org-node--root {
    min-width: 160px;
    padding: 12px 24px;
  }
  .org-node__label {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .org-node__sub {
    font-size: 0.7rem;
    margin-top: 3px;
    opacity: 0.75;
  }
  .org-caption {
    font-size: 0.78rem;
    color: #64748b;
    text-align: center;
    margin-top: 1rem;
    font-style: italic;
  }
</style>
