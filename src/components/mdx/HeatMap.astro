---
/**
 * HeatMap — 행렬형 히트맵 (점수/강도/관계 시각화)
 * 예: 포트폴리오 상관관계, SWOT 강도 매트릭스
 *
 * Props:
 *   title     - 제목 (optional)
 *   headers   - 열 제목 배열
 *   rows      - [{ label, values: number[] }]
 *   min       - 최솟값 (default 0)
 *   max       - 최댓값 (default 100)
 *   colorLow  - 낮은 값 색상 (default whitesmoke)
 *   colorHigh - 높은 값 색상 (default #3b82f6)
 */
interface HRow {
  label: string;
  values: number[];
}
interface Props {
  title?: string;
  headers: string[];
  rows: HRow[];
  min?: number;
  max?: number;
  colorLow?: string;
  colorHigh?: string;
}

const {
  title,
  headers,
  rows,
  min = 0,
  max = 100,
  colorLow = "#f8fafc",
  colorHigh = "#3b82f6",
} = Astro.props;

function lerp(a: number, b: number, t: number) {
  return a + (b - a) * t;
}
// Parse hex to rgb
function hexToRgb(hex: string) {
  const r = parseInt(hex.slice(1, 3), 16),
    g = parseInt(hex.slice(3, 5), 16),
    b = parseInt(hex.slice(5, 7), 16);
  return { r, g, b };
}
function interpolateColor(low: string, high: string, t: number) {
  const lo = hexToRgb(low),
    hi = hexToRgb(high);
  const r = Math.round(lerp(lo.r, hi.r, t));
  const g = Math.round(lerp(lo.g, hi.g, t));
  const b = Math.round(lerp(lo.b, hi.b, t));
  return `rgb(${r},${g},${b})`;
}

// Ensure valid hex for interpolation
const lo = colorLow.startsWith("#") ? colorLow : "#f8fafc";
const hi = colorHigh.startsWith("#") ? colorHigh : "#3b82f6";
---

<div class="edu-heatmap">
  {title && <div class="edu-heatmap__title">{title}</div>}
  <div class="edu-heatmap__wrap">
    <table>
      <thead>
        <tr>
          <th class="edu-heatmap__corner"></th>
          {headers.map((h) => <th>{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td class="edu-heatmap__row-label">{row.label}</td>
              {row.values.map((v) => {
                const t = Math.max(0, Math.min(1, (v - min) / (max - min)));
                const bg = interpolateColor(lo, hi, t);
                const textColor = t > 0.55 ? "#fff" : "#1e293b";
                return (
                  <td
                    class="edu-heatmap__cell"
                    style={`background: ${bg}; color: ${textColor};`}
                  >
                    {v}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .edu-heatmap {
    margin: 2.5rem 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
  .edu-heatmap__title {
    font-weight: 700;
    font-size: 1rem;
    color: #1e293b;
    padding: 1rem 1.5rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    text-align: center;
  }
  .edu-heatmap__wrap {
    overflow-x: auto;
    padding: 1rem;
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 3px;
  }
  th {
    padding: 0.5rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    text-align: center;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .edu-heatmap__corner {
    background: transparent;
  }
  .edu-heatmap__row-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #334155;
    padding: 0.5rem 1rem 0.5rem 0.25rem;
    white-space: nowrap;
    text-align: right;
  }
  .edu-heatmap__cell {
    padding: 0.6rem 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 6px;
    min-width: 50px;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
    cursor: default;
  }
  .edu-heatmap__cell:hover {
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 10;
    position: relative;
  }
</style>
