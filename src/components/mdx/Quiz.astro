---
import { getLocaleFromPath, getTranslations } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = await getTranslations(locale as Locale);
---

<div
  class="my-6 p-6 rounded-xl border border-primary/20 bg-primary/5 animate-fade-in"
>
  <h3 class="font-bold text-lg mb-4 text-primary flex items-center gap-2">
    <span>🧠</span> {t.components.knowledgeCheck}
  </h3>
  <div class="prose-sm max-w-none">
    <slot />
  </div>
</div>
