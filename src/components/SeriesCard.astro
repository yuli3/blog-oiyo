---
/**
 * Academy category series card (B2, 2026-09-11).
 * Fields: display name, chapterCount, primary CTA — no chapter peer rows.
 */
import type { SeriesEntry } from "../lib/wiki-index";
import { isUrlSafeSeriesKey } from "../lib/wiki-index";
import { seriesDisplayName } from "../data/priority-series";

interface Props {
  series: SeriesEntry;
  locale: string;
  chaptersLabel: string;
  ctaLabel: string;
}

const { series, locale, chaptersLabel, ctaLabel } = Astro.props;

const displayName = seriesDisplayName(
  series.key,
  locale,
  series.firstPost.data.title,
);

const firstSlug = series.firstPost.slug.split("/").slice(1).join("/");
const href =
  isUrlSafeSeriesKey(series.key) && series.chapterCount >= 2
    ? `/${locale}/series/${series.key}/`
    : `/${locale}/${firstSlug}/`;
---

<article class="flex flex-col justify-between gap-4 rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:border-primary/40 hover:bg-primary/5">
  <div class="min-w-0 space-y-2">
    <h2 class="text-lg font-bold tracking-tight text-foreground">
      <a href={href} class="hover:text-primary transition-colors">
        {displayName}
      </a>
    </h2>
    <p class="text-sm tabular-nums text-muted-foreground">
      {series.chapterCount} {chaptersLabel}
    </p>
  </div>
  <a
    href={href}
    class="inline-flex items-center gap-1.5 self-start rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary/90"
  >
    {ctaLabel}
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  </a>
</article>
