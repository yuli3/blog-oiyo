---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import CategoryCloud from "./CategoryCloud.astro";
import IntentBundles from "./IntentBundles.astro";
import { siteConfig } from "../config/site.config";
import { getTrackFromData } from "../lib/taxonomy";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface PageData {
  data: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
}

interface Props {
  availableLocales?: string[];
  page: PageData;
  locale: string;
  baseUrl: string;
  title: string;
  subtitle: string;
  activeCategory?: string;
  showIntentBundles?: boolean;
}

const { page, locale, baseUrl, title, subtitle, activeCategory, showIntentBundles = false } = Astro.props;
const paginationEnabled = siteConfig.features.pagination;
const t = await getTranslations(locale as Locale);
const blogT = t.blog as Record<string, string>;
const categoryNames = (t.category.names ?? {}) as unknown as { [key: string]: string };
---

<BaseLayout title={title} description={subtitle} availableLocales={Astro.props.availableLocales}>
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <div class="mb-12 max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight sm:text-5xl mb-4 text-foreground"
        >
          {title}
          {
            page.currentPage > 1 && (
              <span class="text-xl text-muted-foreground font-normal ml-3">
                {t.blog.page} {page.currentPage}
              </span>
            )
          }
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {subtitle}
        </p>
      </div>

      {showIntentBundles
        ? <IntentBundles locale={locale} />
        : <CategoryCloud {locale} {activeCategory} />
      }

      <div class="flex flex-col divide-y divide-border/60">
        {
          page.data.map((post) => {
            // post.slug is like 'ko/visualizing-goals'; strip the lang prefix
            const slug = post.slug.split("/").slice(1).join("/");
            const href = `/${locale}/${slug}/`;
            const chMatch = post.slug.match(/-ch(\d+)$/);
            const chapter = chMatch ? parseInt(chMatch[1], 10) : null;
            const track = getTrackFromData(post.data);
            const isAcademy = track === "academy";
            const isInteractive = track === "interactive";
            const badgeLabel = isAcademy
              ? blogT.badgeAcademy
              : isInteractive
                ? (blogT.badgeInteractive ?? "Interactive")
                : blogT.badgeMagazine;

            return (
              <article
                class:list={[
                  "group flex flex-col gap-4 py-6 md:flex-row md:items-center",
                  {
                    "bg-primary/5 px-4 py-6 md:px-6 rounded-2xl border border-primary/10 hover:border-primary/20 transition-colors":
                      isAcademy,
                    "bg-foreground/[0.03] px-4 py-6 md:px-6 rounded-2xl border border-foreground/10 hover:border-foreground/20 transition-colors":
                      isInteractive,
                  },
                ]}
              >
                {post.data.heroImage && (
                  <a
                    href={href}
                    class="w-full md:w-48 lg:w-56 aspect-[16/10] overflow-hidden rounded-xl border border-border bg-muted/20 shrink-0"
                  >
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                )}

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-widest">
                    <span
                      class:list={[
                        "px-2 py-0.5 rounded-md",
                        isAcademy
                          ? "bg-primary text-primary-foreground"
                          : isInteractive
                            ? "bg-secondary text-secondary-foreground"
                            : "bg-foreground text-background",
                      ]}
                    >
                      {badgeLabel}
                    </span>
                    <span class="text-muted-foreground/40">/</span>
                    <span class="text-muted-foreground">
                      {(post.data.category ? categoryNames[post.data.category] : undefined) ?? post.data.category}
                    </span>
                  </div>

                  <h2 class="mt-2 text-xl font-bold leading-snug group-hover:text-primary transition-colors tracking-tight">
                    <a href={href}>
                      {isAcademy && chapter !== null && (
                        <span class="text-primary mr-1.5">#{chapter}</span>
                      )}
                      {post.data.title}
                    </a>
                  </h2>

                  <div class="mt-2 flex items-center gap-3 text-[11px] text-muted-foreground/60">
                    {post.data.pubDate && (
                      <span>
                        {post.data.pubDate.toLocaleDateString(
                          locale === "ko" ? "ko-KR" : locale === "ja" ? "ja-JP" : locale === "zh" || locale === "cn" ? "zh-CN" : locale === "fr" ? "fr-FR" : locale === "es" ? "es-ES" : "en-US",
                          { month: "short", day: "numeric", year: "numeric" },
                        )}
                      </span>
                    )}
                    {post.data.author && (
                      <>
                        <span>·</span>
                        <span>{post.data.author}</span>
                      </>
                    )}
                  </div>

                  <p class="mt-3 text-muted-foreground line-clamp-3 text-sm leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>

      {
        paginationEnabled && page.lastPage > 1 && (
          <Pagination
            currentPage={page.currentPage}
            totalPages={page.lastPage}
            baseUrl={baseUrl}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
