---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import CategoryCloud from "./CategoryCloud.astro";
import WikiTable from "./WikiTable.astro";
import IntentBundles from "./IntentBundles.astro";
import { siteConfig } from "../config/site.config";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface PageData {
  data: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
}

interface Props {
  availableLocales?: string[];
  page: PageData;
  locale: string;
  baseUrl: string;
  title: string;
  subtitle: string;
  activeCategory?: string;
  showIntentBundles?: boolean;
  jsonLd?: string;
  noindex?: boolean;
  showCategoryCloud?: boolean;
}

const { page, locale, baseUrl, title, subtitle, activeCategory, showIntentBundles = false, showCategoryCloud = true, jsonLd, noindex } = Astro.props;
const paginationEnabled = siteConfig.features.pagination;
const t = await getTranslations(locale as Locale);
---

<BaseLayout title={title} description={subtitle} availableLocales={Astro.props.availableLocales} noindex={noindex}>
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <div class="mb-12 max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight sm:text-5xl mb-4 text-foreground"
        >
          {title}
          {
            page.currentPage > 1 && (
              <span class="text-xl text-muted-foreground font-normal ml-3">
                {t.blog.page} {page.currentPage}
              </span>
            )
          }
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {subtitle}
        </p>
      </div>

      {showIntentBundles
        ? <IntentBundles locale={locale} />
        : showCategoryCloud && <CategoryCloud {locale} {activeCategory} />
      }

      <WikiTable posts={page.data} locale={locale} />

      {
        paginationEnabled && page.lastPage > 1 && (
          <Pagination
            currentPage={page.currentPage}
            totalPages={page.lastPage}
            baseUrl={baseUrl}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
