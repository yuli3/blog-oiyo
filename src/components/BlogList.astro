---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import CategoryCloud from "./CategoryCloud.astro";
import { siteConfig } from "../config/site.config";
import { getTrack } from "../lib/taxonomy";

interface Props {
  page: any;
  locale: string;

  baseUrl: string;
  title: string;
  subtitle: string;
  activeCategory?: string;
}

const { page, locale, baseUrl, title, subtitle, activeCategory } = Astro.props;
const paginationEnabled = siteConfig.features.pagination;
---

<BaseLayout title={title} description={subtitle}>
  <section class="py-24">
    <div class="container px-4">
      <div class="mb-20 animate-fade-up max-w-3xl">
        <h1
          class="text-5xl font-extrabold tracking-tight sm:text-6xl mb-6 font-heading text-primary"
        >
          {title}
          {
            page.currentPage > 1 && (
              <span class="text-2xl text-muted-foreground font-normal ml-4">
                Page {page.currentPage}
              </span>
            )
          }
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed italic">
          {subtitle}
        </p>
      </div>

      <CategoryCloud {locale} {activeCategory} />

      <div class="grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((post: any) => {
            // post.slug is like 'ko/visualizing-goals'; strip the lang prefix
            const slug = post.slug.split("/").slice(1).join("/");
            const href = `/${locale}/${slug}/`;
            const chMatch = post.slug.match(/-ch(\d+)$/);
            const chapter = chMatch ? parseInt(chMatch[1], 10) : null;
            const track = getTrack(post.data.category);
            const isAcademy = track === "academy";

            return (
              <article
                class:list={[
                  "group flex flex-col items-start gap-4 animate-fade-up",
                  {
                    "bg-primary/5 p-6 rounded-3xl -m-6 border border-transparent hover:border-primary/20 transition-all":
                      isAcademy,
                  },
                ]}
              >
                {post.data.heroImage && (
                  <a
                    href={href}
                    class="w-full aspect-[16/10] overflow-hidden rounded-2xl border border-border/40 bg-muted/20"
                  >
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105 group-hover:opacity-90"
                    />
                  </a>
                )}
                <div class="flex items-center gap-2 text-[9px] font-bold uppercase tracking-[0.2em]">
                  <span
                    class:list={[
                      "px-2 py-1 rounded-md",
                      isAcademy
                        ? "bg-primary text-primary-foreground"
                        : "bg-foreground text-background",
                    ]}
                  >
                    {isAcademy ? "Academy" : "Magazine"}
                  </span>
                  <span class="text-muted-foreground/40 font-normal">/</span>
                  <span class="text-muted-foreground">
                    {post.data.category}
                  </span>
                </div>

                <h2 class="text-2xl font-bold leading-tight group-hover:text-primary transition-colors font-heading tracking-tight mt-2">
                  <a href={href}>
                    {isAcademy && chapter !== null && (
                      <span class="text-primary mr-2">#{chapter}</span>
                    )}
                    {post.data.title}
                  </a>
                </h2>

                <div class="flex items-center gap-4 text-[10px] font-medium text-muted-foreground/60">
                  {post.data.pubDate && (
                    <span>
                      {post.data.pubDate.toLocaleDateString(
                        locale === "ko" ? "ko-KR" : "en-US",
                        { month: "short", day: "numeric", year: "numeric" },
                      )}
                    </span>
                  )}
                  {post.data.author && (
                    <>
                      <span>•</span>
                      <span>{post.data.author}</span>
                    </>
                  )}
                </div>

                <p class="text-muted-foreground line-clamp-3 text-base leading-relaxed mt-1">
                  {post.data.description}
                </p>
              </article>
            );
          })
        }
      </div>

      {
        paginationEnabled && page.lastPage > 1 && (
          <Pagination
            currentPage={page.currentPage}
            totalPages={page.lastPage}
            baseUrl={baseUrl}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
