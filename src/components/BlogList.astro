---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import CategoryCloud from "./CategoryCloud.astro";
import { siteConfig } from "../config/site.config";
import { getTrack } from "../lib/taxonomy";

interface Props {
  page: any;
  locale: string;

  baseUrl: string;
  title: string;
  subtitle: string;
  activeCategory?: string;
}

const { page, locale, baseUrl, title, subtitle, activeCategory } = Astro.props;
const paginationEnabled = siteConfig.features.pagination;
---

<BaseLayout title={title} description={subtitle}>
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <div class="mb-12 max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight sm:text-5xl mb-4 text-foreground"
        >
          {title}
          {
            page.currentPage > 1 && (
              <span class="text-xl text-muted-foreground font-normal ml-3">
                Page {page.currentPage}
              </span>
            )
          }
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {subtitle}
        </p>
      </div>

      <CategoryCloud {locale} {activeCategory} />

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((post: any) => {
            // post.slug is like 'ko/visualizing-goals'; strip the lang prefix
            const slug = post.slug.split("/").slice(1).join("/");
            const href = `/${locale}/${slug}/`;
            const chMatch = post.slug.match(/-ch(\d+)$/);
            const chapter = chMatch ? parseInt(chMatch[1], 10) : null;
            const track = getTrack(post.data.category);
            const isAcademy = track === "academy";

            return (
              <article
                class:list={[
                  "group flex flex-col items-start gap-3",
                  {
                    "bg-primary/5 p-5 rounded-xl border border-primary/10 hover:border-primary/20 transition-colors":
                      isAcademy,
                  },
                ]}
              >
                {post.data.heroImage && (
                  <a
                    href={href}
                    class="w-full aspect-[16/10] overflow-hidden rounded-lg border border-border bg-muted/20"
                  >
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                )}
                <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-widest">
                  <span
                    class:list={[
                      "px-2 py-0.5 rounded-md",
                      isAcademy
                        ? "bg-primary text-primary-foreground"
                        : "bg-foreground text-background",
                    ]}
                  >
                    {isAcademy ? "Academy" : "Magazine"}
                  </span>
                  <span class="text-muted-foreground/40">/</span>
                  <span class="text-muted-foreground">
                    {post.data.category}
                  </span>
                </div>

                <h2 class="text-xl font-bold leading-snug group-hover:text-primary transition-colors tracking-tight">
                  <a href={href}>
                    {isAcademy && chapter !== null && (
                      <span class="text-primary mr-1.5">#{chapter}</span>
                    )}
                    {post.data.title}
                  </a>
                </h2>

                <div class="flex items-center gap-3 text-[11px] text-muted-foreground/60">
                  {post.data.pubDate && (
                    <span>
                      {post.data.pubDate.toLocaleDateString(
                        locale === "ko" ? "ko-KR" : "en-US",
                        { month: "short", day: "numeric", year: "numeric" },
                      )}
                    </span>
                  )}
                  {post.data.author && (
                    <>
                      <span>·</span>
                      <span>{post.data.author}</span>
                    </>
                  )}
                </div>

                <p class="text-muted-foreground line-clamp-3 text-sm leading-relaxed">
                  {post.data.description}
                </p>
              </article>
            );
          })
        }
      </div>

      {
        paginationEnabled && page.lastPage > 1 && (
          <Pagination
            currentPage={page.currentPage}
            totalPages={page.lastPage}
            baseUrl={baseUrl}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
