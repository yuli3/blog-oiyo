---
type ToolSeoCard = {
  title: string;
  body: string;
};

type ToolSeoFaq = {
  question: string;
  answer: string;
};

type ToolSeoLink = {
  href: string;
  label: string;
  desc: string;
};

export type ToolSeoContent = {
  eyebrow: string;
  introTitle: string;
  intro: string;
  howToTitle: string;
  steps: string[];
  highlightsTitle: string;
  highlights: ToolSeoCard[];
  faqTitle: string;
  faqs: ToolSeoFaq[];
  relatedTitle: string;
  related: ToolSeoLink[];
  disclaimer: string;
};

interface Props {
  title: string;
  description: string;
  locale: string;
  slug: string;
  content: ToolSeoContent;
  applicationCategory?: string;
}

const {
  title,
  description,
  locale,
  slug,
  content,
  applicationCategory = "FinanceApplication",
} = Astro.props;

const pageUrl = `https://blog.oiyo.net/${locale}/${slug}/`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      name: title,
      url: pageUrl,
      applicationCategory,
      operatingSystem: "Web",
      description,
      isAccessibleForFree: true,
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      name: content.howToTitle,
      step: content.steps.map((step, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        text: step,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: content.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Tools",
          item: `https://blog.oiyo.net/${locale}/tools/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: title,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

<div class="mx-auto max-w-3xl px-4 py-8">
  <section class="mb-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">{content.eyebrow}</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">{title}</h1>
    <p class="mt-4 leading-8 text-slate-700">{description}</p>
  </section>

  <slot />

  <section class="mt-10 border-t border-slate-200 pt-8">
    <h2 class="text-2xl font-bold text-slate-950">{content.introTitle}</h2>
    <p class="mt-4 leading-8 text-slate-700">{content.intro}</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-950">{content.howToTitle}</h2>
    <ol class="mt-4 grid gap-3">
      {content.steps.map((step, index) => (
        <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-black text-emerald-800">
            {index + 1}
          </span>
          <span class="leading-7 text-slate-700">{step}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-950">{content.highlightsTitle}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {content.highlights.map((item) => (
        <article class="rounded-xl bg-emerald-50 p-4">
          <h3 class="font-semibold text-slate-950">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-700">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-950">{content.faqTitle}</h2>
    <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
      {content.faqs.map((faq) => (
        <details class="group p-4">
          <summary class="cursor-pointer list-none font-semibold text-slate-950">
            {faq.question}
          </summary>
          <p class="mt-3 text-sm leading-6 text-slate-700">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-950">{content.relatedTitle}</h2>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {content.related.map((item) => (
        <a class="rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-emerald-300 hover:bg-emerald-50" href={item.href}>
          <span class="font-semibold text-slate-950">{item.label}</span>
          <span class="mt-2 block text-sm leading-6 text-slate-700">{item.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <p class="mt-10 rounded-xl bg-slate-100 p-4 text-sm leading-6 text-slate-700">
    {content.disclaimer}
  </p>
</div>
