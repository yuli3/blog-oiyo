---
interface Props {
  category?: string;
  locale?: string;
}

const { category = '', locale = 'en' } = Astro.props;

const cat = category.toLowerCase();

type CTAConfig = {
  icon: string;
  title: Record<string, string>;
  desc: Record<string, string>;
  cta: Record<string, string>;
  href: (locale: string) => string;
};

// Keyed by exact lowercased article category. Every target is a live, indexable
// page on oiyo.net (personality / decision / fortune surfaces — oiyo owns those;
// blog's own /tools/ is calculators, not tests). No fuzzy matching: a CTA only
// renders when the category is deliberately mapped, so every rendered link is a
// clean, relevant cross-site signal. (FAANG P1 #10 — was 4 loose keys, one 404.)
const CTA_MAP: Record<string, CTAConfig> = {
  finance: {
    icon: '💰',
    title: { en: 'Know Your Financial Personality', ko: '나의 금융 성향 테스트', ja: 'お金の性格診断', fr: 'Testez votre personnalité financière', es: 'Conoce tu perfil financiero' },
    desc: { en: 'Your numbers tell one story — your money mindset tells another. Take a free test to see how you relate to money.', ko: '숫자는 하나의 이야기, 돈을 대하는 마음은 다른 이야기를 합니다. 무료 검사로 나의 금융 성향을 확인해보세요.', ja: '数字は一つの物語、お金への向き合い方は別の物語です。無料テストであなたの金銭傾向を確認しましょう。', fr: 'Les chiffres racontent une histoire, votre rapport à l’argent en raconte une autre. Faites un test gratuit.', es: 'Los números cuentan una historia, tu relación con el dinero cuenta otra. Haz un test gratuito.' },
    cta: { en: 'Take a Money Test →', ko: '금융 성향 검사 하기 →', ja: 'お金のテストを受ける →', fr: 'Faire le test →', es: 'Hacer el test →' },
    href: (locale) => `https://oiyo.net/${locale}/tests/`,
  },
  economics: {
    icon: '🎯',
    title: { en: 'Spot Your Decision-Making Biases', ko: '나의 의사결정 편향 확인', ja: '意思決定バイアスを見つける', fr: 'Repérez vos biais de décision', es: 'Detecta tus sesgos de decisión' },
    desc: { en: 'Behavioral economics shows that biases shape your choices more than you know. Take a free test to spot yours.', ko: '행동경제학은 편향이 생각보다 우리 선택을 크게 좌우한다고 말합니다. 무료 검사로 나의 편향을 확인해보세요.', ja: '行動経済学は、バイアスが想像以上に選択を左右すると示します。無料テストで自分のバイアスを確認しましょう。', fr: 'L’économie comportementale montre que les biais pèsent plus qu’on ne le croit. Faites un test gratuit.', es: 'La economía del comportamiento muestra que los sesgos pesan más de lo que crees. Haz un test gratuito.' },
    cta: { en: 'Take the Bias Test →', ko: '편향 검사 하기 →', ja: 'バイアステストを受ける →', fr: 'Faire le test de biais →', es: 'Hacer el test de sesgos →' },
    href: (locale) => `https://oiyo.net/${locale}/cognitive-bias-test/`,
  },
  philosophy: {
    icon: '🔮',
    title: { en: 'Explore Your Core Motivations', ko: '나의 근본 동기 탐구', ja: '核心的な動機を探求する', fr: 'Explorez vos motivations profondes', es: 'Explora tus motivaciones fundamentales' },
    desc: { en: 'Uncover the deep drives behind how you think and act. Start with a free personality or self-understanding test.', ko: '당신의 생각과 행동 이면의 깊은 동기를 발견하세요. 무료 성격·자기이해 검사로 시작해보세요.', ja: 'あなたの思考と行動の背後にある深い動機を発見してください。無料の性格・自己理解テストから。', fr: 'Découvrez les motivations profondes derrière vos pensées et vos actes. Commencez par un test gratuit.', es: 'Descubre las motivaciones profundas detrás de cómo piensas y actúas. Empieza con un test gratuito.' },
    cta: { en: 'Explore the Tests →', ko: '검사 둘러보기 →', ja: 'テストを見る →', fr: 'Voir les tests →', es: 'Ver los tests →' },
    href: (locale) => `https://oiyo.net/${locale}/tests/`,
  },
  lifestyle: {
    icon: '✨',
    title: { en: 'Today’s Fortune & Tarot', ko: '오늘의 운세와 타로', ja: '今日の運勢とタロット', fr: 'Fortune & tarot du jour', es: 'Fortuna y tarot de hoy' },
    desc: { en: 'From your birth date alone: today’s fortune across saju, zodiac and star sign — plus a tarot card. A short ritual to open your day.', ko: '생년월일만으로 보는 사주·띠·별자리 오늘의 운세, 그리고 타로 한 장. 하루를 여는 짧은 리추얼.', ja: '生年月日だけで見る四柱推命・干支・星座の今日の運勢と、タロット一枚。一日を開く短いリチュアル。', fr: 'À partir de votre date de naissance : la fortune du jour (saju, zodiaque, signe) et une carte de tarot.', es: 'Solo con tu fecha de nacimiento: la fortuna de hoy (saju, zodiaco, signo) y una carta de tarot.' },
    cta: { en: 'See Today’s Fortune →', ko: '오늘의 운세 보기 →', ja: '今日の運勢を見る →', fr: 'Voir la fortune du jour →', es: 'Ver la fortuna de hoy →' },
    href: (locale) => `https://oiyo.net/${locale}/today/`,
  },
};

// Exact match only — the category must be deliberately mapped above.
function matchCTA(category: string): CTAConfig | null {
  return CTA_MAP[category.toLowerCase()] ?? null;
}

const config = matchCTA(cat);

const l = config && (locale in config.title) ? locale : 'en';
const title = config?.title[l] ?? config?.title['en'];
const desc = config?.desc[l] ?? config?.desc['en'];
const cta = config?.cta[l] ?? config?.cta['en'];
const href = config ? config.href(l) : '';
---

{config && (
<aside class="my-7 sm:my-12 rounded-2xl border border-primary/20 bg-primary/5 px-4 sm:px-6 py-5 sm:py-8 text-center not-prose">
  <div class="text-3xl mb-3">{config.icon}</div>
  <h3 class="text-lg font-bold tracking-tight mb-2">{title}</h3>
  <p class="text-sm text-muted-foreground max-w-md mx-auto mb-5">{desc}</p>
  <a
    href={href}
    class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors"
  >
    {cta}
  </a>
</aside>
)}
