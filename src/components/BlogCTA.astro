---
interface Props {
  category?: string;
  locale?: string;
}

const { category = '', locale = 'en' } = Astro.props;

const cat = category.toLowerCase();

type CTAConfig = {
  icon: string;
  title: Record<string, string>;
  desc: Record<string, string>;
  cta: Record<string, string>;
  href: (locale: string) => string;
};

const CTA_MAP: Record<string, CTAConfig> = {
  psychology: {
    icon: '🧠',
    title: { en: 'Discover Your Personality Type', ko: '나의 성격 유형 알아보기', ja: '自分の性格タイプを発見', fr: 'Découvrez votre type de personnalité', es: 'Descubre tu tipo de personalidad' },
    desc: { en: 'Take the free personality tests and uncover your cognitive style — MBTI, narcissism tendency, stress type, and more.', ko: '무료 성격 테스트로 나의 인지 스타일을 발견하세요 — MBTI, 나르시시즘, 스트레스 유형 등 다양한 도구가 있습니다.', ja: '無料の性格テストで認知スタイルを発見してください — MBTI、ナルシシズム、ストレスタイプなど。', fr: 'Découvrez votre style cognitif avec nos tests gratuits — MBTI, narcissisme, type de stress.', es: 'Descubre tu estilo cognitivo con tests gratuitos — MBTI, narcisismo, tipo de estrés.' },
    cta: { en: 'Explore Personality Tools →', ko: '성격 테스트 도구 모음 →', ja: '性格テストツールを見る →', fr: 'Explorer les outils personnalité →', es: 'Explorar herramientas de personalidad →' },
    href: (locale) => `/${locale}/tools/`,
  },
  finance: {
    icon: '💰',
    title: { en: 'Know Your Financial Personality', ko: '나의 금융 성향 테스트', ja: '投資性格診断', fr: 'Testez votre personnalité financière', es: 'Conoce tu perfil financiero' },
    desc: { en: 'Your numbers tell one story — your personality tells another. Explore our finance and decision-making tools.', ko: '숫자는 하나의 이야기, 성격은 다른 이야기를 합니다. 금융·의사결정 도구를 탐색해보세요.', ja: '数字は一つの物語、性格は別の物語を語ります。金融・意思決定ツールをご利用ください。', fr: 'Les chiffres racontent une histoire, votre personnalité en raconte une autre. Explorez nos outils.', es: 'Los números cuentan una historia, tu personalidad cuenta otra. Explora nuestras herramientas.' },
    cta: { en: 'Explore Finance Tools →', ko: '금융 도구 모음 →', ja: '金融ツールを探索する →', fr: 'Explorer les outils finance →', es: 'Explorar herramientas financieras →' },
    href: (locale) => `/${locale}/tools/`,
  },
  'behavioral economics': {
    icon: '🎯',
    title: { en: 'Understand Your Decision-Making Style', ko: '나의 의사결정 성향 파악', ja: '意思決定スタイルを理解する', fr: 'Comprendre votre style de décision', es: 'Comprende tu estilo de toma de decisiones' },
    desc: { en: 'Behavioral biases shape your choices more than you know. Explore personality and decision-making tools to understand yourself better.', ko: '행동 편향이 당신의 선택에 생각보다 더 큰 영향을 미칩니다. 성격·의사결정 도구로 자신을 탐구해보세요.', ja: '行動バイアスはあなたの選択に想像以上の影響を与えます。性格・意思決定ツールで自分を探求しましょう。', fr: 'Les biais comportementaux influencent vos choix plus que vous ne le croyez. Explorez nos outils.', es: 'Los sesgos conductuales moldean tus elecciones más de lo que crees. Explora nuestras herramientas.' },
    cta: { en: 'Explore Decision Tools →', ko: '의사결정 도구 탐색 →', ja: '意思決定ツールを探索する →', fr: 'Explorer les outils de décision →', es: 'Explorar herramientas de decisión →' },
    href: (locale) => `/${locale}/tools/`,
  },
  philosophy: {
    icon: '🔮',
    title: { en: 'Explore Your Core Motivations', ko: '나의 근본 동기 탐구', ja: '核心的な動機を探求する', fr: 'Explorez vos motivations profondes', es: 'Explora tus motivaciones fundamentales' },
    desc: { en: 'Uncover the deep drives behind how you think and act. Explore personality type tests and self-discovery tools.', ko: '당신의 생각과 행동 이면의 깊은 동기를 발견하세요. 성격 유형 테스트와 자기 탐구 도구를 이용해보세요.', ja: 'あなたの思考と行動の背後にある深い動機を発見してください。性格タイプテストと自己発見ツールをご利用ください。', fr: 'Découvrez les motivations profondes derrière vos pensées et actions. Explorez les outils de découverte.', es: 'Descubre las motivaciones profundas detrás de cómo piensas y actúas. Explora herramientas de autodescubrimiento.' },
    cta: { en: 'Explore Self-Discovery Tools →', ko: '자기 탐구 도구 모음 →', ja: '自己発見ツールを探索 →', fr: 'Explorer les outils de découverte →', es: 'Explorar herramientas de autodescubrimiento →' },
    href: (locale) => `/${locale}/tools/`,
  },
  life: {
    icon: '✨',
    title: { en: 'Get Your Daily Tarot Card', ko: '오늘의 타로 카드', ja: '今日のタロットカード', fr: 'Tirez votre carte tarot du jour', es: 'Tu carta tarot del día' },
    desc: { en: 'Draw a daily tarot card for reflection and insight. A moment of mindfulness to start or end your day.', ko: '매일 타로 카드를 뽑아 하루를 돌아보세요. 하루를 시작하거나 마무리하는 마음챙김의 순간.', ja: '毎日タロットカードを引いて、一日を振り返りましょう。マインドフルネスのひとときを。', fr: 'Tirez une carte tarot quotidienne pour la réflexion. Un moment de pleine conscience.', es: 'Saca una carta tarot diaria para reflexionar. Un momento de mindfulness para tu día.' },
    cta: { en: 'Draw Today\'s Card →', ko: '오늘의 카드 뽑기 →', ja: '今日のカードを引く →', fr: 'Tirer ma carte du jour →', es: 'Sacar mi carta del día →' },
    href: (locale) => `/${locale}/tools/tarot-daily-card/`,
  },
};

// Category matching — try exact, then partial
function matchCTA(category: string): CTAConfig | null {
  const lower = category.toLowerCase();
  if (CTA_MAP[lower]) return CTA_MAP[lower];
  for (const key of Object.keys(CTA_MAP)) {
    if (lower.includes(key) || key.includes(lower)) return CTA_MAP[key];
  }
  return null;
}

const config = matchCTA(cat);

const l = config && (locale in config.title) ? locale : 'en';
const title = config?.title[l] ?? config?.title['en'];
const desc = config?.desc[l] ?? config?.desc['en'];
const cta = config?.cta[l] ?? config?.cta['en'];
const href = config ? config.href(l) : '';
---

{config && (
<aside class="my-12 rounded-2xl border border-primary/20 bg-primary/5 px-6 py-8 text-center not-prose">
  <div class="text-3xl mb-3">{config.icon}</div>
  <h3 class="text-lg font-bold tracking-tight mb-2">{title}</h3>
  <p class="text-sm text-muted-foreground max-w-md mx-auto mb-5">{desc}</p>
  <a
    href={href}
    class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors"
  >
    {cta}
  </a>
</aside>
)}
