---
/**
 * Academy category landing: series cards instead of flat BlogList (B2).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SeriesCardGrid from "./SeriesCardGrid.astro";
import type { SeriesEntry } from "../lib/wiki-index";

interface Props {
  locale: string;
  title: string;
  subtitle: string;
  seriesList: SeriesEntry[];
  /** One-post "series" — rendered as plain links, not course cards. */
  articleList?: SeriesEntry[];
  coursesLabel?: string;
  articlesLabel?: string;
  articlesHint?: string;
  chaptersLabel: string;
  ctaLabel: string;
  availableLocales?: string[];
  jsonLd?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  subtitle,
  seriesList,
  articleList = [],
  coursesLabel,
  articlesLabel,
  articlesHint,
  chaptersLabel,
  ctaLabel,
  availableLocales,
  jsonLd,
  noindex,
} = Astro.props;
---

<BaseLayout title={title} description={subtitle} availableLocales={availableLocales} noindex={noindex}>
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <div class="mb-7 sm:mb-12 max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4 text-foreground">
          {title}
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {subtitle}
        </p>
      </div>

      {seriesList.length > 0 && (
        <>
          {articleList.length > 0 && coursesLabel && (
            <h2 class="mb-4 text-sm font-black uppercase tracking-[0.18em] text-muted-foreground">
              {coursesLabel}
            </h2>
          )}
          <SeriesCardGrid
            seriesList={seriesList}
            locale={locale}
            chaptersLabel={chaptersLabel}
            ctaLabel={ctaLabel}
          />
        </>
      )}

      {articleList.length > 0 && (
        <div class={seriesList.length > 0 ? "mt-12 sm:mt-16" : ""}>
          {articlesLabel && (
            <h2 class="mb-1 text-sm font-black uppercase tracking-[0.18em] text-muted-foreground">
              {articlesLabel}
            </h2>
          )}
          {articlesHint && (
            <p class="mb-4 text-sm text-muted-foreground">{articlesHint}</p>
          )}
          <ul class="divide-y divide-border rounded-xl border border-border">
            {articleList.map((s) => (
              <li>
                <a
                  href={`/${locale}/${s.firstPost.slug.split("/").slice(1).join("/")}/`}
                  class="block px-4 py-3 text-sm font-medium text-foreground transition-colors hover:bg-muted/50 hover:text-primary"
                >
                  {s.firstPost.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
