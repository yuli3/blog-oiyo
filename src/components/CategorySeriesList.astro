---
/**
 * Academy category landing: series cards instead of flat BlogList (B2).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SeriesCardGrid from "./SeriesCardGrid.astro";
import type { SeriesEntry } from "../lib/wiki-index";

interface Props {
  locale: string;
  title: string;
  subtitle: string;
  seriesList: SeriesEntry[];
  chaptersLabel: string;
  ctaLabel: string;
  availableLocales?: string[];
  jsonLd?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  subtitle,
  seriesList,
  chaptersLabel,
  ctaLabel,
  availableLocales,
  jsonLd,
  noindex,
} = Astro.props;
---

<BaseLayout title={title} description={subtitle} availableLocales={availableLocales} noindex={noindex}>
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <div class="mb-7 sm:mb-12 max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4 text-foreground">
          {title}
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {subtitle}
        </p>
      </div>

      <SeriesCardGrid
        seriesList={seriesList}
        locale={locale}
        chaptersLabel={chaptersLabel}
        ctaLabel={ctaLabel}
      />
    </div>
  </section>
</BaseLayout>
