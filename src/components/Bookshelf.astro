---
/**
 * 과목을 책등으로 세운 책장.
 *
 * 2026-10-13 세운 요청: books.euiyun.com 랜딩의 "책장" 느낌을 blog·wiki에 가져온다.
 * blog-oiyo 와 wiki-oiyo 의 src/components/Bookshelf.astro 는 같은 파일이다. 고치면 둘 다 고친다.
 * 가져온 것은 메타포(나무 책장, 선반마다 학문, 책등 하나가 과목, 누르면 1장)뿐이고,
 * 그쪽의 그림·CSS 값·문장은 옮기지 않는다(reference-books-euiyun §8.6).
 *
 * 첫 판(평면 책등)은 "원작보다 퀄리티가 낮다"는 세운 피드백을 받았다. 그래서 책장
 * 프레임·어두운 안쪽·선반 판을 따로 두고, 책등마다 색을 돌리고, 위 금박 띠·세로
 * 제목·아래 장 수의 세 칸과 좌우 그라데이션으로 둥근 등을 낸다. 패밀리는 그림자를
 * 꺼 두었으므로(global.css @theme) 입체감은 그라데이션과 테두리로만 만든다.
 *
 * 높이·폭은 장 수와 제목 길이 구간으로 몇 단계만 쓴다. 값을 픽셀로 계산하면
 * 임의값이 되고(shadcn lint), 30장짜리 과목이 선반 밖으로 튀어나간다.
 */
export type ShelfTint = "chart-1" | "chart-2" | "chart-3" | "chart-4" | "chart-5";

export interface ShelfBook {
  title: string;
  href: string;
  chapters: number;
  /** 책등 아래에 찍는 짧은 코드. 없으면 장 수를 쓴다. */
  code?: string;
}

export interface Shelf {
  id: string;
  label: string;
  /** 선반 이름이 가리킬 학문 페이지. 학문 여러 개를 모은 선반이면 비운다. */
  href?: string;
  tint: ShelfTint;
  books: ShelfBook[];
  more: number;
}

interface Props {
  chapterWord: string;
  moreLabel: string;
  shelves: Shelf[];
}

const { chapterWord, moreLabel, shelves } = Astro.props;

// 긴 제목은 글자를 줄이고 키를 키워서 세로 한 줄에 들어가게 한다.
const height = (chapters: number, title: string) =>
  Math.max(chapters >= 15 ? 4 : chapters >= 10 ? 3 : chapters >= 5 ? 2 : 1, title.length >= 10 ? 3 : 1);
const width = (title: string) => (title.length >= 9 ? 3 : title.length >= 6 ? 2 : 1);
// 선반마다 시작 색을 밀어서 같은 색이 위아래로 겹쳐 보이지 않게 한다.
const spine = (shelfIndex: number, bookIndex: number) => ((shelfIndex * 3 + bookIndex) % 8) + 1;
// 책이 많은 선반은 두 칸을 다 쓴다. 반 칸에 넣으면 대부분이 가로 스크롤 뒤로 숨는다.
const wide = (shelf: Shelf) => shelf.books.length + (shelf.more > 0 ? 1 : 0) > 10;
---

<section class="mb-10 sm:mb-14">
  <div class="rounded-xl border-4 border-shelf-frame bg-shelf-frame">
    <div class="grid gap-x-4 rounded-lg bg-shelf-back px-3 pb-2 pt-4 sm:px-5 lg:grid-cols-2">
      {shelves.map((shelf, shelfIndex) => (
        <div
          class:list={[
            "flex min-w-0 flex-col pb-4",
            (wide(shelf) || (shelfIndex === shelves.length - 1 && shelfIndex % 2 === 0)) && "lg:col-span-2",
          ]}
        >
          {shelf.href ? (
            <a
              href={shelf.href}
              class="inline-flex w-fit items-baseline gap-2 text-xs text-shelf-ink/70 hover:text-shelf-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <span class="font-mono tabular-nums">{String(shelfIndex + 1).padStart(2, "0")}</span>
              <span class="font-semibold text-shelf-ink">{shelf.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <p class="inline-flex w-fit items-baseline gap-2 text-xs text-shelf-ink/70">
              <span class="font-mono tabular-nums">{String(shelfIndex + 1).padStart(2, "0")}</span>
              <span class="font-semibold text-shelf-ink">{shelf.label}</span>
            </p>
          )}
          <ul class="mt-3 flex flex-1 items-end gap-0.5 overflow-x-auto px-1 pt-3" aria-label={shelf.label}>
            {shelf.books.map((book, bookIndex) => {
              const h = height(book.chapters, book.title);
              const w = width(book.title);
              const c = spine(shelfIndex, bookIndex);
              return (
                <li class="shrink-0">
                  <a
                    href={book.href}
                    title={`${book.title} · ${book.chapters} ${chapterWord}`}
                    class:list={[
                      "group relative flex flex-col items-center overflow-hidden rounded-t-sm border-x border-black/25 text-white transition-transform duration-300 motion-safe:hover:-translate-y-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-shelf-ink",
                      h === 1 && "h-40",
                      h === 2 && "h-44",
                      h === 3 && "h-48",
                      h === 4 && "h-52",
                      w === 1 && "w-10",
                      w === 2 && "w-11",
                      w === 3 && "w-12",
                      c === 1 && "bg-spine-1",
                      c === 2 && "bg-spine-2",
                      c === 3 && "bg-spine-3",
                      c === 4 && "bg-spine-4",
                      c === 5 && "bg-spine-5",
                      c === 6 && "bg-spine-6",
                      c === 7 && "bg-spine-7",
                      c === 8 && "bg-spine-8",
                    ]}
                  >
                    <span aria-hidden="true" class="mt-2 h-1 w-full border-y border-white/40"></span>
                    <span
                      class:list={[
                        "writing-vertical mt-2 min-h-0 flex-1 overflow-hidden whitespace-nowrap font-bold leading-tight tracking-tight",
                        book.title.length >= 10 ? "text-xs" : "text-sm",
                      ]}
                    >
                      {book.title}
                    </span>
                    <span aria-hidden="true" class="w-full border-t border-white/30 bg-black/15 py-1 text-center font-mono text-xs tabular-nums text-white/85">
                      {book.code ?? book.chapters}
                    </span>
                    <span class="sr-only">{book.chapters} {chapterWord}</span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-0 bg-linear-to-r from-white/20 via-white/0 to-black/35"
                    ></span>
                  </a>
                </li>
              );
            })}
            {shelf.more > 0 && shelf.href && (
              <li class="shrink-0 pl-1.5">
                <a
                  href={shelf.href}
                  class="flex h-40 w-10 items-center justify-center rounded-t-sm border border-dashed border-shelf-ink/40 text-xs font-semibold text-shelf-ink/80 hover:border-shelf-ink hover:text-shelf-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-shelf-ink"
                >
                  <span class="writing-vertical">{moreLabel.replace("{count}", String(shelf.more))}</span>
                </a>
              </li>
            )}
          </ul>
          <div class="h-3 rounded-sm border-b-4 border-shelf-frame bg-shelf-plank" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>
