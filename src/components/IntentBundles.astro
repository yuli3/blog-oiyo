---

<div class="mb-10">
  <!-- Section divider header -->
  <div class="flex items-center gap-3 mb-6">
    <div class="flex-1 h-px bg-border"></div>
    <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
      빠른 탐색
    </span>
    <div class="flex-1 h-px bg-border"></div>
  </div>

  <!-- Intent grid -->
  <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
    {bundles.map((bundle) => (
      <a
        href={bundle.href}
        class="group flex flex-col gap-3 p-4 md:p-5 rounded-2xl border border-border bg-background hover:shadow-lg transition-all duration-200 hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        aria-label={`${bundle.title} — ${bundle.subtitle}`}
      >
        <!-- Icon circle -->
        <div
          class:list={[
            "w-10 h-10 rounded-full flex items-center justify-center shrink-0",
            bundle.bgColor,
          ]}
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class:list={["w-5 h-5", bundle.iconColor]}
          >
            <Fragment set:html={bundle.svgPath} />
          </svg>
        </div>

        <!-- Text -->
        <div>
          <p class="text-sm font-bold text-foreground leading-snug">
            {bundle.title}
          </p>
          <p class="mt-0.5 text-xs text-muted-foreground leading-relaxed">
            {bundle.subtitle}
          </p>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none !important;
    }
    a:hover {
      transform: none !important;
    }
  }
</style>
