---
// ahoxy.com에서 리다이렉트되어 온 방문자 안내 팝오버.
// utm_source=ahoxy 감지 시 1회 노출(localStorage로 재노출 억제), 8초 후 자동 닫힘.
// oiyo/blog/wiki/game 4개 레포에 동일 사본 유지 (in-repo copy rule).
//
// 카피는 빌드 시점에 페이지 로케일 하나만 렌더한다. 예전 구조는 ko/en 마크업을
// 둘 다 실어 보내고 클라이언트에서 `[data-ko]`/`[data-en]`을 토글했는데,
// (1) 페이지 로케일은 빌드 때 이미 알고 있어 토글이 불필요했고
// (2) ko가 아닌 페이지의 HTML에 한국어가 그대로 남아 있었으며
// (3) 언어를 늘리려면 마크업을 언어 수만큼 복제해야 했다.
// repo마다 Locale 타입 경로가 달라 4개 사본을 바이트 동일하게 두려고
// 여기서는 문자열로 받아 해석한다.
type Copy = { title: string; body: string; tools: string; games: string; guides: string; dict: string };

const COPY: Record<string, Copy> = {
  ko: {
    title: "Ahoxy는 OIYO 패밀리가 되었습니다 👋",
    body: "찾으시던 콘텐츠는 아래 사이트에서 계속 이용할 수 있어요.",
    tools: "심리테스트·도구", games: "게임", guides: "정보·강의", dict: "사전·위키",
  },
  en: {
    title: "Ahoxy is now part of the OIYO family 👋",
    body: "Everything you used lives on across these sites.",
    tools: "Tests & tools", games: "Games", guides: "Guides & lessons", dict: "Dictionary",
  },
  ja: {
    title: "AhoxyはOIYOファミリーになりました 👋",
    body: "お探しのコンテンツは以下のサイトで引き続きご利用いただけます。",
    tools: "心理テスト・ツール", games: "ゲーム", guides: "情報・講座", dict: "事典・ウィキ",
  },
  zh: {
    title: "Ahoxy 已加入 OIYO 家族 👋",
    body: "你需要的内容都在下面这些站点继续提供。",
    tools: "心理测试与工具", games: "游戏", guides: "指南与课程", dict: "词典 · 维基",
  },
  fr: {
    title: "Ahoxy fait désormais partie de la famille OIYO 👋",
    body: "Tout ce que vous utilisiez continue de vivre sur ces sites.",
    tools: "Tests et outils", games: "Jeux", guides: "Guides et cours", dict: "Dictionnaire",
  },
  es: {
    title: "Ahoxy ahora forma parte de la familia OIYO 👋",
    body: "Todo lo que usabas sigue disponible en estos sitios.",
    tools: "Tests y herramientas", games: "Juegos", guides: "Guías y cursos", dict: "Diccionario",
  },
};

interface Props {
  /** 페이지 로케일. 미지정·미지원이면 en 으로 떨어진다 (ko 로 떨어뜨리면 타 로케일에 한국어가 노출된다). */
  locale?: string;
}

const { locale = "en" } = Astro.props as Props;
const t = COPY[locale] ?? COPY.en;

const FAMILY = [
  { href: "https://oiyo.net", label: "oiyo.net", desc: t.tools },
  { href: "https://game.oiyo.net", label: "game.oiyo.net", desc: t.games },
  { href: "https://blog.oiyo.net", label: "blog.oiyo.net", desc: t.guides },
  { href: "https://wiki.oiyo.net", label: "wiki.oiyo.net", desc: t.dict },
];
---

<div id="ahoxy-welcome" hidden
  class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-md rounded-2xl border border-lime-300 bg-white p-4 shadow-2xl sm:inset-x-auto sm:right-4">
  <div class="flex items-start justify-between gap-2">
    <p class="text-sm font-black text-slate-900">{t.title}</p>
    <button id="ahoxy-welcome-close" aria-label="close"
      class="shrink-0 rounded-full px-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">✕</button>
  </div>
  <p class="mt-1 text-xs leading-5 text-slate-500">{t.body}</p>
  <ul class="mt-3 grid grid-cols-2 gap-1.5 text-xs">
    {FAMILY.map((f) => (
      <li>
        <a href={f.href} class="flex flex-col rounded-xl border border-slate-100 bg-slate-50 px-3 py-2 hover:border-lime-400">
          <b class="text-slate-800">{f.label}</b>
          <span class="text-slate-500">{f.desc}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  (() => {
    try {
      const KEY = "oiyo:ahoxy-welcome:v1";
      const q = new URLSearchParams(location.search);
      if (q.get("utm_source") !== "ahoxy" || localStorage.getItem(KEY)) return;
      const el = document.getElementById("ahoxy-welcome");
      if (!el) return;
      el.hidden = false;
      localStorage.setItem(KEY, "1");
      const close = () => el.remove();
      document.getElementById("ahoxy-welcome-close")?.addEventListener("click", close);
      setTimeout(close, 8000);
    } catch { /* storage/DOM unavailable — never break the page */ }
  })();
</script>
