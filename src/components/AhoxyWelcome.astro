---
// ahoxy.com에서 리다이렉트되어 온 방문자 안내 팝오버.
// utm_source=ahoxy 감지 시 1회 노출(localStorage로 재노출 억제), 8초 후 자동 닫힘.
// oiyo/blog/wiki/game 4개 레포에 동일 사본 유지 (in-repo copy rule).
const FAMILY = [
  { href: "https://oiyo.net", ko: "심리테스트·도구", en: "Tests & tools", label: "oiyo.net" },
  { href: "https://game.oiyo.net", ko: "게임", en: "Games", label: "game.oiyo.net" },
  { href: "https://blog.oiyo.net", ko: "정보·강의", en: "Guides & lessons", label: "blog.oiyo.net" },
  { href: "https://wiki.oiyo.net", ko: "사전·위키", en: "Dictionary", label: "wiki.oiyo.net" },
];
---

<div id="ahoxy-welcome" hidden
  class="fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-md rounded-2xl border border-lime-300 bg-white p-4 shadow-2xl sm:inset-x-auto sm:right-4">
  <div class="flex items-start justify-between gap-2">
    <p class="text-sm font-black text-slate-900">
      <span data-ko>Ahoxy는 OIYO 패밀리가 되었습니다 👋</span>
      <span data-en hidden>Ahoxy is now part of the OIYO family 👋</span>
    </p>
    <button id="ahoxy-welcome-close" aria-label="close"
      class="shrink-0 rounded-full px-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">✕</button>
  </div>
  <p class="mt-1 text-xs leading-5 text-slate-500">
    <span data-ko>찾으시던 콘텐츠는 아래 사이트에서 계속 이용할 수 있어요.</span>
    <span data-en hidden>Everything you used lives on across these sites.</span>
  </p>
  <ul class="mt-3 grid grid-cols-2 gap-1.5 text-xs">
    {FAMILY.map((f) => (
      <li>
        <a href={f.href} class="flex flex-col rounded-xl border border-slate-100 bg-slate-50 px-3 py-2 hover:border-lime-400">
          <b class="text-slate-800">{f.label}</b>
          <span class="text-slate-500"><span data-ko>{f.ko}</span><span data-en hidden>{f.en}</span></span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  (() => {
    try {
      const KEY = "oiyo:ahoxy-welcome:v1";
      const q = new URLSearchParams(location.search);
      if (q.get("utm_source") !== "ahoxy" || localStorage.getItem(KEY)) return;
      const el = document.getElementById("ahoxy-welcome");
      if (!el) return;
      const lang = (document.documentElement.lang || "en").slice(0, 2);
      if (lang !== "ko") {
        el.querySelectorAll("[data-ko]").forEach((n) => (n.hidden = true));
        el.querySelectorAll("[data-en]").forEach((n) => (n.hidden = false));
      }
      el.hidden = false;
      localStorage.setItem(KEY, "1");
      const close = () => el.remove();
      document.getElementById("ahoxy-welcome-close")?.addEventListener("click", close);
      setTimeout(close, 8000);
    } catch { /* storage/DOM unavailable — never break the page */ }
  })();
</script>
