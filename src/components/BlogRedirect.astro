---
import { siteConfig } from "../config/site.config";

// Same-site (blog→blog) redirect stub: meta-refresh + canonical + noindex,follow.
// Used to consolidate duplicate course series onto the kept one.
interface Props {
  locale: string;
  targetPath: string; // locale-less, e.g. "/academy-tax-law-basic-ch1"
}
const { locale, targetPath } = Astro.props;
const rel = `/${locale}${targetPath}/`;
const abs = `${siteConfig.url}${rel}`;

const copy: Record<string, { moved: string; body: string; link: string }> = {
  ko: { moved: "이 강의는 통합되었습니다", body: "중복 정리를 위해 이 시리즈는 더 완성도 높은 세법 강의로 통합했습니다.", link: "통합된 강의로 이동" },
  en: { moved: "This course has been merged", body: "To remove duplication, this series was merged into the more complete tax-law course.", link: "Go to the merged course" },
};
const text = copy[locale] ?? copy.en;
---
<html lang={locale}>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{text.moved}</title>
    <link rel="canonical" href={abs} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${rel}`} />
  </head>
  <body>
    <main style="font-family: system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1rem;">
      <h1>{text.moved}</h1>
      <p>{text.body}</p>
      <p><a href={rel}>{text.link}</a></p>
    </main>
  </body>
</html>
