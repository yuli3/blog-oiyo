---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

const pageUrl = (p: number) => (p === 1 ? `${baseUrl}/` : `${baseUrl}/${p}/`);

const delta = 2;
const range = [];
const paginationRange = [];
let l;

for (let i = 1; i <= totalPages; i++) {
  if (
    i === 1 ||
    i === totalPages ||
    (i >= currentPage - delta && i <= currentPage + delta)
  ) {
    range.push(i);
  }
}

for (let i of range) {
  if (l) {
    if (i - l === 2) {
      paginationRange.push(l + 1);
    } else if (i - l !== 1) {
      paginationRange.push("...");
    }
  }
  paginationRange.push(i);
  l = i;
}
---

{
  totalPages > 1 && (
    <nav class="flex items-center justify-center gap-2 mt-16 animate-fade-up">
      {currentPage > 1 && (
        <a
          href={pageUrl(currentPage - 1)}
          class="flex items-center justify-center w-10 h-10 rounded-xl border border-border/40 hover:bg-primary/10 hover:text-primary transition-all"
          title="Previous Page"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
        </a>
      )}

      {paginationRange.map((p) => {
        if (p === "...") {
          return (
            <span class="flex items-center justify-center w-10 h-10 text-muted-foreground">
              ...
            </span>
          );
        }

        return (
          <a
            href={pageUrl(p as number)}
            class:list={[
              "flex items-center justify-center w-10 h-10 rounded-xl font-bold text-sm transition-all",
              p === currentPage
                ? "bg-primary text-primary-foreground shadow-lg shadow-primary/20 scale-110"
                : "border border-border/40 hover:bg-muted/50",
            ]}
          >
            {p}
          </a>
        );
      })}

      {currentPage < totalPages && (
        <a
          href={pageUrl(currentPage + 1)}
          class="flex items-center justify-center w-10 h-10 rounded-xl border border-border/40 hover:bg-primary/10 hover:text-primary transition-all"
          title="Next Page"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
      )}
    </nav>
  )
}
