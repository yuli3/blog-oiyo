---
import { siteConfig } from "../config/site.config";
import { getAuthor } from "../lib/authors";
import deindexedLocales from "../config/deindexed-locales.json";

// Crawl-budget policy — see astro.config.mjs. These locales stay reachable for
// users but are kept out of the index and out of the sitemap/hreflang cluster.
const DEINDEXED_LOCALES = new Set<string>(deindexedLocales);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  author?: string;
  availableLocales?: string[];
  // Search-result pages must stay out of the index (Google quality guidelines).
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = `${siteConfig.url}/og-image.png`,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = "website",
  pubDate,
  updatedDate,
  tags,
  category,
  author = siteConfig.author,
  availableLocales,
  noindex = false,
} = Astro.props;

const siteTitle =
  title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;

const currentPathname = Astro.url.pathname;
const supportedLocales = siteConfig.locales;
const currentLocale = supportedLocales.includes(currentPathname.split("/")[1])
  ? currentPathname.split("/")[1]
  : siteConfig.locale;
// Multilingual hreflang logic.
// Article routes pass availableLocales from actual content siblings.
// Pages generated from the full locale list (home, static tool/listing slugs
// at /{locale}/{slug}/) exist in every locale, so they fall back to the full
// set — hreflang clusters must be reciprocal with a single x-default.
// Pagination (/{locale}/119/) and deeper dynamic routes (category pages)
// vary per locale, so they stay self-referential.
const pathSegments = currentPathname.split("/").filter(Boolean);
const isLocalePath = supportedLocales.includes(pathSegments[0]);
const isLocaleCompleteRoute =
  isLocalePath &&
  (pathSegments.length === 1 ||
    (pathSegments.length === 2 && !/^\d+$/.test(pathSegments[1])));
const allLocales =
  availableLocales ?? (isLocaleCompleteRoute ? supportedLocales : [currentLocale]);
// Deindexed locales are dropped from the hreflang cluster: Google discards
// hreflang annotations pointing at noindex URLs, so advertising them only
// muddies the cluster.
const locales = allLocales.filter((l: string) => !DEINDEXED_LOCALES.has(l));
const xDefaultLocale = locales.includes(siteConfig.locale)
  ? siteConfig.locale
  : (locales.includes(currentLocale) ? currentLocale : locales[0]);

// Helper to generate localized URLs
const getLocalizedUrl = (locale: string) => {
  const firstSegment = currentPathname.split("/")[1];
  // Locale-less pages (e.g. /knowledge) have no per-locale variants — keep the
  // alternate self-referential rather than inventing a non-existent /xx/ URL.
  if (!supportedLocales.includes(firstSegment)) {
    return new URL(currentPathname, Astro.site);
  }

  const restOfPath = currentPathname.replace(`/${firstSegment}`, "") || "/";
  const localizedPath = `/${locale}${restOfPath === "/" ? "/" : restOfPath}`;

  return new URL(localizedPath, Astro.site);
};

const googleAnalyticsId = siteConfig.analytics.googleAnalyticsId;
const googleAdsenseId = siteConfig.analytics.googleAdsenseId;
const resolvedCanonicalUrl = new URL(String(canonicalURL), Astro.site);
const canonicalHost = resolvedCanonicalUrl.hostname;
const isCrossDomainCanonical = canonicalHost !== new URL(siteConfig.url).hostname;
const isDeindexedLocale = DEINDEXED_LOCALES.has(currentLocale);
const robotsContent = noindex || isCrossDomainCanonical || isDeindexedLocale
  ? "noindex, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// BCP-47 locale mapping for hreflang tags
const hreflangMap: Record<string, string> = {
  en: "en", ko: "ko", ja: "ja", fr: "fr", es: "es",
  zh: "zh-CN",
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={siteConfig.themeColor} />

<!-- Robots & Indexing -->
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<meta name="bingbot" content={robotsContent} />

<!-- Preconnect to external origins -->
{googleAnalyticsId && (
  <link rel="preconnect" href="https://www.googletagmanager.com" />
)}
{googleAdsenseId && (
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
  <link rel="preconnect" href="https://googleads.g.doubleclick.net" />
)}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

{googleAnalyticsId && (
  <script is:inline define:vars={{ googleAnalyticsId }}>
    // Local hosts must not report to the production property. Dev and local
    // preview were reaching it: 173 sessions and 2,295 pageviews in 28 days,
    // about a quarter of blog's real volume, which inflated every
    // pageview-based number we reasoned from (2026-08-19).
    // window.gtag is defined either way so callers never have to branch.
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    if (!/^(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])$/.test(location.hostname)) {
      gtag('js', new Date());
      gtag('config', googleAnalyticsId);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + googleAnalyticsId;
      document.head.appendChild(s);
    }
  </script>
)}

{googleAdsenseId && (
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${googleAdsenseId}`}
     crossorigin="anonymous"></script>
)}

<!-- Canonical URL -->
<link rel="canonical" href={resolvedCanonicalUrl} />

<!-- Multilingual SEO (Hreflang) -->
{
  locales.map((locale) => (
    <link rel="alternate" hreflang={hreflangMap[locale] ?? locale} href={getLocalizedUrl(locale)} />
  ))
}
{xDefaultLocale && <link rel="alternate" hreflang="x-default" href={getLocalizedUrl(xDefaultLocale)} />}

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{tags && tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:width" content="1200" />}
{image && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
<!-- og:locale uses BCP-47 with underscore notation -->
<meta property="og:locale" content={(hreflangMap[currentLocale] ?? "en").replace("-", "_")} />

<!-- Article-specific Open Graph meta tags -->
{type === "article" && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === "article" && (updatedDate ?? pubDate) && (
  <meta property="article:modified_time" content={(updatedDate ?? pubDate)!.toISOString()} />
)}
{type === "article" && (
  <meta property="article:author" content={`${siteConfig.url}/about`} />
)}
{type === "article" && category && (
  <meta property="article:section" content={category} />
)}
{type === "article" && tags && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
{image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}
{image && <meta property="twitter:image:alt" content={title} />}
{
  siteConfig.seo.twitterHandle && (
    <meta property="twitter:site" content={siteConfig.seo.twitterHandle} />
  )
}
{
  siteConfig.seo.twitterHandle && (
    <meta property="twitter:creator" content={siteConfig.seo.twitterHandle} />
  )
}

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteConfig.title}
  href="/rss.xml"
/>

<!-- Knowledge catalog (machine-citable data foundation) -->
<link
  rel="alternate"
  type="application/json"
  title="Knowledge Catalog"
  href="/knowledge/index.json"
/>

<!-- JSON-LD Schemas -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": siteConfig.seo.organization.id,
    name: siteConfig.seo.organization.name,
    url: siteConfig.seo.organization.canonicalUrl,
    logo: siteConfig.seo.organization.logo,
    ...(siteConfig.seo.organization.sameAs.length ? { sameAs: siteConfig.seo.organization.sameAs } : {}),
  })}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    publisher: {
      "@id": siteConfig.seo.organization.id,
    },
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteConfig.url}/en/search?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  })}
/>

<!-- Breadcrumb Schema -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: (() => {
      // locale segments are routing noise, and the final crumb should carry
      // the real page title, not a prettified raw slug (#16)
      const localeSegs = new Set(["en", "ko", "ja", "zh", "fr", "es"]);
      const all = Astro.url.pathname.split("/").filter(Boolean);
      const crumbs = all
        .map((segment, index) => ({ segment, path: "/" + all.slice(0, index + 1).join("/") }))
        .filter(({ segment }, index) => !(index === 0 && localeSegs.has(segment)));
      return [
        { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
        ...crumbs.map(({ segment, path }, i) => ({
          "@type": "ListItem",
          position: i + 2,
          name:
            i === crumbs.length - 1 && title
              ? title
              : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " "),
          item: new URL(path, Astro.site),
        })),
      ];
    })(),
  })}
/>

{
  type === "article" && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: description,
        ...(image ? { image: [new URL(image, Astro.url)] } : {}),
        datePublished: pubDate
          ? pubDate.toISOString()
          : new Date().toISOString(),
        dateModified: updatedDate
          ? updatedDate.toISOString()
          : pubDate
            ? pubDate.toISOString()
            : new Date().toISOString(),
        author: {
          "@type": getAuthor(author).schemaType,
          name: author,
          url: `${siteConfig.url}/about`,
          ...(getAuthor(author).knowsAbout?.length
            ? { knowsAbout: getAuthor(author).knowsAbout }
            : {}),
        },
        publisher: {
          "@type": "Organization",
          "@id": siteConfig.seo.organization.id,
          name: siteConfig.seo.organization.name,
          logo: {
            "@type": "ImageObject",
            url: siteConfig.seo.organization.logo,
          },
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url,
        },
      })}
    />
  )
}
