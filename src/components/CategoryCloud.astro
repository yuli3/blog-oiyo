---
import { getCollection } from "astro:content";

interface Props {
  activeCategory?: string;
  locale: string;
}

const { activeCategory, locale } = Astro.props;

const allPosts = await getCollection(
  "blog",
  ({ data }) => data.draft !== true && data.locale === locale,
);
const categoryCounts = allPosts.reduce(
  (acc, post) => {
    const cat = post.data.category;
    if (!cat) return acc;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

import { ACADEMY_CATEGORIES } from "../lib/taxonomy";

const categories = Object.keys(categoryCounts).sort();

const academyCats = categories.filter((cat) =>
  ACADEMY_CATEGORIES.includes(cat),
);
const magazineCats = categories.filter(
  (cat) => !ACADEMY_CATEGORIES.includes(cat),
);
---

<div class="space-y-12 mb-16">
  {/* Academy Section */}
  {
    academyCats.length > 0 && (
      <div class="animate-fade-up">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px flex-1 bg-border/40" />
          <h2 class="text-[10px] font-bold uppercase tracking-[0.3em] text-primary/60">
            OIYO Academy
          </h2>
          <div class="h-px flex-1 bg-border/40" />
        </div>
        <div class="relative">
          <div class="flex overflow-x-auto whitespace-nowrap gap-2 pb-4 scrollbar-hide w-full max-w-full snap-x snap-mandatory mask-gradient">
            {academyCats.map((cat) => {
              const slug = cat.toLowerCase().replace(/[^a-z0-9]+/g, "-");
              const isActive = activeCategory === slug;
              return (
                <a
                  href={
                    locale === "en"
                      ? `/category/${slug}`
                      : `/${locale}/category/${slug}`
                  }
                  class:list={[
                    "px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all border snap-start",
                    isActive
                      ? "bg-primary text-primary-foreground border-primary shadow-lg shadow-primary/20"
                      : "bg-primary/5 text-primary/70 border-primary/20 hover:border-primary/40",
                  ]}
                >
                  {cat}{" "}
                  <span class="ml-1 opacity-40">({categoryCounts[cat]})</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    )
  }

  {/* Magazine Section */}
  {
    magazineCats.length > 0 && (
      <div class="animate-fade-up delay-100">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px flex-1 bg-border/40" />
          <h2 class="text-[10px] font-bold uppercase tracking-[0.3em] text-muted-foreground/60">
            OIYO Magazine
          </h2>
          <div class="h-px flex-1 bg-border/40" />
        </div>
        <div class="relative">
          <div class="flex overflow-x-auto whitespace-nowrap gap-2 pb-4 scrollbar-hide w-full max-w-full snap-x snap-mandatory mask-gradient">
            <a
              href={locale === "en" ? "/" : `/${locale}/`}
              class:list={[
                "px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all border snap-start",
                !activeCategory
                  ? "bg-foreground text-background border-foreground shadow-lg shadow-foreground/10"
                  : "bg-muted/30 text-muted-foreground border-border/40 hover:border-foreground/40 hover:text-foreground",
              ]}
            >
              All Insights
            </a>
            {magazineCats.map((cat) => {
              const slug = cat.toLowerCase().replace(/[^a-z0-9]+/g, "-");
              const isActive = activeCategory === slug;
              return (
                <a
                  href={
                    locale === "en"
                      ? `/category/${slug}`
                      : `/${locale}/category/${slug}`
                  }
                  class:list={[
                    "px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all border snap-start",
                    isActive
                      ? "bg-foreground text-background border-foreground shadow-lg shadow-foreground/10"
                      : "bg-muted/30 text-muted-foreground border-border/40 hover:border-foreground/40 hover:text-foreground",
                  ]}
                >
                  {cat}{" "}
                  <span class="ml-1 opacity-40">({categoryCounts[cat]})</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .mask-gradient {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

  /* Show full text when scrolled or hovered if needed, but for now simple mask helps mobile discoverability */
</style>
