---
/**
 * ChapterSidebar — 강의 챕터 목록 사이드바
 * 시리즈의 모든 챕터를 보여주며 현재 챕터를 강조 표시
 */
interface ChapterPost {
  slug: string;
  data: { title: string };
}

interface Props {
  seriesPosts: ChapterPost[];
  currentChapter: number;
  locale: string;
  seriesName: string;
  coursesHref: string;
}

const { seriesPosts, currentChapter, locale, seriesName, coursesHref } = Astro.props;
const total = seriesPosts.length;
const progressPct = Math.round((currentChapter / total) * 100);

---

<nav class="hidden lg:flex flex-col gap-0 text-sm" aria-label="Course chapters">
  <!-- Back to courses + series name -->
  <div class="mb-4">
    <a
      href={coursesHref}
      class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors mb-2"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      All Courses
    </a>
    <div class="font-black text-xs uppercase tracking-widest text-foreground leading-snug">
      {seriesName}
    </div>
  </div>

  <!-- Progress bar -->
  <div class="mb-4">
    <div class="flex justify-between items-center mb-1">
      <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Progress</span>
      <span class="text-[10px] font-black text-primary">{currentChapter}/{total}</span>
    </div>
    <div class="h-1.5 bg-border rounded-full overflow-hidden">
      <div
        class="h-full bg-primary rounded-full transition-all duration-500"
        style={`width: ${progressPct}%`}
      />
    </div>
  </div>

  <!-- Chapter list -->
  <div class="flex flex-col gap-0.5 max-h-[60vh] overflow-y-auto pr-1 scrollbar-thin scrollbar-thumb-border scrollbar-track-transparent">
    {seriesPosts.map((p) => {
      const chNum = parseInt(p.slug.match(/-ch(\d+)$/)?.[1] ?? "0", 10);
      const slugParts = p.slug.split("/");
      const slugPath = slugParts.slice(1).join("/");
      const href = `/${locale}/${slugPath}/`;
      const isCurrent = chNum === currentChapter;

      return (
        <a
          href={href}
          aria-current={isCurrent ? "page" : undefined}
          class:list={[
            "flex items-start gap-2.5 px-2.5 py-2 rounded-lg transition-colors text-[11px] leading-snug group",
            isCurrent
              ? "bg-primary/10 text-primary font-bold"
              : "text-muted-foreground hover:bg-muted/60 hover:text-foreground font-medium",
          ]}
        >
          <span
            class:list={[
              "flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-[9px] font-black mt-0.5",
              isCurrent
                ? "bg-primary text-primary-foreground"
                : "bg-border/60 text-muted-foreground group-hover:bg-primary/20 group-hover:text-primary",
            ]}
          >
            {chNum}
          </span>
          <span class="line-clamp-2">{p.data.title}</span>
        </a>
      );
    })}
  </div>
</nav>
