---
/**
 * 2-level drawer menu content: categories → series within each category.
 *
 * Rendered inside the existing mobile-menu drawer in BaseLayout.astro. Kept
 * as a standalone component so header/nav chrome stays owned by the
 * family-header batch; this file only supplies the drawer's browse content.
 */
import { getCollection } from "astro:content";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { buildSeriesIndex, groupSeriesByCategory } from "../lib/wiki-index";
import { prioritySeriesName, prettifySlug } from "../data/priority-series";
import { slugifyCategory } from "../lib/taxonomy";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = await getTranslations(locale as Locale);
const wikiT = (t as Record<string, unknown>).wiki as Record<string, string> | undefined;
const categoryNames = (t.category.names ?? {}) as unknown as { [key: string]: string };

const posts = await getCollection("blog", ({ data }) =>
  data.draft !== true && data.locale === locale && !data.redirectToBlog,
);

const catGroups = groupSeriesByCategory(Array.from(buildSeriesIndex(posts).values()))
  .filter(([, list]) => list.length > 0)
  .slice(0, 12);

const label = wikiT?.browseByCategory ?? "Browse by category";
---

<p class="px-2 pt-2 pb-1 text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50">
  {label}
</p>
{catGroups.map(([cat, list]) => (
  <details class="rounded-lg">
    <summary class="flex items-center justify-between cursor-pointer select-none h-11 px-2 rounded-lg text-sm font-bold text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors list-none">
      <span class="truncate">{categoryNames[cat] ?? cat}</span>
      <span class="text-[11px] tabular-nums font-normal opacity-60 shrink-0 ml-2">{list.length}</span>
    </summary>
    <ul class="ml-4 border-l border-border/50 pl-3 py-1 space-y-0.5">
      {list.slice(0, 10).map((s) => (
        <li>
          <a
            href={`/${locale}/${s.firstPost.slug.split("/").slice(1).join("/")}/`}
            class="flex items-baseline justify-between gap-2 rounded-md px-2 py-1.5 text-[13px] text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors"
          >
            <span class="truncate">{prioritySeriesName(s.key, locale) ?? prettifySlug(s.key)}</span>
            <span class="text-[10px] tabular-nums opacity-60 shrink-0">{s.chapterCount}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
))}
