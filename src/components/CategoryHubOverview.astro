---
import type { CategoryHubData } from "../lib/seo/category-hub-builder";
import type { Locale } from "../lib/i18n";

interface Props {
  data: CategoryHubData;
  locale: Locale;
}

// 2026-11-09: 모든 허브에 같은 문답 3개를 넣던 FAQ 칸과 FAQPage JSON-LD를 뺀다.
// 문답이 카테고리마다 같아(템플릿) 검색엔진엔 얇은 대량 페이지로 보이고, FAQ 리치 결과는 2026-05 종료.
const { data } = Astro.props;
---

<div class="mb-10 rounded-2xl border border-border bg-muted/30 p-6 md:p-8 space-y-6">
  <div class="space-y-3 text-sm md:text-base leading-relaxed text-muted-foreground">
    {data.overviewParagraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</div>
