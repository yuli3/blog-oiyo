---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WikiTable from "./WikiTable.astro";
import RelatedPosts from "./RelatedPosts.astro";
import RelatedToolLinks from "./RelatedToolLinks.astro";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { buildSeriesIndex, groupSeriesByCategory, isRedirectStub } from "../lib/wiki-index";
import { prioritySeriesName, deriveSeriesLabel } from "../data/priority-series";
import { slugifyCategory } from "../lib/taxonomy";
import { firstChapterSlugs } from "../lib/related-next";

interface Props {
  locale: string;
  title: string;
  subtitle: string;
  posts: CollectionEntry<"blog">[];
}

const { locale, title, subtitle, posts: incomingPosts } = Astro.props;
const posts = incomingPosts.filter((p) => !isRedirectStub(p.data));
const t = await getTranslations(locale as Locale);
const wikiT = (t as Record<string, unknown>).wiki as Record<string, string> | undefined;
const categoryNames = (t.category.names ?? {}) as unknown as { [key: string]: string };

const L = (key: string, fallback: string) => wikiT?.[key] ?? fallback;

// ── series index for this locale ──────────────────────────────────────────
const allSeries = Array.from(buildSeriesIndex(posts).values());

// The landing page teaches the information architecture before it optimizes
// for traffic. These four durable study/job-preparation domains are deliberate;
// individual series remain discoverable inside each category.
const featuredCategoryOrder = ["Business", "Economics", "Accounting", "Exam"] as const;
const featuredCategories = featuredCategoryOrder.map((category) => {
  const series = allSeries.filter((entry) => entry.category === category);
  const categoryPosts = series
    .flatMap((entry) => entry.posts)
    .sort((a, b) => {
      const da = a.data.updatedDate ?? a.data.pubDate;
      const db = b.data.updatedDate ?? b.data.pubDate;
      return db.valueOf() - da.valueOf();
    });
  return { category, series, posts: categoryPosts };
}).filter((entry) => entry.posts.length > 0);

// Fixed "next one page" CTA: first chapter of top priority series (pages/session).
const featuredFirstSeries = featuredCategories
  .flatMap((entry) => entry.series.slice(0, 1));
const nextReadSlugs = firstChapterSlugs(featuredFirstSeries, 3);

// Two-level category → series index for the sidebar.
const catGroups = groupSeriesByCategory(allSeries);

// Recent updates table.
const recent = [...posts]
  .sort((a, b) => {
    const da = a.data.updatedDate ?? a.data.pubDate;
    const db = b.data.updatedDate ?? b.data.pubDate;
    return db.valueOf() - da.valueOf();
  })
  .slice(0, 15);

const fmt = (d: Date) => {
  const tag = locale === "ko" ? "ko-KR" : locale === "ja" ? "ja-JP" : locale === "zh" ? "zh-CN" : locale === "fr" ? "fr-FR" : locale === "es" ? "es-ES" : "en-US";
  return d.toLocaleDateString(tag, { year: "numeric", month: "short", day: "numeric" });
};

const totalChapters = posts.length;
const totalSeries = allSeries.length;

const chapterWord = L("chapters", "chapters");
---

<BaseLayout title={title} description={subtitle}>
  <section class="py-10 md:py-14">
    <div class="container px-4">
      <div class="border-b border-border pb-6 mb-5 sm:mb-8">
        <h1 class="text-3xl md:text-4xl font-black tracking-tight text-foreground">{title}</h1>
        <p class="mt-2 text-muted-foreground leading-relaxed max-w-2xl">{subtitle}</p>
        <p class="mt-3 text-xs uppercase tracking-widest text-muted-foreground/60 tabular-nums">
          {totalSeries} {L("seriesCount", "series")} · {totalChapters} {chapterWord}
        </p>
      </div>

      <div class="grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-12">
        <!-- ── Sidebar: full category→series index ────────────────────────── -->
        <aside class="min-w-0 lg:sticky lg:top-20 self-start">
          <nav aria-label={L("seriesIndex", "Series index")}>
            <p class="text-[11px] font-bold uppercase tracking-widest text-muted-foreground/70 mb-3 border-b border-border pb-2">
              {L("categoriesIndex", "Categories")}
            </p>
            {catGroups.map(([cat, list], gi) => (
              <details class="group mb-1.5" open={gi < 4}>
                <summary class="flex min-w-0 items-center justify-between cursor-pointer select-none py-1 text-sm font-semibold text-foreground hover:text-primary transition-colors list-none">
                  <span class="truncate">{categoryNames[cat] ?? cat}</span>
                  <span class="text-[11px] tabular-nums text-muted-foreground/60 shrink-0">{list.reduce((n, s) => n + s.chapterCount, 0)}</span>
                </summary>
                <ul class="ml-3 border-l border-border/60 pl-3 my-1 space-y-1">
                  {list.slice(0, 8).map((s) => (
                    <li>
                      <a href={`/${locale}/${s.firstPost.slug.split("/").slice(1).join("/")}/`} class="flex min-w-0 items-baseline gap-1 py-1 text-[13px] text-muted-foreground hover:text-primary transition-colors">
                        <span class="truncate">{prioritySeriesName(s.key, locale) ?? deriveSeriesLabel(s.firstPost.data.title, s.key)}</span>
                        <span class="tabular-nums text-muted-foreground/50 shrink-0">{s.chapterCount}</span>
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href={`/${locale}/category/${slugifyCategory(cat)}/`} class="block py-1 text-[13px] font-semibold text-primary/80 hover:text-primary">
                      {L("viewCategory", "View all")} →
                    </a>
                  </li>
                </ul>
              </details>
            ))}
          </nav>
        </aside>

        <!-- ── Main column ─────────────────────────────────────────────────── -->
        <div class="min-w-0 space-y-7 sm:space-y-12">
          {featuredCategories.map((featured) => {
            const categorySlug = slugifyCategory(featured.category);
            const displayName = categoryNames[featured.category] ?? featured.category;
            return (
            <section aria-labelledby={`sec-${categorySlug}`}>
              <div class="flex items-baseline justify-between gap-3 border-b border-border mb-4 pb-2">
                <h2 id={`sec-${categorySlug}`} class="min-w-0 truncate text-lg font-bold tracking-tight text-foreground">
                  {displayName}
                </h2>
                <div class="flex items-baseline gap-3 shrink-0">
                  <span class="text-xs tabular-nums text-muted-foreground/70 whitespace-nowrap">{featured.posts.length} {chapterWord}</span>
                  <a href={`/${locale}/category/${categorySlug}/`} class="py-1.5 text-xs font-semibold text-primary/80 hover:text-primary whitespace-nowrap">
                    {L("viewCategory", "View all")} →
                  </a>
                </div>
              </div>
              <WikiTable posts={featured.posts.slice(0, 5)} locale={locale} />
            </section>
          )})}

          <section aria-labelledby="sec-recent">
            <div class="border-b border-border mb-4 pb-2">
              <h2 id="sec-recent" class="text-lg font-bold tracking-tight text-foreground">{L("recentUpdates", "Recent updates")}</h2>
            </div>
            <WikiTable posts={recent} locale={locale} />
          </section>
        </div>
      </div>
    </div>
  </section>

  <div slot="bottom-cta" class="max-w-4xl mx-auto space-y-6">
    <RelatedPosts locale={locale} slugs={nextReadSlugs} variant="next" maxItems={3} />
    <RelatedToolLinks
      locale={locale as Locale}
      variant="next"
      slugs={["height-converter", "salary-calculator", "sleep-calculator", "percentage-calculator", "bmi-calculator"]}
    />
  </div>
</BaseLayout>
