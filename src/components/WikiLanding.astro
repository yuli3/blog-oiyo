---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WikiTable from "./WikiTable.astro";
import RelatedPosts from "./RelatedPosts.astro";
import RelatedToolLinks from "./RelatedToolLinks.astro";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { buildSeriesIndex, groupSeriesByCategory, isRedirectStub } from "../lib/wiki-index";
import {
  PRIORITY_SERIES,
  PRIORITY_CATEGORIES,
  prioritySeriesName,
  seriesDisplayName,
} from "../data/priority-series";
import { slugifyCategory } from "../lib/taxonomy";
import { firstChapterSlugs } from "../lib/related-next";

interface Props {
  locale: string;
  title: string;
  subtitle: string;
  posts: CollectionEntry<"blog">[];
}

const { locale, title, subtitle, posts: incomingPosts } = Astro.props;
const posts = incomingPosts.filter((p) => !isRedirectStub(p.data));
const t = await getTranslations(locale as Locale);
const wikiT = (t as Record<string, unknown>).wiki as Record<string, string> | undefined;
const categoryNames = (t.category.names ?? {}) as unknown as { [key: string]: string };

const L = (key: string, fallback: string) => wikiT?.[key] ?? fallback;

// ── series index for this locale ──────────────────────────────────────────
const allSeries = Array.from(buildSeriesIndex(posts).values());
const byKey = new Map(allSeries.map((s) => [s.key, s]));

// Priority axis: curated top-traffic/importance series (see priority-series.ts).
const priority = PRIORITY_SERIES.map((k) => byKey.get(k)).filter(
  (s): s is NonNullable<typeof s> => !!s,
);

// Fixed "next one page" CTA: first chapter of top priority series (pages/session).
const nextReadSlugs = firstChapterSlugs(priority, 3);

// ── 학문 → 과목 ──────────────────────────────────────────────────────────
// 과목(course)은 **1장이 academy·education 트랙이고 2장 이상 이어지는 시리즈**다.
// 이 규칙을 한 군데서만 정의한다. 랜딩 상단 숫자, 학문 칸, 전체 학문 목록이
// 서로 다른 기준으로 세면 같은 페이지가 다른 말을 한다(2026-09-19 A1 감사:
// 상단 "534개 시리즈"는 한 편짜리 매거진 글까지 센 값이었다).
const COURSE_TRACKS = new Set(["academy", "education"]);
const isCourse = (s: (typeof allSeries)[number]) =>
  s.chapterCount >= 2 && COURSE_TRACKS.has(String(s.firstPost.data.track ?? ""));

const courseGroups = groupSeriesByCategory(allSeries.filter(isCourse));
const courseGroupMap = new Map(courseGroups);

// 정규 과목(이름이 정리된 것)을 먼저, 그다음 장 수 순서.
const sortCourses = (list: typeof allSeries) =>
  [...list].sort((a, b) => {
    const ca = prioritySeriesName(a.key, locale) ? 0 : 1;
    const cb = prioritySeriesName(b.key, locale) ? 0 : 1;
    return ca - cb || b.chapterCount - a.chapterCount || a.key.localeCompare(b.key);
  });

const priorityCats = PRIORITY_CATEGORIES.map((cat) => {
  const list = sortCourses(courseGroupMap.get(cat) ?? []);
  return {
    cat,
    list,
    chapters: list.reduce((n, s) => n + s.chapterCount, 0),
    top: list.slice(0, cat === "Exam" ? 6 : 3),
  };
}).filter((g) => g.list.length > 0);

// 나머지 학문도 전부 보여준다. 다섯 칸만 있으면 나머지 26개 학문이 랜딩에서
// 사라진다(2026-09-20 세운 지적).
const prioritySet = new Set<string>(PRIORITY_CATEGORIES);
const otherCats = courseGroups
  .filter(([cat]) => !prioritySet.has(cat))
  .map(([cat, list]) => ({
    cat,
    courses: list.length,
    chapters: list.reduce((n, s) => n + s.chapterCount, 0),
  }))
  .sort((a, b) => b.chapters - a.chapters || a.cat.localeCompare(b.cat));

const otherCourses = otherCats.reduce((n, c) => n + c.courses, 0);
const otherChapters = otherCats.reduce((n, c) => n + c.chapters, 0);
const totalCourses = priorityCats.reduce((n, g) => n + g.list.length, 0) + otherCourses;
const totalChapters = priorityCats.reduce((n, g) => n + g.chapters, 0) + otherChapters;
const totalFields = priorityCats.length + otherCats.length;

// 시험 학문은 과목이 많아 한 단계 접는다. 분류는 시리즈 이름으로 한다.
const examBuckets = (() => {
  const exam = priorityCats.find((g) => g.cat === "Exam");
  if (!exam) return [] as { key: string; label: string; courses: number }[];
  const b = { pro: 0, tech: 0, ncs: 0, etc: 0 };
  for (const s of exam.list) {
    const name = `${s.key} ${s.firstPost.data.title ?? ""}`;
    if (/NCS/i.test(name)) b.ncs += 1;
    else if (/기사|기능사|기술사/.test(name)) b.tech += 1;
    else if (/시험/.test(name)) b.pro += 1;
    else b.etc += 1;
  }
  return [
    { key: "examPro", label: L("examPro", "Professional licences"), courses: b.pro },
    { key: "examTech", label: L("examTech", "Technical certificates"), courses: b.tech },
    { key: "examEtc", label: L("examEtc", "Other certificates"), courses: b.etc },
    { key: "examNcs", label: L("examNcs", "Public-sector NCS"), courses: b.ncs },
  ].filter((x) => x.courses > 0);
})();

// Recent updates table.
const recent = [...posts]
  .sort((a, b) => {
    const da = a.data.updatedDate ?? a.data.pubDate;
    const db = b.data.updatedDate ?? b.data.pubDate;
    return db.valueOf() - da.valueOf();
  })
  .slice(0, 15);

const fmt = (d: Date) => {
  const tag = locale === "ko" ? "ko-KR" : locale === "ja" ? "ja-JP" : locale === "zh" ? "zh-CN" : locale === "fr" ? "fr-FR" : locale === "es" ? "es-ES" : "en-US";
  return d.toLocaleDateString(tag, { year: "numeric", month: "short", day: "numeric" });
};

const chapterWord = L("chapters", "chapters");
---

<BaseLayout title={title} description={subtitle}>
  <section class="py-10 md:py-14">
    <div class="container px-4">
      <div class="border-b border-border pb-6 mb-6 sm:mb-9">
        <h1 class="max-w-3xl text-3xl md:text-4xl font-black tracking-tight text-foreground">{title}</h1>
        <p class="mt-3 max-w-2xl text-muted-foreground leading-relaxed">{subtitle}</p>
        <p class="mt-3 text-xs tracking-wide text-muted-foreground/70 tabular-nums">
          {L("landingStats", "{fields} fields · {courses} courses · {chapters} chapters")
            .replace("{fields}", String(totalFields))
            .replace("{courses}", String(totalCourses))
            .replace("{chapters}", String(totalChapters))}
        </p>
      </div>

      <!-- ── 다섯 학문 ─────────────────────────────────────────────────────── -->
      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
        {priorityCats.map(({ cat, list, chapters, top }) => (
          <section
            aria-labelledby={`sec-${slugifyCategory(cat)}`}
            class:list={[
              "flex flex-col gap-3 rounded-lg border border-border bg-card p-5",
              cat === "Exam" && "lg:col-span-2",
            ]}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h2 id={`sec-${slugifyCategory(cat)}`} class="min-w-0 truncate text-xl font-bold tracking-tight text-foreground">
                {categoryNames[cat] ?? cat}
              </h2>
              <span class="shrink-0 text-xs tabular-nums text-muted-foreground/70">
                {list.length} {L("subjects", "subjects")} · {chapters} {chapterWord}
              </span>
            </div>

            <ul class:list={["grid gap-y-1.5", cat === "Exam" && "sm:grid-cols-3 sm:gap-x-6"]}>
              {top.map((s) => (
                <li class="min-w-0">
                  <a
                    href={`/${locale}/${s.firstPost.slug.split("/").slice(1).join("/")}/`}
                    class="flex min-w-0 items-baseline gap-2 py-1 text-sm text-foreground hover:text-primary transition-colors"
                  >
                    <span class="min-w-0 truncate">{seriesDisplayName(s.key, locale, s.firstPost.data.title)}</span>
                    <span class="shrink-0 tabular-nums text-xs text-muted-foreground/60">{s.chapterCount}</span>
                  </a>
                </li>
              ))}
            </ul>

            {cat === "Exam" && examBuckets.length > 0 && (
              <ul class="flex flex-wrap gap-1.5">
                {examBuckets.map((b) => (
                  <li class="rounded bg-muted px-2 py-1 text-xs text-muted-foreground tabular-nums">
                    {b.label} {b.courses}
                  </li>
                ))}
              </ul>
            )}

            <a
              href={`/${locale}/category/${slugifyCategory(cat)}/`}
              class="mt-auto pt-1 text-sm font-semibold text-primary/90 hover:text-primary"
            >
              {L("viewAllSubjects", "All {count} subjects").replace("{count}", String(list.length))} →
            </a>
          </section>
        ))}
      </div>

      <!-- ── 그 밖의 학문 ──────────────────────────────────────────────────── -->
      {otherCats.length > 0 && (
        <section aria-labelledby="sec-other-fields" class="mt-10 sm:mt-14">
          <div class="flex items-baseline justify-between gap-3 border-b border-border mb-3 pb-2">
            <h2 id="sec-other-fields" class="min-w-0 truncate text-lg font-bold tracking-tight text-foreground">
              {L("otherFields", "Other fields")} {otherCats.length}
            </h2>
            <span class="shrink-0 text-xs tabular-nums text-muted-foreground/70">
              {otherCourses} {L("subjects", "subjects")} · {otherChapters} {chapterWord}
            </span>
          </div>
          <ul class="grid gap-x-7 sm:grid-cols-2 lg:grid-cols-4">
            {otherCats.map((c) => (
              <li class="min-w-0">
                <a
                  href={`/${locale}/category/${slugifyCategory(c.cat)}/`}
                  class="flex min-w-0 items-baseline justify-between gap-2 border-b border-border/40 py-2 text-sm text-foreground hover:text-primary transition-colors"
                >
                  <span class="min-w-0 truncate">{categoryNames[c.cat] ?? c.cat}</span>
                  <span class="shrink-0 tabular-nums text-xs text-muted-foreground/60">{c.courses} · {c.chapters}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ── 최근 업데이트 ─────────────────────────────────────────────────── -->
      <section aria-labelledby="sec-recent" class="mt-10 sm:mt-14">
        <div class="flex items-baseline justify-between gap-3 border-b border-border mb-4 pb-2">
          <h2 id="sec-recent" class="min-w-0 truncate text-lg font-bold tracking-tight text-foreground">{L("recentUpdates", "Recent updates")}</h2>
          <a href={`/${locale}/updates/`} class="shrink-0 py-1.5 text-xs font-semibold text-primary/80 hover:text-primary whitespace-nowrap">
            {L("viewAllUpdates", "View all")} →
          </a>
        </div>
        <WikiTable posts={recent} locale={locale} />
      </section>
    </div>
  </section>

  <div slot="bottom-cta" class="max-w-4xl mx-auto space-y-6">
    <RelatedPosts locale={locale} slugs={nextReadSlugs} variant="next" maxItems={3} />
    <RelatedToolLinks
      locale={locale as Locale}
      variant="next"
      slugs={["height-converter", "salary-calculator", "sleep-calculator", "percentage-calculator", "bmi-calculator"]}
    />
  </div>
</BaseLayout>
