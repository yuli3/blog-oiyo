---
/**
 * Hand-placed AdSense units, alongside Auto ads (세운 2026-10-06: "섞는 방식으로 갑시다").
 *
 * Why: over 28 days (2026-09-08..10-05) Auto ads put an in-content ad on about 3% of
 * blog page views; nearly all earnings came from the anchor and the vignette. These
 * units fill the empty in-content spots, and only where the reader already has what
 * they came for: once in the middle of a long article, at its end, and under a tool.
 * Never inside a tool, a form or a game.
 *
 * The units are placed by a small inline script instead of markup in each template,
 * because the spots depend on the rendered page (the third heading, the first tool
 * island) and there are 195 tool pages. It runs while the page is still being parsed,
 * so the reserved box is there before first paint and nothing shifts.
 *
 * Off switch: siteConfig.manualAds.enabled. A slot with an empty id is skipped.
 * Measured per unit in AdSense (oiyo-blog-article-mid / -article-end / -tool-result).
 */
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../lib/i18n";

interface Props { locale: Locale; noindex?: boolean }
const { locale, noindex = false } = Astro.props as Props;

const config = siteConfig.manualAds;
const client = siteConfig.analytics.googleAdsenseId;

// A tool page is a top-level page that mounts an interactive island. Read once per
// build from the page sources, so a new tool is covered without touching a list.
const pagesDir = join(process.cwd(), "src/pages/[...lang]");
const toolSlugs = readdirSync(pagesDir)
  .filter((name) => name.endsWith(".astro") && readFileSync(join(pagesDir, name), "utf8").includes("client:"))
  .map((name) => name.slice(0, -6));

const parts = Astro.url.pathname.split("/").filter(Boolean);
const isTool = parts.length === 2 && toolSlugs.includes(parts[1]);

const LABEL: Record<Locale, string> = { ko: "광고", en: "Advertisement", ja: "広告", zh: "广告", fr: "Publicité", es: "Publicidad" };
const payload = JSON.stringify({
  client,
  slots: config.slots,
  isTool,
  label: LABEL[locale] ?? LABEL.en,
  minHeadings: config.midArticleMinHeadings,
});
const active = config.enabled && Boolean(client) && !noindex;
---

{active && (
  <script is:inline set:html={`(function(){
  var cfg=${payload};
  var host=location.hostname;
  // Real pages only: a local build or a preview deploy must not request ads.
  var preview=false;try{preview=localStorage.getItem("oiyo:ads-preview")==="1"}catch(e){}
  if(!/(^|\\.)oiyo\\.net$/.test(host)&&!preview)return;
  var units=[];
  function box(name,slot,inArticle){
    if(!slot)return null;
    var wrap=document.createElement("aside");
    wrap.className="not-prose my-8 min-h-72 rounded-lg border border-border bg-card p-2";
    wrap.setAttribute("data-manual-ad",name);
    wrap.setAttribute("aria-label",cfg.label);
    var tag=document.createElement("p");
    tag.className="mb-1 text-center text-xs text-muted-foreground";
    tag.textContent=cfg.label;
    var ins=document.createElement("ins");
    ins.className="adsbygoogle block";
    ins.setAttribute("data-ad-client",cfg.client);
    ins.setAttribute("data-ad-slot",slot);
    if(inArticle){ins.setAttribute("data-ad-layout","in-article");ins.setAttribute("data-ad-format","fluid");ins.classList.add("text-center")}
    else{ins.setAttribute("data-ad-format","auto");ins.setAttribute("data-full-width-responsive","true")}
    wrap.appendChild(tag);wrap.appendChild(ins);units.push(wrap);
    // AdSense marks a unit it could not fill. An empty framed box labelled as an ad is worse than no box.
    if("MutationObserver" in window){new MutationObserver(function(){if(ins.getAttribute("data-ad-status")==="unfilled")wrap.hidden=true}).observe(ins,{attributes:true,attributeFilter:["data-ad-status"]})}
    return wrap;
  }
  var main=document.getElementById("main-content");
  if(!main)return;
  var prose=main.querySelector(".prose-content");
  if(prose){
    var heads=prose.querySelectorAll(":scope > h2");
    if(heads.length>=cfg.minHeadings){var mid=box("article-mid",cfg.slots.articleMid,true);if(mid)prose.insertBefore(mid,heads[2])}
    var end=box("article-end",cfg.slots.articleEnd,false);
    if(end)prose.parentNode.insertBefore(end,prose.nextSibling);
  }else if(cfg.isTool){
    var island=main.querySelector("astro-island");
    var tool=island&&box("tool-result",cfg.slots.toolResult,false);
    if(tool){tool.classList.add("mx-auto","max-w-3xl");island.parentNode.insertBefore(tool,island.nextSibling)}
  }
  if(!units.length)return;
  function fill(el){try{(window.adsbygoogle=window.adsbygoogle||[]).push({})}catch(e){}el.setAttribute("data-manual-ad-requested","1")}
  // Ask for an ad only when the box is about to be seen: an unseen request earns nothing and lowers viewability.
  if(!("IntersectionObserver" in window)){units.forEach(fill);return}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){io.unobserve(entry.target);fill(entry.target)}})},{rootMargin:"300px 0px"});
  units.forEach(function(el){io.observe(el)});
})();`} />
)}
